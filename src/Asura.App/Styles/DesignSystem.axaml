<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:converters="using:Avalonia.Data.Converters">
  <!--
    The shell's design system: the components every view is built from, defined
    once, in terms of the published tokens and nothing else.

    Nothing in here may contain a literal colour, size, gap, or radius. Every value
    comes from a Shell* resource, because those are what the appearance settings
    and the platform profile actually move. A literal here is a setting that
    silently stops working, and that is exactly how the interface drifted apart:
    a hundred distinct margins and eight kinds of card, none of which the density
    or corner-radius settings could reach.
  -->

  <Styles.Resources>
    <ControlTheme x:Key="{x:Type controls:SurfaceCard}" TargetType="controls:SurfaceCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource ShellCardPadding}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <!--
            Two borders, because a border that clips itself eats its own outline.
            Putting ClipToBounds on the element that draws the stroke clips the
            stroke too, and at a rounded corner that removes its outer half — the
            arc comes out as a dark diagonal notch between two straight edges.
            The outer border draws; the inner one clips the content.
          -->
          <Border
              Name="PART_Surface"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Border
                Name="PART_Clip"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="{TemplateBinding ClipToBounds}">
              <ContentPresenter
                  Name="PART_ContentPresenter"
                  Margin="{TemplateBinding Padding}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>

      <!--
        One selector per tone. A view names what the card is; which fill and which
        border that turns into is decided here, so a host profile can answer
        differently without any view changing.
      -->
      <Style Selector="^:tone-raised">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
      </Style>
      <Style Selector="^:tone-sunken">
        <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
      </Style>
      <Style Selector="^:tone-panel">
        <Setter Property="Background" Value="{DynamicResource ShellSidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellSidebarBorderBrush}" />
      </Style>
      <!-- A notice is information, in its own tone. Drawn in the accent it
           read as a warning whenever the accent was orange or yellow. -->
      <Style Selector="^:tone-notice">
        <Setter Property="Background" Value="{DynamicResource ShellInfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellInfoBorderBrush}" />
      </Style>
      <Style Selector="^:tone-danger">
        <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerBorderBrush}" />
      </Style>
      <Style Selector="^:tone-warning">
        <Setter Property="Background" Value="{DynamicResource ShellWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellWarningBorderBrush}" />
      </Style>
      <Style Selector="^:tone-success">
        <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccessBorderBrush}" />
      </Style>

      <Style Selector="^:overlay">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceOverlayBrush}" />
      </Style>
      <!-- The shadow belongs to the shape, so it is set on the template's border. -->
      <Style Selector="^:overlay /template/ Border#PART_Surface">
        <Setter Property="BoxShadow" Value="{DynamicResource ShellOverlayShadow}" />
      </Style>

      <!--
        A card that is the active one — the focused runtime panel, the selected
        layout slot — outlines itself in the accent. Views state it by binding
        Classes.active, which is why it is a class here rather than a property.
      -->
      <Style Selector="^.active">
        <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      </Style>

      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>

      <Style Selector="^:interactive:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      </Style>
      <Style Selector="^:interactive:focus-within /template/ Border#PART_Surface">
        <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      </Style>
    </ControlTheme>
    <!--
      A runtime panel. The card, the header, and the three actions every panel
      has: split beside, split below, close.

      These lived in each panel view, eight times over, and had drifted the way
      duplicated markup does — the browser declared its split buttons with no
      Grid.Column, so they rendered stacked underneath its status dot where
      nobody could press them, and its two split icons were swapped relative to
      the other seven. A panel now states only what is particular to it.
    -->
    <ControlTheme x:Key="{x:Type controls:PanelChrome}" TargetType="controls:PanelChrome">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <controls:SurfaceCard
              Name="PART_PanelSurface"
              Tone="Panel"
              ClipsContent="True"
              Padding="0"
              Classes.active="{TemplateBinding IsActive}">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <Border
                  Grid.Row="0"
                  Classes="PanelHeader"
                  Height="{DynamicResource ShellPanelHeaderHeight}">
                <!--
                  Docked, not a grid of Auto columns. A narrow panel has less
                  header than it has things to put in it, and a grid answers that
                  by letting its Auto columns overlap: the browser's status text
                  printed straight through its address box. Docking states the
                  order in which the row gives up space instead — secondary actions move to overflow when space is tight. The
                  browser keeps the remaining width for its address field.
                -->
                <DockPanel Margin="{controls:Inset Horizontal=Md}" LastChildFill="True">
                  <!--
                    One group of square glyphs, touching. They are the same four
                    actions on every panel and read as a set; spacing them apart
                    spent header width the browser's address bar wanted, for a
                    separation the glyphs already have inside their own boxes.
                  -->
                  <StackPanel
                      DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
                    <controls:SignalDot
                        Margin="{controls:Inset Right=Xs}"
                        IsVisible="{TemplateBinding HasAttention}"
                        ToolTip.Tip="This panel has an unread notification" />
                    <StackPanel Name="PART_HeaderActions" Orientation="Horizontal">
                      <!-- A wrap panel: one row in the header, which gives it
                           all the width it asks for, and as many rows as it
                           needs in the overflow strip, where it moves when
                           the header is short of width. -->
                      <WrapPanel Name="PART_SecondaryActions" Orientation="Horizontal">
                        <Button
                            Name="PART_Collapse"
                            AutomationProperties.Name="Collapse this panel"
                            Classes="IconButton Compact"
                            ToolTip.Tip="Collapse panel">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="Subtract" />
                        </Button>
                        <Button
                            Name="PART_Expand"
                            AutomationProperties.Name="{TemplateBinding ExpansionLabel}"
                            Classes="IconButton Compact"
                            ToolTip.Tip="{TemplateBinding ExpansionLabel}">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="{TemplateBinding ExpansionIcon}" />
                        </Button>
                        <Button
                            Name="PART_Float"
                            AutomationProperties.Name="Move this panel to its own window"
                            Classes="IconButton Compact"
                            IsVisible="{TemplateBinding CanFloat}"
                            ToolTip.Tip="Move to its own window">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="WindowMultiple" />
                        </Button>
                        <Button
                            Name="PART_Dock"
                            AutomationProperties.Name="Put this panel back in the workspace"
                            Classes="IconButton Compact"
                            IsVisible="{TemplateBinding IsFloating}"
                            ToolTip.Tip="Put back in the workspace">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="WindowMultipleOff" />
                        </Button>
                        <Button
                            Name="PART_SplitLeftRight"
                            AutomationProperties.Name="Split this panel left and right"
                            Classes="IconButton Compact"
                            IsVisible="{TemplateBinding CanSplit}"
                            ToolTip.Tip="Split left/right">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="SplitVertical" />
                        </Button>
                        <Button
                            Name="PART_SplitTopBottom"
                            AutomationProperties.Name="Split this panel top and bottom"
                            Classes="IconButton Compact"
                            IsVisible="{TemplateBinding CanSplit}"
                            ToolTip.Tip="Split top/bottom">
                          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="SplitHorizontal" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                    <Button Name="PART_Overflow" Classes="IconButton Compact"
                        IsVisible="{TemplateBinding IsHeaderCondensed}"
                        AutomationProperties.Name="Panel actions" ToolTip.Tip="Panel actions">
                      <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="MoreHorizontal" />
                    </Button>
                    <Button
                        Name="PART_Close"
                        AutomationProperties.Name="{TemplateBinding CloseLabel}"
                        Classes="IconButton Compact"
                        ToolTip.Tip="{TemplateBinding CloseLabel}">
                      <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize12}" Symbol="Dismiss" />
                    </Button>
                  </StackPanel>
                  <ContentPresenter
                      DockPanel.Dock="Right"
                      Margin="{controls:Inset Right=Sm}"
                      VerticalAlignment="Center"
                      Content="{TemplateBinding Actions}"
                      IsVisible="{TemplateBinding IsActionsVisible}" />
                  <!-- Status stays bound to the panel even when the handle
                       resolves Dock's document as its drag context. -->
                  <controls:PanelDockHandle
                      Name="PART_StatusDragHandle"
                      DockPanel.Dock="Left"
                      Padding="{controls:Inset Right=Sm}"
                      VerticalContentAlignment="Center"
                      IsVisible="{TemplateBinding IsStatusVisible}">
                    <ContentPresenter
                        DataContext="{TemplateBinding DataContext}"
                        Content="{TemplateBinding Status}" />
                  </controls:PanelDockHandle>
                  <ContentPresenter
                      DockPanel.Dock="Left"
                      Margin="{controls:Inset Right=Sm}"
                      VerticalAlignment="Center"
                      Content="{TemplateBinding Leading}"
                      MaxWidth="{TemplateBinding LeadingMaxWidth}"
                      IsVisible="{TemplateBinding IsLeadingVisible}" />
                  <!--
                    The title is Dock's drag surface, which is why panels have no
                    second tab strip above them. Where the panel adds no header
                    controls of its own it takes the free width too, so the grab
                    area is the whole row rather than the glyphs of the title.
                  -->
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:PanelDockHandle
                        Name="PART_TitleDragHandle"
                        IsVisible="{TemplateBinding IsTitleVisible}"
                        Grid.Column="0"
                        Grid.ColumnSpan="{TemplateBinding TitleColumnSpan}">
                      <controls:PanelTitleLine
                          VerticalAlignment="Center"
                          Spacing="{DynamicResource ShellSpaceSm}">
                        <TextBlock
                            FontSize="{DynamicResource ShellFontSize11}"
                            Text="{TemplateBinding Title}"
                            MaxWidth="{Binding $self.FontSize, Converter={x:Static controls:TextScaledLength.PanelTitle}}"
                            TextTrimming="CharacterEllipsis" />
                        <ContentPresenter
                            Content="{TemplateBinding TitleAdornment}"
                            IsVisible="{TemplateBinding IsTitleAdornmentVisible}" />
                      </controls:PanelTitleLine>
                    </controls:PanelDockHandle>
                    <ContentPresenter
                        Grid.Column="1"
                        Margin="{controls:Inset Left=Sm}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding HeaderContent}"
                        IsVisible="{TemplateBinding IsHeaderContentVisible}" />
                  </Grid>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Name="PART_OverflowStrip"
                  IsVisible="{TemplateBinding IsHeaderOverflowOpen}"
                  Background="{DynamicResource ShellSidebarBrush}"
                  BorderBrush="{DynamicResource ShellSidebarBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}">
                <!-- Wraps rather than scrolls, so every action in the strip is
                     whole and in view. A scrolling row cut its last button in
                     half on a narrow panel. -->
                <WrapPanel Name="PART_OverflowActions" Orientation="Horizontal"
                    HorizontalAlignment="Right" KeyboardNavigation.TabNavigation="Continue">
                  <ContentPresenter Name="PART_BrowserOverflow"
                      Content="{TemplateBinding HeaderOverflowContent}" />
                </WrapPanel>
              </Border>
              <components:ErrorNoticesView Grid.Row="2" DataContext="{CompiledBinding $parent[controls:PanelChrome].((vm:ObservableObject)DataContext).ErrorNotices}" />
              <ContentPresenter
                  Grid.Row="3"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <!--
                The far end of the same band. For a panel holding an
                operating-system view this is the only strip of it the shell
                still draws — such a view is composited above every Avalonia
                pixel — so what has to be seen while the panel works, and what
                has to be reachable, both belong here.
              -->
              <Border
                  Grid.Row="4"
                  Classes="PanelFooter"
                  IsVisible="{TemplateBinding IsFooterVisible}">
                <controls:PanelDockHandle
                    Name="PART_FooterDragHandle"
                    Padding="{controls:Inset Horizontal=Sm}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">
                  <ContentPresenter
                      DataContext="{TemplateBinding DataContext}"
                      Content="{TemplateBinding Footer}" />
                </controls:PanelDockHandle>
              </Border>
              </Grid>
            </controls:SurfaceCard>
            <Border
                Background="{DynamicResource ShellAgentPanelGlowBrush}"
                BorderBrush="{DynamicResource ShellAccentBrush}"
                BorderThickness="2"
                BoxShadow="{DynamicResource ShellAgentPanelGlowShadow}"
                Classes="PanelAgentGlow"
                CornerRadius="{Binding CornerRadius, ElementName=PART_PanelSurface}"
                IsHitTestVisible="False"
                IsVisible="{TemplateBinding IsAgentActive}" />
            <Border
                Name="PART_NotificationPulse"
                Background="{DynamicResource ShellAccentSoftBrush}"
                BorderBrush="{DynamicResource ShellAccentBrush}"
                BorderThickness="2"
                Classes="PanelNotificationPulse"
                CornerRadius="{Binding CornerRadius, ElementName=PART_PanelSurface}"
                IsHitTestVisible="False"
                IsVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <!-- The flash itself is a window-level style below, so Reduce Motion
           can withhold it; without motion the outline simply shows for as
           long as the panel is announcing. -->
      <Style Selector="^:notification-pulse /template/ Border#PART_NotificationPulse">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
    <!--
      A floated panel: placed by its own coordinates over the workspace, wearing
      the same chrome it wears docked. Only the resize grip is added, because a
      panel in the layout is resized by the splitters around it and one out here
      has none.
    -->
    <ControlTheme x:Key="{x:Type controls:FloatingPanelLayer}" TargetType="controls:FloatingPanelLayer">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <Canvas ClipToBounds="False" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:FloatingRuntimePanelViewModel">
          <Setter Property="Canvas.Left" Value="{Binding X}" />
          <Setter Property="Canvas.Top" Value="{Binding Y}" />
          <Setter Property="Width" Value="{Binding Width}" />
          <Setter Property="Height" Value="{Binding Height}" />
          <Setter Property="IsVisible" Value="{Binding !Panel.IsCollapsed}" />
        </ControlTheme>
      </Setter>
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="vm:FloatingRuntimePanelViewModel">
          <Grid>
            <components:RuntimePanelContentControl
                DataContext="{Binding Panel}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
            <!--
              A corner worth aiming at. The mark is smaller than the target it
              stands for: what has to be easy is landing on it, not seeing it.
              The glyph takes no pointer input of its own, so the press is always
              attributed to the grip around it.
            -->
            <Border
                Name="PART_ResizeGrip"
                Width="26"
                Height="26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomRightCorner"
                AutomationProperties.Name="Resize this panel">
              <Path
                  Width="10"
                  Height="10"
                  Margin="{controls:Inset Right=Xs, Bottom=Xs}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Data="M 0,10 L 10,0 M 5,10 L 10,5"
                  IsHitTestVisible="False"
                  Opacity="0.55"
                  Stroke="{DynamicResource ShellMutedBrush}"
                  StrokeThickness="1.25" />
            </Border>
          </Grid>
        </DataTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type controls:IdentityTile}" TargetType="controls:IdentityTile">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="Width" Value="{DynamicResource ShellTileSizeMd}" />
      <Setter Property="Height" Value="{DynamicResource ShellTileSizeMd}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeMd}" />
      <!-- The fallback ink, for a tint that is not one solid colour. A solid
           tint is measured by the tile itself: it is the workspace's own
           colour, which the palette's accent pair knows nothing about. -->
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{TemplateBinding Tint}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <icons:SymbolIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Symbol="{TemplateBinding Symbol}"
                FontSize="{TemplateBinding FontSize}"
                Foreground="{TemplateBinding Ink}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:small">
        <Setter Property="Width" Value="{DynamicResource ShellTileSizeSm}" />
        <Setter Property="Height" Value="{DynamicResource ShellTileSizeSm}" />
        <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeSm}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShellInnerCornerRadius}" />
      </Style>
      <Style Selector="^:large">
        <Setter Property="Width" Value="{DynamicResource ShellTileSizeLg}" />
        <Setter Property="Height" Value="{DynamicResource ShellTileSizeLg}" />
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSize26}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
      </Style>
    </ControlTheme>

    <!--
      The two actions inside a rail tile. They paint nothing at all.

      The tile is one block of the workspace's colour, and hovering it is what
      lights that block up — so an action that painted a surface of its own put
      a second, differently-coloured rectangle inside it. On the tile you were
      already in it read as the colour being greyed out on hover, and across
      the opened tile it split one block into two, which came apart visibly as
      the tile closed again and the two halves stopped agreeing.

      Feedback is the glyph instead: it dims while pressed. At rest it is drawn
      at full strength — a white glyph at 78% on a blue or bronze tile fell
      under the contrast a non-text mark needs.

      Keyboard focus is a frame inside the action in the glyph's own colour,
      which is the one colour measured to read on this tile. The shell's accent
      halo would be clipped by the tile, and an accent ring on a tile that may
      itself be accent-coloured is a ring nobody can see.

      Only what no plain `Button` selector reaches is set here. The shell styles
      every button by element, and an element selector outranks a control
      theme's setter, so background, padding and the rest are stated locally at
      the two use sites where they will actually win. The pointer stays an
      arrow, as it does over every Mac button.
    -->
    <ControlTheme x:Key="WorkspaceRailTileAction" TargetType="Button">
      <!-- Templated outright rather than derived from the stock button. A
           BasedOn reaching for the platform theme resolves against a different
           dictionary than this one, and a button that silently inherits no
           template draws no content at all — which is how the rail lost its
           icons the first time this was built. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Name="PART_Surface"
              Background="Transparent"
              BorderBrush="{TemplateBinding Foreground}"
              BorderThickness="0"
              CornerRadius="{DynamicResource ShellInnerCornerRadius}">
            <!-- The shell washes every button's content presenter on hover by
                 element selector, and a pseudo-class style outranks anything a
                 template can set — so this transparency is not what stops it.
                 The exception that does live beside that rule, in
                 AsuraTheme, keyed on the class below. -->
            <ContentPresenter
                Name="PART_Mark"
                Margin="{TemplateBinding Padding}"
                Content="{TemplateBinding Content}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pressed /template/ ContentPresenter#PART_Mark">
        <Setter Property="Opacity" Value="0.6" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Surface">
        <Setter Property="BorderThickness" Value="2" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:WorkspaceRailTile}" TargetType="controls:WorkspaceRailTile">
      <Setter Property="Width" Value="{DynamicResource ShellTileSizeMd}" />
      <Setter Property="Height" Value="{DynamicResource ShellTileSizeMd}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize16}" />
      <!-- The tile opens over the canvas rather than pushing the rail wider: a
           rail that changed width on hover would move every panel beside it. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border Name="PART_SortBefore" Height="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Top=Sm, Scale=-0.5}"
                VerticalAlignment="Top" Background="{DynamicResource ShellAccentBrush}"
                IsVisible="False" IsHitTestVisible="False" />
            <Border Name="PART_SortAfter" Height="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Bottom=Sm, Scale=-0.5}"
                VerticalAlignment="Bottom" Background="{DynamicResource ShellAccentBrush}"
                IsVisible="False" IsHitTestVisible="False" />
            <!--
              The colour is layered rather than swapped, because a style
              targeting a template part cannot reach back to the tile for a
              brush it computed. The resting fill is always painted; the full
              colour is a sheet above it that fades in, and the outline is a
              third layer outside the clip, so its stroke keeps both halves at
              the rounded corners.
            -->
            <Border
                Name="PART_Surface"
                Width="{DynamicResource ShellTileSizeMd}"
                Height="{DynamicResource ShellTileSizeMd}"
                HorizontalAlignment="Left"
                Background="{TemplateBinding RestingBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
              <!-- Opening is a movement, so it is drawn as one. Short enough
                   that the close is under the pointer about as soon as the
                   pointer stops, rather than being waited for. -->
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
              <Panel>
                <Border Name="PART_Wash" Background="{TemplateBinding AccentBrush}" Opacity="0">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <Grid Name="PART_Actions" HorizontalAlignment="Left" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <Button
                      Name="PART_Open"
                      Grid.Column="2"
                      Classes="WorkspaceRailTileAction"
                      Theme="{StaticResource WorkspaceRailTileAction}"
                      Width="{DynamicResource ShellTileSizeMd}"
                      Height="{DynamicResource ShellTileSizeMd}"
                      MinWidth="0"
                      MinHeight="0"
                      Padding="{DynamicResource ShellInsetNone}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{TemplateBinding MarkBrush}"
                      AutomationProperties.Name="Open this workspace">
                    <icons:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="{TemplateBinding Icon}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding MarkBrush}" />
                  </Button>
                  <!-- Declared in the order they sit, so Tab walks them the way
                       the eye does: open, save, terminate. The names written
                       here stand only until the tile replaces them with ones
                       that say which workspace each action is for. -->
                  <Button
                      Name="PART_Save"
                      Grid.Column="3"
                      Classes="WorkspaceRailTileAction"
                      Theme="{StaticResource WorkspaceRailTileAction}"
                      Width="{DynamicResource ShellTileSizeMd}"
                      Height="{DynamicResource ShellTileSizeMd}"
                      MinWidth="0" MinHeight="0"
                      Padding="{DynamicResource ShellInsetNone}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{TemplateBinding MarkBrush}"
                      IsVisible="False"
                      ToolTip.Tip="Save workspace layout"
                      AutomationProperties.Name="Save workspace layout">
                    <icons:SymbolIcon Symbol="Save" FontSize="{DynamicResource ShellFontSize13}" />
                  </Button>
                  <Button
                      Name="PART_Close"
                      Grid.Column="4"
                      Classes="WorkspaceRailTileAction"
                      Theme="{StaticResource WorkspaceRailTileAction}"
                      Width="{DynamicResource ShellTileSizeMd}"
                      Height="{DynamicResource ShellTileSizeMd}"
                      MinWidth="0"
                      MinHeight="0"
                      Padding="{DynamicResource ShellInsetNone}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{TemplateBinding MarkBrush}"
                      IsVisible="False"
                      ToolTip.Tip="Terminate this workspace and everything running in it"
                      AutomationProperties.Name="Terminate this workspace">
                    <icons:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Dismiss"
                        FontSize="{DynamicResource ShellFontSize13}"
                        Foreground="{TemplateBinding MarkBrush}" />
                  </Button>
                </Grid>
              </Panel>
            </Border>
            <Border
                Name="PART_Ring"
                Width="{DynamicResource ShellTileSizeMd}"
                Height="{DynamicResource ShellTileSizeMd}"
                HorizontalAlignment="Left"
                BorderBrush="{TemplateBinding MarkBrush}"
                BorderThickness="{DynamicResource ShellWorkspaceRailRing}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0"
                IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <!-- With Differentiate Without Color on, the tile you are in is
                 not left to its saturation alone: it carries an inner ring in
                 the ink drawn on it, a shape the resting tiles never have. -->
            <Border
                Name="PART_CurrentMark"
                Width="{DynamicResource ShellTileSizeMd}"
                Height="{DynamicResource ShellTileSizeMd}"
                HorizontalAlignment="Left"
                IsHitTestVisible="False"
                IsVisible="False">
              <Border
                  Margin="{controls:Inset Xs}"
                  BorderBrush="{TemplateBinding MarkBrush}"
                  BorderThickness="2"
                  CornerRadius="{TemplateBinding CornerRadius}" />
            </Border>
            <controls:SignalDot
                Name="PART_Attention"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False" />
            <icons:SymbolIcon
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="AI agent active in this workspace"
                Classes="PanelAgentActivity"
                FontSize="{DynamicResource ShellFontSize10}"
                Foreground="{TemplateBinding AccentBrush}"
                IsHitTestVisible="False"
                IsVisible="{TemplateBinding HasAgentActivity}"
                Symbol="Bot"
                ToolTip.Tip="AI agent active in this workspace" />
            <!-- The badge owns an opaque patch of the tile before drawing the
                 cube. That patch masks the workspace glyph beneath it, so the
                 two line icons never merge into one illegible mark. -->
            <Border
                Name="PART_IsolationMask"
                Width="16"
                Height="16"
                Margin="{controls:Inset Right=Xs, Bottom=Xs}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{TemplateBinding RestingBrush}"
                AutomationProperties.Name="Workspace isolation enabled"
                IsHitTestVisible="False"
                IsVisible="{TemplateBinding IsIsolated}"
                ToolTip.Tip="Workspace isolation enabled">
              <Panel>
                <Border
                    Name="PART_IsolationMaskWash"
                    Background="{TemplateBinding AccentBrush}"
                    Opacity="0" />
                <icons:SymbolIcon
                    Name="PART_Isolation"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Foreground="{TemplateBinding MarkBrush}"
                    Symbol="Box" />
              </Panel>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>

      <!-- The state a tile opens in arrives at once; only later changes
           move. See WorkspaceRailTile.OnLoaded. -->
      <Style Selector="^:not(:settled) /template/ Border#PART_Surface, ^:not(:settled) /template/ Border#PART_Wash, ^:not(:settled) /template/ Border#PART_Ring">
        <Setter Property="Transitions" Value="{x:Null}" />
      </Style>

      <Style Selector="^.sortBefore /template/ Border#PART_SortBefore">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^.sortAfter /template/ Border#PART_SortAfter">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <!-- Alive, but not the one you are looking at: a thin edge in the tile's
           own ink while its fill stays at rest. Two different marks, because
           they are two different facts. The edge was the workspace's colour,
           which on an orange workspace was the accent the focus ring and the
           selection are drawn in, so running read as focused. -->
      <Style Selector="^:running /template/ Border#PART_Ring">
        <Setter Property="Opacity" Value="1" />
      </Style>

      <!-- Where you are, and what the pointer or keyboard is on, all read as
           full colour. Hovering the rail is how you read it. -->
      <Style Selector="^:current /template/ Border#PART_Wash, ^:pointerover /template/ Border#PART_Wash, ^:keyboard-focus-within /template/ Border#PART_Wash">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:current /template/ Border#PART_IsolationMaskWash, ^:pointerover /template/ Border#PART_IsolationMaskWash, ^:keyboard-focus-within /template/ Border#PART_IsolationMaskWash">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <!-- The tile you are in needs no outline as well: it is already the
           brightest thing in the rail. -->
      <Style Selector="^:current /template/ Border#PART_Ring">
        <Setter Property="Opacity" Value="0" />
      </Style>

      <Style Selector="^:attention /template/ controls|SignalDot#PART_Attention">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <!-- The close action is offered on hover, and only where there is
           something to close and somewhere to fall back to. Keyboard focus
           opens the tile the same way: Tab reaches the actions whether or not
           the pointer is there, and an action you can focus but not see is an
           action you can trigger by accident. Only keyboard focus: a click
           focuses the button it lands on too, and a tile that stayed open over
           the canvas after the pointer left, Terminate live, would be a tile
           left open by accident. -->
      <Style Selector="^:closable:pointerover /template/ Border#PART_Surface, ^:closable:keyboard-focus-within /template/ Border#PART_Surface">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
        <!-- It is standing off the rail and over the canvas, so it casts the
             same shadow anything else that floats above the page does, inside
             a ring of the page colour that keeps it apart from the sidebar
             row it opens over: its fill used to run into the selected tab's
             corner and the two read as one shape. -->
        <Setter Property="BoxShadow" Value="{DynamicResource ShellRailTileFloatShadow}" />
      </Style>
      <Style Selector="^:closable:pointerover /template/ Border#PART_Ring, ^:closable:keyboard-focus-within /template/ Border#PART_Ring">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
      </Style>
      <Style Selector="^:saveable:pointerover /template/ Border#PART_Surface, ^:saveable:keyboard-focus-within /template/ Border#PART_Surface">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShellRailTileFloatShadow}" />
      </Style>
      <Style Selector="^:saveable:pointerover /template/ Border#PART_Ring, ^:saveable:keyboard-focus-within /template/ Border#PART_Ring">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
      </Style>
      <Style Selector="^:saveable:closable:pointerover /template/ Border#PART_Surface, ^:saveable:closable:keyboard-focus-within /template/ Border#PART_Surface">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileSaveWidth}" />
      </Style>
      <Style Selector="^:saveable:closable:pointerover /template/ Border#PART_Ring, ^:saveable:closable:keyboard-focus-within /template/ Border#PART_Ring">
        <Setter Property="Width" Value="{DynamicResource ShellWorkspaceRailTileSaveWidth}" />
      </Style>
      <Style Selector="^:saveable /template/ Button#PART_Save">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
      <Style Selector="^:saveable:pointerover /template/ Button#PART_Save, ^:saveable:keyboard-focus-within /template/ Button#PART_Save">
        <Setter Property="IsHitTestVisible" Value="True" />
      </Style>
      <Style Selector="^:expandsleft /template/ Button#PART_Save">
        <Setter Property="Grid.Column" Value="1" />
      </Style>
      <Style Selector="^:expandsleft /template/ Grid#PART_Actions">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <!-- Keep the action row at full width while the surface clips it. This
           anchors the workspace icon when the right-hand rail is collapsed. -->
      <Style Selector="^:closable /template/ Grid#PART_Actions">
        <Setter Property="MinWidth" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
      </Style>
      <Style Selector="^:saveable /template/ Grid#PART_Actions">
        <Setter Property="MinWidth" Value="{DynamicResource ShellWorkspaceRailTileExpandedWidth}" />
      </Style>
      <Style Selector="^:saveable:closable /template/ Grid#PART_Actions">
        <Setter Property="MinWidth" Value="{DynamicResource ShellWorkspaceRailTileSaveWidth}" />
      </Style>
      <!-- Present whenever there is something to close, and hidden by the
           tile's own clip rather than by a switch: flipping it on and off made
           the glyph appear and vanish while the tile was still moving, which is
           what came apart on the way out. It slides in and out with the width
           instead, and only answers the pointer once the tile has opened. -->
      <Style Selector="^:closable /template/ Button#PART_Close">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
      <Style Selector="^:closable:pointerover /template/ Button#PART_Close, ^:closable:keyboard-focus-within /template/ Button#PART_Close">
        <Setter Property="IsHitTestVisible" Value="True" />
      </Style>

      <!-- Docked against the right edge, the tile has to open the other way, and
           the icon must stay where it was rather than sliding across. -->
      <Style Selector="^:expandsleft /template/ Border#PART_Surface">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="^:expandsleft /template/ Border#PART_Ring">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="^:expandsleft /template/ Border#PART_CurrentMark">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="^:expandsleft /template/ Button#PART_Close">
        <Setter Property="Grid.Column" Value="0" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SignalDot}" TargetType="controls:SignalDot">
      <Setter Property="Width" Value="{DynamicResource ShellSignalDotSize}" />
      <Setter Property="Height" Value="{DynamicResource ShellSignalDotSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <!-- The host's badge red: a dot says something is waiting for you. It
           was the secondary label colour, the same gray as an idle mark, so
           a workspace asking for you looked like one with nothing to say; and
           it is not the accent, which is kept for what can be pressed. A
           caller with a tone sets its own fill. -->
      <Setter Property="Background" Value="{DynamicResource ShellAttentionBrush}" />
      <!-- The ring is the page behind it, not a colour of its own: the dot is
           drawn over whatever it marks, and against a tile that happens to be
           accent-coloured an unringed dot is invisible. -->
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ShellSignalDotRing}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{DynamicResource ShellPillCornerRadius}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:ListItem}" TargetType="controls:ListItem">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid
              Margin="{TemplateBinding ContentPadding}"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <ContentPresenter Name="PART_Leading" VerticalAlignment="Center" Content="{TemplateBinding Leading}" />
            <!-- A step between the name and the line about it, as the host's
                 lists leave: set flush, the two lines read as one paragraph
                 and a column of rows could not be scanned by name. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock
                  Name="PART_Title"
                  FontWeight="SemiBold"
                  Text="{TemplateBinding Title}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  Name="PART_Detail"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize11}"
                  Text="{TemplateBinding Detail}"
                  TextTrimming="CharacterEllipsis"
                  IsVisible="False" />
              <TextBlock
                  Name="PART_Metadata"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellPillFontSize}"
                  Text="{TemplateBinding Metadata}"
                  TextTrimming="CharacterEllipsis"
                  IsVisible="False" />
            </StackPanel>
            <ContentPresenter
                Name="PART_Trailing"
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{TemplateBinding Trailing}" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:detailed /template/ TextBlock#PART_Detail">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:metadata /template/ TextBlock#PART_Metadata">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <!--
        Truncation that keeps what tells two rows apart, chosen by the row:
        MiddleTruncatedTitle and MiddleTruncatedDetail keep both ends of a
        name or a reference around a middle ellipsis, and PathDetail drops a
        path's middle segments so the file name stays, as Finder does. The
        same trimming the TextBlock.MiddleTruncated and TextBlock.Path
        classes give a bare text block.
      -->
      <Style Selector="^.MiddleTruncatedTitle /template/ TextBlock#PART_Title">
        <Setter Property="TextTrimming" Value="{x:Static TextTrimming.PrefixCharacterEllipsis}" />
      </Style>
      <Style Selector="^.MiddleTruncatedDetail /template/ TextBlock#PART_Detail">
        <Setter Property="TextTrimming" Value="{x:Static TextTrimming.PrefixCharacterEllipsis}" />
      </Style>
      <Style Selector="^.PathDetail /template/ TextBlock#PART_Detail">
        <Setter Property="TextTrimming" Value="{x:Static TextTrimming.PathSegmentEllipsis}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:StatusChip}" TargetType="controls:StatusChip">
      <Setter Property="Padding" Value="{DynamicResource ShellPillPadding}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellPillCornerRadius}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellPillFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <!-- Neutral unless told otherwise. A chip that only named a kind — a
           key's type, a ref — came out in the success green and read as a
           verdict nobody had made. -->
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Name="PART_Surface"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:outlined">
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <!--
        Tone as a class as well as a property, because several chips take their
        state from a binding — Classes.Warning="{Binding IsWarning}" — and a
        property cannot be switched on and off that way.
      -->
      <Style Selector="^.Warning">
        <Setter Property="Background" Value="{DynamicResource ShellWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellWarningBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
      </Style>
      <Style Selector="^.Danger">
        <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
      </Style>
      <Style Selector="^.Success">
        <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
      </Style>
      <Style Selector="^.Neutral">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      </Style>
      <Style Selector="^.Notice">
        <Setter Property="Background" Value="{DynamicResource ShellInfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellInfoBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellInfoBrush}" />
      </Style>

      <Style Selector="^:tone-success">
        <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
      </Style>
      <Style Selector="^:tone-raised, ^:tone-sunken">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      </Style>
      <Style Selector="^:tone-notice">
        <Setter Property="Background" Value="{DynamicResource ShellInfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellInfoBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellInfoBrush}" />
      </Style>
      <Style Selector="^:tone-danger">
        <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
      </Style>
      <Style Selector="^:tone-warning">
        <Setter Property="Background" Value="{DynamicResource ShellWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellWarningBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
      </Style>

      <!-- Shape is stated after tone, so a label's fill is not undone by it. -->
      <Style Selector="^:rounded">
        <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:EmptyStatePanel}" TargetType="controls:EmptyStatePanel">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="{DynamicResource ShellInsetXl}" />
      <Setter Property="Template">
        <ControlTemplate>
          <!--
            A Grid, not a StackPanel. A StackPanel gives its children the whole
            cross axis and ignores a vertical centre, which is why every hand-built
            empty state sat in the top third of the space it was given.
          -->
          <Grid Margin="{TemplateBinding Padding}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{DynamicResource ShellSpaceMd}">
              <Border
                  Name="PART_GlyphTile"
                  Width="54"
                  Height="54"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ShellSurfaceHoverBrush}"
                  CornerRadius="{DynamicResource ShellCardCornerRadius}"
                  IsVisible="{TemplateBinding ShowsGlyph}">
                <!-- Neutral, not the accent: the empty state is not something
                     to press, and the accent is kept for what is. -->
                <icons:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Symbol="{TemplateBinding Glyph}"
                    FontSize="{controls:TextScaled 27}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
              </Border>
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="Title3"
                  Text="{TemplateBinding Heading}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <TextBlock
                  MaxWidth="280"
                  HorizontalAlignment="Center"
                  Foreground="{DynamicResource ShellMutedBrush}"
                  FontSize="{DynamicResource ShellFontSize11}"
                  LineHeight="{DynamicResource ShellLineHeight11}"
                  Text="{TemplateBinding Body}"
                  TextAlignment="Center"
                  TextWrapping="Wrap"
                  IsVisible="{TemplateBinding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter
                  HorizontalAlignment="Center"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:LabeledField}" TargetType="controls:LabeledField">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <!-- The label carries the field's name at full text colour and
                 base size, in the regular weight the host gives a form's
                 labels: weight is what headings use to rank, and a form whose
                 every label was semibold had nothing left to rank with. The
                 field links this label to its control, so it is the control's
                 accessible name as well. It starts where the field starts:
                 the inset it had set every label off the edge it names. -->
            <TextBlock
                Name="PART_Label"
                Text="{TemplateBinding Label}"
                TextTrimming="CharacterEllipsis" />
            <ContentPresenter
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <!-- The error sits where the eye already is: directly under the
                 control, in the danger tone and behind a glyph, so it is not
                 told by colour alone. While it shows, it stands in for the
                 hint rather than stacking a second sentence under it. -->
            <Grid
                Name="PART_Error"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource ShellSpaceXs}"
                IsVisible="False">
              <icons:SymbolIcon
                  VerticalAlignment="Top"
                  Symbol="ErrorCircle"
                  FontSize="{DynamicResource ShellFontSize11}"
                  Foreground="{DynamicResource ShellDangerBrush}" />
              <TextBlock
                  Grid.Column="1"
                  Foreground="{DynamicResource ShellDangerBrush}"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  LineHeight="{DynamicResource ShellLineHeight11}"
                  Text="{TemplateBinding Error}"
                  TextWrapping="Wrap" />
            </Grid>
            <TextBlock
                Name="PART_Hint"
                Foreground="{DynamicResource ShellMutedBrush}"
                FontSize="{DynamicResource ShellSecondaryFontSize}"
                LineHeight="{DynamicResource ShellLineHeight11}"
                Text="{TemplateBinding Hint}"
                TextWrapping="Wrap"
                IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:error /template/ Grid#PART_Error">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:error /template/ TextBlock#PART_Hint">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>

    <!--
      The segmented control: the track the segmented picker always drew, around
      radio-button segments the control makes for each item. The segments share
      the width equally, so the strip is as stable as the views it switches
      between; the segment look itself is the shell's RadioButton.Segment.
    -->
    <ControlTheme x:Key="{x:Type controls:SegmentedControl}" TargetType="controls:SegmentedControl">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{DynamicResource ShellSurfaceHoverBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              ClipToBounds="True"
              CornerRadius="{DynamicResource ShellControlCornerRadius}"
              Padding="{DynamicResource ShellPreviewTileInset}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- Disabled dims the icon and the name, not the sentence: the
           sentence is the reason the tile cannot be used, and it has to stay
           readable to be any use. -->
      <Style Selector="^:disabled /template/ Border#PART_Icon">
        <Setter Property="Opacity" Value="0.48" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#PART_Title">
        <Setter Property="Opacity" Value="0.48" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SettingRow}" TargetType="controls:SettingRow">
      <Setter Property="Padding" Value="{DynamicResource ShellRowPadding}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Grid
                Name="PART_Row"
                Margin="{TemplateBinding Padding}"
                ColumnSpacing="{DynamicResource ShellSpaceLg}">
              <!--
                The control column's width is set from code. A ColumnDefinition is
                not a visual and so has no templated parent, which means a
                TemplateBinding here silently resolves to nothing and both columns
                fall back to an even split — the row still renders, just never at
                the width the group asked for. The code also gives the column up
                when the row is too narrow for it and a readable label both: the
                control then moves under the label, into the second row.
              -->
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- The label is the control's accessible name too, and reads in
                   the regular weight the host gives a form row's label. -->
              <StackPanel
                  Margin="{controls:Inset Horizontal=Xs}"
                  VerticalAlignment="Center"
                  Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock
                    Name="PART_Label"
                    LineHeight="{DynamicResource ShellLineHeight12}"
                    Text="{TemplateBinding Label}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource ShellMutedBrush}"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    LineHeight="{DynamicResource ShellLineHeight11}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ContentPresenter
                  Name="PART_Control"
                  Grid.Column="1"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <!-- The group decides which row is last; the row only draws it. -->
            <Border
                Name="PART_Separator"
                Height="1"
                Background="{DynamicResource ShellBorderBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:last /template/ Border#PART_Separator">
        <Setter Property="IsVisible" Value="False" />
      </Style>

      <!-- A checkbox row, as the host lays one out: the box at the leading
           edge with the setting's name as its title, so a click on the words
           toggles it, and the description under the title, aligned with it
           rather than with the box. The row hands the label to a checkbox
           that has no content of its own. -->
      <Style Selector="^:leading">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel>
              <StackPanel
                  Margin="{TemplateBinding Padding}"
                  Spacing="{DynamicResource ShellSpaceXs}">
                <ContentPresenter
                    Name="PART_Control"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="Left" />
                <TextBlock
                    Name="PART_Description"
                    Margin="{DynamicResource ShellCheckBoxTitleInset}"
                    Foreground="{DynamicResource ShellMutedBrush}"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    LineHeight="{DynamicResource ShellLineHeight11}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Border
                  Name="PART_Separator"
                  Height="1"
                  Background="{DynamicResource ShellBorderBrush}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </Style>

      <!-- Stacked, the control takes the row's whole width under the label.
           The group still pushes a column width to the row; a stacked row has
           no column for it to land in, which is the point. -->
      <Style Selector="^:stacked">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel>
              <StackPanel
                  Margin="{TemplateBinding Padding}"
                  Spacing="{DynamicResource ShellSpaceMd}">
                <StackPanel
                    Margin="{controls:Inset Horizontal=Xs}"
                    Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock
                      Name="PART_Label"
                      LineHeight="{DynamicResource ShellLineHeight12}"
                      Text="{TemplateBinding Label}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="{DynamicResource ShellMutedBrush}"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      LineHeight="{DynamicResource ShellLineHeight11}"
                      Text="{TemplateBinding Description}"
                      TextWrapping="Wrap"
                      IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="Stretch" />
              </StackPanel>
              <Border
                  Name="PART_Separator"
                  Height="1"
                  Background="{DynamicResource ShellBorderBrush}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SettingsGroup}" TargetType="controls:SettingsGroup">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
            <!-- A group's heading is the host's Headline: body size, bold. It
                 was 14 semibold, a size the host's ramp does not have. -->
            <StackPanel
                Spacing="{DynamicResource ShellSpaceXs}"
                IsVisible="{TemplateBinding Heading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock
                  Classes="Headline"
                  AutomationProperties.HeadingLevel="2"
                  Text="{TemplateBinding Heading}" />
              <!-- The same rank as SectionHeader's description, on purpose:
                   these are the two components that head a group of content,
                   and they disagreed by two points for no reason anyone chose. -->
              <TextBlock
                  Foreground="{DynamicResource ShellMutedBrush}"
                  FontSize="{DynamicResource ShellFontSize12}"
                  LineHeight="{DynamicResource ShellLineHeight12}"
                  Text="{TemplateBinding Description}"
                  TextWrapping="Wrap"
                  IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <controls:SurfaceCard Padding="0">
              <StackPanel>
                <ItemsPresenter Name="PART_Rows" ItemsPanel="{TemplateBinding ItemsPanel}" />
                <Border
                    Name="PART_FooterSeparator"
                    Height="1"
                    Background="{DynamicResource ShellBorderBrush}"
                    IsVisible="False" />
                <ContentPresenter
                    Name="PART_Footer"
                    Margin="{DynamicResource ShellRowPadding}"
                    Content="{TemplateBinding Footer}"
                    IsVisible="False" />
              </StackPanel>
            </controls:SurfaceCard>
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:footed /template/ Border#PART_FooterSeparator">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:footed /template/ ContentPresenter#PART_Footer">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!--
      A chooser tile sits on an overlay or launcher surface and reads as a
      sunken card the pointer can light up. Focus is the shell's focus ring, as
      on every push button. The pointer stays an arrow: a Mac button is not a
      link, and the hand said it was.
    -->
    <ControlTheme x:Key="{x:Type controls:ChooserTile}" TargetType="controls:ChooserTile">
      <Setter Property="MinHeight" Value="116" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource ShellCardPadding}" />
      <!-- The tile is a button styled by its own key, so the shell's rules for
           Button do not reach it: without this it wore Avalonia's square white
           adorner. It takes the push buttons' ring, around its rounded card. -->
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <controls:FocusRing />
        </FocusAdornerTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Name="PART_Surface"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Top-aligned, icon at the left: tiles in a row share one
                 baseline whether their description runs one line or two. -->
            <StackPanel
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="Top"
                Spacing="{DynamicResource ShellSpaceSm}">
              <Border
                  Name="PART_Icon"
                  Classes="ChooserIconTile"
                  HorizontalAlignment="Left"
                  Width="{DynamicResource ShellTileSizeMd}"
                  Height="{DynamicResource ShellTileSizeMd}">
                <icons:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Symbol="{TemplateBinding Icon}"
                    FontSize="{DynamicResource ShellIconSizeMd}" />
              </Border>
              <TextBlock Name="PART_Title" Classes="Headline" Text="{TemplateBinding Title}" />
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  LineHeight="{DynamicResource ShellLineHeight11}"
                  Text="{TemplateBinding EffectiveDescription}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      </Style>
      <!-- Disabled dims the icon and the name, not the sentence: the
           sentence is the reason the tile cannot be used, and it has to stay
           readable to be any use. -->
      <Style Selector="^:disabled /template/ Border#PART_Icon">
        <Setter Property="Opacity" Value="0.48" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#PART_Title">
        <Setter Property="Opacity" Value="0.48" />
      </Style>
    </ControlTheme>

    <!-- Every not-content state uses one layout contract. The kind changes its
         non-colour glyph, tone, live announcement, and quiet/working/attention
         layout without making each screen rebuild the same state card. -->
    <ControlTheme x:Key="{x:Type controls:StateOverlay}" TargetType="controls:StateOverlay">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <controls:EmptyStatePanel
              Glyph="{TemplateBinding EffectiveGlyph}"
              Heading="{TemplateBinding Heading}"
              Body="{TemplateBinding Body}"
              AutomationProperties.LiveSetting="{TemplateBinding AnnouncementMode}"
              AutomationProperties.Name="{TemplateBinding AccessibleStatus}">
            <StackPanel HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
              <ContentPresenter
                  HorizontalAlignment="Center"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button
                  Name="PART_Action"
                  HorizontalAlignment="Center"
                  Classes="SecondaryButton"
                  Command="{TemplateBinding ActionCommand}"
                  Content="{TemplateBinding ActionLabel}"
                  IsVisible="{TemplateBinding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </controls:EmptyStatePanel>
        </ControlTemplate>
      </Setter>

      <!-- Working sets its words as every other state does — the heading in
           Title 3, the sentence in secondary text — with the bar under them
           a step further down, so a page moving from loading to empty or to
           a failure keeps one typography. -->
      <Style Selector="^:working">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{DynamicResource ShellSpaceMd}"
                AutomationProperties.LiveSetting="{TemplateBinding AnnouncementMode}"
                AutomationProperties.Name="{TemplateBinding AccessibleStatus}">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="Title3"
                  Text="{TemplateBinding Heading}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <TextBlock
                  MaxWidth="280"
                  HorizontalAlignment="Center"
                  Foreground="{DynamicResource ShellMutedBrush}"
                  FontSize="{DynamicResource ShellFontSize11}"
                  LineHeight="{DynamicResource ShellLineHeight11}"
                  Text="{TemplateBinding Body}"
                  TextAlignment="Center"
                  TextWrapping="Wrap"
                  IsVisible="{TemplateBinding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ProgressBar
                  Name="PART_Progress"
                  Width="180"
                  Margin="{controls:Inset Top=Sm}"
                  HorizontalAlignment="Center"
                  IsIndeterminate="True" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </Style>

      <Style Selector="^:attention">
        <Setter Property="Template">
          <ControlTemplate>
            <controls:SurfaceCard
                Tone="{TemplateBinding PresentationTone}"
                MaxWidth="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="{TemplateBinding AnnouncementMode}"
                AutomationProperties.Name="{TemplateBinding AccessibleStatus}">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon
                    Name="PART_Glyph"
                    HorizontalAlignment="Left"
                    Symbol="{TemplateBinding EffectiveGlyph}"
                    FontSize="{DynamicResource ShellFontSize24}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock
                    Classes="Title3"
                    Text="{TemplateBinding Heading}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource ShellMutedBrush}"
                    FontSize="{DynamicResource ShellFontSize11}"
                    LineHeight="{DynamicResource ShellLineHeight11}"
                    Text="{TemplateBinding Body}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button
                    Name="PART_Action"
                    HorizontalAlignment="Left"
                    Classes="SecondaryButton"
                    Command="{TemplateBinding ActionCommand}"
                    Content="{TemplateBinding ActionLabel}"
                    IsVisible="{TemplateBinding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </controls:SurfaceCard>
          </ControlTemplate>
        </Setter>
      </Style>

      <!-- The glyph speaks in the state's tone, as a callout's does: a failure
           drawn in the danger red and a warning in its own colour. Every
           attention card used to draw the danger red, so a stale result and a
           permission prompt looked like crashes. -->
      <Style Selector="^:tone-warning /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
      </Style>
      <Style Selector="^:tone-danger /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
      </Style>
      <Style Selector="^:tone-notice /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellInfoBrush}" />
      </Style>
    </ControlTheme>

    <!--
      A callout's surface is the card, so its tone vocabulary is the card's.
      Only the glyph is coloured here: it carries the tone's voice at a glance
      the way the border alone cannot.
    -->
    <ControlTheme x:Key="{x:Type controls:Callout}" TargetType="controls:Callout">
      <Setter Property="Template">
        <ControlTemplate>
          <controls:SurfaceCard
              Tone="{TemplateBinding Tone}"
              Padding="{DynamicResource ShellCardPaddingCompact}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon
                  Name="PART_Glyph"
                  VerticalAlignment="Top"
                  Symbol="{TemplateBinding Glyph}"
                  FontSize="{DynamicResource ShellIconSizeMd}"
                  Foreground="{DynamicResource ShellMutedBrush}"
                  IsVisible="{TemplateBinding ShowsGlyph}" />
              <ContentPresenter
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Action}"
                  IsVisible="{TemplateBinding Action, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock
                    Classes="Headline"
                    Text="{TemplateBinding Title}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Body text at the body size and its own leading: inherited,
                     it took whatever size the page around it happened to
                     have, set solid. -->
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellBaseFontSize}"
                    LineHeight="{DynamicResource ShellLineHeight13}"
                    Text="{TemplateBinding Text}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    LineHeight="{DynamicResource ShellLineHeight11}"
                    Text="{TemplateBinding Footnote}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding Footnote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </controls:SurfaceCard>
        </ControlTemplate>
      </Setter>

      <!--
        Tone as a class as well as a property, for the callouts whose tone is
        a binding — a test result that is a warning until it succeeds. A class
        carries the glyph that tone speaks with, so the view names the state
        and not the picture.
      -->
      <Style Selector="^.Warning">
        <Setter Property="Tone" Value="Warning" />
        <Setter Property="Glyph" Value="Warning" />
      </Style>
      <Style Selector="^.Danger">
        <Setter Property="Tone" Value="Danger" />
        <Setter Property="Glyph" Value="ErrorCircle" />
      </Style>
      <Style Selector="^.Success">
        <Setter Property="Tone" Value="Success" />
        <Setter Property="Glyph" Value="CheckmarkCircle" />
      </Style>

      <Style Selector="^:tone-warning /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
      </Style>
      <Style Selector="^:tone-danger /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
      </Style>
      <Style Selector="^:tone-success /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
      </Style>
      <Style Selector="^:tone-notice /template/ icons|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource ShellInfoBrush}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:ToggleField}" TargetType="controls:ToggleField">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock
                  Name="PART_Label"
                  Text="{TemplateBinding Label}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Name="PART_Description"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  LineHeight="{DynamicResource ShellLineHeight11}"
                  Text="{TemplateBinding StateDescription}"
                  TextWrapping="Wrap"
                  IsVisible="False" />
            </StackPanel>
            <ToggleSwitch
                Name="PART_Switch"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:described /template/ TextBlock#PART_Description">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!--
      The dialog frame. The header band and the footer rule are the two pieces
      every dialog rebuilt by hand, and the two that had drifted: subtitle sizes
      apart, row heights in three variants, a close glyph that was a literal ×
      in three files and an icon in the fourth.
    -->
    <ControlTheme x:Key="{x:Type controls:DialogShell}" TargetType="controls:DialogShell">
      <Setter Property="Padding" Value="{DynamicResource ShellInsetLg}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Classes="TopChrome">
              <Grid
                  Margin="{controls:Inset Horizontal=Lg, Vertical=Md}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                  <!-- An editor fills a window of its own, so its title is the
                       window's: Title 1 rather than a dialog's Title 2. The role
                       class is chosen here, not overridden from the theme,
                       because an application class style outranks a theme's
                       template-child style. -->
                  <TextBlock
                      Name="PART_Title"
                      Classes.Title1="{TemplateBinding Chrome, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static controls:DialogChrome.Editor}}"
                      Classes.Title2="{TemplateBinding Chrome, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static controls:DialogChrome.Editor}}"
                      Text="{TemplateBinding Title}" />
                  <TextBlock
                      Name="PART_Subtitle"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      LineHeight="{DynamicResource ShellLineHeight11}"
                      Text="{TemplateBinding Subtitle}"
                      TextWrapping="Wrap"
                      IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding HeaderContent}"
                    IsVisible="{TemplateBinding HeaderContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- No close glyph: the footer's Cancel is the way out, and
                     DialogWindow sends Escape and ⌘. to it. -->
              </Grid>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                Name="PART_Scroll"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <ContentPresenter
                  Name="PART_ContentPresenter"
                  Margin="{TemplateBinding Padding}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ScrollViewer>
            <Border
                Grid.Row="2"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{TemplateBinding IsFooterVisible}">
              <Grid
                  Margin="{controls:Inset Horizontal=Lg, Vertical=Md}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    LineHeight="{DynamicResource ShellLineHeight11}"
                    Text="{TemplateBinding FooterHint}"
                    TextWrapping="Wrap"
                    IsVisible="{TemplateBinding FooterHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Footer}" />
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^[Scrolls=False] /template/ ScrollViewer#PART_Scroll">
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!--
    Motion. Every ambient or repeating animation below is keyed on a window
    that has not been told to reduce motion, because an animation cannot be
    switched off by a later style — only never started. The "motion-disabled"
    class is the host's Reduce Motion setting (or the app's own), applied to
    every window, and each animated mark has a still form for it: the agent
    glow becomes a plain accent outline, the pulses hold at full strength, and
    the notification flash is an outline for as long as it lasts.
  -->

  <!-- A single marker shared by every runtime panel and tab. Its turn-scoped
       lease originates from a governed action's exact panel identity, so it
       never guesses from focus, the active tab, or provider streaming state. -->
  <Style Selector="Window:not(.motion-disabled) icons|SymbolIcon.PanelAgentActivity">
    <Style.Animations>
      <Animation Duration="0:0:5" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The same glow drawn straight over a window's content rather than in a
       panel's template — the Quick Terminal's. Set here rather than on the
       element, where the Reduce Motion form below could not reach it. -->
  <Style Selector="Border.PanelAgentGlow.WindowGlow">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShellAgentPanelGlowShadow}" />
  </Style>
  <Style Selector="Window:not(.motion-disabled) Border.PanelAgentGlow">
    <Style.Animations>
      <Animation Duration="0:0:5" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window:not(.motion-disabled) icons|SymbolIcon.AgentToolbarActivityPulse.running">
    <Style.Animations>
      <Animation Duration="0:0:2.5" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window:not(.motion-disabled) controls|PanelChrome:notification-pulse /template/ Border#PART_NotificationPulse">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="1">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="18%">
          <Setter Property="Opacity" Value="0.72" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The still forms. The glow keeps its 2 pt accent outline and drops the
       wash that breathed over the panel's content; the notification flash is
       the same outline. -->
  <Style Selector="Window.motion-disabled Border.PanelAgentGlow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Window.motion-disabled controls|PanelChrome /template/ Border#PART_NotificationPulse">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The two running marks — the workspace toolbar's and the agent panel's
       own — sit at zero opacity until their pulse lifts them, and that zero is
       set on the element, where no setter can reach it. A held animation can:
       it lands on full strength and stays there, which is the mark without
       the movement. -->
  <Style Selector="Window.motion-disabled icons|SymbolIcon.AgentToolbarActivityPulse.running, Window.motion-disabled icons|SymbolIcon.AgentActivityPulse.running">
    <Style.Animations>
      <Animation Duration="0:0:0.001" FillMode="Forward">
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Transitions are motion too: the rail tile sliding open and its colour
       fading in, and a copy button's label crossfading to its check. Without
       motion each simply arrives at its new state. -->
  <Style Selector="Window.motion-disabled controls|WorkspaceRailTile /template/ Border#PART_Surface, Window.motion-disabled controls|WorkspaceRailTile /template/ Border#PART_Wash, Window.motion-disabled controls|WorkspaceRailTile /template/ Border#PART_Ring">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.motion-disabled Button.CopyAction TextBlock.CopyLabel, Window.motion-disabled Button.CopyAction icons|SymbolIcon.CopyCheck">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- A vertical ItemsControl does not generate ListBoxItem containers, so it
       does not inherit the shell's normal full-width list-row alignment. Apply
       this class to list-shaped ItemsControls; horizontal strips and wrapping
       galleries intentionally keep their content-sized presenters. -->
  <Style Selector="ItemsControl.StretchItems">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ItemsControl.StretchItems > ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
