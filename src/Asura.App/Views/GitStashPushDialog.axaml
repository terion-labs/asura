<controls:DialogWindow
    x:Class="Asura.App.Views.GitStashPushDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    Width="440"
    SizeToContent="Height"
    CanResize="False">
  <controls:DialogShell
      Scrolls="False"
      Title="Stash Changes"
      Subtitle="Working changes move onto the stash list and the working tree returns to HEAD.">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Classes="PrimaryButton" Click="OnConfirmClick" Content="Stash" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <controls:LabeledField Label="Message (optional)">
      <TextBox x:Name="MessageInput" AutomationProperties.Name="Stash message" />
    </controls:LabeledField>
  </controls:DialogShell>
</controls:DialogWindow>
