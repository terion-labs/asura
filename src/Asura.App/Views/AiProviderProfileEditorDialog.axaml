<controls:DialogWindow
    x:Class="Asura.App.Views.AiProviderProfileEditorDialog"
    x:DataType="vm:AiProviderProfileEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Width="780"
    Height="720"
    MinWidth="680"
    MinHeight="600"
    CanResize="True">
  <controls:DialogShell
      Chrome="Editor"
      Title="{Binding EditorTitle}"
      Subtitle="{Binding ProfileId, StringFormat={}Profile: {0}}"
      FooterHint="Tests load the provider's model list.">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnTestClick" Content="Test" IsEnabled="{Binding CanTest}" />
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Classes="PrimaryButton" Click="OnSaveClick" Content="Save Provider" IsDefault="True" IsEnabled="{Binding CanTest}" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}" IsEnabled="{Binding !IsStoringCredential}">
      <!-- A failure about one field is shown under that field; what is left
           is read here, at the top, where the dialog scrolls to it. -->
      <components:ErrorNoticesView x:Name="FormErrors" DataContext="{Binding ErrorNotices}" />
      <controls:SurfaceCard>
        <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
          <Grid
              x:Name="IdentityFields"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <controls:LabeledField Label="Name" controls:FieldValidation.For="Name">
              <TextBox Text="{Binding Name}" PlaceholderText="Production OpenAI" />
            </controls:LabeledField>
            <controls:LabeledField Grid.Column="1" Label="Provider">
              <ComboBox
                  x:Name="ProviderSelector"
                  ItemsSource="{Binding ProviderOptions}"
                  SelectedItem="{Binding SelectedProvider}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </controls:LabeledField>
          </Grid>
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding ProviderProtocol, StringFormat={}Wire protocol: {0}}" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              IsVisible="{Binding !IsProviderRuntimeSupported}"
              Text="{Binding ProviderAvailability}"
              TextWrapping="Wrap" />
          <controls:LabeledField
              Label="API base endpoint"
              Hint="{Binding EndpointPolicy}"
              controls:FieldValidation.For="Endpoint">
            <TextBox IsEnabled="{Binding IsEndpointEditable}" Text="{Binding Endpoint}" PlaceholderText="https://api.example.com/v1/" />
          </controls:LabeledField>
          <Grid
              x:Name="ModelFields"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <controls:LabeledField Label="Default model">
              <TextBox Text="{Binding DefaultModel}" PlaceholderText="Run Test to discover models, or enter a model ID" />
            </controls:LabeledField>
            <controls:LabeledField Grid.Column="1" Label="Display order">
              <NumericUpDown Minimum="0" Maximum="10000" Value="{Binding Order}" />
            </controls:LabeledField>
          </Grid>
          <controls:ToggleField
              Label="Enable this provider for future agent selection"
              IsChecked="{Binding IsEnabled}"
              AutomationProperties.Name="Enable this provider for future agent selection" />
        </StackPanel>
      </controls:SurfaceCard>

      <controls:SurfaceCard>
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="SectionHeading" Text="Authentication" />
          <ComboBox
              x:Name="AuthenticationSelector"
              AutomationProperties.Name="Authentication"
              IsVisible="{Binding HasMultipleAuthenticationOptions}"
              ItemsSource="{Binding AuthenticationOptions}"
              SelectedItem="{Binding SelectedAuthentication}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid
              x:Name="AuthenticationValue"
              MinHeight="{DynamicResource ShellControlMinHeight}"
              IsVisible="{Binding HasSingleAuthenticationOption}">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding SelectedAuthentication.Label}" />
          </Grid>
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding SelectedAuthentication.Detail}"
              TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding UsesCredential}" Spacing="{DynamicResource ShellSpaceSm}">
            <controls:LabeledField Label="Credential">
              <Grid>
                <ComboBox
                    x:Name="CredentialSelector"
                    IsVisible="{Binding HasMultipleCredentialOptions}"
                    ItemsSource="{Binding SecretOptions}"
                    SelectedItem="{Binding SelectedCredential}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid
                    x:Name="CredentialValue"
                    MinHeight="{DynamicResource ShellControlMinHeight}"
                    IsVisible="{Binding HasSingleCredentialOption}">
                  <TextBlock
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Text="{Binding SelectedCredential.DisplayName}" />
                </Grid>
              </Grid>
            </controls:LabeledField>
            <controls:LabeledField Label="New API key" controls:FieldValidation.For="ApiKeyValue">
              <TextBox
                  x:Name="ApiKeyInput"
                  Text="{Binding ApiKeyValue, Mode=TwoWay}"
                  PasswordChar="●"
                  MaxLength="65536"
                  PlaceholderText="Paste an API key"
                  AutomationProperties.Name="New provider API key" />
            </controls:LabeledField>
            <Button
                Classes="SecondaryButton"
                HorizontalAlignment="Left"
                Click="OnStoreApiKeyClick"
                Content="Store API Key"
                IsEnabled="{Binding CanStoreCredential}"
                AutomationProperties.Name="{Binding Source={x:Static vm:SecretStoreName.Current}, StringFormat={}Store the API key in {0}}" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Source={x:Static vm:SecretStoreName.Current}, StringFormat='Store, Test, or Save writes the entered key to {0} and selects it here. A stored key stays in {0} if you cancel; existing keys are not overwritten.'}" TextWrapping="Wrap" />
            <controls:LiveRegionTextBlock Text="{Binding CredentialStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <StackPanel
              IsVisible="{Binding UsesInteractiveAuthentication}"
              Spacing="{DynamicResource ShellSpaceSm}">
            <Button
                Classes="SecondaryButton"
                HorizontalAlignment="Left"
                Click="OnAuthenticateClick"
                Content="{Binding AuthenticationButtonLabel}"
                IsEnabled="{Binding CanAuthenticate}" />
            <controls:LiveRegionTextBlock
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding AuthenticationStatus}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
            <Border
                IsVisible="{Binding HasDeviceCode}"
                Padding="{DynamicResource ShellInsetSm}"
                Background="{DynamicResource ShellSurfaceElevatedBrush}"
                CornerRadius="{DynamicResource ShellRadiusSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="DEVICE CODE" />
                <SelectableTextBlock FontFamily="{DynamicResource ShellMonoFontFamily}" FontSize="{DynamicResource ShellFontSize16}" Text="{Binding DeviceCode}" />
                <SelectableTextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AuthenticationUri}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </controls:SurfaceCard>

      <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontWeight="SemiBold" Text="{Binding TestStatus}" />
          <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TestDetail}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <StackPanel IsVisible="{Binding HasModels}" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock x:Name="ModelCatalogHeading" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Last discovered models" />
            <ItemsControl ItemsSource="{Binding Models}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                    <TextBlock FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Id}" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayName}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </controls:SurfaceCard>

    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
