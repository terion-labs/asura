<controls:DialogWindow
    x:Class="Asura.App.Views.ConnectionEditorDialog"
    x:DataType="vm:UnifiedConnectionEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:core="using:Asura.Core"
    xmlns:controls="using:Asura.App.Controls"
    Width="760"
    Height="780"
    MinWidth="640"
    MinHeight="620"
    CanResize="True">
  <controls:DialogShell
      Title="{Binding EditorTitle}"
      Subtitle="Configure the connection and its credentials."
      Chrome="Editor"
      FooterHint="{Binding TestFooterHint}">
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <!-- A failure that names a field is shown under that field. What is
           left — a failure about the whole connection — is read here, at the
           top, where the dialog scrolls to it, not below every card. -->
      <StackPanel x:Name="FormErrors" Spacing="{DynamicResource ShellSpaceSm}">
        <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
        <components:ErrorNoticesView DataContext="{Binding Terminal.ErrorNotices}" />
        <components:ErrorNoticesView DataContext="{Binding Files.ErrorNotices}" />
        <components:ErrorNoticesView DataContext="{Binding Database.ErrorNotices}" />
      </StackPanel>

      <!-- Every family starts the same way: a name and a type. -->
      <controls:SurfaceCard>
        <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
          <controls:LabeledField Label="Name" controls:FieldValidation.For="Name">
            <TextBox Text="{Binding Name}" PlaceholderText="Production database" AutomationProperties.Name="Connection name" />
          </controls:LabeledField>
          <controls:LabeledField Label="Type">
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding TypeOptions}"
                SelectedItem="{Binding SelectedType}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:LabeledField>
        </StackPanel>
      </controls:SurfaceCard>

      <!-- Terminal family -->
      <StackPanel IsVisible="{Binding IsTerminal}" Spacing="{DynamicResource ShellSpaceMd}">
        <StackPanel DataContext="{Binding Terminal}" Spacing="{DynamicResource ShellSpaceMd}">
          <controls:SurfaceCard IsVisible="{Binding ShowsLocalShell}">
            <controls:LabeledField Label="Shell executable" Hint="Leave blank to use the host default shell.">
              <TextBox Text="{Binding LocalShell}" PlaceholderText="/bin/zsh" />
            </controls:LabeledField>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsSsh}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <!-- Git · SSH only: the Git connection references a saved SSH
                   connection and uses its endpoint and credentials live —
                   later edits to the saved connection apply here too. -->
              <controls:LabeledField
                  Label="From saved connection"
                  Hint="Uses the saved connection for host and credentials; changes to it apply here."
                  IsVisible="{Binding ShowsSavedSshSources}">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SavedSshSources}"
                    SelectedItem="{Binding SelectedSavedSshSource}"
                    AutomationProperties.Name="Use a saved SSH connection">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </controls:LabeledField>

              <!-- A chosen saved connection speaks for the endpoint: the
                   fields fold away behind a one-line summary of what the
                   reference currently resolves to, and come back untouched
                   on "Enter manually". -->
              <TextBlock
                  Classes="Muted"
                  Text="{Binding SavedSshSourceSummary}"
                  IsVisible="{Binding !ShowsSshEndpointFields}" />

              <StackPanel Spacing="{DynamicResource ShellSpaceMd}" IsVisible="{Binding ShowsSshEndpointFields}">
                <Grid ColumnDefinitions="*,110,180" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <controls:LabeledField Label="Host" controls:FieldValidation.For="Host"><TextBox Text="{Binding Host}" PlaceholderText="server.example.com" /></controls:LabeledField>
                  <controls:LabeledField Grid.Column="1" Label="Port"><NumericUpDown Minimum="1" Maximum="65535" Value="{Binding Port}" /></controls:LabeledField>
                  <controls:LabeledField Grid.Column="2" Label="Username"><TextBox Text="{Binding Username}" PlaceholderText="Current local user" /></controls:LabeledField>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <controls:LabeledField Label="Authentication"><ComboBox ItemsSource="{Binding AuthenticationChoices}" SelectedItem="{Binding Authentication}" /></controls:LabeledField>
                  <controls:LabeledField Grid.Column="1" Label="Host-key policy"><ComboBox ItemsSource="{Binding HostKeyPolicies}" SelectedItem="{Binding HostKeyPolicy}" /></controls:LabeledField>
                </Grid>
                <controls:LabeledField
                    Label="Credential"
                    Hint="Choose a saved credential for this connection or add a new one."
                    controls:FieldValidation.For="SecretReference"
                    IsVisible="{Binding UsesSecretReference}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <ComboBox ItemsSource="{Binding CredentialOptions}" SelectedItem="{Binding SelectedCredential}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Connection credential">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionCredentialOption">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Classes="SecondaryButton" Click="OnAddCredentialClick" Content="Add New…" AutomationProperties.Name="Add connection credential" />
                  </Grid>
                </controls:LabeledField>
                <controls:LabeledField Label="Passphrase (optional)" IsVisible="{Binding UsesPassphraseReference}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <ComboBox ItemsSource="{Binding PassphraseOptions}" SelectedItem="{Binding SelectedPassphrase}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Private key passphrase">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionCredentialOption">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Classes="SecondaryButton" Click="OnAddPassphraseClick" Content="Add New…" AutomationProperties.Name="Add private key passphrase" />
                  </Grid>
                </controls:LabeledField>
                <components:ConnectionCredentialDraftView
                    x:Name="TerminalCredentialDraft"
                    IsVisible="False"
                    Created="OnCredentialDraftCreated"
                    Cancelled="OnCredentialDraftCancelled" />
              </StackPanel>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsDocker}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <controls:LabeledField Label="Container" controls:FieldValidation.For="Container"><TextBox Text="{Binding Container}" PlaceholderText="api-dev" /></controls:LabeledField>
              <controls:LabeledField Grid.Column="1" Label="Docker context (optional)"><TextBox Text="{Binding DockerContext}" PlaceholderText="desktop-linux" /></controls:LabeledField>
            </Grid>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsWsl}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <controls:LabeledField Label="Distribution" controls:FieldValidation.For="Distribution"><TextBox Text="{Binding Distribution}" PlaceholderText="Ubuntu-24.04" /></controls:LabeledField>
              <controls:LabeledField Grid.Column="1" Label="Username (optional)"><TextBox Text="{Binding Username}" /></controls:LabeledField>
            </Grid>
          </controls:SurfaceCard>

          <!-- Git types: the repository the connection opens into. Browsing
               lists directories on the connection target itself, never
               through the system picker that only sees this machine. -->
          <controls:SurfaceCard IsVisible="{Binding OpensGitRepository}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <controls:LabeledField
                Label="Repository path"
                Hint="The connection opens in this repository."
                controls:FieldValidation.For="RepositoryPath">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBox
                    Text="{Binding RepositoryPath}"
                    PlaceholderText="/home/user/project"
                    AutomationProperties.Name="Git repository path" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Classes="SecondaryButton"
                    Click="OnBrowseRepositoryClick"
                    Content="Browse…"
                    IsVisible="{Binding CanBrowseRepository}" />
              </Grid>
            </controls:LabeledField>
            <!-- The folder browser opens here, under the field it fills, not
                 as a window over this one. -->
            <StackPanel x:Name="RepositoryBrowser" IsVisible="False" Spacing="{DynamicResource ShellSpaceSm}">
              <components:GitRepositoryBrowserView
                  x:Name="RepositoryBrowserView"
                  Height="280"
                  RepositoryChosen="OnRepositoryChosen" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <Button Classes="SecondaryButton" Click="OnCloseRepositoryBrowserClick" Content="Cancel" AutomationProperties.Name="Close the folder browser" />
                <Button x:Name="UseRepositoryButton" Classes="PrimaryButton" Click="OnUseRepositoryClick" Content="Use Folder" />
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding ShowsStartupOptions}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Working directory">
                  <TextBox Text="{Binding StartupDirectory}" PlaceholderText="Optional" />
                </controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Startup command">
                  <TextBox Text="{Binding StartupCommand}" PlaceholderText="Optional command run in the shell" />
                </controls:LabeledField>
              </Grid>
              <!-- A minor option in a form, so a checkbox in the label
                   column, with the two numbers it governs indented under it
                   and dimmed while it is off. -->
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <CheckBox
                    x:Name="KeepAliveCheckBox"
                    Content="Keep connection alive"
                    IsChecked="{Binding KeepAliveEnabled}" />
                <StackPanel Margin="{controls:Inset Left=Xl}" Spacing="{DynamicResource ShellSpaceSm}" IsEnabled="{Binding KeepAliveEnabled}">
                  <Grid ColumnDefinitions="140,140" ColumnSpacing="{DynamicResource ShellSpaceSm}" HorizontalAlignment="Left">
                    <controls:LabeledField Label="Interval (seconds)"><NumericUpDown Minimum="1" Maximum="86400" Value="{Binding KeepAliveSeconds}" /></controls:LabeledField>
                    <controls:LabeledField Grid.Column="1" Label="Max failures"><NumericUpDown Minimum="1" Maximum="100" Value="{Binding KeepAliveFailures}" /></controls:LabeledField>
                  </Grid>
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="Asura checks the connection at this interval and disconnects after this many unanswered checks."
                      TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:Callout Tone="Notice" Title="{Binding TestStatus}" Text="{Binding TestDetail}" />

          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="{controls:Inset Xs}" ColumnDefinitions="9,110,80,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <Ellipse Width="7" Height="7" controls:StatusToneBrush.Fill="{Binding StatusTone}" />
                  <TextBlock Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Stage}" />
                  <TextBlock Grid.Column="2" Classes="Eyebrow" Text="{Binding Status}" />
                  <TextBlock Grid.Column="3" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <controls:SurfaceCard IsVisible="{Binding HasHostKeyReview}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding HostKeyReview.Endpoint}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="SecondaryButton"
                    Click="OnTrustHostKeyClick"
                    Content="{Binding TrustHostKeyLabel}"
                    IsVisible="{Binding CanTrustHostKey}" />
              </Grid>
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="Eyebrow" Text="Algorithm" />
                <TextBlock Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReview.Presented.Algorithm}" />
                <TextBlock Grid.Row="1" Classes="Eyebrow" Text="Presented" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Classes="Eyebrow" Text="Previous" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding TrustedHostKeyFingerprint}" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </controls:SurfaceCard>
        </StackPanel>
      </StackPanel>

      <!-- Files family -->
      <StackPanel IsVisible="{Binding IsFiles}" Spacing="{DynamicResource ShellSpaceMd}">
        <StackPanel DataContext="{Binding Files}" Spacing="{DynamicResource ShellSpaceMd}">
          <controls:SurfaceCard IsVisible="{Binding IsLocal}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock Classes="SectionHeading" Text="Local folder" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Asura stays inside this folder and doesn't follow links that lead outside it." TextWrapping="Wrap" />
              <controls:LabeledField Label="Folder" controls:FieldValidation.For="LocalRoot"><TextBox Text="{Binding LocalRoot}" PlaceholderText="Absolute folder path" AutomationProperties.Name="Local folder" /></controls:LabeledField>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsS3}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <TextBlock Classes="SectionHeading" Text="S3 / S3-compatible" />
              <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Bucket" controls:FieldValidation.For="BucketName"><TextBox Text="{Binding BucketName}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Region"><TextBox Text="{Binding Region}" PlaceholderText="us-east-1" /></controls:LabeledField>
              </Grid>
              <controls:LabeledField Label="Service URI" controls:FieldValidation.For="ServiceUri"><TextBox Text="{Binding ServiceUri}" PlaceholderText="Optional HTTPS endpoint for compatible services" /></controls:LabeledField>
              <controls:LabeledField Label="Initial prefix"><TextBox Text="{Binding RootPrefix}" PlaceholderText="Optional/path/prefix" /></controls:LabeledField>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceLg}"><CheckBox IsChecked="{Binding ForcePathStyle}" Content="Force path-style requests" /><CheckBox IsChecked="{Binding AllowInsecureTransport}" Content="Allow unencrypted HTTP" /></StackPanel>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsSftp}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock Classes="SectionHeading" Text="SFTP" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="SFTP uses the same SSH connection and credentials as the terminal." TextWrapping="Wrap" />
              <controls:LabeledField Label="SSH connection">
                <ComboBox ItemsSource="{Binding SshConnections}" SelectedItem="{Binding SelectedSshConnection}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </controls:LabeledField>
              <controls:LabeledField Label="Remote root" controls:FieldValidation.For="RemoteRoot"><TextBox Text="{Binding RemoteRoot}" /></controls:LabeledField>
              <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding HasHostKeyReview}">
                <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding HostKeyReviewStatus}" TextWrapping="Wrap" />
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Presented" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding PresentedHostKey}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding HasTrustedHostKey}">
                    <TextBlock Classes="Eyebrow" Text="Currently trusted" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TrustedHostKey}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                      HorizontalAlignment="Left"
                      Classes="DestructiveButton"
                      Click="OnTrustFileHostKeyClick"
                      Content="{Binding HostKeyActionText}"
                      IsEnabled="{Binding CanApplyHostKeyTrust}" />
                </StackPanel>
              </controls:SurfaceCard>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsFtp}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <TextBlock Classes="SectionHeading" Text="FTP / FTPS" />
              <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Host" controls:FieldValidation.For="Host"><TextBox Text="{Binding Host}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Port"><NumericUpDown Minimum="1" Maximum="65535" Value="{Binding Port}" /></controls:LabeledField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="TLS mode"><ComboBox ItemsSource="{Binding FtpSecurityModes}" SelectedItem="{Binding FtpSecurity}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Data connection"><ComboBox ItemsSource="{Binding FtpConnectionModes}" SelectedItem="{Binding FtpConnectionMode}" /></controls:LabeledField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Username"><TextBox Text="{Binding Username}" PlaceholderText="Blank for anonymous" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Remote root" controls:FieldValidation.For="RemoteRoot"><TextBox Text="{Binding RemoteRoot}" /></controls:LabeledField>
              </Grid>
              <CheckBox IsVisible="{Binding IsPlaintextFtp}" IsChecked="{Binding AllowPlaintext}" Content="I understand plaintext FTP exposes credentials and files" />
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsSmb}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <TextBlock Classes="SectionHeading" Text="SMB 2/3" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Server" controls:FieldValidation.For="Server"><TextBox Text="{Binding Server}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Share" controls:FieldValidation.For="Share"><TextBox Text="{Binding Share}" /></controls:LabeledField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:LabeledField Label="Authentication"><ComboBox ItemsSource="{Binding SmbCredentialModes}" SelectedItem="{Binding SmbCredentialMode}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Remote root" controls:FieldValidation.For="RemoteRoot"><TextBox Text="{Binding RemoteRoot}" /></controls:LabeledField>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding UsesSmbCredential}">
                <controls:LabeledField Label="Domain"><TextBox Text="{Binding Domain}" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Username" controls:FieldValidation.For="Username"><TextBox Text="{Binding Username}" /></controls:LabeledField>
              </Grid>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding IsWebDav}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <TextBlock Classes="SectionHeading" Text="WebDAV" />
              <controls:LabeledField Label="Base URI" controls:FieldValidation.For="BaseUri"><TextBox Text="{Binding BaseUri}" /></controls:LabeledField>
              <controls:LabeledField Label="Username"><TextBox Text="{Binding Username}" PlaceholderText="Blank when authentication is not required" /></controls:LabeledField>
              <CheckBox IsChecked="{Binding AllowInsecureTransport}" Content="Allow unencrypted HTTP" />
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding UsesProviderCredential}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock Classes="SectionHeading" Text="Saved credential" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SecretOptions}" SelectedItem="{Binding SelectedCredential}" AutomationProperties.Name="Credential"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <Button Grid.Column="1" Classes="SecondaryButton" Click="OnAddFileCredentialClick" Content="Add New…" AutomationProperties.Name="Add file connection credential" />
              </Grid>
              <components:ConnectionCredentialDraftView
                  x:Name="FileCredentialDraft"
                  IsVisible="False"
                  Created="OnCredentialDraftCreated"
                  Cancelled="OnCredentialDraftCancelled" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Choose a credential saved for this connection. An S3 credential is JSON with accessKeyId, secretAccessKey, and an optional sessionToken." TextWrapping="Wrap" />
            </StackPanel>
          </controls:SurfaceCard>

          <controls:Callout Tone="Notice" Title="{Binding TestStatus}" Text="{Binding TestDetail}" />
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsKubernetes}" Spacing="{DynamicResource ShellSpaceMd}">
        <StackPanel DataContext="{Binding Kubernetes}" Spacing="{DynamicResource ShellSpaceMd}">
          <controls:LabeledField Label="Kubeconfig file"><TextBox Text="{Binding KubeconfigPath}" PlaceholderText="~/.kube/config" AutomationProperties.Name="Kubeconfig file" /></controls:LabeledField>
          <Button Content="Review Configuration" Command="{Binding ReviewCommand}" HorizontalAlignment="Left" />
          <TextBlock Classes="Muted" Text="{Binding ReviewStatus}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedContext}" HorizontalAlignment="Stretch" AutomationProperties.Name="Discovered Kubernetes contexts">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ContextName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="Muted" Text="{Binding ContextDescription}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasCredentialCommand}" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Text="{Binding CredentialCommandDescription}" TextWrapping="Wrap" />
            <CheckBox Content="Trust this exact credential command when connecting" IsChecked="{Binding TrustCredentialCommand}" />
            <TextBlock Classes="Muted" Text="Without workspace isolation, authentication runs on this computer using its installed tools, login files, and network. Kubernetes traffic uses the workspace network connection. In isolated workspaces, authentication runs inside the workspace." TextWrapping="Wrap" />
          </StackPanel>
          <controls:LabeledField Label="Context"><TextBox Text="{Binding ContextName}" PlaceholderText="Exact kubeconfig context name" AutomationProperties.Name="Kubernetes context" /></controls:LabeledField>
          <controls:LabeledField Label="Default namespace"><TextBox Text="{Binding Namespace}" AutomationProperties.Name="Default Kubernetes namespace" /></controls:LabeledField>
          <TextBlock Classes="Muted" Text="Saving does not connect or run credential plugins. The selected context is bound to this connection; kubectl current-context remains unchanged." TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <!-- Database family: one flat form. Everything about the connection reads
           as fields of the same page. -->
      <StackPanel IsVisible="{Binding IsDatabase}" Spacing="{DynamicResource ShellSpaceMd}">
        <StackPanel DataContext="{Binding Database}" Spacing="{DynamicResource ShellSpaceMd}">
          <controls:SurfaceCard>
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceLg}">
                <RadioButton
                    GroupName="DatabaseInputMode"
                    IsChecked="{Binding UseFields, Mode=OneWay}"
                    Content="Parameters"
                    AutomationProperties.Name="Describe the connection with fields" />
                <RadioButton
                    GroupName="DatabaseInputMode"
                    IsChecked="{Binding UseConnectionString, Mode=TwoWay}"
                    Content="Connection string"
                    AutomationProperties.Name="Describe the connection with one string" />
              </StackPanel>

              <!-- One pasted string: engine URL or keyword form -->
              <controls:LabeledField
                  Label="URL"
                  controls:FieldValidation.For="ConnectionStringInput"
                  Hint="{Binding Source={x:Static core:PlatformTerms.SecretStore}, StringFormat='A URL (postgresql://…, mysql://…) or a keyword string. When you store it, a password in the string goes to {0}, never into the saved connection.'}"
                  IsVisible="{Binding UseConnectionString}">
                <TextBox
                    Text="{Binding ConnectionStringInput}"
                    PlaceholderText="{Binding ConnectionStringHint}"
                    AutomationProperties.Name="Database connection string or URL" />
              </controls:LabeledField>

              <!-- Structured fields -->
              <StackPanel Spacing="{DynamicResource ShellSpaceMd}" IsVisible="{Binding UseFields}">
                <controls:LabeledField Label="File" IsVisible="{Binding IsFileBased}" controls:FieldValidation.For="FilePath">
                  <TextBox Text="{Binding FilePath}" PlaceholderText="/path/to/database.db" AutomationProperties.Name="Database file path" />
                </controls:LabeledField>

                <Grid ColumnDefinitions="*,110" ColumnSpacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding IsServerBased}">
                  <controls:LabeledField Label="Host"><TextBox Text="{Binding Host}" PlaceholderText="localhost" AutomationProperties.Name="Database host" /></controls:LabeledField>
                  <controls:LabeledField Grid.Column="1" Label="Port" controls:FieldValidation.For="Port"><TextBox Text="{Binding Port}" PlaceholderText="{Binding PortPlaceholder}" AutomationProperties.Name="Database port" /></controls:LabeledField>
                </Grid>

                <controls:LabeledField Label="User" IsVisible="{Binding IsServerBased}">
                  <TextBox Text="{Binding Username}" PlaceholderText="User name" AutomationProperties.Name="Database user" />
                </controls:LabeledField>

                <controls:LabeledField Label="Password" IsVisible="{Binding IsServerBased}">
                  <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password" AutomationProperties.Name="Database password" />
                </controls:LabeledField>
                <!-- What storing means is said under the checkbox, not only in
                     a tooltip nobody hovers. -->
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding IsServerBased}">
                  <CheckBox
                      x:Name="StorePasswordCheckBox"
                      IsChecked="{Binding StorePassword}"
                      Content="{Binding Source={x:Static core:PlatformTerms.SecretStore}, StringFormat={}Store the password in {0}}" />
                  <TextBlock
                      Margin="{controls:Inset Left=Xl}"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="The saved connection never contains the password. If it isn't stored, Asura asks for it each time you connect."
                      TextWrapping="Wrap" />
                </StackPanel>

                <controls:LabeledField Label="{Binding DatabaseLabel}" IsVisible="{Binding IsServerBased}">
                  <TextBox Text="{Binding DatabaseName}" PlaceholderText="Database name" AutomationProperties.Name="Database name" />
                </controls:LabeledField>

                <controls:LabeledField Label="Options">
                  <TextBox Text="{Binding Options}" PlaceholderText="Key=Value;…" AutomationProperties.Name="Additional connection options" />
                </controls:LabeledField>
              </StackPanel>
            </StackPanel>
          </controls:SurfaceCard>

          <controls:SurfaceCard IsVisible="{Binding ShowsTunnel}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <controls:LabeledField Label="SSH tunnel">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding TunnelOptions}"
                    SelectedItem="{Binding SelectedTunnel}"
                    AutomationProperties.Name="SSH tunnel connection">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </controls:LabeledField>

              <Grid ColumnDefinitions="*,110" ColumnSpacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding IsInlineTunnel}">
                <controls:LabeledField Label="Host" controls:FieldValidation.For="TunnelHost"><TextBox Text="{Binding TunnelHost}" PlaceholderText="bastion.example.com" AutomationProperties.Name="Tunnel host" /></controls:LabeledField>
                <controls:LabeledField Grid.Column="1" Label="Port" controls:FieldValidation.For="TunnelPort"><TextBox Text="{Binding TunnelPort}" PlaceholderText="22" AutomationProperties.Name="Tunnel port" /></controls:LabeledField>
              </Grid>

              <controls:LabeledField Label="User" IsVisible="{Binding IsInlineTunnel}">
                <TextBox Text="{Binding TunnelUsername}" PlaceholderText="Current local user" AutomationProperties.Name="Tunnel username" />
              </controls:LabeledField>

              <controls:LabeledField Label="Authentication" IsVisible="{Binding IsInlineTunnel}" controls:FieldValidation.For="TunnelPassword">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <ComboBox MinWidth="170" ItemsSource="{Binding TunnelAuthenticationChoices}" SelectedItem="{Binding TunnelAuthentication}" AutomationProperties.Name="Tunnel authentication" />
                  <TextBox Grid.Column="1" IsVisible="{Binding TunnelUsesPassword}" Text="{Binding TunnelPassword}" PasswordChar="•" PlaceholderText="Password" AutomationProperties.Name="Tunnel password" />
                </Grid>
              </controls:LabeledField>
              <controls:LabeledField Label="Host-key policy" IsVisible="{Binding IsInlineTunnel}">
                <ComboBox ItemsSource="{Binding TunnelHostKeyPolicies}" SelectedItem="{Binding TunnelHostKeyPolicy}" />
              </controls:LabeledField>
              <controls:SurfaceCard Tone="Notice" IsVisible="{Binding HasHostKeyReview}">
                <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock Text="SSH server identity needs review" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding HostKeyReview.Endpoint}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextWrapping="Wrap" />
                  <Button Content="Review Host Key…" Click="OnTrustDatabaseHostKeyClick" />
                </StackPanel>
              </controls:SurfaceCard>
            </StackPanel>
          </controls:SurfaceCard>

          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              IsVisible="{Binding HasStoredPassword}"
              Text="A password is stored for this connection. Leaving the field empty keeps it; storing a new one replaces it."
              TextWrapping="Wrap" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              IsVisible="{Binding HasStoredTunnelPassword}"
              Text="A tunnel password is stored for this connection. Leaving the field empty keeps it; storing a new one replaces it."
              TextWrapping="Wrap" />

          <controls:Callout Tone="Notice" Title="{Binding TestStatus}" Text="{Binding TestDetail}" />
        </StackPanel>
      </StackPanel>

    </StackPanel>

    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Border x:Name="ConnectPurposeRow" VerticalAlignment="Center" IsVisible="False">
          <CheckBox
              x:Name="SaveConnectionCheckBox"
              Content="Save connection"
              IsChecked="True"
              IsVisible="{Binding SupportsUnsavedConnect}"
              AutomationProperties.Name="Save this connection for later" />
        </Border>
        <Button
            MinWidth="120"
            Classes="SecondaryButton"
            Click="OnTestClick"
            Content="{Binding TestLabel}"
            IsEnabled="{Binding !IsTesting}"
            IsVisible="{Binding CanTest}" />
        <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button x:Name="SubmitButton" MinWidth="88" Classes="PrimaryButton" Click="OnSubmitClick" Content="Save" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>
  </controls:DialogShell>
</controls:DialogWindow>
