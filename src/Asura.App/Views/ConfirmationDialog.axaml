<controls:DialogWindow
    x:Class="Asura.App.Views.ConfirmationDialog"
    x:DataType="views:ConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Width="300"
    SizeToContent="Height"
    CanResize="False">
  <!--
    The shell's one alert.

    There used to be ten of these — delete, clear, reset, discard, close,
    error — each its own Window with the same rows re-typed. What an alert asks
    is configuration; what one looks like is decided here, once, in the shape
    of the host's current alert: a narrow window with the app's icon on top,
    the question in bold and the detail under it, both centred, and the
    buttons across the full width at the bottom. A destructive question
    badges the icon with a caution mark; it does not repaint the alert red.
    The question is also the window's title, so it is never shown twice.
  -->
  <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
    <Panel
        Width="64"
        Height="64"
        HorizontalAlignment="Center"
        AutomationProperties.AccessibilityView="Raw">
      <Image x:Name="ApplicationIcon" Width="64" Height="64" />
      <icons:SymbolIcon
          x:Name="FallbackGlyph"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="{DynamicResource ShellIconSizeXl}"
          Foreground="{DynamicResource ShellAccentBrush}"
          Symbol="Info"
          IsVisible="False" />
      <Border
          x:Name="CautionBadge"
          Width="30"
          Height="30"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Background="{DynamicResource ShellBackgroundBrush}"
          CornerRadius="15"
          IsVisible="False">
        <icons:SymbolIcon
            x:Name="CautionGlyph"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="{controls:TextScaled 22}"
            Foreground="{DynamicResource ShellWarningBrush}"
            IconVariant="Filled"
            Symbol="Warning" />
      </Border>
    </Panel>

    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock
          x:Name="HeadingText"
          FontSize="{DynamicResource ShellFontSize13}"
          FontWeight="Bold"
          Text="{Binding Heading}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="DetailText"
          FontSize="{DynamicResource ShellFontSize11}"
          LineHeight="{DynamicResource ShellLineHeight11}"
          Text="{Binding Detail}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
      <!-- The blast radius, or the sessions a close would end: read after
           the detail, in the same voice, not boxed in a callout. -->
      <TextBlock
          x:Name="NoticeText"
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize11}"
          LineHeight="{DynamicResource ShellLineHeight11}"
          Text="{Binding Notice}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          IsVisible="{Binding HasNotice}" />
    </StackPanel>

    <!-- "Don't ask again" sits above the buttons, as the host's own
         suppression checkbox does. -->
    <CheckBox
        x:Name="SuppressionCheckBox"
        HorizontalAlignment="Left"
        Content="{Binding SuppressionLabel}"
        IsChecked="{Binding IsSuppressionChecked}"
        IsVisible="{Binding HasSuppression}" />

    <!-- Two answers share the row, the default on the trailing side. Three —
         Save, Don't Save, Cancel — stack at full width with the default on
         top, as the host stacks them; the code-behind picks the shape. -->
    <Grid x:Name="ButtonRow" ColumnSpacing="{DynamicResource ShellSpaceSm}" RowSpacing="{DynamicResource ShellSpaceSm}">
      <Button
          x:Name="CancelButton"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          Classes="SecondaryButton"
          Click="OnCancelClick"
          Content="{Binding CancelLabel}"
          IsCancel="True"
          IsVisible="{Binding ShowsCancel}" />
      <Button
          x:Name="AlternateButton"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          Classes="SecondaryButton"
          Click="OnAlternateClick"
          Content="{Binding AlternateLabel}"
          IsVisible="{Binding HasAlternate}" />
      <Button
          x:Name="ConfirmButton"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          Click="OnConfirmClick"
          Content="{Binding ConfirmLabel}" />
    </Grid>
  </StackPanel>
</controls:DialogWindow>
