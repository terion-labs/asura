<controls:DialogWindow
    x:Class="Asura.App.Views.ConfirmationDialog"
    x:DataType="views:ConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Width="460"
    SizeToContent="Height"
    CanResize="False">
  <!--
    The shell's one alert.

    There used to be ten of these — delete, clear, reset, discard, close,
    error — each its own Window with the same rows re-typed. What an alert asks
    is configuration; what one looks like is decided here, once, in the shape
    of the host's alert: the app's icon, the question in bold, the detail
    under it, and the buttons on the trailing edge. A destructive question
    badges the icon with a caution mark; it does not repaint the alert red.
    The question is also the window's title, so it is never shown twice.
  -->
  <Grid
      Margin="{controls:Inset Xl}"
      ColumnDefinitions="Auto,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="{DynamicResource ShellSpaceLg}"
      RowSpacing="{DynamicResource ShellSpaceLg}">
    <Panel
        Width="64"
        Height="64"
        VerticalAlignment="Top"
        AutomationProperties.AccessibilityView="Raw">
      <Image x:Name="ApplicationIcon" Width="64" Height="64" />
      <icons:SymbolIcon
          x:Name="FallbackGlyph"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="40"
          Foreground="{DynamicResource ShellAccentBrush}"
          Symbol="Info"
          IsVisible="False" />
      <Border
          x:Name="CautionBadge"
          Width="30"
          Height="30"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Background="{DynamicResource ShellBackgroundBrush}"
          CornerRadius="15"
          IsVisible="False">
        <icons:SymbolIcon
            x:Name="CautionGlyph"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="22"
            Foreground="{DynamicResource ShellWarningBrush}"
            IconVariant="Filled"
            Symbol="Warning" />
      </Border>
    </Panel>

    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock
          x:Name="HeadingText"
          FontSize="{DynamicResource ShellFontSize13}"
          FontWeight="Bold"
          Text="{Binding Heading}"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="DetailText"
          FontSize="{DynamicResource ShellFontSize11}"
          LineHeight="{DynamicResource ShellLineHeight11}"
          Text="{Binding Detail}"
          TextWrapping="Wrap" />
      <!-- The blast radius, or the sessions a close would end: read after
           the detail, in the same voice, not boxed in a callout. -->
      <TextBlock
          x:Name="NoticeText"
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize11}"
          LineHeight="{DynamicResource ShellLineHeight11}"
          Text="{Binding Notice}"
          TextWrapping="Wrap"
          IsVisible="{Binding HasNotice}" />
    </StackPanel>

    <!-- "Don't ask again" shares the button row, on the leading edge, so a
         confirmation without one keeps exactly the layout it had. -->
    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
      <CheckBox
          x:Name="SuppressionCheckBox"
          VerticalAlignment="Center"
          Content="{Binding SuppressionLabel}"
          IsChecked="{Binding IsSuppressionChecked}"
          IsVisible="{Binding HasSuppression}" />
      <!-- Don't Save sits apart from Save and Cancel, on the leading edge,
           as it does in every Mac save alert. -->
      <Button
          x:Name="AlternateButton"
          MinWidth="88"
          HorizontalAlignment="Left"
          Classes="SecondaryButton"
          Click="OnAlternateClick"
          Content="{Binding AlternateLabel}"
          IsVisible="{Binding HasAlternate}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button
            x:Name="CancelButton"
            MinWidth="88"
            Classes="SecondaryButton"
            Click="OnCancelClick"
            Content="{Binding CancelLabel}"
            IsCancel="True"
            IsVisible="{Binding ShowsCancel}" />
        <Button
            x:Name="ConfirmButton"
            MinWidth="88"
            Click="OnConfirmClick"
            Content="{Binding ConfirmLabel}" />
      </StackPanel>
    </Grid>
  </Grid>
</controls:DialogWindow>
