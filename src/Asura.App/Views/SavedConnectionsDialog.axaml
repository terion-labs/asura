<controls:DialogWindow
    x:Class="Asura.App.Views.SavedConnectionsDialog"
    x:DataType="vm:LauncherViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:views="using:Asura.App.Views"
    Width="760" Height="650" MinWidth="600" MinHeight="400" Presentation="Inspector">
  <!-- A window people keep open while they work, not a question: it does not
       block the window it came from, and an editor opened from it is the one
       sheet on top of it rather than a modal on a modal. ⌘W or Escape closes. -->
  <controls:DialogShell Title="Saved Connections" Subtitle="Browse and edit your terminal, file, database, and Kubernetes connections.">
    <!-- The list's one Edit… acts on the selection, at the footer's leading
         edge under the list, where it stays in view however long the list. -->
    <controls:DialogShell.FooterLeading>
      <Button
          x:Name="EditButton"
          MinWidth="88"
          Classes="SecondaryButton"
          Click="OnEditClick"
          Content="Edit…"
          IsEnabled="False"
          AutomationProperties.Name="Edit the selected connection" />
    </controls:DialogShell.FooterLeading>
    <controls:DialogShell.Footer>
      <Button Classes="PrimaryButton" Click="OnAddClick" Content="Add Connection…" />
    </controls:DialogShell.Footer>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <controls:SearchField Text="{Binding ConnectionSearchQuery}" PlaceholderText="Filter connections" AutomationProperties.Name="Filter saved connections" />
      <TextBlock Classes="Muted" Text="{Binding TotalConnectionCount, Converter={x:Static views:CountLabel.Converter}, ConverterParameter=saved connection}" />
      <TextBlock Classes="Muted" Text="No connections match your filter." IsVisible="{Binding HasNoFilteredConnections}" />
      <!-- A Mac list: select a row, then edit it with the one Edit… button,
           a double-click, or Return. A button on every row made nine
           identical Edit… buttons compete with the rows themselves. -->
      <ListBox
          x:Name="ConnectionList"
          ItemsSource="{Binding FilteredConnections}"
          SelectionMode="Single"
          DoubleTapped="OnConnectionDoubleTapped"
          SelectionChanged="OnConnectionSelectionChanged"
          IsVisible="{Binding !HasNoFilteredConnections}"
          AutomationProperties.Name="Saved connections">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <controls:ListItem Margin="{controls:Inset Vertical=Xs}" Classes="MiddleTruncatedDetail" Title="{Binding Name}" Detail="{Binding Detail}">
              <controls:ListItem.Trailing>
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Kind}" />
              </controls:ListItem.Trailing>
            </controls:ListItem>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
