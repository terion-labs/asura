<UserControl
    x:Class="Asura.App.Views.DiagnosticsExportView"
    x:DataType="vm:DiagnosticsExportViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <!--
    The support archive as a grouped form: how much detail goes in, as a row
    with the chosen level's meaning under it; what never goes in, as the
    plate's notice; and creating it, as the last row, with its progress and
    Cancel beside the button. The bundle last made is a plate of its own.
  -->
  <StackPanel Spacing="{DynamicResource ShellSettingsGroupGap}">
    <controls:SettingsGroup
        x:Name="DiagnosticsBundleGroup"
        Heading="Diagnostics bundle"
        Description="Create a support archive after reviewing what it contains.">
      <controls:LabeledField
          Classes="FormRow"
          Label="Diagnostic detail"
          Hint="{Binding SelectedRedactionDescription}">
        <ComboBox
            ItemsSource="{Binding RedactionOptions}"
            SelectedItem="{Binding SelectedRedactionOption, Mode=TwoWay}"
            IsEnabled="{Binding CanChooseRedactionLevel}"
            AutomationProperties.Name="Diagnostics detail and redaction level">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:LabeledField>

      <controls:Callout
          Tone="Notice"
          Glyph="Shield"
          Title="Secrets are never included"
          Text="{Binding RedactionAvailabilityMessage}"
          Footnote="Terminal contents, commands, credentials, environment values, and other secrets are never added to the bundle." />

      <Border
          MinHeight="{DynamicResource ShellSettingsRowMinHeight}"
          Padding="{DynamicResource ShellSettingsRowPadding}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <controls:StatusChip
              VerticalAlignment="Center"
              Classes.Warning="{Binding IsWarning}"
              IsVisible="{Binding HasStatus}"
              Content="{Binding StatusLabel}" />
          <ProgressBar
              Grid.Column="1"
              MinWidth="120"
              VerticalAlignment="Center"
              IsIndeterminate="True"
              IsVisible="{Binding IsExporting}"
              AutomationProperties.Name="Diagnostics export progress" />
          <Button
              Grid.Column="2"
              VerticalAlignment="Center"
              Classes="SecondaryButton"
              Click="OnCancelClick"
              Content="Cancel"
              IsEnabled="{Binding CanCancel}"
              IsVisible="{Binding CanCancel}"
              AutomationProperties.Name="Cancel diagnostics export" />
          <Button
              Grid.Column="3"
              VerticalAlignment="Center"
              Classes="PrimaryButton"
              Click="OnExportClick"
              Content="Create Bundle…"
              IsEnabled="{Binding CanExport}"
              AutomationProperties.Name="Create diagnostics bundle" />
        </Grid>
      </Border>
    </controls:SettingsGroup>

    <controls:Callout Tone="Notice" Glyph="Info" IsVisible="{Binding HasStatus}">
      <controls:LiveRegionTextBlock
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />
    </controls:Callout>

    <controls:SettingsGroup Heading="Last exported bundle" IsVisible="{Binding HasArtifact}">
      <controls:SettingRow
          Label="{Binding ArtifactDisplayName}"
          Description="{Binding ReceiptSummary}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
          <Button
              VerticalAlignment="Center"
              Classes="SecondaryButton"
              Click="OnOpenClick"
              Content="Open"
              IsEnabled="{Binding CanOpenArtifact}"
              AutomationProperties.Name="Open last diagnostics bundle" />
          <Button
              VerticalAlignment="Center"
              Classes="SecondaryButton"
              Click="OnRevealClick"
              Content="Show in Folder"
              IsEnabled="{Binding CanRevealArtifact}"
              AutomationProperties.Name="Reveal last diagnostics bundle in file manager" />
        </StackPanel>
      </controls:SettingRow>
      <controls:SettingsGroup.Footer>
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding DigestSummary}" TextWrapping="Wrap" />
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>
  </StackPanel>
</UserControl>
