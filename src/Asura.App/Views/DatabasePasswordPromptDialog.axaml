<controls:DialogWindow
    x:Class="Asura.App.Views.DatabasePasswordPromptDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    Width="400"
    SizeToContent="Height"
    CanResize="False">
  <controls:DialogShell x:Name="Shell" Title="Database Password" Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel the password prompt" />
        <Button MinWidth="88" Classes="PrimaryButton" Click="OnConnectClick" Content="Connect" IsDefault="True" AutomationProperties.Name="Connect with this password" />
      </StackPanel>
    </controls:DialogShell.Footer>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <TextBlock x:Name="PromptDescription" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="This connection is saved without a password. It is used for this session only." TextWrapping="Wrap" />
      <TextBox
          x:Name="PasswordInput"
          PasswordChar="•"
          PlaceholderText="Password"
          TextChanged="OnPasswordTextChanged"
          AutomationProperties.Name="Database password" />
      <CheckBox
          x:Name="SavePasswordCheckBox"
          IsChecked="False"
          IsEnabled="False"
          IsVisible="False"
          Content="Save in system credential store"
          AutomationProperties.Name="Save password in system credential store" />
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
