<UserControl
    x:Class="Asura.App.Views.SettingsPages.AppearanceSettingsPageView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Asura.App.Views.SettingsPages"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <StackPanel Spacing="{DynamicResource ShellSpaceXl}">
    <components:SettingsPageHeader
        Heading="Appearance"
        Description="Customize how the app looks — color scheme, accent, and window style." />

    <!-- Theme -->
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Theme"
          Description="Asura follows the system's appearance. Override it only when this app has to differ." />
      <!--
        The tile is the control. Each one previews the chrome its mode produces
        with the surface, border, and text colours the appearance mapper
        publishes for that mode, so the tile and the window agree.
        Sibling radio buttons use their logical parent as the group, so detached
        settings pages cannot change selections in another page. System stands
        on its own and Dark and Light sit together in the disclosure below, so
        the three are kept exclusive by OnAppearanceModeChanged.

        System is the visible default, as the host would have it: an app-level
        light or dark mode is an override, so it is offered as one rather than
        as three equal choices.
      -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}">
        <RadioButton
            x:Name="AppearanceModeSystem"
            Classes="PresetCard"
            IsCheckedChanged="OnAppearanceModeChanged"
            AutomationProperties.Name="Color mode System">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Height="72" CornerRadius="{DynamicResource ShellControlCornerRadius}" ClipToBounds="True">
              <Grid ColumnDefinitions="*,*">
                <Border Background="{DynamicResource ShellThemePreviewDarkBackgroundBrush}" BorderBrush="{DynamicResource ShellThemePreviewDarkBorderBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" />
                <Border Grid.Column="1" Background="{DynamicResource ShellThemePreviewLightBackgroundBrush}" BorderBrush="{DynamicResource ShellThemePreviewLightBorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" />
                <TextBlock Margin="{controls:Inset Left=Sm}" VerticalAlignment="Center" FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewDarkMutedBrush}" Text="❯ dev" />
                <TextBlock Grid.Column="1" Margin="{controls:Inset Right=Sm}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewLightMutedBrush}" Text="❯ dev" />
              </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="PresetName" Text="System" />
              <icons:SymbolIcon Grid.Column="1" Classes="PresetCheck" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Grid>
          </StackPanel>
        </RadioButton>
      </StackPanel>
      <!-- Starts folded; it opens on its own when the stored mode is already
           an override, so an override is never hidden from the person who
           made it. -->
      <Expander
          x:Name="AppearanceOverrideExpander"
          Header="Override system appearance"
          IsExpanded="False"
          AutomationProperties.Name="Override system appearance">
        <StackPanel Margin="{controls:Inset Top=Sm}" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}">
            <RadioButton
                x:Name="AppearanceModeDark"
                Classes="PresetCard"
                IsCheckedChanged="OnAppearanceModeChanged"
                AutomationProperties.Name="Color mode Dark">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="72" Background="{DynamicResource ShellThemePreviewDarkBackgroundBrush}" BorderBrush="{DynamicResource ShellThemePreviewDarkBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" ClipToBounds="True">
                  <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewDarkMutedBrush}" Text="❯ npm run dev" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewDarkSuccessBrush}" Text="✓ ready in 312ms" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewDarkAccentTextBrush}" Text="▸ localhost:3000" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="PresetName" Text="Dark" />
                  <icons:SymbolIcon Grid.Column="1" Classes="PresetCheck" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
                </Grid>
              </StackPanel>
            </RadioButton>
            <RadioButton
                x:Name="AppearanceModeLight"
                Classes="PresetCard"
                IsCheckedChanged="OnAppearanceModeChanged"
                AutomationProperties.Name="Color mode Light">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="72" Background="{DynamicResource ShellThemePreviewLightBackgroundBrush}" BorderBrush="{DynamicResource ShellThemePreviewLightBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" ClipToBounds="True">
                  <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewLightMutedBrush}" Text="❯ npm run dev" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewLightSuccessBrush}" Text="✓ ready in 312ms" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{DynamicResource ShellThemePreviewLightAccentTextBrush}" Text="▸ localhost:3000" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="PresetName" Text="Light" />
                  <icons:SymbolIcon Grid.Column="1" Classes="PresetCheck" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
                </Grid>
              </StackPanel>
            </RadioButton>
        </StackPanel>
      </Expander>
      <!-- A setting, not a theme: a row under the tiles rather than a card
           beside them that read as a fourth tile. -->
      <controls:SettingsGroup ControlWidth="240">
        <controls:SettingRow
            Label="Platform profile"
            Description="Which system’s look to match: window controls, corner radius, and density."
            IsLast="True">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
            <ComboBox x:Name="PlatformProfilePicker" HorizontalAlignment="Stretch" SelectionChanged="OnPlatformProfileChanged" AutomationProperties.Name="Platform profile" />
            <TextBlock
                x:Name="ProfileDepartureMarker"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="*"
                IsVisible="False"
                ToolTip.Tip="Density or translucency has been changed from what this profile arrives with."
                AutomationProperties.Name="Profile settings changed" />
          </Grid>
        </controls:SettingRow>
      </controls:SettingsGroup>
    </StackPanel>

    <!-- Terminal palette -->
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <components:SectionHeader
            Heading="Terminal palette"
            Description="Pick a preset or start from a custom palette. Every terminal shows a change as it’s made." />
        <!-- Applied as it changes, like every other setting here. Revert
             puts back the palette and font this page opened with. -->
        <Button
            x:Name="RevertTerminalButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="TextButton"
            Click="OnRevertTerminalClick"
            Content="Revert"
            IsEnabled="{Binding CanRevertTerminalAppearance}"
            AutomationProperties.Name="Revert the terminal palette and font"
            AutomationProperties.HelpText="Puts back the terminal palette and font as they were when this page opened." />
        <controls:StatusChip Shape="Rounded" Tone="Default" IsOutlined="False" Grid.Column="2" VerticalAlignment="Center" Content="{Binding TerminalSettingsEditor.PaletteName}" />
      </Grid>
      <!-- Six presets in at most three columns: three by two, or two by
           three when narrow, so no row is left with a lone card. Four
           columns left a ragged row of two under a row of four. -->
      <ItemsControl x:Name="TerminalPalettePresets" ItemsSource="{Binding TerminalSettingsEditor.PalettePresets}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="168" MaxColumns="3" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton
                Width="NaN"
                Classes="PresetCard"
                GroupName="TerminalPalette"
                Click="OnSelectTerminalPaletteClick"
                IsCheckedChanged="OnTerminalAppearanceChanged"
                IsChecked="{Binding IsSelected, Mode=OneWay}"
                AutomationProperties.Name="{Binding Name, StringFormat=Use the {0} palette}">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="72" Background="{Binding Background, Converter={StaticResource HexColorBrushConverter}}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" ClipToBounds="True">
                  <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{Binding Foreground, Converter={StaticResource HexColorBrushConverter}}" Text="❯ npm run dev" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{Binding Green, Converter={StaticResource HexColorBrushConverter}}" Text="✓ ready in 312ms" />
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" Foreground="{Binding Blue, Converter={StaticResource HexColorBrushConverter}}" Text="▸ localhost:3000" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="PresetName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <icons:SymbolIcon Grid.Column="1" Classes="PresetCheck" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
                </Grid>
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Colors -->
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Colors"
          Description="Fine-tune the terminal palette and review its ANSI colors." />
      <!-- Two to a row, so a hex field has room for "#RRGGBB" under its
           label; four to a row left each one a few characters wide. -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}" RowSpacing="{DynamicResource ShellSpaceMd}">
        <controls:SurfaceCard Tone="Raised">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <ColorPicker
                Classes="Swatch"
                Color="{Binding TerminalSettingsEditor.BackgroundColor, Mode=TwoWay}"
                ColorChanged="OnColorChanged"
                AutomationProperties.Name="Pick the terminal background color" />
            <controls:LabeledField Grid.Column="1" VerticalAlignment="Center"
                Label="Background">
              <TextBox
                  MinWidth="96"
                  FontFamily="{DynamicResource ShellDataFontFamily}"
                  Text="{Binding TerminalSettingsEditor.Background}"
                  LostFocus="OnTerminalAppearanceChanged"
                  KeyDown="OnCommitKeyDown"
                  AutomationProperties.Name="Terminal background color" />

            </controls:LabeledField>
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Classes="IconButton"
                Tag="Background"
                Click="OnPickColorClick"
                ToolTip.Tip="Sample a color from the window"
                AutomationProperties.Name="Sample the terminal background color from the window">
              <icons:SymbolIcon Symbol="Eyedropper" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </Grid>
        </controls:SurfaceCard>
        <controls:SurfaceCard Tone="Raised" Grid.Column="1">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <ColorPicker
                Classes="Swatch"
                Color="{Binding TerminalSettingsEditor.ForegroundColor, Mode=TwoWay}"
                ColorChanged="OnColorChanged"
                AutomationProperties.Name="Pick the terminal foreground color" />
            <controls:LabeledField Grid.Column="1" VerticalAlignment="Center"
                Label="Foreground">
              <TextBox
                  MinWidth="96"
                  FontFamily="{DynamicResource ShellDataFontFamily}"
                  Text="{Binding TerminalSettingsEditor.Foreground}"
                  LostFocus="OnTerminalAppearanceChanged"
                  KeyDown="OnCommitKeyDown"
                  AutomationProperties.Name="Terminal foreground color" />

            </controls:LabeledField>
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Classes="IconButton"
                Tag="Foreground"
                Click="OnPickColorClick"
                ToolTip.Tip="Sample a color from the window"
                AutomationProperties.Name="Sample the terminal foreground color from the window">
              <icons:SymbolIcon Symbol="Eyedropper" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </Grid>
        </controls:SurfaceCard>
        <controls:SurfaceCard Tone="Raised" Grid.Row="1">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <ColorPicker
                Classes="Swatch"
                Color="{Binding TerminalSettingsEditor.CursorColor, Mode=TwoWay}"
                ColorChanged="OnColorChanged"
                AutomationProperties.Name="Pick the terminal cursor color" />
            <controls:LabeledField Grid.Column="1" VerticalAlignment="Center"
                Label="Cursor">
              <TextBox
                  MinWidth="96"
                  FontFamily="{DynamicResource ShellDataFontFamily}"
                  Text="{Binding TerminalSettingsEditor.Cursor}"
                  LostFocus="OnTerminalAppearanceChanged"
                  KeyDown="OnCommitKeyDown"
                  AutomationProperties.Name="Terminal cursor color" />

            </controls:LabeledField>
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Classes="IconButton"
                Tag="Cursor"
                Click="OnPickColorClick"
                ToolTip.Tip="Sample a color from the window"
                AutomationProperties.Name="Sample the terminal cursor color from the window">
              <icons:SymbolIcon Symbol="Eyedropper" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </Grid>
        </controls:SurfaceCard>
        <controls:SurfaceCard Tone="Raised" Grid.Row="1" Grid.Column="1">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <ColorPicker
                Classes="Swatch"
                Color="{Binding TerminalSettingsEditor.SelectionColor, Mode=TwoWay}"
                ColorChanged="OnColorChanged"
                AutomationProperties.Name="Pick the terminal selection color" />
            <controls:LabeledField Grid.Column="1" VerticalAlignment="Center"
                Label="Selection">
              <TextBox
                  MinWidth="96"
                  FontFamily="{DynamicResource ShellDataFontFamily}"
                  Text="{Binding TerminalSettingsEditor.Selection}"
                  LostFocus="OnTerminalAppearanceChanged"
                  KeyDown="OnCommitKeyDown"
                  AutomationProperties.Name="Terminal selection color" />

            </controls:LabeledField>
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Classes="IconButton"
                Tag="Selection"
                Click="OnPickColorClick"
                ToolTip.Tip="Sample a color from the window"
                AutomationProperties.Name="Sample the terminal selection color from the window">
              <icons:SymbolIcon Symbol="Eyedropper" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </Grid>
        </controls:SurfaceCard>
      </Grid>
      <controls:LiveRegionTextBlock
          Classes="Muted"
          AutomationProperties.Name="Terminal contrast status"
          AutomationProperties.LiveSetting="Polite"
          IsVisible="{Binding TerminalSettingsEditor.HasContrastWarning}"
          Text="{Binding TerminalSettingsEditor.ContrastWarning}"
          TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Accent"
          Description="Where the interface accent comes from." />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <controls:SurfaceCard Tone="Raised">
          <controls:LabeledField
              Label="Source">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
              <ComboBox
                  x:Name="AccentModePicker"
                  SelectionChanged="OnAccentModeSelectionChanged"
                  AutomationProperties.Name="Accent mode">
                <ComboBoxItem Content="Follow System" />
                <ComboBoxItem Content="Asura Orange" />
                <ComboBoxItem Content="Custom" />
              </ComboBox>
              <Border
                  Grid.Column="1"
                  Width="30"
                  Height="30"
                  VerticalAlignment="Center"
                  Classes="Swatch"
                  Background="{DynamicResource ShellAccentBrush}" />
            </Grid>

          </controls:LabeledField>
        </controls:SurfaceCard>
        <controls:SurfaceCard Tone="Raised" Grid.Column="1">
          <controls:LabeledField
              Label="Custom color">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <ColorPicker
                  x:Name="CustomAccentPicker"
                  Classes="Swatch"
                  ColorChanged="OnCustomAccentPicked"
                  AutomationProperties.Name="Pick a custom accent color" />
              <TextBox
                  x:Name="CustomAccentText"
                  Grid.Column="1"
                  TextChanged="OnCustomAccentTextChanged"
                  LostFocus="OnAppearanceChanged"
                  KeyDown="OnCommitKeyDown"
                  AutomationProperties.Name="Custom accent color" />
              <Button
                  x:Name="CustomAccentEyedropper"
                  Grid.Column="2"
                  Classes="IconButton"
                  Tag="Accent"
                  Click="OnPickColorClick"
                  ToolTip.Tip="Sample a color from the screen"
                  AutomationProperties.Name="Sample the accent color from the screen">
                <icons:SymbolIcon Symbol="Eyedropper" FontSize="{DynamicResource ShellIconSizeSm}" />
              </Button>
            </Grid>
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Applies only when the source is Custom." />


            </StackPanel>
</controls:LabeledField>
        </controls:SurfaceCard>
      </Grid>
    </StackPanel>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Font"
          Description="The terminal profile's typeface, size, and line height." />
      <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <controls:SurfaceCard Tone="Raised">
          <controls:LabeledField
              Label="Family">
            <ComboBox
                ItemsSource="{Binding TerminalSettingsEditor.FontFamilies}"
                SelectedItem="{Binding TerminalSettingsEditor.FontFamily, Mode=TwoWay}"
                SelectionChanged="OnTerminalAppearanceChanged"
                AutomationProperties.Name="Terminal font family" />

          </controls:LabeledField>
        </controls:SurfaceCard>
        <controls:SurfaceCard Tone="Raised" Grid.Column="1">
          <controls:LabeledField
              Label="Size">
            <NumericUpDown
                Minimum="6"
                Maximum="72"
                Increment="1"
                FormatString="0"
                Value="{Binding TerminalSettingsEditor.FontSize, Mode=TwoWay}"
                ValueChanged="OnTerminalAppearanceChanged"
                AutomationProperties.Name="Terminal font size" />

          </controls:LabeledField>
        </controls:SurfaceCard>
        <!-- Labeled like Family and Size beside it. The interface is written
             in English, so its numbers are too: "1.40" with the invariant
             culture, as the Scrollback and Timeout fields group "100,000",
             whatever the region's number format. -->
        <controls:SurfaceCard Tone="Raised" Grid.Column="2">
          <controls:LabeledField
              Label="Line height">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <Slider
                  VerticalAlignment="Center"
                  Minimum="1"
                  Maximum="2"
                  TickFrequency="0.01"
                  IsSnapToTickEnabled="True"
                  Value="{Binding TerminalSettingsEditor.LineHeight, Mode=TwoWay}"
                  ValueChanged="OnTerminalAppearanceChanged"
                  AutomationProperties.Name="Terminal line height" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding TerminalSettingsEditor.LineHeightText}" />
            </Grid>
          </controls:LabeledField>
        </controls:SurfaceCard>
      </Grid>
    </StackPanel>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Typography"
          Description="Scale application text across every Asura window." />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <!-- The terminal's font is set once, in Font above. -->
        <controls:SurfaceCard Tone="Raised">
          <controls:LabeledField
              Label="Application text size"
              Hint="Follow System uses the system’s text size. Changes apply right away.">
            <ComboBox
                x:Name="ApplicationTextScalePicker"
                SelectionChanged="OnAppearanceChanged"
                AutomationProperties.Name="Application text size">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pages:AppearanceTextScaleOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:LabeledField>
        </controls:SurfaceCard>
      </Grid>
    </StackPanel>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Corners &amp; UI"
          Description="Window corners, density, and interface behavior." />
      <!-- Every on/off choice here is one shape: a checkbox naming the
           option, its description under the words. The cursor's settings
           moved to the Terminal page, beside the rest of the cursor. -->
      <controls:SettingsGroup ControlWidth="300">
        <controls:SettingRow
            Label="Density"
            Description="Padding, spacing, and corner rounding across the interface.">
          <!-- Compact, Normal, Spacious: the segment order is the
               InterfaceDensity order, Compact first. -->
          <controls:SegmentedControl
              x:Name="DensityPicker"
              AutomationProperties.Name="Density">
            <RadioButton Content="Compact" AutomationProperties.Name="Compact density" />
            <RadioButton Content="Normal" AutomationProperties.Name="Normal density" />
            <RadioButton Content="Spacious" AutomationProperties.Name="Spacious density" />
          </controls:SegmentedControl>
        </controls:SettingRow>
        <controls:SettingRow
            Label="Translucency"
            Description="Show the desktop through the window’s sidebars and title bar.">
          <ToggleSwitch
              x:Name="TranslucencyToggle"
              IsCheckedChanged="OnAppearanceChanged"
              AutomationProperties.Name="Translucency" />
        </controls:SettingRow>
        <controls:SettingRow
            Label="Glass panels"
            Description="Let the desktop show through the panels too, not only the sidebars and title bar.">
          <ToggleSwitch
              x:Name="GlassPanelsToggle"
              IsEnabled="{Binding #TranslucencyToggle.IsChecked}"
              IsCheckedChanged="OnAppearanceChanged"
              AutomationProperties.Name="Glass panels" />
        </controls:SettingRow>
        <controls:SettingRow
            Label="Set background opacity"
            Description="Off leaves the material’s own translucency alone. On paints the window’s color over it: lower values let more of the desktop through; at full, it reads as a frame around the panels rather than as glass.">
          <ToggleSwitch
              x:Name="OverrideOpacityToggle"
              IsEnabled="{Binding #TranslucencyToggle.IsChecked}"
              IsCheckedChanged="OnAppearanceChanged"
              AutomationProperties.Name="Override background opacity" />
        </controls:SettingRow>
        <controls:SettingRow Label="Background opacity">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <Slider
                x:Name="BackdropOpacitySlider"
                VerticalAlignment="Center"
                IsEnabled="{Binding #OverrideOpacityToggle.IsChecked}"
                ValueChanged="OnAppearanceChanged"
                Minimum="40"
                Maximum="100"
                TickFrequency="2"
                IsSnapToTickEnabled="True"
                AutomationProperties.Name="Background opacity" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding #BackdropOpacitySlider.Value, StringFormat={}{0:0}%}" />
          </Grid>
        </controls:SettingRow>
        <!-- Terminal output is content and stays opaque unless asked. The
             box is dimmed, with the reason under it, wherever the window
             has no material to show: translucency off, Reduce Transparency,
             Increase Contrast, or a host without it. -->
        <controls:SettingRow
            Label="Translucent terminal background"
            Description="{DynamicResource ShellTerminalTranslucencyStatus}">
          <ToggleSwitch
              x:Name="TranslucentTerminalToggle"
              IsEnabled="{DynamicResource ShellTerminalTranslucencyAvailable}"
              IsCheckedChanged="OnAppearanceChanged"
              AutomationProperties.Name="Translucent terminal background" />
        </controls:SettingRow>
        <controls:SettingRow Label="Show tab bar" IsLast="True">
          <ToggleSwitch x:Name="ShowTabBarSwitch" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Show tab bar" />
        </controls:SettingRow>
      </controls:SettingsGroup>
    </StackPanel>

    <!-- Tabs & Workspaces -->
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Tabs &amp; Workspaces"
          Description="Where the tab strip sits, plus how the workspaces panel is arranged." />
      <controls:SettingsGroup>
        <controls:SettingRow Label="Show workspaces panel" IsLast="True">
          <ToggleSwitch x:Name="ShowWorkspacesPanelSwitch" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Show workspaces panel" />
        </controls:SettingRow>
      </controls:SettingsGroup>
      <controls:SurfaceCard Tone="Raised">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <StackPanel Classes="CardText" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Classes="Headline" Text="Tab placement" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Where the tab strip sits" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <RadioButton x:Name="TabPlacementTop" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Tab strip at the top">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="22" Height="7" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="16" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="16" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Top" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabPlacementBottom" Grid.Column="1" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Tab strip at the bottom">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="22" Height="7" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="16" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="16" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Bottom" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabPlacementLeft" Grid.Column="2" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Tab strip on the left">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel HorizontalAlignment="Left" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="26" Height="7" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="26" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="26" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Left" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabPlacementRight" Grid.Column="3" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Tab strip on the right">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel HorizontalAlignment="Right" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="26" Height="7" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="26" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="26" Height="7" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Right" />
              </StackPanel>
            </RadioButton>
          </Grid>
        </StackPanel>
      </controls:SurfaceCard>
      <controls:SurfaceCard Tone="Raised">
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <StackPanel Classes="CardText" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Classes="Headline" Text="Workspaces panel placement" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Which edge the workspaces panel sits on" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <RadioButton x:Name="WorkspacePanelLeft" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Workspaces panel on the left">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel HorizontalAlignment="Left" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="8" Height="8" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="8" Height="8" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="8" Height="8" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Left" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="WorkspacePanelRight" Grid.Column="1" Width="NaN" HorizontalAlignment="Stretch" Classes="PresetCard" IsCheckedChanged="OnAppearanceChanged" AutomationProperties.Name="Workspaces panel on the right">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Xs}">
                  <StackPanel HorizontalAlignment="Right" Spacing="{DynamicResource ShellSpaceXs}">
                    <Border Width="8" Height="8" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="8" Height="8" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                    <Border Width="8" Height="8" Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
                  </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Classes="PresetName" Text="Right" />
              </StackPanel>
            </RadioButton>
          </Grid>
        </StackPanel>
      </controls:SurfaceCard>
    </StackPanel>

    <!-- Preview -->
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Preview"
          Description="The saved profile as the shell renders it right now." />
      <controls:SurfaceCard Tone="Raised">
        <Border
            Height="168"
            Background="{DynamicResource ShellBackgroundBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellCardCornerRadius}"
            ClipToBounds="True">
          <Grid RowDefinitions="34,*">
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Margin="{controls:Inset Horizontal=Md}" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <Border Width="9" Height="9" Background="{DynamicResource ShellMutedBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}" Opacity="0.5" />
                <Border Width="9" Height="9" Background="{DynamicResource ShellMutedBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}" Opacity="0.5" />
                <Border Width="9" Height="9" Background="{DynamicResource ShellMutedBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}" Opacity="0.5" />
                <TextBlock Margin="{controls:Inset Left=Sm}" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" FontWeight="SemiBold" Text="Asura" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="112,*">
              <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                  <Border Background="{DynamicResource ShellSurfaceHoverBrush}" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Sm}">
                    <TextBlock FontSize="{DynamicResource ShellSecondaryFontSize}" FontWeight="SemiBold" Text="Home" />
                  </Border>
                  <Border Padding="{controls:Inset Sm}"><TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Screens" /></Border>
                  <Border Padding="{controls:Inset Sm}"><TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Settings" /></Border>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1" Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="Bold" Text="Saved Connections" />
                <Border Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellCardCornerRadius}" Padding="{controls:Inset Horizontal=Md, Vertical=Sm}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                      <Border Width="7" Height="7" VerticalAlignment="Center" Background="{DynamicResource ShellSuccessBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}" />
                      <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="production-api" />
                    </StackPanel>
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="deploy@10.0.1.42" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <Border Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Horizontal=Md, Vertical=Xs}">
                    <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentForegroundBrush}" Text="New Tab" />
                  </Border>
                  <Border Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" Padding="{controls:Inset Horizontal=Md, Vertical=Xs}">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Cancel" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </controls:SurfaceCard>
    </StackPanel>

    <!-- Stored profile -->
    <controls:SurfaceCard>
      <!-- The validation line runs the card's full width under both
           columns: beside the buttons, an unwrapped warning took the whole
           width and squeezed the saved profile's details out of view. -->
      <Grid
          ColumnDefinitions="*,Auto"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="{DynamicResource ShellSpaceLg}"
          RowSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="SectionHeading" Text="Saved appearance" />
          <TextBlock Text="{Binding ThemeMode, StringFormat={}Mode: {0}}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ThemeProfile, StringFormat={}Platform: {0}}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ThemeTextScale, StringFormat={}Text size: {0}}" />
          <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{DynamicResource ShellAppearanceStatus}" AutomationProperties.Name="Effective appearance status" AutomationProperties.LiveSetting="Polite" />
          <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{DynamicResource ShellAccentStatus}" AutomationProperties.Name="Effective accent status" AutomationProperties.LiveSetting="Polite" />
          <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{DynamicResource ShellMaterialStatus}" AutomationProperties.Name="Effective material status" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="{DynamicResource ShellSpaceSm}">
          <Button Classes="SecondaryButton" Click="OnImportClick" Content="Import…" />
          <Button Classes="SecondaryButton" Click="OnExportClick" Content="Export…" />
          <Button Classes="DestructiveButton" Click="OnResetClick" Content="Reset App Defaults" AutomationProperties.Name="Reset application appearance to defaults" />
          <Button Classes="DestructiveButton" Click="OnCancelClick" Content="Discard Changes" IsVisible="{Binding CanRetryAppearanceSave}" AutomationProperties.Name="Discard unsaved appearance changes" />
          <Button Classes="PrimaryButton" Click="OnApplyClick" Content="Try Again" IsVisible="{Binding CanRetryAppearanceSave}" AutomationProperties.Name="Retry saving appearance changes" />
        </StackPanel>
        <controls:LiveRegionTextBlock
            x:Name="AppearanceValidationStatus"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            AutomationProperties.Name="Appearance validation status"
            AutomationProperties.LiveSetting="Polite"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            TextWrapping="Wrap"
            IsVisible="False" />
      </Grid>
    </controls:SurfaceCard>
  </StackPanel>
</UserControl>
