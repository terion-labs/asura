<UserControl
    x:Class="Asura.App.Views.SettingsPages.NetworkingSettingsPageView"
    x:DataType="vm:NetworkSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:core="using:Asura.Core"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia">
  <!--
    Two things live here: the route the application uses unless a workspace
    says otherwise, and the connections any route can be built from. Editing a
    connection is a dialog, like every other definition editor, so the page
    stays a page.
  -->
  <StackPanel Spacing="{DynamicResource ShellSpaceXl}">
      <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
    <components:SettingsPageHeader
        Heading="Networking"
        Description="Route application and workspace traffic through reusable proxy or VPN connections." />

    <controls:SettingsGroup
        Heading="Application default"
        Description="Workspaces follow this route unless their own settings replace it."
        ControlWidth="320">
      <controls:SettingRow
          Label="Use a network connection"
          Description="Off connects directly and keeps the chosen connection for later.">
        <ToggleSwitch
            IsChecked="{Binding Policy.IsEnabled, Mode=TwoWay}"
            IsEnabled="{Binding Policy.CanEnable}"
            AutomationProperties.Name="Use an application network connection" />
      </controls:SettingRow>
      <controls:SettingRow
          Label="Active connection"
          Description="Used by application traffic and by every workspace that follows the default.">
        <ComboBox
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Policy.AvailableConnections}"
            SelectedItem="{Binding Policy.SelectedConnection, Mode=TwoWay}"
            IsEnabled="{Binding Policy.HasAvailableConnections}"
            AutomationProperties.Name="Application network connection">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NetworkPolicyConnectionOptionViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="MiddleTruncated" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding KindLabel}" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:SettingRow>
      <controls:SettingRow
          IsLeading="True"
          Label="Kill switch"
          Description="Block Asura-routed traffic when the connection fails instead of falling back to a direct route. Programs that ignore proxy settings aren’t held back; isolate a workspace when every process must be.">
        <CheckBox
            IsChecked="{Binding Policy.KillSwitchEnabled, Mode=TwoWay}"
            AutomationProperties.Name="Application network kill switch" />
      </controls:SettingRow>
      <!-- Every choice here applies as it is made. A route that can't apply
           yet says why under it rather than waiting behind a Save button. -->
      <controls:SettingsGroup.Footer>
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <controls:LiveRegionTextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="{Binding Policy.Summary}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Application network route" />
          <Grid
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{DynamicResource ShellSpaceXs}"
              IsVisible="{Binding HasPolicyValidationMessage}">
            <icons:SymbolIcon
                VerticalAlignment="Top"
                Symbol="ErrorCircle"
                FontSize="{DynamicResource ShellFontSize11}"
                Foreground="{DynamicResource ShellDangerBrush}" />
            <controls:LiveRegionTextBlock
                Grid.Column="1"
                Foreground="{DynamicResource ShellDangerBrush}"
                FontSize="{DynamicResource ShellSecondaryFontSize}"
                Text="{Binding PolicyValidationMessage}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Application network route problem" />
          </Grid>
        </StackPanel>
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>

    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:SectionHeader
          Heading="Network connections"
          Description="{Binding Source={x:Static core:PlatformTerms.SecretStore}, StringFormat={}Saved proxy and VPN connections. Credentials stay in {0}.}" />

      <Border IsVisible="{Binding !HasError}">
      <controls:Callout
          Tone="Notice"
          ShowsGlyph="False"
          Text="{Binding OperationStatus}"
          Classes.Warning="{Binding HasError}"
          IsVisible="{Binding HasOperationStatus}" />
      </Border>

      <controls:Callout
          Tone="Notice"
          Glyph="ArrowRouting"
          Title="No network connections yet"
          Text="Create a proxy or VPN connection, then choose it as the application default or offer it to a workspace."
          IsVisible="{Binding HasNoProfiles}" />

      <!-- The Mac list pattern: select a connection, then – below the
           list, its context menu, or Delete removes it; + adds one. -->
      <controls:SurfaceCard Padding="0" ClipsContent="True" IsVisible="{Binding HasProfiles}">
        <ListBox
            x:Name="ProfileList"
            Classes="Rows"
            ItemsSource="{Binding Profiles}"
            AutomationProperties.Name="Network connections">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NetworkConnectionProfileItemViewModel">
              <controls:ListItem ContentPadding="{DynamicResource ShellListRowPadding}" Title="{Binding Name}" Detail="{Binding Summary}">
                <controls:ListItem.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Edit…" Click="OnEditProfileClick" />
                    <MenuItem Header="Delete…" Click="OnDeleteProfileClick" />
                  </ContextMenu>
                </controls:ListItem.ContextMenu>
                <controls:ListItem.Leading>
                  <controls:IdentityTile
                      TileSize="Small"
                      Tint="{DynamicResource ShellSurfaceHoverBrush}"
                      Foreground="{DynamicResource ShellTextBrush}"
                      Symbol="{Binding KindSymbol}" />
                </controls:ListItem.Leading>
                <controls:ListItem.Trailing>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                    <controls:StatusChip Shape="Rounded" Tone="Default" Content="{Binding KindLabel}" />
                    <Button
                        Classes="SecondaryButton"
                        Click="OnEditProfileClick"
                        Content="Edit…"
                        AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}" />
                  </StackPanel>
                </controls:ListItem.Trailing>
              </controls:ListItem>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </controls:SurfaceCard>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
        <Button
            x:Name="AddProfileButton"
            Classes="IconButton"
            Click="OnAddProfileClick"
            ToolTip.Tip="New connection…"
            AutomationProperties.Name="Create a network connection">
          <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Button
            x:Name="DeleteProfileButton"
            Classes="IconButton"
            Click="OnDeleteProfileClick"
            IsEnabled="False"
            ToolTip.Tip="Delete connection…"
            AutomationProperties.Name="Delete selected network connection">
          <icons:SymbolIcon Symbol="Subtract" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
