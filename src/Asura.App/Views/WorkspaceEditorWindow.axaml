<views:EditorWindow
    x:Class="Asura.App.Views.WorkspaceEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    Title="Edit Workspace"
    Width="980"
    Height="680"
    Background="{DynamicResource ShellBackgroundBrush}">
  <!--
    The workspace editor, in a window beside the workspace rather than an
    overlay that blacked it out. Its content is the main window's
    WorkspaceEditorView, handed over on show; the title names the workspace.
  -->
</views:EditorWindow>
