<controls:DialogWindow
    x:Class="Asura.App.Views.DefinitionImportPreflightDialog"
    x:DataType="views:DefinitionImportPreflightDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:application="using:Asura.Application"
    Width="680"
    MaxHeight="720"
    SizeToContent="Height"
    CanResize="False">
  <controls:DialogShell
      Title="Review Definition Import"
      Subtitle="Preflight is complete. Nothing has been imported yet."
      FooterHint="{Binding CommitHint}"
      Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button x:Name="ImportButton" MinWidth="88" Classes="PrimaryButton" Click="OnImportClick" Content="Import Definitions" IsDefault="True" IsEnabled="{Binding CanApply}" />
      </StackPanel>
    </controls:DialogShell.Footer>
  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Classes="Keycap"><TextBlock Text="{Binding ModeLabel}" /></Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Muted Path" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Directory}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Summary}" />
      </Grid>
    </controls:SurfaceCard>

    <Grid Grid.Row="1" MaxHeight="{Binding IssuesMaximumHeight}">
      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding HasNoIssues}">
        <TextBlock Text="No conflicts or compatibility issues were found." />
      </controls:SurfaceCard>
      <ScrollViewer IsVisible="{Binding HasIssues}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <Border Classes="Keycap"><TextBlock Text="{Binding Label}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Message}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </controls:SurfaceCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" IsVisible="{Binding HasExecutionReview}" Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock FontWeight="SemiBold" Text="Executable content and connection authority" />
      <ListBox ItemsSource="{Binding ExecutionReview}" MaxHeight="220">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="application:DefinitionExecutionReviewItem">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBox Text="{Binding Details}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" TextWrapping="Wrap" AutomationProperties.Name="{Binding Heading}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <CheckBox x:Name="ExecutionAcknowledgement" IsChecked="False" IsCheckedChanged="OnExecutionAcknowledged">
        <TextBlock Text="I reviewed and trust these commands, images, host mounts and connection destinations. Opening imported workspaces or panels may run code or connect using the displayed authority." TextWrapping="Wrap" />
      </CheckBox>
    </StackPanel>
  </Grid>
  </controls:DialogShell>
</controls:DialogWindow>
