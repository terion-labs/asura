<controls:DialogWindow
    x:Class="Asura.App.Views.DefinitionImportModeDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    Width="560"
    SizeToContent="Height"
    CanResize="False">
  <controls:DialogShell
      Title="Import Setup"
      Subtitle="Choose what happens to items you already have. Asura checks the file before anything changes."
      Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button MinWidth="88" Classes="PrimaryButton" Click="OnChooseFileClick" Content="Choose File…" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
        <RadioButton
            x:Name="FailOnConflictOption"
            GroupName="ImportMode"
            IsChecked="True">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock FontWeight="SemiBold" Text="Stop on conflicts" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Safest. Items you already have are never replaced." />
          </StackPanel>
        </RadioButton>
      </controls:SurfaceCard>
      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}">
        <RadioButton
            x:Name="ReplaceExistingOption"
            GroupName="ImportMode">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock FontWeight="SemiBold" Text="Replace matching items" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Items you already have are replaced by the imported ones after you review the import." TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
      </controls:SurfaceCard>
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
