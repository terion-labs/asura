<UserControl
    x:Class="Asura.App.Views.LocalArtifactControlView"
    x:DataType="vm:LocalArtifactControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <!--
    A section of the Data & Diagnostics page, drawn as every settings group
    is: the heading and its sentence above one plate, whose rows are the
    kinds of storage, separated by inset hairlines, and whose last row says
    what they add up to beside Refresh. What is never cleared here closes
    the plate as its footnote. Each kind used to be a card of its own inside
    the section's card, filled with the notice tone, so the page read as a
    stack of blue boxes.
  -->
  <StackPanel Spacing="{DynamicResource ShellSettingsGroupGap}">
    <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
    <controls:SettingsGroup
        x:Name="LocalArtifactGroup"
        Heading="App-managed cache &amp; logs"
        Description="Files Asura keeps in its own cache and log folders. The log in use isn’t listed.">
      <!-- One state at a time: loading, nothing listed, couldn't check, or
           the list. A refresh with items already listed keeps the list, and
           the summary row says it is reloading. Every state sits in the
           plate the list would fill, as the recovery section's states below
           do, so the page keeps one shape whichever state it is in. -->
      <Panel>
        <Panel>
          <Panel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsBusy" FallbackValue="False" />
              <Binding Path="!HasInventory" FallbackValue="False" />
            </MultiBinding>
          </Panel.IsVisible>
          <controls:StateOverlay
              Margin="{controls:Inset Xl}"
              Kind="Loading"
              Heading="Loading cache and log details…"
              Body="Nothing is removed while Asura checks its storage." />
        </Panel>
        <controls:StateOverlay
            Margin="{controls:Inset Xl}"
            IsVisible="{Binding HasNoInventory, FallbackValue=False}"
            Kind="Empty"
            Heading="Nothing listed yet"
            Body="Click Refresh to see what Asura has stored." />
        <controls:StateOverlay
            Margin="{controls:Inset Xl}"
            IsVisible="{Binding HasError, FallbackValue=False}"
            Kind="Retry"
            Heading="Storage couldn’t be checked"
            Body="Nothing was removed. Click Refresh to try again."
            ActionLabel="Refresh"
            ActionRequested="OnRefreshClick"
            FocusTarget="PrimaryAction" />
        <ItemsControl
            x:Name="LocalArtifactList"
            Classes="Separated StretchItems"
            ItemsSource="{Binding Items}"
            IsEnabled="{Binding CanClearItems, FallbackValue=False}"
            IsVisible="{Binding HasInventory, FallbackValue=False}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- A row of the grouped form: its title where a settings
                   row's label starts, what it holds under it, and Clear… at
                   the trailing edge. -->
              <Border
                  MinHeight="{DynamicResource ShellSettingsRowMinHeight}"
                  Padding="{DynamicResource ShellSettingsRowPadding}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                  <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSettingsLabelSpacing}">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{DynamicResource ShellSpaceMd}">
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding FileCountLabel}" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SizeLabel}" />
                    </WrapPanel>
                  </StackPanel>
                  <Button
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="DestructiveButton"
                      Click="OnClearClick"
                      Content="Clear…"
                      IsEnabled="{Binding HasFiles, FallbackValue=False}"
                      AutomationProperties.Name="{Binding ClearAutomationName}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
      <!-- What the rows add up to, and Refresh, as the plate's last row. -->
      <Border
          MinHeight="{DynamicResource ShellSettingsRowMinHeight}"
          Padding="{DynamicResource ShellSettingsRowPadding}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
          <controls:LiveRegionTextBlock
              VerticalAlignment="Center"
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="{Binding StatusMessage}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{Binding StatusAutomationName}" />
          <Button
              x:Name="RefreshLocalArtifactsButton"
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="SecondaryButton"
              Click="OnRefreshClick"
              Content="Refresh"
              IsEnabled="{Binding CanRefresh, FallbackValue=False}"
              AutomationProperties.Name="Refresh the cache and log list" />
        </Grid>
      </Border>
      <controls:SettingsGroup.Footer>
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="Saved workspaces, screens, and connections, secrets, history, recovery snapshots, terminal content, system caches, debug traces, and the log in use are never cleared here."
            TextWrapping="Wrap" />
      </controls:SettingsGroup.Footer>
    </controls:SettingsGroup>
  </StackPanel>
</UserControl>
