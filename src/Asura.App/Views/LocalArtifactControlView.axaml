<UserControl
    x:Class="Asura.App.Views.LocalArtifactControlView"
    x:DataType="vm:LocalArtifactControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <controls:SurfaceCard>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Headline" Text="App-managed cache &amp; logs" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="Files Asura keeps in its own cache and log folders. The log in use isn’t listed."
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="RefreshLocalArtifactsButton"
            Grid.Column="1"
            Classes="SecondaryButton"
            Click="OnRefreshClick"
            Content="Refresh"
            IsEnabled="{Binding CanRefresh}"
            AutomationProperties.Name="Refresh app-managed cache and log metadata" />
      </Grid>

      <controls:Callout
          Tone="Notice"
          Glyph="Shield"
          Text="Saved workspaces, screens, and connections, secrets, history, recovery snapshots, terminal content, system caches, debug traces, and the log in use are never cleared here." />

      <controls:LiveRegionTextBlock
          Classes="Muted"
          FontSize="{DynamicResource ShellSecondaryFontSize}"
          Text="{Binding StatusMessage}"
          IsVisible="{Binding !HasError}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />

      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding HasNoInventory}">
        <controls:EmptyStatePanel
            ShowsGlyph="False"
            Heading="Nothing listed yet"
            Body="Click Refresh to see what Asura has stored." />
      </controls:SurfaceCard>

      <controls:Callout
          Tone="Notice"
          ShowsGlyph="False"
          Title="Storage couldn’t be checked"
          Text="Asura couldn’t finish checking its storage. Nothing was removed. Click Refresh to try again."
          IsVisible="{Binding HasError}" />

      <ItemsControl
          ItemsSource="{Binding Items}"
          IsEnabled="{Binding CanClearItems}"
          IsVisible="{Binding HasInventory}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="{Binding Description}"
                      TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Margin="{controls:Inset Right=Md}" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding FileCountLabel}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SizeLabel}" />
                  </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="DestructiveButton"
                    Click="OnClearClick"
                    Content="Clear…"
                    IsEnabled="{Binding HasFiles}"
                    AutomationProperties.Name="{Binding ClearAutomationName}" />
              </Grid>
            </controls:SurfaceCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
