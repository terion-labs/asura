<UserControl
    x:Class="Asura.App.Views.LocalArtifactControlView"
    x:DataType="vm:LocalArtifactControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <!--
    A section of the Data & Diagnostics page, drawn as a settings group is:
    the heading and its sentence on the page, then one card whose rows are
    the kinds of storage, separated by hairlines, with the total as the
    card's footer. Each kind used to be a card of its own inside the
    section's card, filled with the notice tone, so the page read as a stack
    of blue boxes.
  -->
  <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
    <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock Classes="Headline" Text="App-managed cache &amp; logs" AutomationProperties.HeadingLevel="2" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="Files Asura keeps in its own cache and log folders. The log in use isn’t listed."
            TextWrapping="Wrap" />
      </StackPanel>
      <Button
          x:Name="RefreshLocalArtifactsButton"
          Grid.Column="1"
          VerticalAlignment="Center"
          Classes="SecondaryButton"
          Click="OnRefreshClick"
          Content="Refresh"
          IsEnabled="{Binding CanRefresh, FallbackValue=False}"
          AutomationProperties.Name="Refresh the cache and log list" />
    </Grid>

    <controls:Callout
        Tone="Notice"
        Glyph="Shield"
        Text="Saved workspaces, screens, and connections, secrets, history, recovery snapshots, terminal content, system caches, debug traces, and the log in use are never cleared here." />

    <!-- One state at a time: loading, nothing listed, couldn't check, or
         the list with its summary line. A refresh with items already
         listed keeps the list, and the summary line says it is reloading.
         Every state sits in the card the list would fill, as the recovery
         section's states below do, so the page keeps one shape whichever
         state it is in. -->
    <controls:SurfaceCard Padding="0">
      <controls:SurfaceCard.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsBusy" FallbackValue="False" />
          <Binding Path="!HasInventory" FallbackValue="False" />
        </MultiBinding>
      </controls:SurfaceCard.IsVisible>
      <controls:StateOverlay
          Margin="{controls:Inset Xl}"
          Kind="Loading"
          Heading="Loading cache and log details…"
          Body="Nothing is removed while Asura checks its storage." />
    </controls:SurfaceCard>

    <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoInventory, FallbackValue=False}">
      <controls:StateOverlay
          Margin="{controls:Inset Xl}"
          Kind="Empty"
          Heading="Nothing listed yet"
          Body="Click Refresh to see what Asura has stored." />
    </controls:SurfaceCard>

    <controls:SurfaceCard Padding="0" IsVisible="{Binding HasError, FallbackValue=False}">
      <controls:StateOverlay
          Margin="{controls:Inset Xl}"
          Kind="Retry"
          Heading="Storage couldn’t be checked"
          Body="Nothing was removed. Click Refresh to try again."
          ActionLabel="Refresh"
          ActionRequested="OnRefreshClick"
          FocusTarget="PrimaryAction" />
    </controls:SurfaceCard>

    <controls:SurfaceCard
        x:Name="LocalArtifactList"
        Padding="0"
        ClipsContent="True"
        IsVisible="{Binding HasInventory, FallbackValue=False}">
      <StackPanel>
        <ItemsControl
            Classes="Separated StretchItems"
            ItemsSource="{Binding Items}"
            IsEnabled="{Binding CanClearItems, FallbackValue=False}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- A grouped row: the list row's inset inside the step every
                   settings card keeps from its edge, so its title starts
                   where a settings row's label starts. -->
              <Grid Margin="{DynamicResource ShellInsetXs}">
                <Grid Margin="{DynamicResource ShellListRowPadding}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                  <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{DynamicResource ShellSpaceMd}">
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding FileCountLabel}" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SizeLabel}" />
                    </WrapPanel>
                  </StackPanel>
                  <Button
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="DestructiveButton"
                      Click="OnClearClick"
                      Content="Clear…"
                      IsEnabled="{Binding HasFiles, FallbackValue=False}"
                      AutomationProperties.Name="{Binding ClearAutomationName}" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Background="{DynamicResource ShellBorderBrush}" />
        <controls:LiveRegionTextBlock
            Margin="{DynamicResource ShellListRowPadding}"
            Padding="{controls:Inset Horizontal=Xs}"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StatusMessage}"
            TextWrapping="Wrap"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding StatusAutomationName}" />
      </StackPanel>
    </controls:SurfaceCard>
  </StackPanel>
</UserControl>
