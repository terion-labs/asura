<UserControl
    x:Class="Asura.App.Views.AgentWorkspaceView"
    x:DataType="vm:IAgentWorkspaceHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:application="using:Asura.Application"
    xmlns:core="using:Asura.Core"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:views="using:Asura.App.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <DataTemplate x:Key="MessageSecretControl" x:DataType="vm:AgentChatMessageViewModel">
      <Button Classes="IconButton" Click="OnToggleAgentMessageSecretsClick"
          ToolTip.Tip="{Binding SecretDisclosureExplanation}"
          AutomationProperties.Name="{Binding SecretDisclosureExplanation}">
        <Grid>
          <icons:SymbolIcon Symbol="LockClosed" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding !ExposeSecretsOnNextRequest}" />
          <!-- Fluent UI ic_fluent_lock_open_12_regular from microsoft/fluentui-system-icons. -->
          <Path Width="12" Height="12" Stretch="Uniform"
              IsVisible="{Binding ExposeSecretsOnNextRequest}"
              Fill="{DynamicResource ShellAccentBrush}"
              Data="M9.5 0C10.8807 0 12 1.11929 12 2.5V3C12 3.27614 11.7761 3.5 11.5 3.5C11.2239 3.5 11 3.27614 11 3V2.5C11 1.67157 10.3284 1 9.5 1C8.67157 1 8 1.67157 8 2.5V4C9.10457 4 10 4.89543 10 6V9C10 10.1046 9.10457 11 8 11H4C2.89543 11 2 10.1046 2 9V6C2 4.89543 2.89543 4 4 4H7V2.5C7 1.11929 8.11929 0 9.5 0ZM4 5C3.44772 5 3 5.44772 3 6V9C3 9.55228 3.44772 10 4 10H8C8.55228 10 9 9.55228 9 9V6C9 5.44772 8.55228 5 8 5H4ZM6 6.75C6.41421 6.75 6.75 7.08579 6.75 7.5C6.75 7.91421 6.41421 8.25 6 8.25C5.58579 8.25 5.25 7.91421 5.25 7.5C5.25 7.08579 5.58579 6.75 6 6.75Z" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- A file dragged over the composer lights the composer itself, so
         the place it will land is the place that reacts. -->
    <!-- The resting border is a style, not a local value, so the drop
         target style below can replace it. -->
    <Style Selector="Border#AgentComposer">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    </Style>
    <!-- The raw-secrets help dims with its checkbox, as one option. -->
    <Style Selector="TextBlock#AgentSendRawSecretsHelp:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border#AgentComposer.dropTarget">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShellFocusRingShadow}" />
    </Style>
    <!-- Sized for 13 pt text and grown with the text-size setting, so a
         label or glyph at 200% still fits rather than clipping. -->
    <Style Selector="Button.ComposerControl">
      <Setter Property="MinHeight" Value="{controls:TextScaled 32}" />
      <Setter Property="Margin" Value="{controls:Inset Right=Xs}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="Button.ComposerControl /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ComposerControl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.ComposerControl:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Button.ComposerControl:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The model menu's list reads as menu rows on the popover's own
         surface rather than as a framed list box set into it. -->
    <Style Selector="ListBox.AgentModelList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.AgentModelList ListBoxItem">
      <Setter Property="MinHeight" Value="{controls:TextScaled 44}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    </Style>
    <Style Selector="Button.ComposerSelector">
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ComposerAction">
      <Setter Property="MinWidth" Value="{controls:TextScaled 34}" />
      <Setter Property="Margin" Value="{controls:Inset Left=Xs}" />
      <Setter Property="MinHeight" Value="{controls:TextScaled 34}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellPillCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A live run is visible from every surface hosting the shared agent
         panel. The ordinary icon remains beneath this accent copy, so the
         five-second opacity cycle reads as a slow colour pulse rather than a
         blinking status light. Reduce Motion holds the accent copy at full
         strength instead (the still form lives with the shell's other motion
         rules in DesignSystem.axaml). -->
    <Style Selector="Window:not(.motion-disabled) icons|SymbolIcon.AgentActivityPulse.running">
      <Style.Animations>
        <Animation Duration="0:0:5" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Grid.agentQueueRow Border.queueDropBefore">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.agentQueueRow Border.queueDropAfter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.agentQueueRow.queueDropBefore Border.queueDropBefore">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid.agentQueueRow.queueDropAfter Border.queueDropAfter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The ordinary workspace uses this grip only while floating. An
         edge-resizable host also exposes it while docked because its layout
         spacer follows the Agent surface's live width. -->
    <Style Selector="views|AgentWorkspaceView Thumb#FloatingResizeHandle">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.floating Thumb#FloatingResizeHandle">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Quick Terminal hosts this same surface as an edge-attached drawer.
         Its resize affordance is therefore the full inner edge, not the
         diagonal corner used by the main workspace flyout. -->
    <Style Selector="views|AgentWorkspaceView.edgeResizable Thumb#FloatingResizeHandle">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="{DynamicResource ShellSpaceSm}" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.edgeResizable.edgeRight Thumb#FloatingResizeHandle">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="{controls:Inset Left=Sm, Scale=-1}" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.edgeResizable.edgeLeft Thumb#FloatingResizeHandle">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="{controls:Inset Right=Sm, Scale=-1}" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.edgeResizable Path#CornerResizeGlyph">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|AgentWorkspaceView Thumb#FloatingHeightResizeHandle">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ZIndex" Value="20" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.floating.edgeResizable Thumb#FloatingHeightResizeHandle">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.anchorBottom Thumb#FloatingHeightResizeHandle">
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.anchorTop Thumb#FloatingHeightResizeHandle">
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <!-- The live blur exists only while the panel floats: docked, the panel
         sits beside the canvas rather than over it, and there is nothing
         beneath to blur. -->
    <Style Selector="views|AgentWorkspaceView controls|BlurBehindSurface#FlyoutBackdrop">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|AgentWorkspaceView.floating controls|BlurBehindSurface#FlyoutBackdrop">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="views|AgentWorkspaceView controls|BlurBehindSurface#FlyoutBackdrop">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
    </Style>
    <!-- Reasoning is part of the transcript, not a card inside the transcript.
         This deliberately replaces Fluent's filled expander chrome with one
         quiet disclosure row; the body is carried by a single timeline rule. -->
    <Style Selector="ToggleButton.ReasoningTraceDisclosure">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{controls:TextScaled 32}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs, Vertical=Xs}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.ReasoningTraceDisclosure:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.ReasoningTraceDisclosure:focus-visible /template/ Border">
      <Setter Property="BoxShadow" Value="{DynamicResource ShellFocusRingShadow}" />
    </Style>
    <!-- A checkbox's explanation dims with its checkbox, as a disabled
         control's own label does. -->
    <Style Selector="TextBlock.dimmed">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
  </UserControl.Styles>
  <!--
    Keep the agent surface free of AutomationProperties.LiveSetting. Its one
    status region lives in WorkspaceView, outside the panel, so events are
    heard while the panel is hidden. Avalonia 12.0.5's macOS bridge can raise a native
    live-region notification with a nil announcement while streaming controls
    are updated or detached, which terminates the process. Stable names, help
    text, and keyboard focus remain available to assistive technology without
    that unsafe native callback.
  -->
  <Panel ClipToBounds="False">
  <!-- The floating panel's backdrop: whatever the window has already painted
       beneath it, blurred live on every frame by the compositor itself.
       Nothing is captured ahead of time, so scrolling or streaming content
       under the flyout stays current and can never mis-align. -->
  <controls:BlurBehindSurface
      x:Name="FlyoutBackdrop"
      IsHitTestVisible="False"
      BaseBrush="{DynamicResource ShellBackgroundBrush}" />
  <Border Classes="AgentPanel">
    <!--
      Four bands, and each one owns a different kind of thing: who the panel is and
      how it is doing, the conversation, what you say next, and the settings that
      shape the next run. The provider and
      scope pickers used to sit in a labelled form directly under the heading, where
      three competing idioms fought for the top of a narrow panel; they are chips in
      the footer now, beside the run status they describe.
    -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <Grid MinHeight="44" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Grid VerticalAlignment="Center">
          <icons:SymbolIcon
              Symbol="Bot"
              FontSize="{DynamicResource ShellIconSizeMd}"
              Foreground="{DynamicResource ShellTextBrush}" />
          <icons:SymbolIcon
              x:Name="AgentActivityPulseIcon"
              Classes="AgentActivityPulse"
              Classes.running="{Binding AgentChat.IsBusy}"
              Symbol="Bot"
              FontSize="{DynamicResource ShellIconSizeMd}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Opacity="0" />
        </Grid>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="Headline"
            Text="AI Agent" />
        <controls:StatusChip
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes.Warning="{Binding AgentChat.NeedsProviderAttention}"
            Content="{Binding AgentChat.ConnectionStatus}"
            IsVisible="{Binding AgentChat, Converter={x:Static ObjectConverters.IsNotNull}}"
            AutomationProperties.Name="AI agent state" />
        <Button
            x:Name="AgentConversationHistoryButton"
            Grid.Column="3"
            Classes="IconButton"
            IsVisible="{Binding AgentChat, Converter={x:Static ObjectConverters.IsNotNull}}"
            ToolTip.Tip="Conversations"
            AutomationProperties.Name="Open saved AI conversations">
          <icons:SymbolIcon Symbol="History" FontSize="{DynamicResource ShellIconSizeSm}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="AgentConversationMenu">
              <Grid Width="380" MaxHeight="620" RowDefinitions="Auto,*,Auto">
                <Border Padding="{controls:Inset Sm}">
                  <controls:SearchField
                      PlaceholderText="Filter conversations"
                      Text="{Binding AgentChat.ConversationSearch, Mode=TwoWay}"
                      AutomationProperties.Name="Filter saved AI conversations" />
                </Border>
                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="330"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}">
                    <ItemsControl ItemsSource="{Binding AgentChat.FilteredConversations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgentConversationItemViewModel">
                          <!-- A saved conversation is deleted the macOS list way: from
                               its context menu, or with Delete on the focused row. A red
                               trash on every row made the destructive action the loudest
                               thing in the list. -->
                          <Button
                              MinHeight="48"
                              Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Classes="FlyoutMenuItem"
                              Classes.current="{Binding IsCurrent}"
                              Click="OnOpenConversationClick"
                              KeyDown="OnConversationRowKeyDown"
                              Tag="{Binding RunId}"
                              IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="{Binding Title, StringFormat={}Open conversation {0}}"
                              AutomationProperties.HelpText="Press Delete to delete this conversation.">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Delete Conversation…" Click="OnDeleteConversationClick" Tag="{Binding RunId}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="{controls:Inset Md}"
                        HorizontalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="No matching conversations"
                        IsVisible="{Binding AgentChat.HasNoConversationMatches}" />
                    <TextBlock
                        Margin="{controls:Inset Md}"
                        HorizontalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="No saved conversations yet"
                        IsVisible="{Binding !AgentChat.HasConversationHistory}" />
                  </StackPanel>
                </ScrollViewer>
                <Border
                    Grid.Row="2"
                    Padding="{controls:Inset Sm}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="0,1,0,0">
                  <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Classes="FlyoutMenuItem"
                        Click="OnStartNewConversationClick"
                        AutomationProperties.Name="Start a new AI conversation">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                        <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
                        <TextBlock Text="New Conversation" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- One button, two facts: pinned holds the panel in the layout,
             unpinned lets it float over the canvas. The workspace remembers
             which. -->
        <Button
            Grid.Column="5"
            VerticalAlignment="Center"
            Classes="IconButton"
            Click="OnToggleAgentPinClick"
            ToolTip.Tip="{Binding AgentPanelPinTip}"
            AutomationProperties.Name="Pin or unpin the AI agent panel">
          <Panel>
            <icons:SymbolIcon Symbol="Pin" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding !IsAgentPanelDocked}" />
            <icons:SymbolIcon Symbol="PinOff" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding IsAgentPanelDocked}" />
          </Panel>
        </Button>
      </Grid>

      <ScrollViewer
          x:Name="AgentChatTranscript"
          Grid.Row="1"
          IsVisible="{Binding AgentChat.HasAgentContent, FallbackValue=False}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          BringIntoViewOnFocusChange="False"
          ScrollChanged="OnAgentChatTranscriptScrollChanged"
          AutomationProperties.Name="AI agent activity">
        <StackPanel
            Margin="{controls:Inset Horizontal=Md}"
            Spacing="{DynamicResource ShellSpaceSm}">
          <!--
            What you said is a bubble; what the agent said is the page. Giving both
            sides a bordered bubble halved the usable width of an already narrow
            panel and made a paragraph of prose read like a stack of receipts.
          -->
          <ItemsControl
              x:Name="AgentChatMessages">
            <!-- The view supplies a bounded recent slice and prepends older
                 pages on demand. A plain stack preserves exact offsets for
                 variable-height Markdown instead of estimating row heights. -->
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentChatMessageViewModel">
                <Grid Margin="{controls:Inset Bottom=Sm}">
                  <StackPanel
                      MaxWidth="286"
                      HorizontalAlignment="Right"
                      IsVisible="{Binding IsUserMessage}"
                      AutomationProperties.Name="{Binding Author}">
                    <Border
                        Padding="{controls:Inset Sm}"
                        Background="{DynamicResource ShellAccentSoftBrush}"
                        CornerRadius="12,12,3,12">
                      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                        <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="application:AgentChatImage">
                              <components:AgentChatImagePreview Attachment="{Binding}" Margin="{controls:Inset Bottom=Xs}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Classes="Eyebrow"
                            Text="{Binding FilesLabel}"
                            IsVisible="{Binding HasFiles}" />
                        <components:MarkdownPreviewView
                            ContinuousSelection="True"
                            Text="{Binding Content}"
                            HiddenReferences="{Binding HiddenReferences}"
                            SecretRuntime="{Binding SecretRuntime}" />
                      </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="{controls:Inset Top=Xs}"
                        Spacing="{DynamicResource ShellSpaceXs}">
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageSecretControl}"
                          IsVisible="{Binding HasHiddenSecrets}" />
                      <Button
                          Classes="IconButton"
                          Click="OnCopyAgentMessageClick"
                          Tag="{Binding}"
                          IsVisible="{Binding HasMessageText}"
                          ToolTip.Tip="Copy message"
                          AutomationProperties.Name="Copy this message">
                        <icons:SymbolIcon Symbol="Copy" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel
                      HorizontalAlignment="Stretch"
                      Spacing="{DynamicResource ShellSpaceSm}"
                      IsVisible="{Binding IsAssistantMessage}"
                      AutomationProperties.Name="{Binding Author}">
                    <StackPanel
                        IsVisible="{Binding HasReasoningSummary}"
                        AutomationProperties.Name="AI reasoning summary">
                      <ToggleButton
                          x:Name="CommittedReasoningDisclosure"
                          Classes="ReasoningTraceDisclosure"
                          IsChecked="False"
                          AutomationProperties.Name="Show or hide AI reasoning summary">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                          <icons:SymbolIcon
                              VerticalAlignment="Center"
                              Symbol="BrainCircuit"
                              FontSize="{DynamicResource ShellIconSizeSm}"
                              Foreground="{DynamicResource ShellMutedBrush}" />
                          <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Classes="Muted"
                              FontSize="{DynamicResource ShellSecondaryFontSize}"
                              Text="{Binding ReasoningTitle}" />
                          <icons:SymbolIcon
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Symbol="ChevronDown"
                              FontSize="{DynamicResource ShellIconSizeSm}"
                              Foreground="{DynamicResource ShellMutedBrush}"
                              IsVisible="{Binding !IsChecked, ElementName=CommittedReasoningDisclosure}" />
                          <icons:SymbolIcon
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Symbol="ChevronUp"
                              FontSize="{DynamicResource ShellIconSizeSm}"
                              Foreground="{DynamicResource ShellMutedBrush}"
                              IsVisible="{Binding IsChecked, ElementName=CommittedReasoningDisclosure}" />
                        </Grid>
                      </ToggleButton>
                      <Border
                          Margin="{controls:Inset Top=Xs, Left=Sm}"
                          Padding="{controls:Inset Left=Md, Bottom=Xs}"
                          BorderBrush="{DynamicResource ShellBorderBrush}"
                          BorderThickness="1,0,0,0"
                          IsVisible="{Binding IsChecked, ElementName=CommittedReasoningDisclosure}">
                        <components:MarkdownPreviewView
                            ContinuousSelection="True"
                            Text="{Binding ReasoningSummaryDisplay}"
                            HiddenReferences="{Binding HiddenReferences}"
                            SecretRuntime="{Binding SecretRuntime}" />
                      </Border>
                    </StackPanel>
                    <components:MarkdownPreviewView
                        ContinuousSelection="True"
                        Text="{Binding Content}"
                            HiddenReferences="{Binding HiddenReferences}"
                            SecretRuntime="{Binding SecretRuntime}" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding UsageLabel}"
                        IsVisible="{Binding HasUsage}"
                        AutomationProperties.Name="{Binding UsageLabel, StringFormat={}AI token usage · {0}}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{DynamicResource ShellSpaceXs}">
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageSecretControl}"
                          IsVisible="{Binding HasHiddenSecrets}" />
                      <Button
                          Classes="IconButton"
                          Click="OnCopyAgentMessageClick"
                          Tag="{Binding}"
                          IsVisible="{Binding HasMessageText}"
                          ToolTip.Tip="Copy message"
                          AutomationProperties.Name="Copy this message">
                        <icons:SymbolIcon Symbol="Copy" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                      <Button
                          Classes="IconButton"
                          Click="OnForkAgentConversationClick"
                          Tag="{Binding ForkPoint}"
                          IsVisible="{Binding CanFork}"
                          ToolTip.Tip="Fork conversation here"
                          AutomationProperties.Name="Fork conversation from this message">
                        <icons:SymbolIcon Symbol="BranchFork" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                  <controls:SurfaceCard
                      x:Name="AgentQuestionAnswerBlock"
                      Tone="Notice"
                      Padding="{DynamicResource ShellCardPaddingCompact}"
                      IsVisible="{Binding IsQuestionOrAnswer}"
                      AutomationProperties.Name="{Binding QuestionAnswerLabel}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="Eyebrow"
                            Text="{Binding QuestionAnswerLabel}" />
                        <Button
                            Grid.Column="1"
                            Classes="IconButton"
                            Click="OnCopyAgentMessageClick"
                            Tag="{Binding}"
                            IsVisible="{Binding HasMessageText}"
                            ToolTip.Tip="Copy message"
                            AutomationProperties.Name="{Binding QuestionAnswerLabel, StringFormat={}Copy {0}}">
                          <icons:SymbolIcon Symbol="Copy" FontSize="{DynamicResource ShellIconSizeSm}" />
                        </Button>
                      </Grid>
                      <components:MarkdownPreviewView
                          ContinuousSelection="True"
                          Text="{Binding Content}"
                            HiddenReferences="{Binding HiddenReferences}"
                            SecretRuntime="{Binding SecretRuntime}" />
                    </StackPanel>
                  </controls:SurfaceCard>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding AgentChat.HasProvisionalAgentContent, FallbackValue=False}">
            <StackPanel
                IsVisible="{Binding AgentChat.HasProvisionalReasoningSummary, FallbackValue=False}"
                AutomationProperties.Name="AI reasoning summary in progress">
              <ToggleButton
                  x:Name="ProvisionalReasoningDisclosure"
                  Classes="ReasoningTraceDisclosure"
                  IsChecked="True"
                  AutomationProperties.Name="Show or hide reasoning in progress">
                <Grid
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="Reasoning"
                      AutomationProperties.Name="Reasoning status" />
                  <icons:SymbolIcon
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Symbol="ChevronDown"
                      FontSize="{DynamicResource ShellIconSizeSm}"
                      Foreground="{DynamicResource ShellMutedBrush}"
                      IsVisible="{Binding !IsChecked, ElementName=ProvisionalReasoningDisclosure}" />
                  <icons:SymbolIcon
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Symbol="ChevronUp"
                      FontSize="{DynamicResource ShellIconSizeSm}"
                      Foreground="{DynamicResource ShellMutedBrush}"
                      IsVisible="{Binding IsChecked, ElementName=ProvisionalReasoningDisclosure}" />
                  <ProgressBar
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      MinWidth="0"
                      Height="2"
                      Margin="{controls:Inset Top=Xs}"
                      HorizontalAlignment="Stretch"
                      IsIndeterminate="True"
                      IsVisible="{Binding AgentChat.ShowProvisionalReasoningLoader, FallbackValue=False}"
                      AutomationProperties.Name="Reasoning in progress" />
                </Grid>
              </ToggleButton>
              <Border
                  Margin="{controls:Inset Top=Xs, Left=Sm, Bottom=Xs}"
                  Padding="{controls:Inset Left=Md}"
                  BorderBrush="{DynamicResource ShellBorderBrush}"
                  BorderThickness="1,0,0,0"
                  IsVisible="{Binding IsChecked, ElementName=ProvisionalReasoningDisclosure}">
                <components:MarkdownPreviewView
                    ContinuousSelection="True"
                    Text="{Binding AgentChat.ProvisionalReasoningStageDisplay}" />
              </Border>
            </StackPanel>
            <components:MarkdownPreviewView
                ContinuousSelection="True"
                Text="{Binding AgentChat.ProvisionalAssistantText}"
                AutomationProperties.Name="AI response in progress" />
          </StackPanel>
          <controls:SurfaceCard
              x:Name="AgentCurrentProgress"
              Tone="Raised"
              Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
              Focusable="True"
              KeyboardNavigation.IsTabStop="True"
              IsVisible="{Binding AgentChat.HasCurrentProgress, FallbackValue=False}"
              AutomationProperties.Name="AI agent progress"
              AutomationProperties.HelpText="Live status from the AI model">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="Eyebrow Accent" Text="Agent progress" />
                <TextBlock
                    Grid.Column="1"
                    Classes="Eyebrow"
                    Text="{Binding AgentChat.CurrentProgress.PercentLabel}"
                    IsVisible="{Binding AgentChat.CurrentProgress.HasPercent}" />
              </Grid>
              <TextBlock
                  Text="{Binding AgentChat.CurrentProgress.Message}"
                  TextWrapping="Wrap" />
              <ProgressBar
                  Height="3"
                  Minimum="0"
                  Maximum="100"
                  Value="{Binding AgentChat.CurrentProgress.ProgressValue}"
                  IsIndeterminate="{Binding AgentChat.CurrentProgress.IsIndeterminate}"
                  AutomationProperties.Name="{Binding AgentChat.CurrentProgress.AccessibleName}" />
            </StackPanel>
          </controls:SurfaceCard>
          <components:AgentQuestionCardView
              x:Name="AgentQuestionCard"
              DeclineRequested="OnDeclineAgentQuestionClick"
              ResponseKeyDownRequested="OnAgentQuestionResponseKeyDown"
              SubmitRequested="OnSubmitAgentQuestionClick" />
          <components:AgentCapabilityRequestCardView
              x:Name="AgentCapabilityRequestCard"
              EnableAskRequested="OnEnableAgentCapabilityAskClick"
              KeepOffRequested="OnKeepAgentCapabilityOffClick" />
          <!--
            A tool call reads as a run record: where it ran, what it is, and how to
            stop it. It carries the boundary in its own heading so the transcript
            never has to be read against a separate scope indicator.
          -->
          <Border
              Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
              Background="{DynamicResource ShellSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource ShellAccentBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ShellCardCornerRadius}"
              IsVisible="{Binding AgentChat.HasActiveTool, FallbackValue=False}"
              AutomationProperties.Name="AI agent tool activity">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon
                    VerticalAlignment="Center"
                    Symbol="WindowConsole"
                    FontSize="{DynamicResource ShellIconSizeSm}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Eyebrow Accent"
                    Text="{Binding AgentChat.ActiveTool.TargetDisplayTitle, StringFormat={}Running in {0}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding AgentChat.ActiveTool.Risk}" />
              </Grid>
              <TextBlock FontWeight="SemiBold" Text="{Binding AgentChat.ActiveTool.ToolTitle}" TextWrapping="Wrap" />
              <!-- Identifiers bind the action; they are for checking it, not
                   for reading what it is. -->
              <Expander
                  x:Name="AgentToolActivityDetails"
                  Header="Details"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Show AI agent tool details">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Top=Xs}">
                  <SelectableTextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding AgentChat.ActiveTool.ToolName, StringFormat={}Tool: {0}}" TextWrapping="Wrap" />
                  <SelectableTextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding AgentChat.ActiveTool.TargetTitle, StringFormat={}Target: {0}}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <Button
                  Margin="{controls:Inset Top=Xs}"
                  HorizontalAlignment="Left"
                  Classes="SecondaryButton"
                  Click="OnCancelAgentActionClick"
                  Content="{Binding AgentChat.ActiveActionCancellationLabel}"
                  IsEnabled="{Binding AgentChat.CanCancelActiveAction}"
                  AutomationProperties.Name="{Binding AgentChat.ActiveActionCancellationLabel, StringFormat={}AI agent · {0}}"
                  AutomationProperties.HelpText="Cancel the current terminal action" />
            </StackPanel>
          </Border>
          <components:AgentApprovalCardView
              x:Name="AgentApprovalCard"
              ApproveRequested="OnApproveAgentActionClick"
              DenyRequested="OnDenyAgentActionClick"
              IsVisible="{Binding AgentChat.HasPendingApproval, FallbackValue=False}" />
          <Expander
              x:Name="AgentRunAudit"
              Margin="{controls:Inset Bottom=Sm}"
              HorizontalContentAlignment="Stretch"
              IsExpanded="{Binding AgentChat.IsAuditExpanded, Mode=TwoWay}"
              IsVisible="{Binding AgentChat.HasAuditActivity, FallbackValue=False}"
              AutomationProperties.Name="Review AI agent activity"
              AutomationProperties.HelpText="Show recorded actions for this conversation">
            <Expander.Header>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon
                    VerticalAlignment="Center"
                    Symbol="History"
                    FontSize="{DynamicResource ShellIconSizeSm}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Recorded actions" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    Text="{Binding AgentChat.AuditSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel Margin="{controls:Inset Top=Sm}" Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  Text="Only the actions are recorded. Sensitive content isn’t shown."
                  TextWrapping="Wrap" />
              <ProgressBar
                  Height="3"
                  IsIndeterminate="True"
                  IsVisible="{Binding AgentChat.IsAuditLoading}"
                  AutomationProperties.Name="Loading agent activity" />
              <ItemsControl ItemsSource="{Binding AgentChat.AuditEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentAuditEntryViewModel">
                    <Border
                        Margin="{controls:Inset Bottom=Xs}"
                        Padding="{controls:Inset Sm}"
                        Background="{DynamicResource ShellSurfaceBrush}"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ShellControlCornerRadius}"
                        AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                            <TextBlock
                                Classes="Eyebrow Accent"
                                FontSize="{DynamicResource ShellFontSize10}"
                                Text="{Binding Kind}" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                          </StackPanel>
                          <controls:StatusChip
                              Grid.Column="1"
                              VerticalAlignment="Top" Content="{Binding Outcome}" />
                        </Grid>
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding ToolName}"
                            TextWrapping="Wrap"
                            IsVisible="{Binding HasToolName}" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding Evidence}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding Timeline}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding Result}"
                            TextWrapping="Wrap"
                            IsVisible="{Binding HasResult}" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding TargetBinding}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding OccurredAt}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  Text="{Binding AgentChat.AuditStatus}"
                  TextWrapping="Wrap"
                  AutomationProperties.Name="Recorded agent actions status" />
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <Button
                    Classes="SecondaryButton"
                    Click="OnRefreshAgentAuditClick"
                    Content="Refresh"
                    IsEnabled="{Binding AgentChat.CanRefreshAudit}"
                    AutomationProperties.Name="Refresh recorded agent actions" />
                <Button
                    Grid.Column="1"
                    Classes="TextButton"
                    Click="OnLoadOlderAgentAuditClick"
                    Content="Load Older"
                    IsEnabled="{Binding AgentChat.CanLoadOlderAudit}"
                    AutomationProperties.Name="Load older recorded agent actions" />
              </Grid>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <controls:StateOverlay
          x:Name="AgentSetupRequiredState"
          Grid.Row="1"
          Margin="{controls:Inset Horizontal=Md, Vertical=Xl}"
          VerticalAlignment="Center"
          IsVisible="{Binding AgentChat, Converter={x:Static ObjectConverters.IsNull}}"
          Kind="PermissionRequired"
          Heading="AI setup required"
          Body="Choose the primary, compaction, and title models in AI settings.">
        <Button
            Classes="PrimaryButton"
            Click="OnShowAgentSettingsClick"
            Content="AI Settings…"
            AutomationProperties.Name="AI Settings…" />
      </controls:StateOverlay>

      <controls:StateOverlay
          x:Name="AgentNoProviderState"
          Grid.Row="1"
          Margin="{controls:Inset Horizontal=Md, Vertical=Xl}"
          VerticalAlignment="Center"
          IsVisible="{Binding AgentChat.HasNoProvider, FallbackValue=False}"
          Kind="Offline"
          Heading="Connect an AI provider"
          Body="Add a model provider to start using the AI agent.">
        <StackPanel HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
          <Button Classes="PrimaryButton" Click="OnShowAgentSettingsClick" Content="AI Settings…" AutomationProperties.Name="AI Settings…" AutomationProperties.HelpText="{Binding Source={x:Static core:PlatformTerms.SecretStore}, StringFormat='Choose agent defaults and connect AI providers. Credentials stay in {0}.'}" />
          <Button Classes="DestructiveButton" Click="OnClearAgentChatClick" Content="Clear Agent Session" IsVisible="{Binding AgentChat.CanClear}" AutomationProperties.Name="Clear agent session" />
        </StackPanel>
      </controls:StateOverlay>
      <controls:StateOverlay
          x:Name="AgentFailedTurnState"
          Grid.Row="1"
          Margin="{controls:Inset Horizontal=Md, Vertical=Xl}"
          VerticalAlignment="Center"
          IsVisible="{Binding AgentChat.HasFailedTurn, FallbackValue=False}"
          Kind="Retry"
          Heading="{Binding AgentChat.FailureHeading}"
          Body="{Binding AgentChat.Status}">
        <!-- Neither action is the obvious next step, so neither is primary.
             Clearing a run that left nothing saved is routine; clearing one
             whose conversation was saved deletes it, so that is a separate,
             destructive button, and the host confirms first. Both sit beside
             AI Settings… at the same size. -->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
          <Button
              x:Name="AgentClearFailedRunButton"
              Classes="SecondaryButton"
              Click="OnClearAgentChatClick"
              Content="Clear Failed Run"
              IsVisible="{Binding !AgentChat.ClearDeletesConversation, FallbackValue=True}"
              IsEnabled="{Binding AgentChat.CanClear}"
              AutomationProperties.Name="Clear the failed AI agent run"
              AutomationProperties.HelpText="Discards this run so you can send the message again." />
          <Button
              x:Name="AgentDeleteFailedConversationButton"
              Classes="DestructiveButton"
              Click="OnClearAgentChatClick"
              Content="Delete Conversation…"
              IsVisible="{Binding AgentChat.ClearDeletesConversation, FallbackValue=False}"
              IsEnabled="{Binding AgentChat.CanClear}"
              AutomationProperties.Name="{Binding AgentChat.ClearFailedRunAccessibleName}"
              AutomationProperties.HelpText="Deletes the saved conversation with its failed run, after you confirm." />
          <Button
              Classes="SecondaryButton"
              Click="OnShowAgentSettingsClick"
              Content="AI Settings…"
              AutomationProperties.Name="AI Settings…" />
        </StackPanel>
      </controls:StateOverlay>

      <StackPanel
          Grid.Row="3"
          Spacing="2">
        <components:ErrorNoticesView
            Margin="{controls:Inset Horizontal=Md}"
            DataContext="{Binding AgentChat.ErrorNotices}" />
        <ItemsControl
            x:Name="AgentQueuedFollowUps"
            Margin="{controls:Inset Horizontal=Md}"
            ItemsSource="{Binding AgentChat.QueuedFollowUps}"
            IsVisible="{Binding AgentChat.HasQueuedFollowUps, FallbackValue=False}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentQueuedFollowUpViewModel">
              <Grid Classes="agentQueueRow" Margin="{controls:Inset Bottom=2}">
                <Border
                    Classes="queueDropBefore"
                    Height="2"
                    Margin="{controls:Inset Horizontal=Xs}"
                    VerticalAlignment="Top"
                    ZIndex="2"
                    Background="{DynamicResource ShellAccentBrush}" />
                <Border
                    Classes="queueDropAfter"
                    Height="2"
                    Margin="{controls:Inset Horizontal=Xs}"
                    VerticalAlignment="Bottom"
                    ZIndex="2"
                    Background="{DynamicResource ShellAccentBrush}" />
                <Border
                    Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                    Background="{DynamicResource ShellSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ShellControlCornerRadius}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2">
                    <Border
                        Grid.Column="0"
                        Width="28"
                        Background="Transparent"
                        Cursor="SizeAll"
                        IsVisible="{Binding IsReadOnly}"
                        PointerPressed="OnQueuedFollowUpDragPressed"
                        PointerMoved="OnQueuedFollowUpDragMoved"
                        PointerReleased="OnQueuedFollowUpDragReleased"
                        PointerCaptureLost="OnQueuedFollowUpDragCaptureLost"
                        ToolTip.Tip="Drag to reorder"
                        AutomationProperties.Name="Drag queued agent message to reorder">
                      <icons:SymbolIcon
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Symbol="ReOrderDotsVertical"
                          FontSize="{DynamicResource ShellIconSizeSm}"
                          Foreground="{DynamicResource ShellTextMutedBrush}" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding Message}"
                        TextTrimming="CharacterEllipsis"
                        IsVisible="{Binding IsReadOnly}" />
                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MinHeight="{controls:TextScaled 32}"
                        Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                        Text="{Binding EditDraft, Mode=TwoWay}"
                        IsVisible="{Binding IsEditing}"
                        AutomationProperties.Name="Edit queued agent message" />
                    <Button
                        Grid.Column="2"
                        Classes="TextButton"
                        Command="{Binding SteerCommand}"
                        Content="{Binding SteerLabel}"
                        IsVisible="{Binding IsReadOnly}"
                        AutomationProperties.Name="Send this queued message at the next safe boundary" />
                    <Button
                        Grid.Column="3"
                        MinWidth="{controls:TextScaled 32}"
                        MinHeight="{controls:TextScaled 32}"
                        Classes="IconButton Danger"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsReadOnly}"
                        ToolTip.Tip="Delete queued message"
                        AutomationProperties.Name="Delete queued agent message">
                      <icons:SymbolIcon Symbol="Delete" FontSize="{DynamicResource ShellIconSizeSm}" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        MinWidth="{controls:TextScaled 32}"
                        MinHeight="{controls:TextScaled 32}"
                        Classes="IconButton"
                        IsVisible="{Binding IsReadOnly}"
                        ToolTip.Tip="Queued message options"
                        AutomationProperties.Name="Queued agent message options">
                      <icons:SymbolIcon Symbol="MoreCircle" FontSize="{DynamicResource ShellIconSizeSm}" />
                      <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                          <MenuItem Header="Edit Message" Command="{Binding BeginEditCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <StackPanel
                        Grid.Column="2"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2"
                        IsVisible="{Binding IsEditing}">
                      <Button Classes="TextButton" Command="{Binding CancelEditCommand}" Content="Cancel" />
                      <Button Classes="PrimaryButton" Command="{Binding SaveEditCommand}" Content="Save" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border
          x:Name="AgentComposer"
          DragDrop.AllowDrop="True"
          DragDrop.DragEnter="OnAgentComposerDragOver"
          DragDrop.DragOver="OnAgentComposerDragOver"
          DragDrop.DragLeave="OnAgentComposerDragLeave"
          DragDrop.Drop="OnAgentComposerDrop"
          Margin="{controls:Inset Horizontal=Md, Bottom=Md}"
          Padding="{controls:Inset Sm}"
          Background="{DynamicResource ShellSurfaceBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource ShellCardCornerRadius}"
          IsVisible="{Binding AgentChat.ShowComposer, FallbackValue=False}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
          <StackPanel>
            <ItemsControl
                x:Name="AgentPendingImages"
                ItemsSource="{Binding AgentChat.PendingImages}"
                IsVisible="{Binding AgentChat.HasPendingImages}"
                AutomationProperties.Name="Images attached to the next message">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:AgentImageAttachment">
                  <Border Margin="{controls:Inset Right=Xs, Bottom=Xs}" Padding="{controls:Inset Left=Sm}"
                      Background="{DynamicResource ShellSurfaceRaisedBrush}"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                      <icons:SymbolIcon Symbol="Image" FontSize="{DynamicResource ShellIconSizeSm}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" MaxWidth="{controls:TextScaled 180}" VerticalAlignment="Center"
                          Classes="MiddleTruncated" Text="{Binding FileName}" ToolTip.Tip="{Binding FileName}" />
                      <Button Grid.Column="2" Classes="IconButton" Click="OnRemoveAgentImageClick" Tag="{Binding}"
                          ToolTip.Tip="Remove image" AutomationProperties.Name="{Binding FileName, StringFormat={}Remove attached image {0}}">
                        <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl
                x:Name="AgentPendingFiles"
                ItemsSource="{Binding AgentChat.PendingFiles}"
                IsVisible="{Binding AgentChat.HasPendingFiles}"
                AutomationProperties.Name="Files attached to the next message">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:AgentFileAttachment">
                  <Border Margin="{controls:Inset Right=Xs, Bottom=Xs}" Padding="{controls:Inset Left=Sm}"
                      Background="{DynamicResource ShellSurfaceRaisedBrush}"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                      <icons:SymbolIcon Symbol="Document" FontSize="{DynamicResource ShellIconSizeSm}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" MaxWidth="{controls:TextScaled 180}" VerticalAlignment="Center"
                          Classes="MiddleTruncated" Text="{Binding FileName}" ToolTip.Tip="{Binding FileName}" />
                      <Button Grid.Column="2" Classes="IconButton" Click="OnRemoveAgentFileClick" Tag="{Binding}"
                          ToolTip.Tip="Remove file" AutomationProperties.Name="{Binding FileName, StringFormat={}Remove attached file {0}}">
                        <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Grid.Row="4" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource ShellBorderBrush}" Padding="{controls:Inset Top=Xs}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
              <!-- A minor option for one message, so a checkbox rather than a
                   switch, and its consequence is written out rather than kept
                   in a tooltip. The whole row, box and label, is the 28 pt
                   hit target. -->
              <CheckBox
                  x:Name="AgentSendRawSecrets"
                  MinHeight="{controls:TextScaled 28}"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource ShellFontSize11}"
                  Content="Send raw secrets"
                  IsChecked="{Binding AgentChat.SendRawSecrets, Mode=TwoWay}"
                  IsEnabled="{Binding AgentChat.CanUseComposerOptions}"
                  IsVisible="{Binding !AgentChat.HasFailedTurn}"
                  AutomationProperties.Name="Send raw secrets"
                  AutomationProperties.HelpText="{Binding AgentChat.SendRawSecretsExplanation}" />
              <TextBlock
                  x:Name="AgentSendRawSecretsHelp"
                  Grid.Row="1"
                  Grid.ColumnSpan="4"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  Text="{Binding AgentChat.SendRawSecretsHelp}"
                  TextWrapping="Wrap"
                  Classes.dimmed="{Binding !AgentChat.CanUseComposerOptions}"
                  IsVisible="{Binding !AgentChat.HasFailedTurn}" />
              <ComboBox Grid.Column="2" MinWidth="{controls:TextScaled 104}" Margin="4,0" MinHeight="{controls:TextScaled 26}"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource ShellFontSize11}"
                  ItemsSource="{Binding AgentChat.ReasoningEfforts}"
                  SelectedItem="{Binding AgentChat.SelectedReasoningEffort, Mode=TwoWay}"
                  IsVisible="{Binding AgentChat.HasMultipleReasoningEfforts}"
                  IsEnabled="{Binding AgentChat.CanSelectReasoningEffort}"
                  ToolTip.Tip="Reasoning effort" AutomationProperties.Name="AI reasoning effort">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentReasoningEffortOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <TextBox
              x:Name="AgentChatPromptInput"
              Grid.Row="1"
              MinHeight="{controls:TextScaled 56}"
              MaxHeight="{controls:TextScaled 150}"
              Padding="{controls:Inset Sm}"
              Background="Transparent"
              BorderThickness="0"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              MaxLength="65536"
              Text="{Binding AgentChat.Prompt, Mode=TwoWay}"
              PastingFromClipboard="OnAgentPromptPasting"
              IsEnabled="{Binding AgentChat.CanEnterPrompt}"
              PlaceholderText="{Binding AgentChat.PromptPlaceholder}"
              AutomationProperties.Name="AI agent prompt" />
          <Grid
              x:Name="AgentComposerToolbar"
              Grid.Row="2"
              ColumnDefinitions="Auto,*,*,Auto,Auto,Auto"
              ColumnSpacing="0"
              IsVisible="{Binding !AgentChat.HasFailedTurn}">
            <Button
                MinWidth="{controls:TextScaled 32}"
                Classes="IconButton ComposerControl"
                Click="OnAttachAgentImageClick"
                IsEnabled="{Binding AgentChat.CanAttachFiles}"
                ToolTip.Tip="Attach file"
                AutomationProperties.Name="Attach a file to the AI agent prompt">
              <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeMd}" />
            </Button>
            <Button
                x:Name="AgentAccessModeButton"
                Grid.Column="1"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Classes="TextButton ComposerControl ComposerSelector"
                IsEnabled="{Binding AgentChat.CanUseComposerOptions, FallbackValue=False}"
                ToolTip.Tip="{Binding AgentChat.AccessModeLabel}"
                AutomationProperties.Name="Choose how AI actions are approved">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding AgentChat.AccessModeLabel}"
                    TextTrimming="CharacterEllipsis" />
                <icons:SymbolIcon Grid.Column="1" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" VerticalAlignment="Center" />
              </Grid>
              <!-- A pop-up menu of the two modes, the current one checked: the
                   button's label is always one of the item titles. -->
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft">
                  <MenuItem
                      x:Name="AgentAskForApprovalItem"
                      Header="Ask for Approval"
                      ToggleType="Radio"
                      GroupName="AgentApprovalMode"
                      IsChecked="{Binding AgentChat.IsAskForApprovalSelected, Mode=OneWay, FallbackValue=False}"
                      Click="OnDisableAgentYoloClick"
                      ToolTip.Tip="Ask before each agent action that changes something" />
                  <MenuItem
                      x:Name="AgentFullAccessItem"
                      Header="Full Access"
                      ToggleType="Radio"
                      GroupName="AgentApprovalMode"
                      IsChecked="{Binding AgentChat.IsFullAccessSelected, Mode=OneWay, FallbackValue=False}"
                      Click="OnEnableAgentYoloClick"
                      ToolTip.Tip="Let the agent act without asking for the rest of this run" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button
                x:Name="AgentModelPickerButton"
                Grid.Column="2"
                Margin="0"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Classes="TextButton ComposerControl ComposerSelector"
                IsEnabled="{Binding AgentChat.CanUseModelPicker}"
                ToolTip.Tip="{Binding AgentChat.SelectedModelName}"
                AutomationProperties.Name="Choose AI provider and model">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding AgentChat.SelectedModelName}"
                    TextTrimming="CharacterEllipsis" />
                <icons:SymbolIcon Grid.Column="1" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" VerticalAlignment="Center" />
              </Grid>
              <Button.Flyout>
                <!-- A menu that can be filtered, which a plain menu cannot be: a
                     search field above a list with a selection role. The model
                     in use is checked; arrows move through the list, and Return
                     or a click chooses the model and closes the menu. -->
                <Flyout
                    Placement="TopEdgeAlignedRight"
                    FlyoutPresenterClasses="AgentModelMenu"
                    Opened="OnModelMenuOpened">
                  <Grid Width="{controls:TextScaled 330}" MaxHeight="{controls:TextScaled 460}" RowDefinitions="Auto,*,Auto">
                    <Border Padding="{controls:Inset Sm}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                        <controls:SearchField
                            x:Name="AgentModelFilter"
                            PlaceholderText="Filter models"
                            Text="{Binding AgentChat.ModelSearch, Mode=TwoWay}"
                            KeyDown="OnModelFilterKeyDown"
                            AutomationProperties.Name="Filter available AI models" />
                        <Button
                            Grid.Column="1"
                            MinWidth="{controls:TextScaled 30}"
                            MinHeight="{controls:TextScaled 30}"
                            VerticalAlignment="Center"
                            Classes="IconButton"
                            Click="OnRefreshModelsClick"
                            ToolTip.Tip="Refresh models from provider"
                            AutomationProperties.Name="Refresh models from provider">
                          <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeSm}" />
                        </Button>
                      </Grid>
                    </Border>
                    <ProgressBar
                        Grid.Row="0"
                        Height="2"
                        Margin="{controls:Inset Top=Sm, Horizontal=Sm}"
                        VerticalAlignment="Bottom"
                        IsIndeterminate="True"
                        IsVisible="{Binding AgentChat.IsDiscoveringModels}" />
                    <Grid Grid.Row="1" Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}" RowDefinitions="*,Auto,Auto">
                      <ListBox
                          x:Name="AgentModelList"
                          MaxHeight="{controls:TextScaled 310}"
                          Classes="AgentModelList"
                          SelectionMode="Single"
                          ItemsSource="{Binding AgentChat.FilteredModels}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          KeyDown="OnModelListKeyDown"
                          AutomationProperties.Name="Models">
                        <!-- Each row names its model and provider, and says
                             which model is in use; the check is only drawn. -->
                        <ListBox.ItemContainerTheme>
                          <ControlTheme TargetType="ListBoxItem" x:DataType="vm:AgentModelPickerItemViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleStatus}" />
                          </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:AgentModelPickerItemViewModel">
                            <!-- The row carries its model so the hosts that choose
                                 it read it from the sender, as from a button. -->
                            <Grid
                                Tag="{Binding Model}"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{DynamicResource ShellSpaceSm}"
                                ToolTip.Tip="{Binding Id}">
                              <Panel Width="{DynamicResource ShellIconSizeSm}" VerticalAlignment="Center">
                                <icons:SymbolIcon
                                    x:Name="CurrentModelMark"
                                    Symbol="Checkmark"
                                    FontSize="{DynamicResource ShellIconSizeSm}"
                                    IsVisible="{Binding IsCurrent}" />
                              </Panel>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ProviderName}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Button
                                  Grid.Column="2"
                                  MinWidth="{controls:TextScaled 34}"
                                  MinHeight="{controls:TextScaled 34}"
                                  VerticalAlignment="Center"
                                  Classes="IconButton"
                                  Click="OnToggleFavoriteModelClick"
                                  Tag="{Binding}"
                                  ToolTip.Tip="{Binding FavoriteAccessibleName}"
                                  AutomationProperties.Name="{Binding FavoriteAccessibleName}">
                                <Grid>
                                  <icons:SymbolIcon Symbol="Star" IsVisible="{Binding !IsFavorite}" />
                                  <icons:SymbolIcon
                                      Symbol="Star"
                                      IconVariant="Filled"
                                      Foreground="{DynamicResource ShellAccentBrush}"
                                      IsVisible="{Binding IsFavorite}" />
                                </Grid>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock
                          Grid.Row="1"
                          Margin="{controls:Inset Md}"
                          HorizontalAlignment="Center"
                          Classes="Muted"
                          FontSize="{DynamicResource ShellSecondaryFontSize}"
                          Text="No matching models"
                          IsVisible="{Binding AgentChat.HasNoModelMatches}" />
                      <TextBlock
                          Grid.Row="2"
                          Margin="{controls:Inset Sm}"
                          Classes="Muted"
                          FontSize="{DynamicResource ShellSecondaryFontSize}"
                          Text="{Binding AgentChat.ModelDiscoveryStatus}"
                          TextWrapping="Wrap"
                          IsVisible="{Binding AgentChat.HasModelDiscoveryStatus}" />
                    </Grid>
                    <Border
                        Grid.Row="2"
                        Padding="{controls:Inset Sm}"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="0,1,0,0">
                      <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                        <ComboBox
                            ItemsSource="{Binding AgentChat.Providers}"
                            SelectedItem="{Binding AgentChat.SelectedProvider, Mode=TwoWay}"
                            IsEnabled="{Binding AgentChat.CanChangeProvider}"
                            IsVisible="{Binding AgentChat.HasMultipleProviders}"
                            AutomationProperties.Name="AI provider">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="application:AiProviderProfileDescriptor"><TextBlock Text="{Binding Name}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid
                            ColumnDefinitions="*,160"
                            ColumnSpacing="{DynamicResource ShellSpaceSm}"
                            IsVisible="{Binding AgentChat.HasServiceTiers}">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Speed" />
                          <ComboBox
                              Grid.Column="1"
                              ItemsSource="{Binding AgentChat.ServiceTiers}"
                              SelectedItem="{Binding AgentChat.SelectedServiceTier, Mode=TwoWay}"
                              IsEnabled="{Binding AgentChat.CanSelectServiceTier}"
                              AutomationProperties.Name="AI service tier">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:AgentServiceTierOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- How full the context window is. Named in words, with the same
                 words as its tooltip, and kept in the toolbar beside Send
                 rather than in the row that belongs to the raw-secrets option. -->
            <Button
                x:Name="AgentContextWindowButton"
                Grid.Column="3"
                MinWidth="{controls:TextScaled 32}"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="IconButton ComposerControl"
                IsVisible="{Binding AgentChat.HasContextWindow}"
                ToolTip.Tip="{Binding AgentChat.ContextWindowAccessibleName}"
                AutomationProperties.Name="{Binding AgentChat.ContextWindowAccessibleName}"
                AutomationProperties.HelpText="{Binding AgentChat.ContextWindowUsageLabel}">
              <controls:ContextWindowDonut
                  Width="17"
                  Height="17"
                  Percentage="{Binding AgentChat.ContextWindowPercent}"
                  TrackBrush="{DynamicResource ShellBorderBrush}"
                  IndicatorBrush="{DynamicResource ShellAccentBrush}"
                  StrokeThickness="2" />
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                  <StackPanel Width="{controls:TextScaled 240}" Margin="{DynamicResource ShellInsetMd}" Spacing="{DynamicResource ShellSpaceSm}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Panel Width="44" Height="44">
                        <controls:ContextWindowDonut
                            x:Name="AgentContextWindowGauge"
                            Percentage="{Binding AgentChat.ContextWindowPercent}"
                            TrackBrush="{DynamicResource ShellBorderBrush}"
                            IndicatorBrush="{DynamicResource ShellAccentBrush}"
                            StrokeThickness="4"
                            AutomationProperties.Name="{Binding AgentChat.ContextWindowAccessibleName}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource ShellFontSize10}"
                            FontWeight="SemiBold"
                            Text="{Binding AgentChat.ContextWindowPercentLabel}"
                            AutomationProperties.AccessibilityView="Raw" />
                      </Panel>
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Classes="Headline"
                          Text="Context window" />
                    </Grid>
                    <TextBlock
                        Classes="Muted"
                        LineHeight="{DynamicResource ShellLineHeight13}"
                        Text="{Binding AgentChat.ContextWindowUsageLabel}" TextWrapping="Wrap" />
                    <Button
                        Classes="SecondaryButton"
                        Content="{Binding AgentChat.CompactLabel}"
                        Command="{Binding AgentChat.CompactCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="Compact conversation context now"
                        AutomationProperties.HelpText="{Binding AgentChat.CompactUnavailableReason}"
                        ToolTip.Tip="Summarize older context while preserving the latest turn and your chat history" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        LineHeight="{DynamicResource ShellLineHeight11}"
                        Text="{Binding AgentChat.CompactUnavailableReason}"
                        IsVisible="{Binding AgentChat.HasCompactUnavailableReason}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding AgentChat.CompactionStatus}"
                        IsVisible="{Binding AgentChat.HasCompactionStatus}"
                        LineHeight="{DynamicResource ShellLineHeight13}"
                        TextWrapping="Wrap"
                        Classes="Muted" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button
                x:Name="AgentSendButton"
                Grid.Column="4"
                Classes="PrimaryButton ComposerAction"
                Click="OnSendAgentChatClick"
                IsEnabled="{Binding AgentChat.CanSubmitPrompt}"
                IsVisible="{Binding AgentChat.ShowPrimaryAction}"
                ToolTip.Tip="{Binding AgentChat.PrimaryActionAccessibleName}"
                AutomationProperties.Name="{Binding AgentChat.PrimaryActionAccessibleName}">
              <icons:SymbolIcon Symbol="ArrowUp" FontSize="{DynamicResource ShellIconSizeMd}" />
            </Button>
            <Button
                x:Name="AgentStopButton"
                Grid.Column="5"
                Classes="PrimaryButton ComposerAction"
                Click="OnCancelAgentChatClick"
                IsEnabled="{Binding AgentChat.CanRequestStop}"
                IsVisible="{Binding AgentChat.ShowStopAction, FallbackValue=False}"
                ToolTip.Tip="Stop this run to change the model or send a new message"
                AutomationProperties.Name="Stop AI agent run">
              <Border Width="10" Height="10"
                  Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  CornerRadius="2" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="3" Text="{Binding AgentChat.AttachmentError}" TextWrapping="Wrap"
              Foreground="{DynamicResource ShellDangerBrush}" IsVisible="{Binding AgentChat.HasAttachmentError}" />
        </Grid>
        </Border>
      </StackPanel>

      <Grid
          Grid.Row="2"
          MinHeight="{DynamicResource ShellControlHeightCompact}"
          Margin="{controls:Inset Horizontal=Md, Bottom=Sm}"
          IsVisible="{Binding AgentChat.ShowFooterStatus, FallbackValue=False}">
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            HorizontalAlignment="Center"
            Text="{Binding AgentChat.Status}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            IsVisible="{Binding AgentChat.ShowFooterStatus}"
            ToolTip.Tip="{Binding AgentChat.Status}"
            AutomationProperties.Name="AI agent status" />
      </Grid>
    </Grid>
  </Border>
  <!-- The floating panel is anchored to the toolbar at its top-right, so the
       corner that resizes is the one diagonally opposite the anchor. -->
  <Thumb
      x:Name="FloatingResizeHandle"
      DragDelta="OnFloatingResizeDragDelta"
      ToolTip.Tip="Resize"
      AutomationProperties.Name="Resize the agent panel">
    <Thumb.Template>
      <ControlTemplate>
        <Panel Background="Transparent">
          <!-- The classic corner grip, mirrored for a bottom-left corner: two
               chords wrapping the corner, each running from the left edge to
               the bottom edge. Drawn, not an icon font glyph: the Fluent set
               has no resize grip. -->
          <Path
              x:Name="CornerResizeGlyph"
              Width="15"
              Height="15"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stroke="{DynamicResource ShellMutedBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round"
              Data="M 1.5,4.5 L 10.5,13.5 M 1.5,9.5 L 5.5,13.5" />
        </Panel>
      </ControlTemplate>
    </Thumb.Template>
  </Thumb>
  <!-- Edge-attached hosts resize from both sides opposite their anchor
       corner. The vertical edge above owns width; this horizontal edge owns
       height and moves to the top or bottom from the alignment pivot. -->
  <Thumb
      x:Name="FloatingHeightResizeHandle"
      DragDelta="OnFloatingHeightResizeDragDelta"
      ToolTip.Tip="Resize height"
      AutomationProperties.Name="Resize the floating agent panel height">
    <Thumb.Template>
      <ControlTemplate>
        <Panel Background="Transparent" />
      </ControlTemplate>
    </Thumb.Template>
  </Thumb>
  </Panel>
</UserControl>
