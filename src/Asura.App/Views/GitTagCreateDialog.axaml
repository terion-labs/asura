<controls:DialogWindow
    x:Class="Asura.App.Views.GitTagCreateDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    Width="440"
    SizeToContent="Height"
    CanResize="False">
  <controls:DialogShell
      x:Name="Shell"
      Scrolls="False"
      Title="Create Tag"
      Subtitle="The tag marks the current HEAD commit. A message makes it an annotated tag.">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Classes="PrimaryButton" Click="OnConfirmClick" Content="Create Tag" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <controls:LabeledField Label="Name" controls:FieldValidation.For="Name">
        <TextBox x:Name="NameInput" AutomationProperties.Name="Tag name" />
      </controls:LabeledField>
      <!-- The message box keeps Return for new lines. -->
      <controls:LabeledField Label="Message (optional)">
        <TextBox
            x:Name="MessageInput"
            MinHeight="52"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            AutomationProperties.Name="Tag message" />
      </controls:LabeledField>
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
