<controls:DialogWindow x:Class="Asura.App.Views.GitLfsDialog" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:git="using:Asura.Git" xmlns:vm="using:Asura.App.ViewModels" xmlns:controls="using:Asura.App.Controls" Width="850" Height="640" MinWidth="550" MinHeight="400" Presentation="Inspector">
  <!-- An inspector: consulted while working, so it opens beside the panel
       without blocking it and closes with ⌘W or Escape, like any window. -->
  <controls:DialogWindow.Styles>
    <!-- Rows spaced as File History spaces its revisions: an inset around
         each row, and a step between the path and the line about it. -->
    <Style Selector="TabControl.LfsTabs ListBox controls|ListItem">
      <Setter Property="ContentPadding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>
  </controls:DialogWindow.Styles>
  <controls:DialogShell x:Name="Shell" Title="Git LFS" Subtitle="Locks are verified against the remote. Ordinary unlock is available only for locks owned by your account." Scrolls="False">
    <controls:DialogShell.Footer>
      <WrapPanel ItemSpacing="{DynamicResource ShellSpaceSm}" LineSpacing="{DynamicResource ShellSpaceXs}">
        <Button x:Name="RefreshButton" Content="Refresh" Classes="SecondaryButton" Click="OnRefresh" />
      </WrapPanel>
    </controls:DialogShell.Footer>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
      <TextBlock x:Name="Message" TextWrapping="Wrap" IsVisible="False" />
      <WrapPanel Grid.Row="1" ItemSpacing="{DynamicResource ShellSpaceSm}" LineSpacing="{DynamicResource ShellSpaceXs}">
        <ComboBox x:Name="RemoteInput" MinWidth="140" AutomationProperties.Name="LFS remote" SelectionChanged="OnRemoteChanged" />
        <TextBox x:Name="PathInput" Width="240" PlaceholderText="File path to lock" AutomationProperties.Name="File path to lock" />
        <Button x:Name="LockButton" Content="Lock File" Click="OnLock" />
        <Button x:Name="UnlockButton" Content="Unlock Selected" Click="OnUnlock" IsEnabled="False" />
        <Button x:Name="ForceButton" Content="Force Unlock Selected…" Classes="DestructiveButton" Click="OnForceUnlock" IsEnabled="False" />
      </WrapPanel>
      <!-- Three fixed views of the repository's LFS state: the shared
           segmented control picks one, and the tab view below only hosts
           it. The lists start at the toolbar's leading edge, a step below
           the segments. -->
      <controls:SegmentedControl
          x:Name="LfsViewSegments"
          Grid.Row="2"
          HorizontalAlignment="Center"
          AutomationProperties.Name="LFS view">
        <RadioButton Content="Locks" AutomationProperties.Name="Locks" />
        <RadioButton Content="Changed Files" AutomationProperties.Name="Changed LFS files" />
        <RadioButton Content="Summary" AutomationProperties.Name="Pending uploads and summary" />
      </controls:SegmentedControl>
      <TabControl
          x:Name="LfsViews"
          Grid.Row="3"
          Classes="Headless LfsTabs"
          SelectedIndex="{Binding #LfsViewSegments.SelectedIndex}">
        <TabItem Header="Locks">
          <ListBox x:Name="LocksList" SelectionChanged="OnLockSelection" AutomationProperties.Name="Verified LFS locks">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GitLfsLockItemViewModel">
                <controls:ListItem Classes="MiddleTruncatedTitle" Title="{Binding Path}" Detail="{Binding DetailLine}" ToolTip.Tip="{Binding IdTip}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Changed LFS Files">
          <ListBox x:Name="StatusList" AutomationProperties.Name="Changed LFS files">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="git:GitLfsStatusFile">
                <controls:ListItem Classes="MiddleTruncatedTitle" Title="{Binding Path}" Detail="{Binding Status}" ToolTip.Tip="{Binding OriginalPath}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Pending Uploads and Summary">
          <TextBox x:Name="Summary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="LFS status and pending uploads" />
        </TabItem>
      </TabControl>
    </Grid>
  </controls:DialogShell>
</controls:DialogWindow>
