<Window
    x:Class="Asura.App.Views.AboutWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:components="using:Asura.App.Views.Components"
    Title="About Asura"
    Width="520"
    Height="600"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False"
    WindowStartupLocation="CenterScreen">
  <!--
    The About window: the app's identity first, the rest scrolling below it
    the way the standard About panel's credits do.
  -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource ShellBackgroundBrush}">
    <StackPanel
        Margin="{controls:Inset Horizontal=Xl, Top=Xl, Bottom=Lg}"
        HorizontalAlignment="Center"
        Spacing="{DynamicResource ShellSpaceSm}">
      <Image
          x:Name="ApplicationIcon"
          Width="96"
          Height="96"
          HorizontalAlignment="Center"
          AutomationProperties.AccessibilityView="Raw" />
      <TextBlock
          HorizontalAlignment="Center"
          FontSize="{DynamicResource ShellFontSize18}"
          FontWeight="SemiBold"
          Text="{Binding ProductName}" />
      <TextBlock
          x:Name="VersionText"
          HorizontalAlignment="Center"
          Classes="Muted" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <components:AboutAsuraView Margin="{controls:Inset Horizontal=Xl, Bottom=Xl}" />
    </ScrollViewer>
  </Grid>
</Window>
