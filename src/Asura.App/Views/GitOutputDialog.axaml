<controls:DialogWindow x:Class="Asura.App.Views.GitOutputDialog" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Asura.App.Controls" Width="850" Height="600" MinWidth="500" MinHeight="300">
  <!-- Real command output only. A validation message or a failure to report
       is an alert, or a line under the field it is about, not a log window. -->
  <controls:DialogShell x:Name="Shell" Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Content="Copy" Classes="SecondaryButton" Click="OnCopy" />
        <Button Content="Save…" Classes="SecondaryButton" Click="OnSave" />
        <!-- Nothing to cancel: the one way out is an acknowledgement. -->
        <Button Content="OK" MinWidth="88" Classes="PrimaryButton" Click="OnClose" IsCancel="True" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>
    <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource ShellDataFontFamily}" AutomationProperties.Name="Git operation output" />
  </controls:DialogShell>
</controls:DialogWindow>
