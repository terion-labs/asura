<controls:DialogWindow
    x:Class="Asura.App.Views.SshHostKeyReviewDialog"
    x:DataType="views:SshHostKeyReviewPrompt"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    xmlns:controls="using:Asura.App.Controls"
    Width="590"
    SizeToContent="Height"
    CanResize="False">
  <!--
    An alert people must read. A first-seen key is the ordinary case and its
    Trust button answers Return. A changed key may be an interception: its
    Replace button is destructive and is not the default, so a reflexive
    Return cannot accept a key nobody checked.
  -->
  <controls:DialogShell Title="{Binding Title}" Subtitle="{Binding Explanation}" Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" MinWidth="88" Click="OnConfirmClick" Content="{Binding ConfirmLabel}" />
      </StackPanel>
    </controls:DialogShell.Footer>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <controls:SurfaceCard>
        <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="Eyebrow" Text="Endpoint" />
          <TextBlock FontSize="{DynamicResource ShellFontSize11}" Text="{Binding Review.Endpoint}" />
          <TextBlock Classes="Eyebrow" Text="Presented host key" />
          <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Review.Presented.Algorithm}" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Review.Presented.Sha256Fingerprint}" TextWrapping="Wrap" />
          <TextBlock Classes="Eyebrow" Text="Previously trusted" IsVisible="{Binding Review.RequiresExplicitReplacement}" />
          <TextBlock FontFamily="{DynamicResource ShellDataFontFamily}" FontSize="{DynamicResource ShellFontSize10}" Foreground="{DynamicResource ShellDangerBrush}" Text="{Binding Review.Trusted.Sha256Fingerprint}" TextWrapping="Wrap" IsVisible="{Binding Review.RequiresExplicitReplacement}" />
        </StackPanel>
      </controls:SurfaceCard>
      <controls:Callout
          Tone="Warning"
          Glyph="Warning"
          Text="Verify this fingerprint through a separate trusted channel before continuing. Asura will never replace a changed key automatically." />
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
