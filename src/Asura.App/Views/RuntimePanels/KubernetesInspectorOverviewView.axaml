<UserControl x:Class="Asura.App.Views.RuntimePanels.KubernetesInspectorOverviewView"
    x:DataType="vm:KubernetesRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels" xmlns:controls="using:Asura.App.Controls">
  <UserControl.Styles>
    <Style Selector="Border.PropertyRow"><Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="{controls:Inset Vertical=Sm}" /></Style>
    <Style Selector="TextBlock.SectionTitle"><Setter Property="FontSize" Value="{DynamicResource ShellFontSize14}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="{controls:Inset Top=Lg, Bottom=Sm}" /></Style>
    <Style Selector="Button.PropertyLink"><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" /></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
      <StackPanel IsVisible="{Binding HasResourceMetrics}" Spacing="{DynamicResource ShellSpaceSm}">
        <TextBlock Text="Metrics" Classes="SectionTitle" />
        <ProgressBar Classes="WorkingStripe" IsVisible="{Binding IsMetricsLoading}" IsIndeterminate="True" AutomationProperties.Name="Loading resource metrics" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <StackPanel><TextBlock Text="CPU" Classes="Muted" /><TextBlock Text="{Binding SelectedCpuUsage}" FontSize="{DynamicResource ShellFontSize16}" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Memory" Classes="Muted" /><TextBlock Text="{Binding SelectedMemoryUsage}" FontSize="{DynamicResource ShellFontSize16}" /></StackPanel>
        </Grid>
        <TextBlock Text="{Binding MetricsStatus}" Classes="Muted" TextWrapping="Wrap" />
        <Grid IsVisible="{Binding HasMetricsProviderChoices}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <ComboBox ItemsSource="{Binding PrometheusProviders}" SelectedItem="{Binding SelectedPrometheusProvider, Mode=TwoWay}" PlaceholderText="Choose metrics provider" HorizontalAlignment="Stretch" AutomationProperties.Name="Kubernetes metrics provider"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:KubernetesMetricsProviderOption"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <CheckBox Grid.Column="1" IsVisible="{Binding HasMetricHistory}" Content="Memory" IsChecked="{Binding MemoryHistory, Mode=TwoWay}" />
        </Grid>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasMetricHistory}" Spacing="{DynamicResource ShellSpaceSm}">
        <StackPanel IsVisible="{Binding HasSelectedMetricsProvider}" Spacing="{DynamicResource ShellSpaceSm}">
        <ProgressBar Classes="WorkingStripe" IsVisible="{Binding IsHistoryLoading}" IsIndeterminate="True" AutomationProperties.Name="Loading metric history" />
        <ItemsControl ItemsSource="{Binding MetricHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesHistoryRow">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Text="{Binding Container}" Classes="Muted" />
            <controls:TimeSeriesChart Values="{Binding Values}" Maximum="{Binding Maximum}" Height="120" LineBrush="{DynamicResource ShellAccentBrush}" GridBrush="{DynamicResource ShellBorderBrush}" AutomationProperties.Name="Selected resource metric history over the past hour" />
            <TextBlock Text="{Binding Scale}" Classes="Muted" />
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding HistoryStatus}" Classes="Muted" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="Properties" Classes="SectionTitle" />
      <TextBlock Text="{Binding DetailsStatus}" Classes="Muted" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding DetailProperties}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailProperty">
        <Border Classes="PropertyRow"><Grid ColumnDefinitions="130,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Text="{Binding Label}" Classes="Muted" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding !CanNavigate}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="PropertyLink" Command="{Binding NavigateCommand}" IsVisible="{Binding CanNavigate}"><TextBlock Text="{Binding Value}" Foreground="{DynamicResource ShellAccentBrush}" TextWrapping="Wrap" /></Button>
        </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander Header="Labels" IsExpanded="True" IsVisible="{Binding HasDetailLabels}">
        <ItemsControl ItemsSource="{Binding DetailLabels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailProperty">
          <Border Classes="PropertyRow"><Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}"><TextBlock Text="{Binding Label}" Classes="Muted" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" /></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Expander>
      <Expander Header="Annotations" IsVisible="{Binding HasDetailAnnotations}">
        <ItemsControl ItemsSource="{Binding DetailAnnotations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailProperty">
          <Border Classes="PropertyRow"><StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Text="{Binding Label}" Classes="Muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Expander>
      <StackPanel IsVisible="{Binding HasDetailConditions}">
        <TextBlock Text="Conditions" Classes="SectionTitle" />
        <ItemsControl ItemsSource="{Binding DetailConditions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailCondition">
          <Border Classes="PropertyRow"><StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Type}" /><TextBlock Grid.Column="1" Text="{Binding Status}" /></Grid>
            <TextBlock Text="{Binding Reason}" Classes="Muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Message}" Classes="Muted" TextWrapping="Wrap" /><TextBlock Text="{Binding ChangedAt}" Classes="Muted" />
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasDetailContainers}">
        <TextBlock Text="Containers" Classes="SectionTitle" />
        <ItemsControl ItemsSource="{Binding DetailContainers}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailContainer">
          <Border Classes="PropertyRow"><StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Image}" TextWrapping="Wrap" Classes="Muted" />
            <Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding State}" /><TextBlock Grid.Column="1" Text="{Binding Ready}" /></Grid>
            <TextBlock Text="{Binding Restarts, StringFormat='Restarts: {0}'}" Classes="Muted" /><TextBlock Text="{Binding Ports}" Classes="Muted" TextWrapping="Wrap" />
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <TextBlock Text="Events" Classes="SectionTitle" />
      <TextBlock Text="{Binding EventsStatus}" Classes="Muted" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding RelatedEvents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesDetailEvent">
        <Border Classes="PropertyRow"><StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Reason}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Type}" Classes="Muted" /></Grid>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Text="{Binding Count, StringFormat='Count: {0}'}" Classes="Muted" /><TextBlock Text="{Binding LastSeen}" Classes="Muted" />
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
