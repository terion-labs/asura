<UserControl
    x:Class="Asura.App.Views.RuntimePanels.StatisticsRuntimePanelView"
    x:DataType="vm:StatisticsRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Statistics panel">
  <controls:PanelChrome
      CloseLabel="Close Statistics panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <controls:StatusMark Tone="{Binding StatusTone}" Description="{Binding StatusText}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Statistics state" />
        <Button
            Classes="IconButton"
            Command="{Binding RefreshCommand}"
            ToolTip.Tip="Refresh statistics"
            AutomationProperties.Name="Refresh statistics">
          <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
        </Button>
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding CapturedAtText}" />
      </Grid>
    </controls:PanelChrome.Footer>

    <Grid RowDefinitions="Auto,*">
        <!-- A later failure while charts are on screen: its reason sits in a
             notice row under the header, where the panel's notices live, and
             the older charts stay readable below it. -->
        <controls:Callout
            Margin="{controls:Inset Left=Lg, Right=Lg, Top=Md}"
            Glyph="Warning"
            Title="{Binding IssueTitle}"
            Text="{Binding IssueMessage}"
            IsVisible="{Binding ShowStaleNotice, FallbackValue=False}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Statistics refresh status">
          <controls:Callout.Action>
            <Button Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry statistics" />
          </controls:Callout.Action>
        </controls:Callout>

        <!-- One of four fills this area: the charts, the wait for the
             first sample, the failure that replaced them, or a stopped panel
             that never got a sample. A state never floats over the charts. -->
        <ScrollViewer Grid.Row="1" Margin="{controls:Inset Lg}" IsVisible="{Binding ShowContent, FallbackValue=False}">
          <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
            <controls:CardGridPanel MinItemWidth="236" MaxColumns="2" Spacing="{DynamicResource ShellSpaceMd}">
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <Grid RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="CPU usage" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding CpuText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Normalized across logical processors" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding CpuHistory}"
                      Unit="Percent"
                      SampleInterval="{Binding SampleInterval}"
                      LabelBrush="{DynamicResource ShellMutedBrush}"
                      ReadoutBackground="{DynamicResource ShellSurfaceBrush}"
                      LabelFontSize="{DynamicResource ShellFontSize10}"
                      Maximum="100"
                      LineBrush="{DynamicResource ShellChartSeries1Brush}"
                      AreaBrush="{DynamicResource ShellChartSeries1FillBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="CPU usage history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Now" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <Grid RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="Process memory" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding MemoryText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Memory in use by the processes Asura can read" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding MemoryHistory}"
                      Unit="Bytes"
                      SampleInterval="{Binding SampleInterval}"
                      LabelBrush="{DynamicResource ShellMutedBrush}"
                      ReadoutBackground="{DynamicResource ShellSurfaceBrush}"
                      LabelFontSize="{DynamicResource ShellFontSize10}"
                      LineBrush="{DynamicResource ShellChartSeries2Brush}"
                      AreaBrush="{DynamicResource ShellChartSeries2FillBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="Process memory history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Now" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <Grid RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="Network receive" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding NetworkReceivedText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Across non-loopback interfaces" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding NetworkReceivedHistory}"
                      Unit="BytesPerSecond"
                      SampleInterval="{Binding SampleInterval}"
                      LabelBrush="{DynamicResource ShellMutedBrush}"
                      ReadoutBackground="{DynamicResource ShellSurfaceBrush}"
                      LabelFontSize="{DynamicResource ShellFontSize10}"
                      LineBrush="{DynamicResource ShellChartSeries3Brush}"
                      AreaBrush="{DynamicResource ShellChartSeries3FillBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="Network receive history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Now" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <Grid RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="Network send" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding NetworkSentText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Across non-loopback interfaces" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding NetworkSentHistory}"
                      Unit="BytesPerSecond"
                      SampleInterval="{Binding SampleInterval}"
                      LabelBrush="{DynamicResource ShellMutedBrush}"
                      ReadoutBackground="{DynamicResource ShellSurfaceBrush}"
                      LabelFontSize="{DynamicResource ShellFontSize10}"
                      LineBrush="{DynamicResource ShellChartSeries4Brush}"
                      AreaBrush="{DynamicResource ShellChartSeries4FillBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="Network send history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Now" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
            </controls:CardGridPanel>

            <controls:CardGridPanel MinItemWidth="236" MaxColumns="2" Spacing="{DynamicResource ShellSpaceMd}">
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="Eyebrow" Text="Running processes" />
                  <TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="{Binding ProcessCountText}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ProcessDetailText}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="{DynamicResource ShellRowPadding}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="Eyebrow" Text="Host uptime" />
                  <TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="{Binding UptimeText}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ProcessorCountText, StringFormat={}{0} logical processors}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
            </controls:CardGridPanel>

          </StackPanel>
        </ScrollViewer>

        <controls:StateOverlay
            Grid.Row="1"
            Kind="Loading"
            Heading="Waiting for first sample…"
            Body="Collecting resource statistics…"
            IsVisible="{Binding ShowLoading, FallbackValue=False}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Statistics loading" />

        <!-- The failure's own reason, not a generic line: what went wrong
             and what to do is the message the panel was given. -->
        <controls:StateOverlay
            Grid.Row="1"
            Kind="TerminalError"
            Glyph="ErrorCircle"
            Heading="{Binding IssueTitle, TargetNullValue='Statistics unavailable', FallbackValue='Statistics unavailable'}"
            Body="{Binding IssueMessage}"
            ActionLabel="Retry"
            ActionCommand="{Binding RefreshCommand}"
            Background="{DynamicResource ShellSurfaceBrush}"
            IsVisible="{Binding ShowTerminalError, FallbackValue=False}"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="Statistics unavailable" />

        <controls:StateOverlay
            Grid.Row="1"
            Kind="Empty"
            Glyph="DataArea"
            Heading="Statistics stopped"
            Body="This panel stopped before its first sample. Open a new Statistics panel to start again."
            IsVisible="{Binding ShowUnavailable, FallbackValue=False}"
            AutomationProperties.Name="Statistics stopped" />
    </Grid>
  </controls:PanelChrome>
</UserControl>
