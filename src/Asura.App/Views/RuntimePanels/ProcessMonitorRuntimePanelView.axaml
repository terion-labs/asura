<UserControl
    x:Class="Asura.App.Views.RuntimePanels.ProcessMonitorRuntimePanelView"
    x:DataType="vm:ProcessMonitorRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:runtimePanels="using:Asura.App.Views.RuntimePanels"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Processes panel">
  <UserControl.Styles>
    <!-- Numbers line up on the right in the data face, as a Mac table's
         numeric columns do, so magnitudes read down the column. -->
    <Style Selector="DataGridCell.NumericCell">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>
  <controls:PanelChrome
      CloseLabel="Close Processes panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <controls:StatusMark Tone="{Binding StatusTone}" Description="{Binding StatusText}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Processes state" />
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ShowingText}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding CapturedAtText}" />
      </Grid>
    </controls:PanelChrome.Footer>

    <Grid RowDefinitions="46,Auto,*">
      <Border Grid.Row="0" Classes="PanelToolbar">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <controls:SearchField
              x:Name="ProcessFilterBox"
              VerticalAlignment="Center"
              Text="{Binding Filter}"
              PlaceholderText="Filter by name or PID"
              AutomationProperties.Name="Filter processes" />
          <!-- The table's commands sit in the toolbar beside its filter, in a
               toolbar group, as the Files panel keeps its own. -->
          <Border Grid.Column="1" Classes="ToolbarGroup" VerticalAlignment="Center">
            <Button
                Width="32"
                Height="32"
                Classes="IconButton ToolbarGroupAction"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh processes"
                AutomationProperties.Name="Refresh processes">
              <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- A refresh that failed while older rows stay listed: the reason
           sits in its own row between the toolbar and the table, so it never
           covers rows the person is reading. -->
      <controls:Callout
          Grid.Row="1"
          Margin="{controls:Inset Left=Sm, Right=Sm, Top=Sm, Bottom=Sm}"
          Glyph="Warning"
          Title="{Binding IssueTitle}"
          Text="{Binding IssueMessage}"
          IsVisible="{Binding ShowInlineIssue, FallbackValue=False}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Process refresh status">
        <controls:Callout.Action>
          <Button Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry process list" />
        </controls:Callout.Action>
      </controls:Callout>

      <Grid Grid.Row="2">
        <!-- A Mac table: the shared data-grid theme's banded rows and
             platform selection, sortable column headers, several rows at once
             for copying, and a menu on the rows. The host sorts — it bounds
             the sample by the same order — so a header click asks the panel
             to sort rather than reordering rows locally. The Started column
             folds away when the panel is narrow (see the code-behind). -->
        <DataGrid
            x:Name="ProcessGrid"
            Classes="DatabaseGrid ProcessTable"
            AutoGenerateColumns="False"
            ItemsSource="{Binding Processes}"
            SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
            IsReadOnly="True"
            CanUserReorderColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            SelectionMode="Extended"
            Sorting="OnProcessSorting"
            IsVisible="{Binding ShowContent, FallbackValue=False}"
            AutomationProperties.Name="Process list">
          <DataGrid.ContextMenu>
            <ContextMenu x:Name="ProcessContextMenu" Opening="OnProcessContextMenuOpening">
              <MenuItem x:Name="CopyRowsMenuItem" Header="Copy" Click="OnCopyRowsClick" />
              <MenuItem x:Name="CopyNameMenuItem" Header="Copy Name" Click="OnCopyNameClick" />
              <MenuItem x:Name="CopyProcessIdMenuItem" Header="Copy Process ID" Click="OnCopyProcessIdClick" />
              <Separator />
              <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn
                x:DataType="vm:ProcessMonitorEntryViewModel"
                Tag="ProcessId"
                CellStyleClasses="NumericCell"
                FontFamily="{DynamicResource ShellDataFontFamily}"
                Header="PID"
                Binding="{Binding ProcessId}"
                CanUserSort="True"
                Width="72" />
            <DataGridTextColumn
                x:DataType="vm:ProcessMonitorEntryViewModel"
                Tag="Name"
                Header="Name"
                Binding="{Binding Name}"
                CanUserSort="True"
                Width="*"
                MinWidth="140" />
            <DataGridTextColumn
                x:DataType="vm:ProcessMonitorEntryViewModel"
                Tag="Cpu"
                CellStyleClasses="NumericCell"
                FontFamily="{DynamicResource ShellDataFontFamily}"
                Header="CPU"
                Binding="{Binding Cpu}"
                CanUserSort="True"
                Width="80" />
            <DataGridTextColumn
                x:DataType="vm:ProcessMonitorEntryViewModel"
                Tag="Memory"
                CellStyleClasses="NumericCell"
                FontFamily="{DynamicResource ShellDataFontFamily}"
                Header="Memory"
                Binding="{Binding Memory}"
                CanUserSort="True"
                Width="100" />
            <DataGridTextColumn
                x:DataType="vm:ProcessMonitorEntryViewModel"
                Tag="Started"
                Header="Started"
                Binding="{Binding Started}"
                CanUserSort="False"
                Width="140" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:StateOverlay
            Kind="Loading"
            Heading="Waiting for first sample…"
            Body="Command lines, users, environments, and open files aren’t shown."
            IsVisible="{Binding ShowLoading, FallbackValue=False}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Processes loading" />

        <controls:StateOverlay
            Kind="TerminalError"
            Glyph="ErrorCircle"
            Heading="{Binding IssueTitle}"
            Body="{Binding IssueMessage}"
            ActionLabel="Retry"
            ActionCommand="{Binding RefreshCommand}"
            IsVisible="{Binding ShowTerminalError, FallbackValue=False}"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="Processes unavailable" />

        <controls:StateOverlay
            Kind="Empty"
            Glyph="Search"
            Heading="Processes stopped"
            Body="This panel stopped before its first sample. Open a new Processes panel to start again."
            IsVisible="{Binding ShowUnavailable, FallbackValue=False}"
            AutomationProperties.Name="Processes stopped" />

        <!-- No rows left: the table keeps its column headers, and the reason
             sits under them, clear of the header row. -->
        <controls:StateOverlay
            Margin="{controls:Inset Top=Xl}"
            Kind="NoResults"
            Heading="{Binding NoProcessesHeading}"
            Body="{Binding NoProcessesBody}"
            IsVisible="{Binding ShowNoProcesses, FallbackValue=False}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding NoProcessesHeading}" />
      </Grid>

    </Grid>
  </controls:PanelChrome>
</UserControl>
