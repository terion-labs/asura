<UserControl
    x:Class="Asura.App.Views.RuntimePanels.FileRuntimePanelView"
    x:DataType="vm:FileRuntimePanelViewModel"
    x:Name="FileRuntimePanelRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:vm="using:Asura.App.ViewModels"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    Container.Name="filePanel"
    Container.Sizing="Width">
  <UserControl.Styles>
    <!--
      A panel is not a window: two of these can sit side by side in one, and how
      much room this one has is nothing to do with how wide the screen is. So the
      toolbar answers to the panel's own width.

      At this width the action buttons go and the overflow beside them stays.
      Nothing becomes unreachable by it: the overflow menu lists every one of
      them already, because both are the same list of actions.
    -->
    <ContainerQuery Name="filePanel" Query="max-width:660">
      <Style Selector="StackPanel#FileToolbarActionStrip">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="components|CountPill#FileListingCount">
        <Setter Property="IsCompact" Value="True" />
      </Style>
      <!-- And the search box takes what a search box needs rather than what it
           would like, so the path it sits beside stays readable. -->
      <Style Selector="TextBox#FileFilterBox">
        <Setter Property="Width" Value="110" />
      </Style>
    </ContainerQuery>
    <!-- A row's icon is sized from the icon ramp, so it grows with the text
         beside it: the list size in rows, the tile size in the grid. The
         system icon and the stand-in glyph share one box. -->
    <Style Selector="Panel.FileEntryIcon">
      <Setter Property="Width" Value="{DynamicResource ShellIconSizeMd}" />
      <Setter Property="Height" Value="{DynamicResource ShellIconSizeMd}" />
    </Style>
    <Style Selector="Panel.FileEntryIcon.large">
      <Setter Property="Width" Value="{DynamicResource ShellIconSizeLg}" />
      <Setter Property="Height" Value="{DynamicResource ShellIconSizeLg}" />
    </Style>
    <Style Selector="Panel.FileEntryIcon icons|SymbolIcon">
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeMd}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.FileEntryIcon.large icons|SymbolIcon">
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeLg}" />
    </Style>
    <Style Selector="ListBoxItem.transferDropTarget /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
    <!-- Column headers are table cells, not content-sized push buttons. Keep
         their hit target and hover wash flush with the full column while the
         active header alone carries the current direction. -->
    <Style Selector="Button.FileColumnHeader">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.FileColumnHeader /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.FileColumnHeader:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <Style Selector="icons|SymbolIcon.FileSortIndicator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.FileColumnHeader.sorted TextBlock.Eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.FileColumnHeader.sorted icons|SymbolIcon.FileSortAscending">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.FileColumnHeader.sorted.descending icons|SymbolIcon.FileSortAscending">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.FileColumnHeader.sorted.descending icons|SymbolIcon.FileSortDescending">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The Docker panel hosts this exact view inside its own panel chrome. In
         embedded mode only that outer chrome disappears; the toolbar, layouts,
         listing, preview, states, menus, and interaction code remain this same
         component. -->
    <Style Selector="controls|PanelChrome.embedded /template/ Border.PanelHeader">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="controls|PanelChrome.embedded /template/ Border.PanelFooter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="controls|PanelChrome.embedded /template/ controls|SurfaceCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </UserControl.Styles>
  <controls:PanelChrome
      Classes.embedded="{Binding IsEmbedded, ElementName=FileRuntimePanelRoot}"
      CloseLabel="Close Files panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <controls:StatusMark Tone="{Binding StatusTone}" Description="{Binding StatusDescription}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          IsEnabled="{Binding CanSelectProfile}"
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FileConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <Grid RowDefinitions="Auto,*">
      <Border
          Grid.Row="0"
          Padding="{controls:Inset Left=Sm, Top=Xs, Right=Sm, Bottom=Sm}"
          Background="{DynamicResource ShellSurfaceBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Border
              Classes="FileToolbarGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="SecondaryButton" Content="Previous Page"
                  Command="{Binding PreviousPageCommand}" IsVisible="{Binding HasPreviousPage}" />
              <Button Classes="SecondaryButton" Content="Next Page"
                  Command="{Binding NextPageCommand}" IsVisible="{Binding HasNextPage}" />
              <Button Classes="IconButton FileToolbarAction" Click="OnNavigateUpClick" IsEnabled="{Binding CanNavigateUp}" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder">
                <icons:SymbolIcon Symbol="ArrowUp" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button Classes="IconButton FileToolbarAction" Click="OnRefreshClick" ToolTip.Tip="Refresh location" AutomationProperties.Name="Refresh files">
                <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
            </StackPanel>
          </Border>
          <Grid
              Grid.Column="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceXs}">
            <TextBox
                Background="Transparent"
                BorderThickness="0"
                Text="{Binding LocationText}"
                IsEnabled="{Binding CanEditLocation}"
                KeyDown="OnLocationKeyDown"
                AutomationProperties.Name="Editable file location" />
            <components:CountPill
                x:Name="FileListingCount"
                Grid.Column="1"
                IsVisible="{Binding HasListingSummary}"
                Value="{Binding Status}"
                CompactValue="{Binding ShortStatus}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Files item count" />
          </Grid>
          <Border
              Grid.Column="2"
              Classes="FileToolbarGroup">
            <StackPanel Orientation="Horizontal">
              <Button
                  Classes="IconButton FileToolbarAction"
                  ToolTip.Tip="Sort and view options"
                  AutomationProperties.Name="Open file sort and view options">
                <icons:SymbolIcon Symbol="Grid" FontSize="{DynamicResource ShellIconSizeMd}" />
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Width="250" Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock Classes="Eyebrow" Text="View options" />
                      <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock VerticalAlignment="Center" Classes="Muted" Text="Sort by" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SortField}" AutomationProperties.Name="File sort field" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Classes="Muted" Text="Order" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SortDirection}" AutomationProperties.Name="File sort direction" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Classes="Muted" Text="Layout" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" AutomationProperties.Name="File view mode" />
                      </Grid>
                      <CheckBox IsChecked="{Binding ShowHidden}" Content="Show hidden files" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                  Classes="IconButton FileToolbarAction InsetToggle"
                  Classes.active="{Binding IsPreviewVisible}"
                  Click="OnTogglePreviewClick"
                  ToolTip.Tip="Show or hide preview"
                  AutomationProperties.Name="Show or hide file preview"
                  AutomationProperties.ItemStatus="{Binding PreviewVisibilityStatus}">
                <icons:SymbolIcon Symbol="PanelRight" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
              <!-- The actions themselves are data, and this strip is one of the
                   three places that data is shown. When the panel narrows the
                   strip goes and the overflow beside it stays, which is where
                   every one of these already is. -->
              <StackPanel x:Name="FileToolbarActionStrip" Orientation="Horizontal">
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <ItemsControl ItemsSource="{Binding ToolbarActions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FileActionViewModel">
                    <StackPanel Orientation="Horizontal">
                      <Border
                          Width="1"
                          Margin="{DynamicResource ShellToolbarSeparatorMargin}"
                          Background="{DynamicResource ShellBorderBrush}"
                          IsVisible="{Binding StartsGroup}" />
                      <Button
                          Classes="IconButton FileToolbarAction"
                          Command="{Binding Command}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip.Tip="{Binding Description}"
                          AutomationProperties.Name="{Binding Description}">
                        <icons:SymbolIcon Symbol="{Binding Symbol}" FontSize="{DynamicResource ShellIconSizeMd}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button x:Name="FileActionsOverflowButton" Classes="IconButton FileToolbarAction" ToolTip.Tip="More file actions" AutomationProperties.Name="Open more file actions">
                <icons:SymbolIcon Symbol="MoreCircle" FontSize="{DynamicResource ShellIconSizeMd}" />
                <Button.Flyout>
                  <MenuFlyout Placement="Bottom">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" x:DataType="vm:FileActionViewModel" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Command" Value="{Binding Command}" />
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="InputGesture" Value="{Binding Gesture}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                    <MenuFlyout.ItemTemplate>
                      <DataTemplate DataType="vm:FileActionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                          <icons:SymbolIcon VerticalAlignment="Center" Symbol="{Binding Symbol}" FontSize="{DynamicResource ShellIconSizeSm}" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                        </StackPanel>
                      </DataTemplate>
                    </MenuFlyout.ItemTemplate>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Border>
          <controls:SearchField
              x:Name="FileFilterBox"
              Grid.Column="3"
              Width="180"
              Text="{Binding Filter}"
              PlaceholderText="{Binding FilterPlaceholder}"
              AutomationProperties.Name="{Binding FilterAccessibleName}" />
        </Grid>
      </Border>

      <Grid x:Name="FileContentGrid" Grid.Row="1">
        <!-- The division belongs to the panel, not to this view: a view is
             rebuilt on every relayout, and one holding the widths itself comes
             back with the ones written here while the panel still remembers a
             hidden preview — which is how a closed preview left its column
             behind as empty space. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding FileListColumnWidth, Mode=TwoWay}" />
          <ColumnDefinition Width="{Binding PreviewSplitterWidth}" />
          <ColumnDefinition Width="{Binding PreviewColumnWidth, Mode=TwoWay}" MinWidth="{Binding PreviewColumnMinWidth}" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid RowDefinitions="Auto,*">
            <!-- One menu over all three layouts, and over the space below the
                 last row as well: what it offers is decided when it opens, from
                 whether the press landed on a file or on the folder behind
                 them. Three menus in the markup would be three places to add
                 the next action to. -->
            <Grid.ContextMenu>
              <ContextMenu x:Name="FileListContextMenu" Opening="OnFileContextMenuOpening">
                <ContextMenu.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" x:DataType="vm:FileActionViewModel" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="InputGesture" Value="{Binding Gesture}" />
                  </ControlTheme>
                </ContextMenu.ItemContainerTheme>
                <ContextMenu.ItemTemplate>
                  <DataTemplate DataType="vm:FileActionViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon VerticalAlignment="Center" Symbol="{Binding Symbol}" FontSize="{DynamicResource ShellIconSizeSm}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ContextMenu.ItemTemplate>
              </ContextMenu>
            </Grid.ContextMenu>
            <Border
                MinHeight="{controls:TextScaled 29}"
                Background="{DynamicResource ShellSurfaceBrush}"
                IsVisible="{Binding IsDetailsView}">
              <!-- Its width is the room the rows have: the panel narrows the
                   size and date columns to fit it rather than letting the
                   date run off the edge. -->
              <Grid x:Name="FileDetailsHeaderGrid" Margin="{controls:Inset Horizontal=Md}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding FileNameColumnWidth, Mode=TwoWay}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileNameColumnMinWidth}" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="{Binding FileSizeColumnWidth, Mode=TwoWay}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileSizeColumnMinWidth}" MaxWidth="{Binding FileSizeColumnMaxWidth}" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="{Binding FileModifiedColumnWidth, Mode=TwoWay}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileModifiedColumnMinWidth}" MaxWidth="{Binding FileModifiedColumnMaxWidth}" />
                </Grid.ColumnDefinitions>
                <Button
                    Classes="FileColumnHeader"
                    Classes.sorted="{Binding IsSortingByName}"
                    Classes.descending="{Binding IsSortDescending}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="0"
                    Click="OnSortNameClick"
                    AutomationProperties.Name="Sort files by name"
                    AutomationProperties.ItemStatus="{Binding NameSortStatus}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Name" TextTrimming="CharacterEllipsis" />
                    <Panel Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortAscending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronUp" />
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortDescending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronDown" />
                    </Panel>
                  </Grid>
                </Button>
                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource ShellBorderBrush}" IsHitTestVisible="False" />
                <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="Resize file name and size columns" />
                <Button
                    Grid.Column="2"
                    Classes="FileColumnHeader"
                    Classes.sorted="{Binding IsSortingBySize}"
                    Classes.descending="{Binding IsSortDescending}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="{controls:Inset Horizontal=Sm}"
                    Click="OnSortSizeClick"
                    AutomationProperties.Name="Sort files by size"
                    AutomationProperties.ItemStatus="{Binding SizeSortStatus}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Size" TextTrimming="CharacterEllipsis" />
                    <Panel Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortAscending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronUp" />
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortDescending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronDown" />
                    </Panel>
                  </Grid>
                </Button>
                <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{DynamicResource ShellBorderBrush}" IsHitTestVisible="False" />
                <GridSplitter
                    Grid.Column="3"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="Resize file size and modified columns" />
                <Button
                    x:Name="ModifiedColumnHeader"
                    Grid.Column="4"
                    Classes="FileColumnHeader"
                    Classes.sorted="{Binding IsSortingByModified}"
                    Classes.descending="{Binding IsSortDescending}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="{controls:Inset Horizontal=Sm}"
                    Click="OnSortModifiedClick"
                    AutomationProperties.Name="Sort files by modified date"
                    AutomationProperties.ItemStatus="{Binding ModifiedSortStatus}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Modified" TextTrimming="CharacterEllipsis" />
                    <Panel Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortAscending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronUp" />
                      <icons:SymbolIcon
                          Classes="FileSortIndicator FileSortDescending"
                          FontSize="{DynamicResource ShellIconSizeXs}"
                          IsHitTestVisible="False"
                          Symbol="ChevronDown" />
                    </Panel>
                  </Grid>
                </Button>
              </Grid>
            </Border>
            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                IsTextSearchEnabled="True"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsDetailsView}"
                AutomationProperties.Name="Files and folders">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="30" Margin="{controls:Inset Horizontal=Md}">
                    <!-- Same minimums as the header row: when width runs out, a
                         minimum only one of the two grids honors makes the
                         header stop shrinking while the rows keep collapsing,
                         and the columns visibly part ways. -->
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileNameColumnWidth}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileNameColumnMinWidth}" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileSizeColumnWidth}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileSizeColumnMinWidth}" MaxWidth="{Binding $parent[UserControl].DataContext.FileSizeColumnMaxWidth}" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileModifiedColumnWidth}" MinWidth="{x:Static vm:FileRuntimePanelViewModel.FileModifiedColumnMinWidth}" MaxWidth="{Binding $parent[UserControl].DataContext.FileModifiedColumnMaxWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Panel Classes="FileEntryIcon" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                        <icons:SymbolIcon Symbol="Folder" IconVariant="Filled" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding ShowsFolderGlyph}" />
                        <icons:SymbolIcon Symbol="{Binding Glyph}" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding ShowsFileGlyph}" />
                      </Panel>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellBaseFontSize}" Classes="MiddleTruncated" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Size}" TextTrimming="CharacterEllipsis" />
                    <components:FittingTextBlock Grid.Column="4" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" FullText="{Binding Modified}" CompactText="{Binding ModifiedCompact}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                IsTextSearchEnabled="True"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsListView}"
                AutomationProperties.Name="Files and folders, compact list">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="30" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <Panel Classes="FileEntryIcon" VerticalAlignment="Center">
                      <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                      <icons:SymbolIcon Symbol="Folder" IconVariant="Filled" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding ShowsFolderGlyph}" />
                      <icons:SymbolIcon Symbol="{Binding Glyph}" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding ShowsFileGlyph}" />
                    </Panel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellBaseFontSize}" Classes="MiddleTruncated" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Size}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Margin="{controls:Inset Sm}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                IsTextSearchEnabled="True"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsGridView}"
                AutomationProperties.Name="Files and folders, grid">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <controls:SurfaceCard Padding="0" Width="{controls:TextScaled 142}" MinHeight="{controls:TextScaled 88}" Margin="{controls:Inset Xs}">
                    <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                      <Panel Classes="FileEntryIcon large" HorizontalAlignment="Left">
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                        <icons:SymbolIcon Symbol="Folder" IconVariant="Filled" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding ShowsFolderGlyph}" />
                        <icons:SymbolIcon Symbol="{Binding Glyph}" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding ShowsFileGlyph}" />
                      </Panel>
                      <TextBlock FontSize="{DynamicResource ShellBaseFontSize}" Classes="MiddleTruncated" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Size}" />
                    </StackPanel>
                  </controls:SurfaceCard>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border
              Background="{DynamicResource ShellSurfaceBrush}"
              IsVisible="{Binding ShowLoadingState}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Files loading">
            <controls:StateOverlay
                Kind="Loading"
                Heading="{Binding ContentPresentation.Title}"
                Body="{Binding ContentPresentation.Message}" />
          </Border>
          <controls:StateOverlay
              Kind="Retry"
              Heading="Location unavailable"
              Body="Use Retry to read this location again."
              IsVisible="{Binding ShowErrorState}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding ContentPresentation.AccessibleName}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ContentPresentation.SuggestedAction}" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Left" Classes="SecondaryButton" Command="{Binding RetryCommand}" Content="Retry" IsVisible="{Binding CanRetryContentState}" AutomationProperties.Name="Retry reading this location" />
            </StackPanel>
          </controls:StateOverlay>
          <controls:StateOverlay
              Kind="Empty"
              Heading="{Binding ContentPresentation.Title}"
              Body="{Binding ContentPresentation.Message}"
              IsVisible="{Binding ShowEmptyLocationState}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Files empty location">
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </controls:StateOverlay>
          <controls:StateOverlay
              Kind="NoResults"
              Heading="{Binding ContentPresentation.Title}"
              Body="{Binding ContentPresentation.Message}"
              IsVisible="{Binding ShowSearchNoResultsState}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Files search has no results">
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </controls:StateOverlay>

          <ProgressBar Classes="WorkingStripe" IsVisible="{Binding ShowNavigationProgress}" />
        </Grid>

        <Border
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="{DynamicResource ShellBorderBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsPreviewVisible}" />
        <GridSplitter
            x:Name="PreviewSplitter"
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            IsVisible="{Binding IsPreviewVisible}"
            AutomationProperties.Name="Resize file preview" />

        <Border
            Grid.Column="2"
            IsVisible="{Binding IsPreviewVisible}">
          <Grid RowDefinitions="Auto,Auto,Auto,*">
            <!-- The name has the header to itself, so a long one keeps both
                 its ends rather than giving way to an option beside it. -->
            <Border Background="{DynamicResource ShellSurfaceBrush}" MinHeight="{controls:TextScaled 29}">
              <TextBlock
                  Margin="{controls:Inset Horizontal=Md}"
                  VerticalAlignment="Center"
                  Classes="Headline MiddleTruncated"
                  Text="{Binding PreviewTitle}"
                  ToolTip.Tip="{Binding PreviewTitle}" />
            </Border>
            <!-- Only providers that transfer preview bytes onto the host
                 need this choice, so it sits under the name, not beside it. -->
            <CheckBox
                Grid.Row="1"
                Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                FontSize="{DynamicResource ShellSecondaryFontSize}"
                Content="{Binding AutoDownloadPreviewLabel}"
                IsChecked="{Binding AutoDownloadPreviews, Mode=TwoWay}"
                IsVisible="{Binding RequiresHostTransferForPreview}"
                AutomationProperties.Name="Automatically preview files under the size threshold" />
            <controls:SurfaceCard Padding="0" Grid.Row="2" Margin="{controls:Inset Sm}" IsVisible="{Binding HasSelectedMetadata}">
              <StackPanel>
                <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ShellSpaceSm}" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Kind" /><TextBlock FontSize="{DynamicResource ShellBaseFontSize}" Text="{Binding SelectedMetadata.Kind}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedMetadata.Kind}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Size" /><TextBlock FontSize="{DynamicResource ShellBaseFontSize}" Text="{Binding SelectedMetadata.Size}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Modified" /><TextBlock FontSize="{DynamicResource ShellBaseFontSize}" Text="{Binding SelectedMetadata.Modified}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedMetadata.Modified}" /></StackPanel>
                </Grid>
                <!-- A provider's version tag is a hash to most people: kept
                     behind a disclosure, and absent when there is none. -->
                <Expander
                    Margin="{controls:Inset Horizontal=Sm}"
                    Header="Version"
                    IsVisible="{Binding SelectedMetadata.HasVersion, FallbackValue=False}">
                  <SelectableTextBlock
                      FontFamily="{DynamicResource ShellDataFontFamily}"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="{Binding SelectedMetadata.Version}"
                      TextWrapping="Wrap" />
                </Expander>
                <!-- Preview or source, along the bottom of the details: the
                     same two segments for every format, so the side that
                     shows the file as written is always the same side. -->
                <Border
                    Background="{DynamicResource ShellSurfaceBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{controls:Inset Horizontal=Md, Vertical=Xs}"
                    IsVisible="{Binding HasPreviewToggles}">
                  <ItemsControl ItemsSource="{Binding PreviewToggles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PreviewToggleViewModel">
                        <controls:SegmentedControl
                            Classes="FilePreviewMode"
                            SelectedIndex="{Binding SelectedSegment, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                          <RadioButton Content="{x:Static vm:PreviewToggleViewModel.PreviewLabel}" />
                          <RadioButton Content="{Binding Label}" />
                        </controls:SegmentedControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </controls:SurfaceCard>
            <Grid Grid.Row="3">
              <!-- Every preview follows the details card at the card's own
                   bottom margin and lines up with its sides: a top margin of
                   its own would double the gap under the card. -->
              <components:CodePreviewView
                  Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}"
                  IsVisible="{Binding HasSourcePreview}"
                  Text="{Binding PreviewText}"
                  WordWrap="{Binding WrapPreviewText}"
                  FileName="{Binding PreviewTitle}" />
              <!-- A file shown as its bytes, a screenful at a time. -->
              <components:HexPreviewView
                  Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}"
                  DataContext="{Binding PreviewHex}"
                  IsVisible="{Binding $parent[UserControl].DataContext.HasHexPreview}" />
              <!-- A delimited file is shown as the table it describes. -->
              <components:PreviewTableView
                  Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}"
                  DataContext="{Binding PreviewTable}"
                  IsVisible="{Binding $parent[UserControl].DataContext.HasTablePreview}" />
              <!-- A format the shell cannot show is named and given a symbol,
                   rather than answered with a wall of hex nobody asked for. -->
              <StackPanel
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{DynamicResource ShellSpaceSm}"
                  IsVisible="{Binding HasBinaryPreview}">
                <icons:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource ShellIconSizeXl}"
                    Foreground="{DynamicResource ShellMutedBrush}"
                    Symbol="{Binding PreviewBinary.Symbol}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Headline"
                    Text="{Binding PreviewBinary.FormatName}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    Text="{Binding PreviewBinary.Detail}" />
              </StackPanel>
              <!-- An archive is listed, never unpacked. A long one is paged
                   from the listing's own footer, beside its summary, so the
                   entries follow the details card directly. -->
              <components:PreviewTreeView
                  x:Name="ArchivePreview"
                  Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}"
                  DataContext="{Binding PreviewTree}"
                  IsVisible="{Binding $parent[UserControl].DataContext.HasTreePreview}" />
              <!-- Markdown is laid out as native controls, so its text stays
                   selectable and copyable like any other text in the shell. -->
              <ScrollViewer
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding HasMarkdownPreview}">
                <components:MarkdownPreviewView
                    ContinuousSelection="True"
                    Padding="{controls:Inset Horizontal=Lg, Bottom=Lg}"
                    Text="{Binding PreviewText}" />
              </ScrollViewer>
              <!-- A database file previews as the database viewer itself,
                   sharing the docked panel's workspace component. Embedded,
                   it carries its own perspectives row and forwards the same
                   open-object requests a docked database panel would. -->
              <components:DatabaseWorkspaceView
                  DataContext="{Binding DatabasePreview}"
                  IsEmbedded="True"
                  OpenObjectInTabRequested="OnDatabaseObjectOpenInTab"
                  OpenObjectInPanelRequested="OnDatabaseObjectOpenInPanel"
                  OpenInViewerRequested="OnDatabaseOpenInViewer"
                  IsVisible="{Binding $parent[UserControl].DataContext.HasDatabasePreview}" />
              <!-- Fitted to start with, then zoomed, panned and turned: a
                   preview opens showing the whole picture, and detail is
                   reached without leaving the panel. PDF pages share it. -->
              <components:ZoomableImageView
                  Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}"
                  Source="{Binding PreviewImage}"
                  IsVisible="{Binding HasImagePreview}" />

              <!-- A PDF is paged through rather than scrolled as one image: the
                   page being looked at is the only one rendered. -->
              <!-- Left, because the zoom controls own the bottom-right corner:
                   the two bars sit side by side instead of on top of each
                   other when the preview column is narrow. -->
              <Border
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Left"
                  Margin="{controls:Inset Md}"
                  Padding="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                  Background="{DynamicResource ShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ShellBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ShellControlCornerRadius}"
                  IsVisible="{Binding HasPdfPreview}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <Button
                      Classes="IconButton"
                      Click="OnPdfPageBackClick"
                      IsEnabled="{Binding CanTurnPdfPageBack}"
                      ToolTip.Tip="Previous page"
                      AutomationProperties.Name="Previous PDF page">
                    <icons:SymbolIcon Symbol="ChevronLeft" FontSize="{DynamicResource ShellIconSizeSm}" />
                  </Button>
                  <controls:LiveRegionTextBlock
                      VerticalAlignment="Center"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="{Binding PdfPageStatus}"
                      AutomationProperties.LiveSetting="Polite" />
                  <Button
                      Classes="IconButton"
                      Click="OnPdfPageForwardClick"
                      IsEnabled="{Binding CanTurnPdfPageForward}"
                      ToolTip.Tip="Next page"
                      AutomationProperties.Name="Next PDF page">
                    <icons:SymbolIcon Symbol="ChevronRight" FontSize="{DynamicResource ShellIconSizeSm}" />
                  </Button>
                </StackPanel>
              </Border>

              <!-- HTML renders in the same embedded Chromium engine used by
                   browser panels. -->
              <ContentControl
                  x:Name="HtmlPreviewHost"
                  IsVisible="{Binding HasHtmlPreview}" />
              <!-- A strip along the top rather than a curtain over the panel:
                   a reading being prepared should say so without taking away
                   the one already on screen. -->
              <ProgressBar
                  Classes="WorkingStripe"
                  IsVisible="{Binding IsPreviewLoading}"
                  AutomationProperties.Name="Preparing preview" />
              <controls:StateOverlay
                  Kind="Loading"
                  Heading="Reading preview…"
                  IsVisible="{Binding ShowPreviewProgressDetail}" />
              <controls:StateOverlay
                  Kind="Empty"
                  Body="Select a file to preview it."
                  IsVisible="{Binding ShowPreviewPlaceholder}" />

              <!-- The preview of a remote file is a download, so it is offered
                   rather than taken. Space activates it because the file list
                   keeps focus while browsing. -->
              <StackPanel
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{DynamicResource ShellSpaceSm}"
                  IsVisible="{Binding ShowPreviewDownloadPrompt}">
                <Button
                    x:Name="PreviewDownloadButton"
                    Classes="PrimaryButton"
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="0"
                    Click="OnPreviewDownloadClick"
                    ToolTip.Tip="Download and preview (Space)"
                    AutomationProperties.Name="Download this file and preview it">
                  <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Eye" FontSize="{DynamicResource ShellIconSizeLg}" />
                </Button>
                <TextBlock
                    MaxWidth="260"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    Text="{Binding PreviewDownloadPromptDetail}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                    Text="Press Space to preview" />
              </StackPanel>

            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border
          Grid.Row="0"
          Grid.RowSpan="2"
          Background="Transparent"
          IsVisible="{Binding ShowNavigationProgress}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Files loading folder" />
      <Rectangle
          x:Name="TransferDropOutline"
          Grid.RowSpan="2"
          Margin="{DynamicResource ShellHairlineInset}"
          IsHitTestVisible="False"
          IsVisible="False"
          RadiusX="{DynamicResource ShellCardRadius}"
          RadiusY="{DynamicResource ShellCardRadius}"
          Stroke="{DynamicResource ShellAccentBrush}"
          StrokeDashArray="4,3"
          StrokeThickness="2"
          AutomationProperties.Name="File transfer drop target" />
    </Grid>
  </controls:PanelChrome>
</UserControl>
