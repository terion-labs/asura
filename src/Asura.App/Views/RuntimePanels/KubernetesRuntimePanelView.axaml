<UserControl x:Class="Asura.App.Views.RuntimePanels.KubernetesRuntimePanelView"
    x:DataType="vm:KubernetesRuntimePanelViewModel" x:Name="PanelRoot"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels" xmlns:app="using:Asura.Application"
    xmlns:controls="using:Asura.App.Controls" xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia" xmlns:panels="using:Asura.App.Views.RuntimePanels"
    Classes="RuntimePanelFocusTarget" Focusable="True" IsVisible="{Binding IsVisibleInLayout}"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Kubernetes panel">
  <UserControl.Styles>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="{DynamicResource ShellFontSize12}" /><Setter Property="Padding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" /></Style>
    <Style Selector="Button.KubernetesNavigation"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="{controls:Inset Horizontal=Md, Vertical=Xs}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="Button.KubernetesNavigation.selected"><Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" /></Style>
    <Style Selector="TextBlock.KubernetesStatus.healthy"><Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" /></Style>
    <Style Selector="TextBlock.KubernetesStatus.warning"><Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" /></Style>
    <Style Selector="TextBlock.KubernetesStatus.error"><Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" /></Style>
    <Style Selector="Button.KubernetesTableLink"><Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="{controls:Inset Horizontal=Sm}" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="TextBlock.KubernetesLinkText"><Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" /></Style>
    <Style Selector="DataGridRow:selected TextBlock.KubernetesLinkText"><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" /></Style>
    <Style Selector="DataGrid.KubernetesTable"><Setter Property="GridLinesVisibility" Value="Horizontal" /></Style>
    <Style Selector="ListBox.KubernetesResources"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.KubernetesResources ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <controls:PanelChrome Title="{Binding Title}" CloseLabel="Close Kubernetes panel" CloseRequested="OnCloseClick"
      SplitRequested="OnSplitRequested" IsActive="{Binding IsActive}" IsZoomed="{Binding IsZoomed}"
      HasAttention="{Binding HasAttention}" IsAgentActive="{Binding IsAgentActive}" IsNotificationPulseActive="{Binding IsNotificationPulseActive}">
    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).KubernetesPanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}" ConnectionSelected="OnConnectionSelected" NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>
    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
      <Button Classes="IconButton" Click="OnToggleNavigatorClick" AutomationProperties.Name="Toggle Kubernetes navigator" ToolTip.Tip="Toggle navigator"><icons:SymbolIcon Symbol="Navigation" FontSize="{DynamicResource ShellFontSize12}" /></Button>
      <Button Content="Forwards" IsVisible="{Binding HasForwards}" Click="OnShowForwardsClick" />
      <Button Classes="IconButton" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh Kubernetes resources" ToolTip.Tip="Refresh resources">
        <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
      </Button>
      </StackPanel>
    </controls:PanelChrome.Actions>
    <controls:PanelChrome.Footer>
      <TextBlock Classes="Muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </controls:PanelChrome.Footer>
    <Grid RowDefinitions="Auto,Auto,*">
      <controls:Callout Margin="{controls:Inset Horizontal=Md}" IsVisible="{Binding HasIssue}" Title="Kubernetes request failed" Text="{Binding Issue}" />
      <ProgressBar Grid.Row="1" Classes="WorkingStripe" IsVisible="{Binding IsBusy}" IsIndeterminate="True" AutomationProperties.Name="Loading Kubernetes resources" />
      <Grid Grid.Row="2" IsVisible="{Binding HasConnection}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding NavigatorColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border IsVisible="{Binding IsNavigatorVisible}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource ShellSurfaceBrush}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Text="Navigator" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ContextName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ContextName}" Classes="Muted" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding NavigationGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesNavigationGroup">
                <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesNavigationItem">
                    <Button Classes="KubernetesNavigation" Classes.selected="{Binding IsSelected}" Content="{Binding Title}" ToolTip.Tip="{Binding Title}" Command="{Binding SelectCommand}" Click="OnNavigationClick" AutomationProperties.Name="{Binding Title}" />
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Expander>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Column="1">
      <TabItem x:Name="ResourcesTab" Header="{Binding ResourceTitle}">
      <Grid x:Name="BrowserBody" IsVisible="{Binding HasConnection}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ResourceColumnWidth}" /><ColumnDefinition Width="{Binding InspectorColumnWidth}" /></Grid.ColumnDefinitions>
        <Grid x:Name="ResourceBrowser" Grid.ColumnSpan="2" IsVisible="{Binding IsResourceBrowserVisible}" RowDefinitions="Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="{controls:Inset Sm}" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <ComboBox x:Name="NamespacePicker" ItemsSource="{Binding NamespaceChoices}" SelectedItem="{Binding NamespaceSelection, Mode=TwoWay}" IsVisible="{Binding IsNamespaceScopeVisible}" IsEnabled="{Binding !IsBusy}" MinWidth="150" MaxWidth="220" HorizontalAlignment="Stretch" PlaceholderText="Choose namespace" AutomationProperties.Name="Kubernetes namespace" />
            <TextBox Grid.Column="1" Text="{Binding Filter, Mode=TwoWay}" PlaceholderText="Search resources…" AutomationProperties.Name="Filter Kubernetes resources" />
            <TextBlock Grid.Column="2" Text="{Binding ResourceCountLabel}" Classes="Muted" VerticalAlignment="Center" />
          </Grid>
          <DataGrid Grid.Row="1" x:Name="ResourceList" Classes="DatabaseGrid KubernetesTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionMode="Single" AutomationProperties.Name="Kubernetes resources">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="3*" MinWidth="320"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Namespace" SortMemberPath="Namespace" Width="120" MinWidth="120" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNamespaceScopeVisible}"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow">
                <Grid><TextBlock Text="{Binding Namespace}" IsVisible="{Binding !CanNavigateNamespace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /><Button Classes="KubernetesTableLink" IsVisible="{Binding CanNavigateNamespace}" Command="{Binding NamespaceCommand}" ToolTip.Tip="{Binding Namespace}"><TextBlock Classes="KubernetesLinkText" Text="{Binding Namespace}" TextTrimming="CharacterEllipsis" /></Button></Grid>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="CPU" IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" Binding="{Binding Cpu}" SortMemberPath="CpuValue" Width="70" MinWidth="70" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Memory" IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" Binding="{Binding Memory}" SortMemberPath="MemoryValue" Width="100" MinWidth="100" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Ready" Binding="{Binding Ready}" Width="80" MinWidth="80" IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Restarts" Binding="{Binding Restarts}" SortMemberPath="RestartCount" Width="100" MinWidth="100" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}" />
              <DataGridTemplateColumn Header="Controlled by" SortMemberPath="Owner" Width="130" MinWidth="130" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow">
                <Grid><TextBlock Text="{Binding Owner}" IsVisible="{Binding !CanNavigateOwner}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Owner}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /><Button Classes="KubernetesTableLink" IsVisible="{Binding CanNavigateOwner}" Command="{Binding ControlledByCommand}" ToolTip.Tip="{Binding Owner}"><TextBlock Classes="KubernetesLinkText" Text="{Binding Owner}" TextTrimming="CharacterEllipsis" /></Button></Grid>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Node" SortMemberPath="Node" Width="130" MinWidth="130" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow">
                <Grid><TextBlock Text="{Binding Node}" IsVisible="{Binding !CanNavigateNode}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Node}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /><Button Classes="KubernetesTableLink" IsVisible="{Binding CanNavigateNode}" Command="{Binding NodeCommand}" ToolTip.Tip="{Binding Node}"><TextBlock Classes="KubernetesLinkText" Text="{Binding Node}" TextTrimming="CharacterEllipsis" /></Button></Grid>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="QoS" Binding="{Binding Qos}" Width="90" MinWidth="90" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}" />
              <DataGridTemplateColumn Header="Disk" SortMemberPath="DiskPercentValue" Width="85" MinWidth="85" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow"><TextBlock Text="{Binding Disk}" ToolTip.Tip="{Binding DiskDetail}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Taints" Binding="{Binding Taints}" Width="80" MinWidth="80" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Roles" Binding="{Binding Roles}" Width="100" MinWidth="100" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Version" Binding="{Binding Version}" Width="85" MinWidth="85" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
              <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="95" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:KubernetesResourceRow"><TextBlock Classes="KubernetesStatus" Classes.healthy="{Binding IsHealthy}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Text="{Binding Status}" VerticalAlignment="Center" Margin="{controls:Inset Horizontal=Sm}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Age" Binding="{Binding Age}" SortMemberPath="AgeSeconds" Width="80" MinWidth="80" />
              <DataGridTextColumn x:DataType="vm:KubernetesResourceRow" Header="Details" Binding="{Binding Detail}" Width="3*" MinWidth="180" IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Margin="{controls:Inset Md}" IsVisible="{Binding IsEmpty}" Classes="Muted" Text="No resources in this scope." TextWrapping="Wrap" />
          <Button Grid.Row="3" Content="Load more resources" IsVisible="{Binding HasMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" />
        </Grid>
        <Border x:Name="Inspector" Background="{DynamicResource ShellPopupSurfaceBrush}" IsVisible="{Binding IsInspectorVisible}" Grid.Column="1" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0" Padding="{controls:Inset Sm}">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
            <Button x:Name="BackButton" Classes="TextButton" Content="Back to resources" Click="OnBackClick" IsVisible="{Binding IsBackButtonVisible}" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="IconButton" Click="OnBackClick" AutomationProperties.Name="Close resource details" ToolTip.Tip="Close details"><icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellFontSize12}" /></Button>
                <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding Summary}" Classes="Muted" TextWrapping="Wrap" />
            </StackPanel>
            <TabControl x:Name="InspectorTabs" Grid.Row="2" IsVisible="{Binding HasInspectorContent}">
              <TabItem x:Name="OverviewTab" Header="Overview" IsVisible="{Binding HasSelection}"><panels:KubernetesInspectorOverviewView /></TabItem>
              <TabItem Header="YAML / JSON" IsVisible="{Binding HasSelection}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
                  <WrapPanel IsVisible="{Binding CanEditManifest}">
                    <CheckBox Content="Force field ownership" ToolTip.Tip="Explicitly replace conflicting field ownership. A new dry run is required." IsChecked="{Binding ForceOwnership, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Dry run" Command="{Binding DryRunCommand}" />
                    <Button Content="Apply changes" Command="{Binding ApplyManifestCommand}" />
                    <Button Content="Discard edits" Command="{Binding DiscardManifestCommand}" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" Text="{Binding MutationStatus}" Classes="Muted" TextWrapping="Wrap" />
                  <components:CodeEditBox x:Name="ManifestEditor" Grid.Row="2" Text="{Binding ManifestDraft, Mode=TwoWay}" GrammarExtension="{Binding ManifestGrammarExtension}" IsReadOnly="{Binding ManifestReadOnly}" ShowLineNumbers="True" WordWrap="False" AutomationProperties.Name="Kubernetes resource manifest, YAML or JSON" />
                </Grid>
              </TabItem>
              <TabItem Header="Review" IsVisible="{Binding HasMutationPreview}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <Grid RowDefinitions="Auto,*"><TextBlock Text="Current resource" /><components:CodePreviewView Grid.Row="1" Text="{Binding FormattedManifest}" FileName="resource.json" WordWrap="False" AutomationProperties.Name="Current Kubernetes resource" /></Grid>
                  <Grid Grid.Column="1" RowDefinitions="Auto,*"><TextBlock Text="Server dry run result" /><components:CodePreviewView Grid.Row="1" Text="{Binding PreviewManifest}" FileName="dry-run.json" WordWrap="False" AutomationProperties.Name="Server dry run result" /></Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Node" IsVisible="{Binding HasNodeMaintenance}">
                <ScrollViewer><StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <WrapPanel><Button Content="Review cordon" IsEnabled="{Binding !IsBusy}" Click="OnReviewCordonClick" /><Button Content="Review uncordon" IsEnabled="{Binding !IsBusy}" Click="OnReviewUncordonClick" /></WrapPanel>
                  <CheckBox Content="Allow unmanaged pods" IsChecked="{Binding AllowUnmanagedPods, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                  <CheckBox Content="Allow deletion of emptyDir data" IsChecked="{Binding DeleteEmptyDirData, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                  <Button Content="Preview drain" IsEnabled="{Binding !IsBusy}" Click="OnReviewDrainClick" />
                  <TextBlock Text="{Binding NodeStatus}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding DrainPods}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:KubernetesDrainPod">
                    <StackPanel Margin="{controls:Inset Bottom=Sm}"><TextBlock Text="{Binding Pod.Name}" /><TextBlock Text="{Binding Disposition}" Classes="Muted" /></StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Button Content="Confirm reviewed node operation" IsEnabled="{Binding CanConfirmNode}" Click="OnConfirmNodeClick" />
                  <ItemsControl ItemsSource="{Binding DrainResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:KubernetesDrainPodResult">
                    <StackPanel Margin="{controls:Inset Bottom=Sm}"><TextBlock Text="{Binding Pod.Name}" /><TextBlock Text="{Binding Outcome}" /><TextBlock Text="{Binding ErrorCode}" Classes="Muted" /></StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem Header="Actions" IsVisible="{Binding HasResourceActions}">
                <ScrollViewer><StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock Text="Each operation runs a server dry run before confirmation." Classes="Muted" TextWrapping="Wrap" />
                  <StackPanel IsVisible="{Binding CanScale}">
                    <TextBox Text="{Binding Replicas, Mode=TwoWay}" AutomationProperties.Name="Desired replica count" />
                    <Button Content="Review scale" Click="OnReviewScaleClick" />
                  </StackPanel>
                  <Button Content="Review rollout restart" IsVisible="{Binding CanRestart}" Click="OnReviewRestartClick" />
                  <Button Content="Review delete" IsVisible="{Binding CanDelete}" Click="OnReviewDeleteClick" />
                  <TextBlock Text="{Binding OperationDescription}" TextWrapping="Wrap" />
                  <Button Content="Confirm reviewed operation" IsVisible="{Binding HasOperationReview}" IsEnabled="{Binding CanConfirmOperation}" Click="OnConfirmOperationClick" />
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem x:Name="ForwardTab" Header="Ports" IsVisible="{Binding HasForwardTools}">
                <ScrollViewer><StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <StackPanel IsVisible="{Binding CanForward}" Spacing="{DynamicResource ShellSpaceSm}">
                    <TextBlock Text="{Binding DeclaredPorts}" Classes="Muted" TextWrapping="Wrap" />
                    <Button Content="Find ready backing pods" IsVisible="{Binding IsServiceForward}" IsEnabled="{Binding !IsBusy}" Click="OnResolveServiceForwardClick" />
                    <ComboBox ItemsSource="{Binding ServiceForwardChoices}" SelectedItem="{Binding SelectedServiceForward, Mode=TwoWay}" IsVisible="{Binding IsServiceForward}" PlaceholderText="Choose pod and target port" AutomationProperties.Name="Service forward destination"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:KubernetesServiceForwardChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox IsVisible="{Binding IsPodForward}" Text="{Binding ForwardPort, Mode=TwoWay}" PlaceholderText="Remote pod port, 1–65535" AutomationProperties.Name="Remote pod port" />
                    <Button Content="Start forward" Click="OnStartForwardClick" IsEnabled="{Binding !IsBusy}" />
                    <TextBlock Text="A free desktop loopback port is assigned. Forwards stay active until stopped or the workspace closes." Classes="Muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding ForwardState.Forwards}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KubernetesForwardViewModel">
                      <StackPanel Spacing="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Bottom=Md}">
                        <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Address}" IsReadOnly="True" AutomationProperties.Name="Forward local endpoint" />
                        <TextBlock Text="{Binding Status}" Classes="Muted" />
                        <Expander Header="Open database through this forward" IsVisible="{Binding CanOpenDatabase}">
                          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                            <ComboBox ItemsSource="{Binding DatabaseDrivers}" SelectedItem="{Binding DatabaseDriver, Mode=TwoWay}" AutomationProperties.Name="Forwarded database driver"><ComboBox.ItemTemplate><DataTemplate x:DataType="app:DatabaseDriverDescriptor"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBox Text="{Binding DatabaseName, Mode=TwoWay}" PlaceholderText="Database" AutomationProperties.Name="Forwarded database name" />
                            <TextBox Text="{Binding DatabaseUsername, Mode=TwoWay}" PlaceholderText="Username" AutomationProperties.Name="Forwarded database username" />
                            <TextBox Text="{Binding DatabasePassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Session password" AutomationProperties.Name="Forwarded database session password" />
                            <TextBlock Text="Temporary connection. Reopen the forward after restarting Asura. Credentials are not saved." Classes="Muted" TextWrapping="Wrap" />
                            <Button Content="Open database panel" Click="OnOpenForwardDatabaseClick" />
                          </StackPanel>
                        </Expander>
                        <WrapPanel><Button Content="Open browser" IsVisible="{Binding CanOpenBrowser}" Click="OnOpenForwardBrowserClick" /><Button Content="Stop forward" Command="{Binding StopCommand}" /></WrapPanel>
                      </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem Header="Shell" IsVisible="{Binding CanOpenShell}">
                <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                  <ComboBox ItemsSource="{Binding ContainerChoices}" SelectedItem="{Binding Container, Mode=TwoWay}" PlaceholderText="Choose container" AutomationProperties.Name="Pod terminal container" />
                  <ComboBox ItemsSource="{Binding ShellExecutables}" SelectedItem="{Binding ShellExecutable, Mode=TwoWay}" AutomationProperties.Name="Pod shell executable" />
                  <Button Content="Browse container files" IsEnabled="{Binding CanLaunchShell}" Click="OnFilesClick" />
                  <Button Content="Open pod terminal" IsEnabled="{Binding CanLaunchShell}" Click="OnShellClick" />
                  <TextBlock Text="Opens a native terminal in this pod. Commands run in the selected container." Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>
              <TabItem Header="Logs" IsVisible="{Binding CanReadLogs}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
                  <TextBox Text="{Binding Container, Mode=TwoWay}" PlaceholderText="Container, optional for single-container pods" AutomationProperties.Name="Pod log container" />
                  <WrapPanel Grid.Row="1"><CheckBox Content="Previous container" IsChecked="{Binding PreviousLogs, Mode=TwoWay}" /><Button Content="Load recent logs" Command="{Binding LoadLogsCommand}" />
                    <Button Content="Follow" IsVisible="{Binding CanFollowLogs}" IsEnabled="{Binding !FollowingLogs}" Click="OnFollowLogsClick" />
                    <Button Content="Pause" IsVisible="{Binding FollowingLogs}" Click="OnPauseLogsClick" />
                  </WrapPanel>
                  <TextBox Grid.Row="2" Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="avares://Asura.App/Assets/Fonts/JetBrainsMono#JetBrains Mono" AutomationProperties.Name="Pod logs" />
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
      </TabItem>
      <TabItem Header="Helm" IsVisible="{Binding HasHelm}">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}" Margin="{controls:Inset Md}">
          <WrapPanel><Button Content="Load releases" IsEnabled="{Binding !IsBusy}" Click="OnLoadHelmClick" /><Button Content="Load more" IsVisible="{Binding HasMoreHelm}" IsEnabled="{Binding !IsBusy}" Click="OnLoadMoreHelmClick" /></WrapPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="app:KubernetesHelmRelease">
            <controls:ListItem Title="{Binding Name}" Detail="{Binding Chart}" Metadata="{Binding Namespace}" />
          </DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Grid.Row="2" Text="Revision history" Classes="Eyebrow" />
          <TabControl Grid.Row="3">
          <TabItem Header="History"><ListBox ItemsSource="{Binding HelmHistory}"><ListBox.ItemTemplate><DataTemplate x:DataType="app:KubernetesHelmRevision">
            <StackPanel><TextBlock Text="{Binding Revision, StringFormat='Revision {0}'}" /><TextBlock Text="{Binding Chart}" /><TextBlock Text="{Binding Status}" Classes="Muted" /><TextBlock Text="{Binding Updated}" Classes="Muted" /></StackPanel>
          </DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
          <TabItem Header="Change release" IsVisible="{Binding HasHelmChanges}">
            <ScrollViewer><StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <ComboBox ItemsSource="{Binding HelmChangeKinds}" SelectedItem="{Binding HelmChangeKind, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Helm change kind" />
              <StackPanel IsVisible="{Binding IsHelmUpgrade}" IsEnabled="{Binding !IsBusy}" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBox Text="{Binding ChartReference, Mode=TwoWay}" PlaceholderText="OCI chart reference pinned with @sha256:…" AutomationProperties.Name="Pinned Helm OCI chart" />
                <TextBox Text="{Binding ChartVersion, Mode=TwoWay}" PlaceholderText="Exact chart version" AutomationProperties.Name="Helm chart version" />
                <TextBox Text="{Binding ValuesYaml, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80" MaxHeight="160" PlaceholderText="Values YAML, optional" AutomationProperties.Name="Helm values YAML" />
                <CheckBox Content="Reuse release values" IsChecked="{Binding ReuseValues, Mode=TwoWay}" />
              </StackPanel>
              <TextBox Text="{Binding RollbackRevision, Mode=TwoWay}" IsVisible="{Binding IsHelmRollback}" IsEnabled="{Binding !IsBusy}" PlaceholderText="Rollback revision" AutomationProperties.Name="Helm rollback revision" />
              <CheckBox Content="Run chart hooks" IsChecked="{Binding AllowHooks, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Review Helm change" IsEnabled="{Binding !IsBusy}" Click="OnReviewHelmChangeClick" />
              <TextBlock Text="{Binding HelmChangeStatus}" TextWrapping="Wrap" />
              <Button Content="Confirm reviewed Helm change" IsEnabled="{Binding CanConfirmHelm}" Click="OnConfirmHelmChangeClick" />
            </StackPanel></ScrollViewer>
          </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      </TabControl>
      </Grid>
      <StackPanel Grid.Row="2" Margin="{controls:Inset Xl}" IsVisible="{Binding !HasConnection}" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceMd}">
        <TextBlock Text="Connect a Kubernetes cluster" FontWeight="SemiBold" />
        <TextBlock Classes="Muted" Text="Choose a saved connection or add an explicit kubeconfig context. Your current kubectl context stays unchanged." TextWrapping="Wrap" />
        <Button Content="Add Kubernetes connection" Click="OnNewConnectionRequested" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </controls:PanelChrome>
</UserControl>
