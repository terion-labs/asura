<UserControl
    x:Class="Asura.App.Views.RuntimePanels.KubernetesRuntimePanelView"
    x:DataType="vm:KubernetesRuntimePanelViewModel"
    x:Name="PanelRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:app="using:Asura.Application"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:panels="using:Asura.App.Views.RuntimePanels"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Kubernetes panel">
  <UserControl.Resources>
    <!-- A pod in a drain's preview or result: its name, and what happens to
         it in words, toned where it blocks or fails. -->
    <DataTemplate x:Key="KubernetesDrainPodTemplate" x:DataType="vm:KubernetesDrainPodRow">
      <Border Classes="InspectorRecord">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBlock Classes="MiddleTruncated" Text="{Binding Pod}" ToolTip.Tip="{Binding Pod}" />
          <TextBlock
              Grid.Column="1"
              Classes="KubernetesStatus"
              Classes.healthy="{Binding IsHealthy}"
              Classes.warning="{Binding IsWarning}"
              Classes.error="{Binding IsError}"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="{Binding Outcome}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- While Helm is showing, the resource kind the browser will return to
         stays remembered but must not read as the current place. -->
    <Style Selector="ItemsControl.helmActive Button.ListRow.selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- One control height for the whole panel: the connection pill's 26px, the
         same rule the database toolbar follows. The kit's push button, text
         field and dense variants are 32, 28 and 24 tall, and a row that mixes
         them never lines up. Multi-line fields keep their own height. -->
    <Style Selector="Button.PrimaryButton, Button.SecondaryButton, Button.DestructiveButton, Button.TextButton, Button.PanelPicker, ToggleButton.KubernetesFollowToggle">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Md}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Md}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Md}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Padding" Value="{controls:Inset Sm}" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- The check box template centres its box in a fixed 32px lane, so the
         control keeps that height and only its label is brought in line. -->
    <Style Selector="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="{controls:Inset Left=Sm}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    </Style>

    <Style Selector="Border.KubernetesDrawer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- The panel being resized is not the drawer opening: it keeps up with the
         panel's edge rather than easing after it. -->
    <Style Selector="Border.KubernetesDrawer.resizing">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Window.motion-disabled Border.KubernetesDrawer">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="Border.KubernetesNavigator">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- A drag follows the pointer; easing toward it would lag behind the hand. -->
    <Style Selector="Border.KubernetesNavigator.resizing">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Window.motion-disabled Border.KubernetesNavigator">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBlock.KubernetesStatus.healthy">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.KubernetesStatus.warning">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.KubernetesStatus.error">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <!-- Numbers line up on the right, as a Mac table's numeric columns do. -->
    <Style Selector="DataGridCell.NumericCell">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- A cell that navigates is a value first. It takes the accent under the
         pointer; forty accent cells in a column outshout the status column,
         which is the one that should carry colour. -->
    <Style Selector="Button.KubernetesTableLink">
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.KubernetesTableLink /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.KubernetesTableLink:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Logs are a flat reading surface; the toolbar above owns the border. -->
    <Style Selector="TextBox.LogOutput /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.LogOutput:focus /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>

    <!-- Inspector forms: one column of labelled controls at the data size. -->
    <Style Selector="StackPanel.InspectorForm">
      <Setter Property="Margin" Value="{controls:Inset Md}" />
      <Setter Property="Spacing" Value="{DynamicResource ShellSpaceMd}" />
    </Style>
    <Style Selector="StackPanel.InspectorForm TextBlock.Muted">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
    </Style>
    <Style Selector="StackPanel.ActionRow">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="{DynamicResource ShellSpaceXs}" />
    </Style>
    <Style Selector="Border.InspectorRecord">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="{controls:Inset Vertical=Sm}" />
    </Style>

    <!-- The navigator's rows draw the current resource type with a class, so
         the same style says it: a screen reader hears which row is current,
         not only a row of identical buttons. -->
    <Style Selector="ItemsControl.KubernetesNavigation Button.ListRow">
      <Setter Property="AutomationProperties.ItemStatus" Value="" />
    </Style>
    <Style Selector="ItemsControl.KubernetesNavigation Button.ListRow.selected">
      <Setter Property="AutomationProperties.ItemStatus" Value="Current" />
    </Style>
    <Style Selector="ItemsControl.KubernetesNavigation.helmActive Button.ListRow.selected">
      <Setter Property="AutomationProperties.ItemStatus" Value="" />
    </Style>
    <Style Selector="Button.ListRow.KubernetesHelmRow.selected">
      <Setter Property="AutomationProperties.ItemStatus" Value="Current" />
    </Style>

    <!-- The inspector's views sit in the drawer's toolbar band, full width. -->
    <Style Selector="controls|SegmentedControl.InspectorSegments">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>

    <!-- The connection's status mark is a dot; where colour cannot carry state
         the dot gives way to a glyph with a shape for each state. -->
    <Style Selector="icons|SymbolIcon.KubernetesStatusGlyph">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeXs}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="Window.differentiate-without-color icons|SymbolIcon.KubernetesStatusGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.differentiate-without-color Border.KubernetesStatusDot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <controls:PanelChrome
      CloseLabel="Close Kubernetes panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <Grid Background="Transparent" ToolTip.Tip="{Binding ConnectionStatusLabel}">
        <Border
            Classes="StatusDot KubernetesStatusDot"
            controls:StatusToneBrush.Background="{Binding ConnectionStatusTone}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding ConnectionStatusLabel}" />
        <icons:SymbolIcon
            Classes="KubernetesStatusGlyph"
            Symbol="{Binding ConnectionStatusGlyph}"
            AutomationProperties.Name="{Binding ConnectionStatusLabel}" />
      </Grid>
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).KubernetesPanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
        <!-- A toolbar action among icon buttons is an icon button too. -->
        <Button
            Classes="IconButton"
            Click="OnShowForwardsClick"
            IsVisible="{Binding HasForwards}"
            ToolTip.Tip="Show active port forwards"
            AutomationProperties.Name="Show active Kubernetes port forwards">
          <icons:SymbolIcon Symbol="PlugConnected" FontSize="{DynamicResource ShellIconSizeMd}" />
        </Button>
        <Button
            Classes="IconButton"
            Click="OnToggleNavigatorClick"
            ToolTip.Tip="Show or hide navigator"
            AutomationProperties.Name="Show or hide Kubernetes navigator">
          <icons:SymbolIcon Symbol="Navigation" FontSize="{DynamicResource ShellIconSizeMd}" />
        </Button>
        <Button
            Classes="IconButton"
            Command="{Binding RefreshCommand}"
            ToolTip.Tip="Refresh resources"
            AutomationProperties.Name="Refresh Kubernetes resources">
          <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
        </Button>
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding Status}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Kubernetes state" />
        <!-- The session, never the kubeconfig: which context this panel reads. -->
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="Muted MiddleTruncated"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding ContextName}"
            AutomationProperties.Name="Kubernetes context" />
      </Grid>
    </controls:PanelChrome.Footer>

    <Grid RowDefinitions="Auto,*">

      <Grid Grid.Row="1" IsVisible="{Binding HasConnection}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail idiom: transparent over the panel material with a single
             hairline at the boundary, the same as the database object list.
             Its width animates and its content keeps its own width against the
             trailing edge, so the rail slides out rather than squeezing. -->
        <Border
            x:Name="Navigator"
            Classes="KubernetesNavigator"
            Width="{Binding NavigatorWidth}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True">
          <Grid
              Width="{Binding NavigatorContentWidth}"
              HorizontalAlignment="Right"
              IsEnabled="{Binding IsNavigatorVisible}"
              RowDefinitions="Auto,Auto,Auto,*">
            <!-- The cluster heads its resources, as the database heads its
                 objects. -->
            <Grid
                MinHeight="30"
                Margin="{controls:Inset Horizontal=Lg, Top=Sm}"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource ShellSpaceSm}"
                ToolTip.Tip="{Binding ContextName}">
              <icons:SymbolIcon
                  VerticalAlignment="Center"
                  Symbol="Cloud"
                  FontSize="{DynamicResource ShellIconSizeSm}"
                  Foreground="{DynamicResource ShellMutedBrush}" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="MiddleTruncated"
                  FontWeight="SemiBold"
                  Text="{Binding ContextName}" />
            </Grid>

            <controls:SearchField
                Grid.Row="1"
                Margin="{controls:Inset Horizontal=Xs, Vertical=Sm}"
                Text="{Binding NavigationFilter, Mode=TwoWay}"
                PlaceholderText="Filter resource types"
                AutomationProperties.Name="Filter Kubernetes resource types" />

            <Button
                Grid.Row="2"
                Classes="ListRow KubernetesHelmRow"
                Classes.selected="{Binding #HelmTab.IsSelected}"
                Click="OnHelmNavigationClick"
                IsVisible="{Binding IsHelmNavigationVisible}"
                AutomationProperties.Name="Helm Releases">
              <Grid
                  Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon
                    VerticalAlignment="Center"
                    Symbol="Box"
                    FontSize="{DynamicResource ShellIconSizeSm}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="Helm Releases"
                    TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>

            <TextBlock
                Grid.Row="3"
                Margin="{controls:Inset Horizontal=Lg, Vertical=Sm}"
                Classes="Muted"
                FontSize="{DynamicResource ShellSecondaryFontSize}"
                IsVisible="{Binding !HasNavigationMatches}"
                Text="No resource types match."
                TextWrapping="Wrap" />
            <ScrollViewer
                Grid.Row="3"
                Margin="{controls:Inset Top=Xs}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <ItemsControl
                  x:Name="NavigationList"
                  Classes="KubernetesNavigation"
                  Classes.helmActive="{Binding #HelmTab.IsSelected}"
                  ItemsSource="{Binding NavigationGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KubernetesNavigationGroup">
                    <StackPanel Margin="{controls:Inset Bottom=Xs}" IsVisible="{Binding HasVisibleItems}">
                      <ToggleButton
                          Margin="{controls:Inset Horizontal=Xs}"
                          Classes="SectionDisclosure"
                          Content="{Binding Title}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Title}" />
                      <ItemsControl IsVisible="{Binding IsOpen}" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KubernetesNavigationItem">
                            <Button
                                Classes="ListRow"
                                Classes.selected="{Binding IsSelected}"
                                Click="OnNavigationClick"
                                IsVisible="{Binding IsVisible}"
                                Command="{Binding SelectCommand}"
                                ToolTip.Tip="{Binding Title}"
                                AutomationProperties.Name="{Binding Title}">
                              <TextBlock
                                  Margin="{controls:Inset Left=Xl, Right=Md, Vertical=Xs}"
                                  VerticalAlignment="Center"
                                  Text="{Binding Title}"
                                  TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- The boundary hairline is also the grip: a transparent handle over the
             rail's trailing edge, the database inspector's resize idiom. -->
        <Border
            x:Name="NavigatorResizeHandle"
            Width="5"
            HorizontalAlignment="Right"
            Background="Transparent"
            Cursor="SizeWestEast"
            IsVisible="{Binding IsNavigatorVisible}"
            PointerPressed="OnNavigatorResizePressed"
            PointerMoved="OnNavigatorResizeMoved"
            PointerReleased="OnNavigatorResizeReleased"
            PointerCaptureLost="OnNavigatorResizeCaptureLost"
            AutomationProperties.Name="Resize the Kubernetes navigator" />

        <!-- Resources and Helm are two places in the navigator, not two tabs:
             the navigator picks, this only hosts. -->
        <TabControl x:Name="WorkspaceTabs" Grid.Column="1" Classes="Headless">
          <TabItem x:Name="ResourcesTab" Header="{Binding ResourceTitle}">
            <Grid x:Name="BrowserBody" IsVisible="{Binding HasConnection}">
              <Grid
                  x:Name="ResourceBrowser"
                  IsVisible="{Binding IsResourceBrowserVisible}"
                  RowDefinitions="Auto,*,Auto">
                <Border Classes="PanelToolbar">
                  <Grid
                      Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                      ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="SectionHeading"
                        Foreground="{DynamicResource ShellTextBrush}"
                        Text="{Binding ResourceTitle}" />
                    <!-- A cluster can hold hundreds of namespaces: the picker is
                         the database object picker's idiom, a popup button
                         over a filtered list, not a bare drop-down. -->
                    <Button
                        x:Name="NamespacePicker"
                        Grid.Column="1"
                        Classes="PanelPicker"
                        MinWidth="150"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsNamespaceScopeVisible}"
                        ToolTip.Tip="Choose namespace"
                        AutomationProperties.Name="Kubernetes namespace">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="MiddleTruncated"
                            Text="{Binding NamespaceSelection}" />
                        <icons:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource ShellIconSizeXs}"
                            Foreground="{DynamicResource ShellMutedBrush}"
                            Symbol="ChevronDown" />
                      </Grid>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnNamespaceFlyoutOpened">
                          <Grid
                              Width="280"
                              Margin="{controls:Inset Xs}"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="{DynamicResource ShellSpaceSm}">
                            <controls:SearchField
                                x:Name="NamespaceFilterBox"
                                Text="{Binding NamespaceFilter, Mode=TwoWay}"
                                PlaceholderText="Filter namespaces"
                                KeyDown="OnNamespaceFilterKeyDown"
                                AutomationProperties.Name="Filter Kubernetes namespaces" />
                            <ListBox
                                x:Name="NamespaceList"
                                Grid.Row="1"
                                MaxHeight="320"
                                Classes="Rows"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding FilteredNamespaceChoices}"
                                SelectedItem="{Binding NamespaceSelection, Mode=OneWay}"
                                Tapped="OnNamespaceListTapped"
                                KeyDown="OnNamespaceListKeyDown"
                                AutomationProperties.Name="Kubernetes namespaces">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock
                                      Margin="{controls:Inset Horizontal=Sm, Vertical=Sm}"
                                      Classes="MiddleTruncated"
                                      Text="{Binding}" />
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Grid>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <!-- A capped star column keeps the field at the leading
                         edge; a stretched control with a MaxWidth centres. -->
                    <Grid Grid.Column="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="320" />
                      </Grid.ColumnDefinitions>
                      <controls:SearchField
                          x:Name="ResourceFilterBox"
                          VerticalAlignment="Center"
                          Text="{Binding Filter, Mode=TwoWay}"
                          PlaceholderText="Filter resources"
                          AutomationProperties.Name="Filter Kubernetes resources" />
                    </Grid>
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding ResourceCountLabel}" />
                  </Grid>
                </Border>

                <!-- No containing ScrollViewer: DataGrid must receive a finite
                     viewport to virtualize rows and columns correctly. -->
                <DataGrid
                    x:Name="ResourceList"
                    Grid.Row="1"
                    Classes="DatabaseGrid KubernetesTable"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    SelectionMode="Extended"
                    ContextRequested="OnResourceContextRequested"
                    AutomationProperties.Name="Kubernetes resources">
                  <DataGrid.Columns>
                    <!-- The name takes the spare width but no more than its share, so the
                         status column stays whole with the inspector open;
                         a long name is cut in the middle. -->
                    <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="2*" MinWidth="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <TextBlock
                              Margin="{controls:Inset Horizontal=Sm}"
                              VerticalAlignment="Center"
                              Classes="MiddleTruncated"
                              Text="{Binding Name}"
                              ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Header="Namespace"
                        SortMemberPath="Namespace"
                        Width="120"
                        MinWidth="120"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNamespaceScopeVisible}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <Grid>
                            <TextBlock
                                Margin="{controls:Inset Horizontal=Sm}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !CanNavigateNamespace}"
                                Classes="MiddleTruncated"
                                Text="{Binding Namespace}"
                                ToolTip.Tip="{Binding Namespace}" />
                            <Button
                                Classes="KubernetesTableLink"
                                Command="{Binding NamespaceCommand}"
                                IsVisible="{Binding CanNavigateNamespace}"
                                ToolTip.Tip="{Binding Namespace, StringFormat=Show namespace {0}}">
                              <TextBlock Classes="MiddleTruncated" Text="{Binding Namespace}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="CPU"
                        Binding="{Binding Cpu}"
                        SortMemberPath="CpuValue"
                        CellStyleClasses="NumericCell"
                        Width="70"
                        MinWidth="70"
                        IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Memory"
                        Binding="{Binding Memory}"
                        SortMemberPath="MemoryValue"
                        CellStyleClasses="NumericCell"
                        Width="100"
                        MinWidth="100"
                        IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Ready"
                        Binding="{Binding Ready}"
                        Width="80"
                        MinWidth="80"
                        IsVisible="{Binding !#PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Restarts"
                        Binding="{Binding Restarts}"
                        SortMemberPath="RestartCount"
                        CellStyleClasses="NumericCell"
                        Width="100"
                        MinWidth="100"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}" />
                    <DataGridTemplateColumn
                        Header="Controlled By"
                        SortMemberPath="Owner"
                        Width="130"
                        MinWidth="130"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <Grid>
                            <TextBlock
                                Margin="{controls:Inset Horizontal=Sm}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !CanNavigateOwner}"
                                Classes="MiddleTruncated"
                                Text="{Binding Owner}"
                                ToolTip.Tip="{Binding Owner}" />
                            <Button
                                Classes="KubernetesTableLink"
                                Command="{Binding ControlledByCommand}"
                                IsVisible="{Binding CanNavigateOwner}"
                                ToolTip.Tip="{Binding Owner, StringFormat=Show {0}}">
                              <TextBlock Classes="MiddleTruncated" Text="{Binding Owner}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Header="Node"
                        SortMemberPath="Node"
                        Width="130"
                        MinWidth="130"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <Grid>
                            <TextBlock
                                Margin="{controls:Inset Horizontal=Sm}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !CanNavigateNode}"
                                Classes="MiddleTruncated"
                                Text="{Binding Node}"
                                ToolTip.Tip="{Binding Node}" />
                            <Button
                                Classes="KubernetesTableLink"
                                Command="{Binding NodeCommand}"
                                IsVisible="{Binding CanNavigateNode}"
                                ToolTip.Tip="{Binding Node, StringFormat=Show node {0}}">
                              <TextBlock Classes="MiddleTruncated" Text="{Binding Node}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="QoS"
                        Binding="{Binding Qos}"
                        Width="90"
                        MinWidth="90"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsPodTable}" />
                    <DataGridTemplateColumn
                        Header="Disk"
                        SortMemberPath="DiskPercentValue"
                        Width="85"
                        MinWidth="85"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <TextBlock
                              Margin="{controls:Inset Horizontal=Sm}"
                              VerticalAlignment="Center"
                              Text="{Binding Disk}"
                              ToolTip.Tip="{Binding DiskDetail}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Taints"
                        Binding="{Binding Taints}"
                        Width="80"
                        MinWidth="80"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Roles"
                        Binding="{Binding Roles}"
                        Width="100"
                        MinWidth="100"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Version"
                        Binding="{Binding Version}"
                        Width="85"
                        MinWidth="85"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsNodeTable}" />
                    <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="120" MinWidth="95">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:KubernetesResourceRow">
                          <StackPanel
                              Margin="{controls:Inset Horizontal=Sm}"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="{DynamicResource ShellSpaceXs}">
                            <icons:SymbolIcon
                                Classes="KubernetesStatusGlyph"
                                Symbol="{Binding StatusGlyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="KubernetesStatus"
                                Classes.healthy="{Binding IsHealthy}"
                                Classes.warning="{Binding IsWarning}"
                                Classes.error="{Binding IsError}"
                                Text="{Binding Status}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding Status}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Age"
                        Binding="{Binding Age}"
                        SortMemberPath="AgeSeconds"
                        Width="80"
                        MinWidth="80" />
                    <DataGridTextColumn
                        x:DataType="vm:KubernetesResourceRow"
                        Header="Details"
                        Binding="{Binding Detail}"
                        Width="3*"
                        MinWidth="180"
                        IsVisible="{Binding #PanelRoot.((vm:KubernetesRuntimePanelViewModel)DataContext).IsGenericTable}" />
                  </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyStatePanel
                    Grid.Row="1"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsEmpty}"
                    ShowsGlyph="False"
                    Heading="No resources in this scope"
                    Body="Choose another namespace or clear the filter." />

                <Border
                    Grid.Row="2"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="0,1,0,0"
                    IsVisible="{Binding HasMore}">
                  <Button
                      Margin="{controls:Inset Xs}"
                      HorizontalAlignment="Center"
                      Classes="TextButton Accent"
                      Command="{Binding LoadMoreCommand}"
                      Content="Load More Resources" />
                </Border>
              </Grid>

              <!-- The details drawer slides over the table and stays opaque, so
                   the rows beneath never read through it. It is pinned to the
                   trailing edge and its width animates, while its content keeps
                   its open width against the leading edge: the drawer's near
                   side arrives first, as a drawer's does. It stays in the tree
                   while closed so that closing is a movement too. -->
              <Border
                  x:Name="Inspector"
                  Width="{Binding InspectorWidth}"
                  HorizontalAlignment="Right"
                  Background="{DynamicResource ShellPopupSurfaceBrush}"
                  BorderBrush="{DynamicResource ShellBorderBrush}"
                  BorderThickness="1,0,0,0"
                  Classes="KubernetesDrawer"
                  ClipToBounds="True"
                  IsEnabled="{Binding IsInspectorVisible}"
                  IsHitTestVisible="{Binding IsInspectorVisible}">
                <Grid
                    Width="{Binding InspectorContentWidth}"
                    HorizontalAlignment="Left"
                    RowDefinitions="Auto,Auto,*">
                  <Border Classes="PanelToolbar">
                    <Grid
                        Margin="{controls:Inset Left=Xs, Right=Xs, Vertical=Xs}"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="{DynamicResource ShellSpaceXs}">
                      <Button
                          x:Name="BackButton"
                          VerticalAlignment="Center"
                          Classes="IconButton"
                          Click="OnBackClick"
                          IsVisible="{Binding IsBackButtonVisible}"
                          ToolTip.Tip="Back to resources"
                          AutomationProperties.Name="Back to resources">
                        <icons:SymbolIcon Symbol="ArrowLeft" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                      <StackPanel
                          Grid.Column="1"
                          Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                          VerticalAlignment="Center"
                          Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock
                            Classes="MiddleTruncated"
                            FontWeight="SemiBold"
                            Text="{Binding SelectionTitle}"
                            ToolTip.Tip="{Binding SelectionTitle}" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Summary}" />
                      </StackPanel>
                      <Button
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Classes="IconButton"
                          Click="OnBackClick"
                          IsVisible="{Binding !IsBackButtonVisible}"
                          ToolTip.Tip="Close details"
                          AutomationProperties.Name="Close resource details">
                        <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Five stable views of the selection, one segmented control.
                       There were up to nine tabs that came and went with the
                       selection; a view that does not apply is dimmed in place
                       now, and the dry-run review, node maintenance and the pod
                       terminal live inside the view they belong to. -->
                  <Border Grid.Row="1" Classes="PanelToolbar" IsVisible="{Binding HasInspectorContent}">
                    <controls:SegmentedControl
                        x:Name="InspectorSegments"
                        Classes="InspectorSegments"
                        AutomationProperties.Name="Resource details view">
                      <RadioButton Content="Overview" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Overview" />
                      <RadioButton Content="Manifest" IsEnabled="{Binding HasSelection}" ToolTip.Tip="The resource as YAML or JSON" AutomationProperties.Name="Manifest" />
                      <RadioButton Content="Logs" IsEnabled="{Binding CanReadLogs}" AutomationProperties.Name="Logs" />
                      <RadioButton Content="Ports" IsEnabled="{Binding HasForwardTools}" AutomationProperties.Name="Ports" />
                      <RadioButton Content="Actions" IsEnabled="{Binding HasInspectorActions}" AutomationProperties.Name="Actions" />
                    </controls:SegmentedControl>
                  </Border>

                  <TabControl
                      x:Name="InspectorTabs"
                      Grid.Row="2"
                      Classes="Headless"
                      IsVisible="{Binding HasInspectorContent}"
                      SelectedIndex="{Binding #InspectorSegments.SelectedIndex}">
                    <TabItem x:Name="OverviewTab" Header="Overview">
                      <panels:KubernetesInspectorOverviewView />
                    </TabItem>

                    <TabItem x:Name="ManifestTab" Header="Manifest">
                      <Grid RowDefinitions="Auto,Auto,*">
                        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
                          <WrapPanel Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
                            <!-- The server's dry run is a second look at the same
                                 manifest, so it is a mode of this view rather
                                 than a tab that appeared after a dry run. -->
                            <controls:SegmentedControl
                                x:Name="ManifestModeSegments"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Manifest view">
                              <RadioButton Content="Edit" AutomationProperties.Name="Edit" />
                              <RadioButton Content="Review" IsEnabled="{Binding HasMutationPreview}" ToolTip.Tip="The server dry run beside the current resource" AutomationProperties.Name="Review" />
                            </controls:SegmentedControl>
                            <Button Classes="SecondaryButton" Command="{Binding DryRunCommand}" Content="Dry Run" IsVisible="{Binding CanEditManifest}" />
                            <Button Classes="PrimaryButton" Command="{Binding ApplyManifestCommand}" Content="Apply" IsVisible="{Binding CanEditManifest}" />
                            <Button Classes="TextButton" Command="{Binding DiscardManifestCommand}" Content="Discard" IsVisible="{Binding CanEditManifest}" />
                            <CheckBox
                                Margin="{controls:Inset Left=Sm}"
                                VerticalAlignment="Center"
                                Content="Force field ownership"
                                IsChecked="{Binding ForceOwnership, Mode=TwoWay}"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding CanEditManifest}"
                                ToolTip.Tip="Explicitly replace conflicting field ownership. A new dry run is required." />
                          </WrapPanel>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                            Classes="Muted"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            IsVisible="{Binding CanEditManifest}"
                            Text="{Binding MutationStatus}"
                            TextWrapping="Wrap" />
                        <TabControl
                            x:Name="ManifestModes"
                            Grid.Row="2"
                            Classes="Headless"
                            SelectedIndex="{Binding #ManifestModeSegments.SelectedIndex}">
                          <TabItem Header="Edit">
                            <!-- Inset from the drawer's edge, so the line numbers
                                 don't sit flush against the border. -->
                            <components:CodeEditBox
                                x:Name="ManifestEditor"
                                Margin="{controls:Inset Left=Sm, Top=Xs}"
                                GrammarExtension="{Binding ManifestGrammarExtension}"
                                IsReadOnly="{Binding ManifestReadOnly}"
                                ShowLineNumbers="True"
                                Text="{Binding ManifestDraft, Mode=TwoWay}"
                                WordWrap="False"
                                AutomationProperties.Name="Kubernetes resource manifest, YAML or JSON" />
                          </TabItem>
                          <TabItem Header="Review">
                            <Grid ColumnDefinitions="*,Auto,*">
                              <Grid RowDefinitions="Auto,*">
                                <TextBlock
                                    Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                                    Classes="Eyebrow"
                                    Text="Current resource" />
                                <components:CodePreviewView
                                    Grid.Row="1"
                                    FileName="resource.json"
                                    Text="{Binding FormattedManifest}"
                                    WordWrap="False"
                                    AutomationProperties.Name="Current Kubernetes resource" />
                              </Grid>
                              <Border Grid.Column="1" Width="1" Background="{DynamicResource ShellBorderBrush}" />
                              <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                <TextBlock
                                    Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                                    Classes="Eyebrow"
                                    Text="Server dry run result" />
                                <components:CodePreviewView
                                    Grid.Row="1"
                                    FileName="dry-run.json"
                                    Text="{Binding PreviewManifest}"
                                    WordWrap="False"
                                    AutomationProperties.Name="Server dry run result" />
                              </Grid>
                            </Grid>
                          </TabItem>
                        </TabControl>
                      </Grid>
                    </TabItem>

                    <TabItem x:Name="LogsTab" Header="Logs">
                      <Grid RowDefinitions="Auto,*">
                        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
                          <!-- The container field is labelled like any other field;
                               Follow is one switch that stays pressed while new
                               lines stream in, not a Follow and a Pause. -->
                          <WrapPanel Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
                            <controls:LabeledField Width="180" Label="Container" Hint="Optional for single-container pods">
                              <TextBox
                                  Text="{Binding Container, Mode=TwoWay}"
                                  AutomationProperties.Name="Pod log container" />
                            </controls:LabeledField>
                            <Button VerticalAlignment="Bottom" Classes="SecondaryButton" Command="{Binding LoadLogsCommand}" Content="Load Recent" />
                            <ToggleButton
                                x:Name="FollowLogsToggle"
                                VerticalAlignment="Bottom"
                                Classes="KubernetesFollowToggle"
                                Click="OnFollowLogsToggled"
                                Content="Follow"
                                IsChecked="{Binding FollowingLogs, Mode=OneWay}"
                                IsVisible="{Binding CanFollowLogs}"
                                ToolTip.Tip="Keep showing new log lines as they arrive"
                                AutomationProperties.Name="Follow pod logs" />
                            <CheckBox
                                Margin="{controls:Inset Left=Sm}"
                                VerticalAlignment="Bottom"
                                Content="Previous container"
                                IsChecked="{Binding PreviousLogs, Mode=TwoWay}" />
                          </WrapPanel>
                        </Border>
                        <TextBox
                            Grid.Row="1"
                            Padding="{controls:Inset Sm}"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            Classes="LogOutput"
                            FontFamily="{DynamicResource ShellDataFontFamily}"
                            FontSize="{DynamicResource ShellFontSize11}"
                            IsReadOnly="True"
                            Text="{Binding Logs}"
                            TextWrapping="NoWrap"
                            AutomationProperties.Name="Pod logs" />
                      </Grid>
                    </TabItem>

                    <TabItem x:Name="ForwardTab" Header="Ports">
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="InspectorForm">
                          <StackPanel IsVisible="{Binding CanForward}" Spacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock Classes="SectionHeading" Text="New forward" />
                            <TextBlock Classes="Muted" Text="{Binding DeclaredPorts}" TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Left"
                                Classes="SecondaryButton"
                                Click="OnResolveServiceForwardClick"
                                Content="Find Ready Backing Pods"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding IsServiceForward}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding IsServiceForward}"
                                ItemsSource="{Binding ServiceForwardChoices}"
                                SelectedItem="{Binding SelectedServiceForward, Mode=TwoWay}"
                                PlaceholderText="Choose pod and target port"
                                AutomationProperties.Name="Service forward destination">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:KubernetesServiceForwardChoice">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                              <TextBox
                                  x:Name="ForwardPortBox"
                                  IsVisible="{Binding IsPodForward}"
                                  Text="{Binding ForwardPort, Mode=TwoWay}"
                                  PlaceholderText="Remote pod port, 1–65535"
                                  AutomationProperties.Name="Remote pod port" />
                              <Button
                                  Grid.Column="1"
                                  Classes="PrimaryButton"
                                  Click="OnStartForwardClick"
                                  Content="Start Forward"
                                  IsEnabled="{Binding !IsBusy}" />
                            </Grid>
                            <TextBlock
                                Classes="Muted"
                                Text="Asura picks a free local port. Forwards stay active until you stop them or close the workspace."
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <ItemsControl ItemsSource="{Binding ForwardState.Forwards}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:KubernetesForwardViewModel">
                                <controls:SurfaceCard Margin="{controls:Inset Bottom=Sm}" Padding="{controls:Inset Sm}">
                                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Identity}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        FontFamily="{DynamicResource ShellDataFontFamily}"
                                        IsReadOnly="True"
                                        Text="{Binding Address}"
                                        AutomationProperties.Name="Forward local address" />
                                    <TextBlock Classes="Muted" Text="{Binding Status}" />
                                    <StackPanel Classes="ActionRow">
                                      <Button
                                          Classes="SecondaryButton"
                                          Click="OnOpenForwardBrowserClick"
                                          Content="Open in Browser"
                                          IsVisible="{Binding CanOpenBrowser}" />
                                      <Button
                                          Classes="SecondaryButton"
                                          Command="{Binding StopCommand}"
                                          Content="Stop Forward" />
                                    </StackPanel>
                                    <ToggleButton
                                        x:Name="ForwardDatabaseDisclosure"
                                        Classes="SectionDisclosure"
                                        Content="Open Database Through This Forward"
                                        IsVisible="{Binding CanOpenDatabase}" />
                                    <StackPanel
                                        IsVisible="{Binding #ForwardDatabaseDisclosure.IsChecked}"
                                        Spacing="{DynamicResource ShellSpaceSm}">
                                      <ComboBox
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding DatabaseDrivers}"
                                          SelectedItem="{Binding DatabaseDriver, Mode=TwoWay}"
                                          AutomationProperties.Name="Forwarded database driver">
                                        <ComboBox.ItemTemplate>
                                          <DataTemplate x:DataType="app:DatabaseDriverDescriptor">
                                            <TextBlock Text="{Binding DisplayName}" />
                                          </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                      </ComboBox>
                                      <TextBox Text="{Binding DatabaseName, Mode=TwoWay}" PlaceholderText="Database" AutomationProperties.Name="Forwarded database name" />
                                      <TextBox Text="{Binding DatabaseUsername, Mode=TwoWay}" PlaceholderText="Username" AutomationProperties.Name="Forwarded database username" />
                                      <TextBox Text="{Binding DatabasePassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Session password" AutomationProperties.Name="Forwarded database session password" />
                                      <TextBlock
                                          Classes="Muted"
                                          Text="Temporary connection. Reopen the forward after restarting Asura. Credentials aren’t saved."
                                          TextWrapping="Wrap" />
                                      <Button
                                          HorizontalAlignment="Left"
                                          Classes="SecondaryButton"
                                          Click="OnOpenForwardDatabaseClick"
                                          Content="Open Database" />
                                    </StackPanel>
                                  </StackPanel>
                                </controls:SurfaceCard>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>

                    <!-- Everything that can be done to the selection: a pod's
                         terminal, a node's scheduling and drain, and the
                         reviewed operations on a workload. -->
                    <TabItem x:Name="ActionsTab" Header="Actions">
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="InspectorForm">
                          <StackPanel IsVisible="{Binding CanOpenShell}" Spacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock Classes="SectionHeading" Text="Terminal" />
                            <controls:LabeledField Label="Container">
                              <ComboBox
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ContainerChoices}"
                                  SelectedItem="{Binding Container, Mode=TwoWay}"
                                  PlaceholderText="Choose container"
                                  AutomationProperties.Name="Pod terminal container" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="Shell">
                              <ComboBox
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ShellExecutables}"
                                  SelectedItem="{Binding ShellExecutable, Mode=TwoWay}"
                                  AutomationProperties.Name="Pod shell executable" />
                            </controls:LabeledField>
                            <StackPanel Classes="ActionRow">
                              <Button Classes="SecondaryButton" Click="OnShellClick" Content="Open Pod Terminal" IsEnabled="{Binding CanLaunchShell}" />
                              <Button Classes="SecondaryButton" Click="OnFilesClick" Content="Browse Container Files" IsEnabled="{Binding CanLaunchShell}" />
                            </StackPanel>
                            <TextBlock
                                Classes="Muted"
                                Text="Opens a terminal in this pod. Commands run in the selected container."
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding HasNodeMaintenance}" Spacing="{DynamicResource ShellSpaceMd}">
                            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                              <TextBlock Classes="SectionHeading" Text="Scheduling" />
                              <StackPanel Classes="ActionRow">
                                <!-- Only the change that applies: a schedulable node can be
                                     cordoned, a cordoned one uncordoned. -->
                                <Button Classes="SecondaryButton" Click="OnReviewCordonClick" Content="Review Cordon" IsEnabled="{Binding CanReviewCordon}" />
                                <Button Classes="SecondaryButton" Click="OnReviewUncordonClick" Content="Review Uncordon" IsEnabled="{Binding CanReviewUncordon}" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                              <TextBlock Classes="SectionHeading" Text="Drain" />
                              <CheckBox Content="Allow unmanaged pods" IsChecked="{Binding AllowUnmanagedPods, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                              <CheckBox Content="Allow deletion of emptyDir data" IsChecked="{Binding DeleteEmptyDirData, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                              <Button
                                  HorizontalAlignment="Left"
                                  Classes="SecondaryButton"
                                  Click="OnReviewDrainClick"
                                  Content="Preview Drain"
                                  IsEnabled="{Binding !IsBusy}" />
                            </StackPanel>
                            <TextBlock Text="{Binding NodeStatus}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DrainPods}" ItemTemplate="{StaticResource KubernetesDrainPodTemplate}" />
                            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                              <Button
                                  HorizontalAlignment="Left"
                                  Classes="PrimaryButton"
                                  Click="OnConfirmNodeClick"
                                  Content="{Binding NodeConfirmLabel}"
                                  IsEnabled="{Binding CanConfirmNode}" />
                              <!-- A dimmed Confirm says why it is dimmed. -->
                              <TextBlock
                                  Classes="Muted"
                                  IsVisible="{Binding HasNodeConfirmHint}"
                                  Text="{Binding NodeConfirmHint}"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DrainResults}" ItemTemplate="{StaticResource KubernetesDrainPodTemplate}" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding HasResourceActions}" Spacing="{DynamicResource ShellSpaceMd}">
                            <TextBlock Classes="SectionHeading" Text="Operations" />
                            <TextBlock Classes="Muted" Text="Each operation runs a server dry run before confirmation." TextWrapping="Wrap" />
                            <controls:LabeledField IsVisible="{Binding CanScale}" Label="Replicas">
                              <Grid ColumnDefinitions="96,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                                <TextBox Text="{Binding Replicas, Mode=TwoWay}" AutomationProperties.Name="Desired replica count" />
                                <Button Grid.Column="1" Classes="SecondaryButton" Click="OnReviewScaleClick" Content="Review Scale" />
                              </Grid>
                            </controls:LabeledField>
                            <StackPanel Classes="ActionRow">
                              <Button
                                  Classes="SecondaryButton"
                                  Click="OnReviewRestartClick"
                                  Content="Review Rollout Restart"
                                  IsVisible="{Binding CanRestart}" />
                              <Button
                                  Classes="DestructiveButton"
                                  Click="OnReviewDeleteClick"
                                  Content="Review Delete"
                                  IsVisible="{Binding CanDelete}" />
                            </StackPanel>
                            <TextBlock Text="{Binding OperationDescription}" TextWrapping="Wrap" />
                            <!-- Confirm names what it does; a delete confirms in
                                 the destructive style. -->
                            <StackPanel Classes="ActionRow" IsVisible="{Binding HasOperationReview}">
                              <Button
                                  Classes.PrimaryButton="{Binding !IsDeleteReview}"
                                  Classes.DestructiveButton="{Binding IsDeleteReview}"
                                  Click="OnConfirmOperationClick"
                                  Content="{Binding ConfirmOperationLabel}"
                                  IsEnabled="{Binding CanConfirmOperation}" />
                              <Button
                                  Classes="TextButton"
                                  Click="OnShowDryRunResultClick"
                                  Content="Show Dry Run Result"
                                  IsVisible="{Binding HasMutationPreview}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem x:Name="HelmTab" Header="Helm" IsVisible="{Binding HasHelm}">
            <Grid RowDefinitions="Auto,*">
              <Border Classes="PanelToolbar">
                <Grid
                    Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock
                      VerticalAlignment="Center"
                      Classes="SectionHeading"
                      Foreground="{DynamicResource ShellTextBrush}"
                      Text="Helm Releases" />
                  <StackPanel Grid.Column="1" Classes="ActionRow">
                    <Button Classes="SecondaryButton" Click="OnLoadHelmClick" Content="{Binding HelmLoadLabel}" IsEnabled="{Binding !IsBusy}" />
                    <Button
                        Classes="TextButton"
                        Click="OnLoadMoreHelmClick"
                        Content="Load More"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding HasMoreHelm}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                <ListBox
                    x:Name="HelmReleaseList"
                    Margin="{controls:Inset Vertical=Xs}"
                    Classes="Rows"
                    IsTextSearchEnabled="True"
                    TextSearch.TextBinding="{Binding Name, DataType={x:Type app:KubernetesHelmRelease}}"
                    ItemsSource="{Binding Releases}"
                    SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                    AutomationProperties.Name="Helm Releases">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="app:KubernetesHelmRelease">
                      <controls:ListItem
                          ContentPadding="{DynamicResource ShellListRowPadding}"
                          Title="{Binding Name}"
                          Detail="{Binding Chart}">
                        <controls:ListItem.Trailing>
                          <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Classes="KubernetesStatus"
                                Classes.error="{Binding Status, Converter={x:Static vm:KubernetesHelmText.FailedConverter}}"
                                FontSize="{DynamicResource ShellSecondaryFontSize}"
                                Text="{Binding Status, Converter={x:Static vm:KubernetesHelmText.StatusConverter}}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Classes="Muted"
                                FontSize="{DynamicResource ShellSecondaryFontSize}"
                                Text="{Binding Namespace}" />
                          </StackPanel>
                        </controls:ListItem.Trailing>
                      </controls:ListItem>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Width="1" Background="{DynamicResource ShellBorderBrush}" />
                <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Classes="PanelToolbar">
                  <controls:SegmentedControl
                      x:Name="HelmViewSegments"
                      Classes="InspectorSegments"
                      AutomationProperties.Name="Helm release view">
                    <RadioButton Content="History" AutomationProperties.Name="History" />
                    <RadioButton Content="Change Release" IsEnabled="{Binding HasHelmChanges}" AutomationProperties.Name="Change Release" />
                  </controls:SegmentedControl>
                </Border>
                <TabControl
                    x:Name="HelmViews"
                    Grid.Row="1"
                    Classes="Headless"
                    SelectedIndex="{Binding #HelmViewSegments.SelectedIndex}">
                  <TabItem Header="History">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl Margin="{controls:Inset Horizontal=Md}" ItemsSource="{Binding HelmHistory}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KubernetesHelmRevisionRow">
                            <Border Classes="InspectorRecord">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" RowSpacing="{DynamicResource ShellSpaceXs}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Number, StringFormat='Revision {0}'}" />
                                <TextBlock Grid.Column="1" Classes="Muted KubernetesStatus" Classes.error="{Binding IsFailed}" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Status}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="Muted MiddleTruncated"
                                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                                    Text="{Binding Chart}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="Muted"
                                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                                    Text="{Binding Updated}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </TabItem>
                  <TabItem Header="Change Release">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Classes="InspectorForm">
                        <controls:LabeledField Label="Change">
                          <ComboBox
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !IsBusy}"
                              ItemsSource="{Binding HelmChangeKinds}"
                              SelectedItem="{Binding HelmChangeKind, Mode=TwoWay}"
                              AutomationProperties.Name="Helm change kind" />
                        </controls:LabeledField>
                        <StackPanel IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsHelmUpgrade}" Spacing="{DynamicResource ShellSpaceSm}">
                          <controls:LabeledField Label="Chart reference" Hint="An OCI reference pinned with @sha256:…">
                            <TextBox Text="{Binding ChartReference, Mode=TwoWay}" AutomationProperties.Name="Pinned Helm OCI chart" />
                          </controls:LabeledField>
                          <controls:LabeledField Label="Chart version" Hint="The exact version to install.">
                            <TextBox Text="{Binding ChartVersion, Mode=TwoWay}" AutomationProperties.Name="Helm chart version" />
                          </controls:LabeledField>
                          <controls:LabeledField Label="Values YAML" Hint="Optional.">
                            <TextBox
                                MinHeight="80"
                                MaxHeight="160"
                                AcceptsReturn="True"
                                FontFamily="{DynamicResource ShellDataFontFamily}"
                                Text="{Binding ValuesYaml, Mode=TwoWay}"
                                AutomationProperties.Name="Helm values YAML" />
                          </controls:LabeledField>
                          <CheckBox Content="Reuse release values" IsChecked="{Binding ReuseValues, Mode=TwoWay}" />
                        </StackPanel>
                        <controls:LabeledField Label="Rollback revision" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsHelmRollback}">
                          <TextBox
                              Text="{Binding RollbackRevision, Mode=TwoWay}"
                              AutomationProperties.Name="Helm rollback revision" />
                        </controls:LabeledField>
                        <CheckBox Content="Run chart hooks" IsChecked="{Binding AllowHooks, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                        <Button
                            HorizontalAlignment="Left"
                            Classes="SecondaryButton"
                            Click="OnReviewHelmChangeClick"
                            Content="Review Helm Change"
                            IsEnabled="{Binding !IsBusy}" />
                        <TextBlock Text="{Binding HelmChangeStatus}" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Classes="PrimaryButton"
                            Click="OnConfirmHelmChangeClick"
                            Content="Confirm Helm Change"
                            IsEnabled="{Binding CanConfirmHelm}" />
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                </TabControl>
                </Grid>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>

      <StackPanel
          Grid.Row="1"
          VerticalAlignment="Center"
          IsVisible="{Binding !HasConnection}"
          Spacing="{DynamicResource ShellSpaceMd}">
        <controls:EmptyStatePanel
            Glyph="Cloud"
            Heading="Connect a Kubernetes cluster"
            Body="Choose a saved connection from the connection menu, or add an explicit kubeconfig context. Your current kubectl context stays unchanged." />
        <Button
            HorizontalAlignment="Center"
            Classes="SecondaryButton"
            Click="OnNewConnectionRequested"
            Content="Add Kubernetes Connection…" />
      </StackPanel>

      <ProgressBar
          Grid.Row="1"
          Classes="WorkingStripe"
          IsVisible="{Binding IsBusy}"
          AutomationProperties.Name="Loading Kubernetes resources" />
    </Grid>
  </controls:PanelChrome>
</UserControl>
