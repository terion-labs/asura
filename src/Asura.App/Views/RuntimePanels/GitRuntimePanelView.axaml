<UserControl
    x:Class="Asura.App.Views.RuntimePanels.GitRuntimePanelView"
    x:DataType="vm:GitRuntimePanelViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:core="using:Asura.Core"
    xmlns:git="using:Asura.Git"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Git panel"
    Container.Name="gitPanel"
    Container.Sizing="Width">
  <UserControl.Resources>
    <!-- A sidebar row is the Finder sidebar's 28-point band: body text with
         room above and below, not a 24-point strip of caption text. -->
    <x:Double x:Key="GitSidebarRowHeight">28</x:Double>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- The section list is a source list: the shell's list selection draws
         the current section, accent while the list has focus and gray
         otherwise, and the count badge turns with the row's text. -->
    <Style Selector="ListBox.GitSections">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.GitSections ListBoxItem">
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- One size for the panel's rows and the controls among them: the
         section list, the sidebar's refs, the file lists, the history and the
         pull-downs above them all read at the body size, as a Finder sidebar
         does, so no label stands a size above the list it sits in. Counts and
         badges are the only captions. -->
    <Style Selector="ListBox.GitSections ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ShellBaseFontSize}" />
    </Style>
    <Style Selector="ListBox.GitSections ListBoxItem Border.GitCountBadge TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ShellCaptionFontSize}" />
    </Style>
    <Style Selector="ListBox.GitSections ListBoxItem icons|SymbolIcon">
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeSm}" />
    </Style>
    <Style Selector="ListBox.GitSections:focus-within ListBoxItem:selected Border.GitCountBadge">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.GitSections:focus-within ListBoxItem:selected Border.GitCountBadge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <!-- A pull-down button: a push button whose trailing chevron says it
         opens a menu of commands rather than acting on its own. -->
    <Style Selector="Button.GitPullDown">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.GitPullDown icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <!-- The status mark: a dot by default, a glyph per state when the host
         asks to differentiate without colour. -->
    <Style Selector="Panel.GitStatusGlyphs">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.GitStatusGlyphs icons|SymbolIcon">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Window).differentiate-without-color Panel.GitStatusGlyphs">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(Window).differentiate-without-color Border.GitStatusDot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="icons|SymbolIcon.GitRefGlyph">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <!-- Ref names keep both ends, so feature/… branches stay apart. -->
    <Style Selector="TextBlock.GitSidebarRow">
      <Setter Property="FontSize" Value="{DynamicResource ShellBaseFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellBodyLineHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="{x:Static TextTrimming.PrefixCharacterEllipsis}" />
    </Style>
    <!-- Ref trees use the shell's standard tree template with a single icon
         column and a fixed row band. The parent viewport constrains labels. -->
    <Style Selector="TreeView.GitRefTree">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="TextBox.GitRefFilter">
      <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellBaseFontSize}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Stashes, worktrees and submodules are flat lists in the same
         sidebar: their rows sit where the ref rows sit, and a row is
         selected as a ref row is, so the Git menu can act on it. -->
    <Style Selector="ListBox.GitSidebarList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.GitSidebarList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.GitSidebarList ListBoxItem:selected Border.GitRefRow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.GitSidebarList:focus-within ListBoxItem:selected icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="Grid.GitSidebarRowLayout">
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>
    <Style Selector="ListBox.GitChanges ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Xs}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBox.GitChanges">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.GitKindBadge">
      <Setter Property="Width" Value="{controls:TextScaled 20}" />
      <Setter Property="Height" Value="{controls:TextScaled 20}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellInnerCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.GitKindBadge TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource ShellCaptionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.addition">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.addition TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.removal">
      <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.removal TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.conflict">
      <Setter Property="Background" Value="{DynamicResource ShellWarningSoftBrush}" />
    </Style>
    <Style Selector="Border.GitKindBadge.conflict TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarningBrush}" />
    </Style>
    <Style Selector="ListBox.GitCommits">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.GitCommits ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Xs}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellInnerCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
    </Style>
    <Style Selector="TextBlock.GitCommitCell">
      <Setter Property="FontSize" Value="{DynamicResource ShellBaseFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellBodyLineHeight}" />
    </Style>
    <!-- A ref name is a label, not something to act on, so it wears a
         neutral fill rather than the accent the selection and focus use. A
         hairline keeps it a pill on a selected row, whose gray is the same
         step as its fill; on a focused row it turns with the row's text. -->
    <Style Selector="Border.GitRefTag">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellPillCornerRadius}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.GitCommits ListBoxItem:selected Border.GitRefTag">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="ListBox.GitCommits:focus-within ListBoxItem:selected Border.GitRefTag">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="Border.GitRefTag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ShellCaptionFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellCaptionLineHeight}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Border.GitCountBadge">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellPillCornerRadius}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.GitCountBadge TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ShellCaptionFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellCaptionLineHeight}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The commit's metadata is one secondary block: labels, values and the
         signature line share the secondary size, the labels muted, so the
         subject and message below are the step up. -->
    <Style Selector="TextBlock.GitMetaLabel">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellSecondaryLineHeight}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.GitMetaValue">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellSecondaryLineHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.GitCommitBody">
      <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight13}" />
    </Style>
    <Style Selector="Button.GitMetaLink">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|SegmentedControl#GitCompactSections">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.GitSidebarRow.current">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- No LineHeight here on purpose: an inflated line box centers digits
         differently from arrows, and the whole point of one text run is a
         shared baseline. -->
    <Style Selector="TextBlock.GitTrackingText">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Ref rows are plain data wrapped in a hit-testable band so the whole
         row answers to the pointer. Every sidebar row puts its label in the
         same column: a 16-point glyph column, then the name, whether the row
         is a branch, a tag, a stash or a worktree. The current branch is
         marked the way a Mac marks the current choice — a checkmark in the
         glyph column and a heavier name — and never with a fill, so the
         selection is the only filled row in the list. -->
    <Style Selector="Border.GitRefRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    </Style>
    <Style Selector="Border.GitRefRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <Style Selector="icons|SymbolIcon.GitCurrentMark">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <!-- A ref tree with focus selects in accent, as a source list does. The
         rules reach only the selected row's own band and its own content (the
         template root that is the row's direct child), never the rows nested
         under a selected folder, so a folder's selection does not recolour
         the branches inside it. Without focus the shell's gray selection
         stands. -->
    <Style Selector="TreeView.GitRefTree:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.GitRefTree:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    </Style>
    <Style Selector="TreeView.GitRefTree:focus-within TreeViewItem:selected > Panel.GitRefTreeRow Border.GitRefRow, TreeView.GitRefTree:focus-within TreeViewItem:selected > Panel.GitRefTreeRow Border.GitRefRow:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeView.GitRefTree:focus-within TreeViewItem:selected > Panel.GitRefTreeRow TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="TreeView.GitRefTree:focus-within TreeViewItem:selected > Panel.GitRefTreeRow icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="TreeView.GitRefTree:focus-within TreeViewItem:selected /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <ContainerQuery Name="gitPanel" Query="max-width:700">
      <Style Selector="Border#GitSidebar">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <!-- The splitter follows the sidebar out of the narrow layout; the
           column itself collapses through the view model, which the
           code-behind informs from the sidebar's visibility. -->
      <Style Selector="Border#GitSidebarSplitterLine">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="GridSplitter#GitSidebarSplitter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="controls|SegmentedControl#GitCompactSections">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="gitPanel" Query="max-width:1000">
      <Style Selector="TextBlock.GitCommitAuthor">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <controls:PanelChrome
      CloseLabel="Close Git panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <!-- The repository's state, not a fixed "available" green. With
           Differentiate Without Color the dot gives way to a glyph per state,
           so the state never rests on hue alone. A Panel has no automation
           peer of its own, so the mark opts into the content view; without
           that VoiceOver never reaches its name. -->
      <Panel
          x:Name="GitStatusMark"
          Background="Transparent"
          ToolTip.Tip="{Binding RepositoryStatusLabel}"
          AutomationProperties.AccessibilityView="Content"
          AutomationProperties.Name="{Binding RepositoryStatusAccessibleName}">
        <Border Classes="StatusDot GitStatusDot" controls:StatusToneBrush.Background="{Binding RepositoryStatusTone}" />
        <Panel Classes="GitStatusGlyphs">
          <icons:SymbolIcon
              Symbol="CheckmarkCircle"
              FontSize="{DynamicResource ShellIconSizeXs}"
              Foreground="{DynamicResource ShellSuccessBrush}"
              IsVisible="{Binding RepositoryStatusTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:StatusTone.Success}}" />
          <icons:SymbolIcon
              Symbol="Warning"
              FontSize="{DynamicResource ShellIconSizeXs}"
              Foreground="{DynamicResource ShellWarningBrush}"
              IsVisible="{Binding RepositoryStatusTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:StatusTone.Warning}}" />
          <icons:SymbolIcon
              Symbol="ErrorCircle"
              FontSize="{DynamicResource ShellIconSizeXs}"
              Foreground="{DynamicResource ShellDangerBrush}"
              IsVisible="{Binding RepositoryStatusTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:StatusTone.Danger}}" />
          <icons:SymbolIcon
              Symbol="Circle"
              FontSize="{DynamicResource ShellIconSizeXs}"
              Foreground="{DynamicResource ShellStatusNeutralBrush}"
              IsVisible="{Binding RepositoryStatusTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:StatusTone.Neutral}}" />
        </Panel>
      </Panel>
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
        <!-- Three pull-down buttons in place of a menu bar inside the panel:
             each keeps one submenu level and a handful of items per group.
             Commands that only read stay enabled while an operation runs;
             only those that change the repository wait for it. -->
        <StackPanel
            x:Name="GitRepositoryMenus"
            Orientation="Horizontal"
            Spacing="{DynamicResource ShellSpaceXs}"
            IsVisible="{Binding IsRepositoryOpen}">
          <Button
              x:Name="GitBranchMenuButton"
              Classes="Dense GitPullDown"
              ToolTip.Tip="Branch, history and worktree commands"
              AutomationProperties.Name="Branch">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock VerticalAlignment="Center" Text="Branch" />
              <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="New Branch at Revision…" Click="OnCreateBranchAtCommit" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Interactive Rebase…" Click="OnInteractiveRebase" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Restore File from Revision…" Click="OnRestoreFile" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Stash Selected Files…" Click="OnSelectiveStash" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Compare Revisions…" Click="OnCompareRevisions" IsEnabled="{Binding CanReadRepository}" />
                <Separator />
                <MenuItem Header="Git Flow">
                  <MenuItem Header="Initialize…" Tag="Initialize" Click="OnGitFlow" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Start…" Tag="Start" Click="OnGitFlow" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Finish…" Tag="Finish" Click="OnGitFlow" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Publish…" Tag="Publish" Click="OnGitFlow" IsEnabled="{Binding CanMutateRepository}" />
                  <Separator />
                  <MenuItem Header="Resume Pending Finish…" Click="OnGitFlowPending" IsEnabled="{Binding CanResolvePendingGitFlowFinish}" />
                  <MenuItem Header="Discard Pending Finish…" Tag="CancelFinish" Click="OnGitFlow" IsEnabled="{Binding CanResolvePendingGitFlowFinish}" />
                </MenuItem>
                <MenuItem Header="Tracking">
                  <MenuItem Header="Set Upstream…" Tag="SetUpstream" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Remove Upstream…" Tag="UnsetUpstream" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <MenuItem Header="Worktrees">
                  <MenuItem Header="Add Worktree…" Click="OnAddWorktree" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Lock Worktree…" Tag="Lock" Click="OnWorktreeTool" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Unlock Worktree…" Tag="Unlock" Click="OnWorktreeTool" IsEnabled="{Binding CanMutateRepository}" />
                  <Separator />
                  <MenuItem Header="Remove Worktree…" Tag="Remove" Click="OnWorktreeTool" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Start Bisect…" Tag="BisectStart" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Recover from Reflog…" Click="OnReflog" IsEnabled="{Binding CanMutateRepository}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button
              x:Name="GitRemoteMenuButton"
              Classes="Dense GitPullDown"
              ToolTip.Tip="Remote and hosting commands"
              AutomationProperties.Name="Remote">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock VerticalAlignment="Center" Text="Remote" />
              <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Fetch…" Tag="Fetch" Click="OnNetworkOptions" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Pull…" Tag="Pull" Click="OnNetworkOptions" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Push…" Tag="Push" Click="OnNetworkOptions" IsEnabled="{Binding CanMutateRepository}" />
                <MenuItem Header="Prune Stale Remote Branches…" Tag="PruneRemote" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                <Separator />
                <MenuItem Header="Open Repository on Host" Tag="Repository" Click="OnHostingShortcut" IsEnabled="{Binding CanReadRepository}" />
                <MenuItem Header="Open Current Branch on Host" Tag="Branch" Click="OnHostingShortcut" IsEnabled="{Binding CanReadRepository}" />
                <MenuItem Header="Open Selected Commit on Host" Tag="Commit" Click="OnHostingShortcut" IsEnabled="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="Open Pull Request…" Tag="PullRequest" Click="OnHostingShortcut" IsEnabled="{Binding CanReadRepository}" />
                <MenuItem Header="Open Notifications" Tag="Notifications" Click="OnHostingShortcut" IsEnabled="{Binding CanReadRepository}" />
                <Separator />
                <MenuItem Header="Accounts and Repositories…" Click="OnHostingAccounts" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button
              x:Name="GitToolsMenuButton"
              Classes="Dense GitPullDown"
              ToolTip.Tip="Inspection, patch and repository tools"
              AutomationProperties.Name="Tools">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock VerticalAlignment="Center" Text="Tools" />
              <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
            </StackPanel>
            <Button.Flyout>
              <!-- Seven entries at the top and one submenu level: reading
                   the history, patches, this repository's own setup, its
                   submodules and LFS, and opening it in other tools. Each
                   item keeps its own enablement. The choices every Git panel
                   shares are in Settings, which the last item opens. -->
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="GitInvestigateMenu" Header="Investigate">
                  <MenuItem Header="File History and Blame…" Click="OnFileHistory" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Line History…" Tag="RangeHistory" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Commit Signature…" Tag="Signature" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Preview Merge Conflicts…" Tag="ConflictForecast" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Review Selection with Agent" Click="OnReviewSelection" IsEnabled="{Binding CanReadRepository}" />
                  <Separator />
                  <MenuItem Header="Repository Statistics…" Tag="Statistics" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Activity Log…" Click="OnActivityLog" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem x:Name="GitBenchmarkMenuItem" Header="Measure Status Read Time…" Tag="Benchmark" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                </MenuItem>
                <MenuItem Header="Patches">
                  <MenuItem Header="Copy Selected Patch" Click="OnCopySelectedPatch" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Save Selected Patch…" Click="OnSaveSelectedPatch" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Export Patch…" Tag="ExportPatch" Click="OnRepositoryTask" IsEnabled="{Binding CanReadRepository}" />
                  <Separator />
                  <MenuItem Header="Apply Patch…" Tag="ApplyPatch" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <!-- Identity and signing are stored in the repository, so
                     they stay with it here rather than in Settings. -->
                <MenuItem x:Name="GitRepositorySetupMenu" Header="Repository">
                  <MenuItem Header="Add Ignore Pattern…" Tag="IgnorePattern" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Run Custom Command…" Click="OnCustomCommand" IsEnabled="{Binding CanMutateRepository}" />
                  <Separator />
                  <MenuItem Header="Repository Identity and Signing…" Click="OnIdentitySettings" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <MenuItem Header="Submodules">
                  <MenuItem Header="Add Submodule…" Tag="Add" Click="OnSubmoduleTool" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Initialize Submodules…" Tag="Initialize" Click="OnSubmoduleTool" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Update Submodules…" Tag="Update" Click="OnSubmoduleTool" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Sync Submodules…" Tag="Sync" Click="OnSubmoduleTool" IsEnabled="{Binding CanMutateRepository}" />
                  <Separator />
                  <MenuItem Header="Remove Submodule…" Tag="Remove" Click="OnSubmoduleTool" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <MenuItem Header="Git LFS">
                  <MenuItem Header="Status and Locks…" Click="OnLfsBrowser" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Set Up for Repository" Tag="LfsInstall" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Fetch Objects" Tag="LfsFetch" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Download Checkout Objects" Tag="LfsPull" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <Separator />
                  <MenuItem Header="Track Pattern…" Tag="LfsTrack" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Untrack Pattern…" Tag="LfsUntrack" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Lock File…" Tag="LfsLock" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                  <MenuItem Header="Unlock File…" Tag="LfsUnlock" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" />
                </MenuItem>
                <MenuItem Header="Open In">
                  <MenuItem Header="Terminal" Tag="Terminal" Click="OnOpenGitContext" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Files" Tag="Files" Click="OnOpenGitContext" IsEnabled="{Binding CanReadRepository}" />
                  <MenuItem Header="Selected File" Tag="File" Click="OnOpenGitContext" IsEnabled="{Binding CanReadRepository}" />
                  <Separator />
                  <MenuItem Header="Diff Tool…" Click="OnSelectedExternalDiff" IsEnabled="{Binding CanMutateRepository}" ToolTip.Tip="Compare the selection in the configured diff tool" />
                  <MenuItem Header="Merge Tool…" Tag="ExternalMerge" Click="OnRepositoryTask" IsEnabled="{Binding CanMutateRepository}" ToolTip.Tip="Resolve the selected conflict in the configured merge tool" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="GitSettingsMenuItem" Header="Git Settings…" Click="OnGitSettings" ToolTip.Tip="Choices every Git panel shares, in Settings" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <Button Content="Cancel Operation" Click="OnCancelGitOperation" IsVisible="{Binding IsMutating}" />
        <Button Classes="IconButton" Tag="Previous" Click="OnNavigateConflict" IsVisible="{Binding HasUnresolvedConflicts}" ToolTip.Tip="Previous conflict" AutomationProperties.Name="Previous conflict">
          <icons:SymbolIcon Symbol="ChevronLeft" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Button Content="Resolve Conflict…" Click="OnResolveConflict" IsVisible="{Binding IsConflictSelected}" IsEnabled="{Binding CanMutateRepository}" />
        <Button Classes="IconButton" Tag="Next" Click="OnNavigateConflict" IsVisible="{Binding HasUnresolvedConflicts}" ToolTip.Tip="Next conflict" AutomationProperties.Name="Next conflict">
          <icons:SymbolIcon Symbol="ChevronRight" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <!-- No LineHeight: the status line carries ↑/↓ arrows beside digits,
             and only an uninflated line box keeps them on one centerline. -->
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite" />
        <Border Classes="FileToolbarGroup" x:Name="GitToolbarActions">
          <StackPanel Orientation="Horizontal">
            <Button
                Classes="IconButton FileToolbarAction"
                Command="{Binding PullCommand}"
                ToolTip.Tip="Pull"
                AutomationProperties.Name="Pull">
              <icons:SymbolIcon Symbol="ArrowDown" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                Classes="IconButton FileToolbarAction"
                Command="{Binding PushCommand}"
                ToolTip.Tip="Push"
                AutomationProperties.Name="Push">
              <icons:SymbolIcon Symbol="ArrowUp" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                Classes="IconButton FileToolbarAction"
                Command="{Binding SyncCommand}"
                ToolTip.Tip="Pull, then push"
                AutomationProperties.Name="Pull, then push">
              <icons:SymbolIcon Symbol="ArrowSync" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                Classes="IconButton FileToolbarAction"
                Click="OnStashClick"
                IsEnabled="{Binding CanMutateRepository}"
                ToolTip.Tip="Stash working changes"
                AutomationProperties.Name="Stash working changes">
              <icons:SymbolIcon Symbol="Archive" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                Classes="IconButton FileToolbarAction"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh repository state"
                AutomationProperties.Name="Refresh repository state">
              <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <TextBlock
            Classes="Muted Path"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding RepositoryRoot}" />
        <TextBlock
            Grid.Column="1"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding ConnectionDisplayName, StringFormat=Connection · {0}}" />
        <!-- Impersonation is visible, never silent: when Git runs as the
             repository's owner rather than the signed-in user, the footer
             says so for the panel's whole life. -->
        <TextBlock
            Grid.Column="2"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding EffectiveGitUser, StringFormat=· git as {0}}"
            IsVisible="{Binding HasEffectiveGitUser}" />
      </Grid>
    </controls:PanelChrome.Footer>

    <!-- No panel-wide fill: like the File Viewer and Process Monitor, the
         content stays transparent so the shell's glass shows through. -->
    <Grid>
      <!-- Repository chooser: what the panel is before a repository is open. -->
      <ScrollViewer IsVisible="{Binding !IsRepositoryOpen}">
        <controls:SurfaceCard
            MaxWidth="480"
            Margin="{controls:Inset Xl}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="{DynamicResource ShellCardPadding}">
          <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="Git" />
              <TextBlock Classes="Title3" Text="Open a repository" />
              <TextBlock
                  Classes="Muted"
                  Text="Choose a repository folder on this connection. Asura uses the Git installed there."
                  TextWrapping="Wrap" />
            </StackPanel>
            <controls:LabeledField Label="Repository path">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <TextBox
                    Text="{Binding RepositoryPathInput, Mode=TwoWay}"
                    PlaceholderText="/path/to/repository"
                    KeyDown="OnRepositoryPathKeyDown"
                    AutomationProperties.Name="Repository path" />
                <Button
                    Grid.Column="1"
                    Classes="SecondaryButton"
                    VerticalAlignment="Stretch"
                    Click="OnBrowseRepositoryClick"
                    Content="Choose…"
                    AutomationProperties.Name="Choose repository folder" />
              </Grid>
            </controls:LabeledField>
            <Button
                    Classes="SecondaryButton"
                    Click="OnTrustRepositoryClick"
                    Content="Trust Repository…"
                    IsVisible="{Binding CanTrustRepository}" />
            <Button
                Classes="PrimaryButton"
                HorizontalAlignment="Left"
                Command="{Binding OpenRepositoryCommand}"
                Content="Open Repository" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
              <Button Content="Accounts and Repositories…" Click="OnHostingAccounts" IsEnabled="{Binding !IsMutating}" />
              <Button Content="Clone…" Tag="Clone" Click="OnCreateRepository" IsEnabled="{Binding !IsMutating}" />
              <Button Content="Initialize…" Tag="Initialize" Click="OnCreateRepository" IsEnabled="{Binding !IsMutating}" />
              <!-- A pull-down of commands, one per recent repository: choosing
                   one opens it. A combo box did the same on selection, which
                   reads as a setting rather than an action. -->
              <Button
                  x:Name="GitRecentRepositoriesButton"
                  Classes="GitPullDown"
                  IsEnabled="{Binding HasRecentRepositories}"
                  ToolTip.Tip="Open a recently used repository"
                  AutomationProperties.Name="Open Recent">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock VerticalAlignment="Center" Text="Open Recent" />
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>
            </StackPanel>
          </StackPanel>
        </controls:SurfaceCard>
      </ScrollViewer>

      <Grid IsVisible="{Binding IsRepositoryOpen}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay}" MinWidth="{Binding SidebarColumnMinWidth}" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Repository sidebar: sections, then refs, mirroring the reference
             client's information architecture with the shell's own visuals. -->
        <Border
            x:Name="GitSidebar"
            Grid.Column="0"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,1,0">
          <Border.Resources>
            <x:Double x:Key="TreeViewItemIndent">16</x:Double>
            <ControlTheme x:Key="GitRefTreeItemTheme" TargetType="TreeViewItem"
                x:DataType="vm:GitRefTreeNodeViewModel" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="MinHeight" Value="{StaticResource GitSidebarRowHeight}" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <!-- A ref row says what it is to VoiceOver by its name, and the
                   current branch says so as its status, not only by its
                   checkmark and weight. -->
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleStatus}" />
              <!-- State selectors override the Fluent template's fixed margins.
                   The disclosure toggle is a 20 × 20 target, but the chevron
                   drawn in it stays the section headers' small one rather
                   than stretching to fill the target. The target ends where
                   the folder name begins, so the gap before the name is the
                   target's own room around the glyph and nothing overlaps. -->
              <Style Selector="^:not(:empty) /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Width" Value="20" />
              </Style>
              <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
                <!-- Fluent stretches its chevron path to fill the toggle, so a
                     20-point target drew a 20-point chevron. This draws the
                     section headers' own glyph at its own size instead. -->
                <Setter Property="Template">
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}">
                      <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icons:SymbolIcon
                            Symbol="ChevronRight"
                            FontSize="{DynamicResource ShellIconSizeXs}"
                            Foreground="{TemplateBinding Foreground}"
                            IsVisible="{TemplateBinding IsChecked, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:True}}" />
                        <icons:SymbolIcon
                            Symbol="ChevronDown"
                            FontSize="{DynamicResource ShellIconSizeXs}"
                            Foreground="{TemplateBinding Foreground}"
                            IsVisible="{TemplateBinding IsChecked, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:True}}" />
                      </Panel>
                    </Border>
                  </ControlTemplate>
                </Setter>
              </Style>
              <!-- A leaf's ref glyph occupies the disclosure column. Reserving
                   an empty chevron here would double its apparent indent, so
                   every leaf, a branch, a remote branch or a tag, carries a
                   16-point glyph column instead and its name lines up with
                   a folder's name beside the chevron. -->
              <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Width" Value="0" />
              </Style>
            </ControlTheme>
          </Border.Resources>
          <Grid Margin="{controls:Inset Sm}" RowDefinitions="Auto,*">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock
                  Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                  Classes="Eyebrow"
                  Text="{Binding RepositoryName}" />
              <!-- The two sections are a source list: one row is the current
                   section, and the list says which to VoiceOver as selection
                   rather than as a tint on a button. -->
              <ListBox
                  x:Name="GitSectionList"
                  Classes="GitSections"
                  SelectionMode="Single,AlwaysSelected"
                  SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                  AutomationProperties.Name="Repository sections">
                <ListBoxItem AutomationProperties.Name="Local Changes">
                  <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Edit" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Local Changes" />
                    <Border Grid.Column="2" HorizontalAlignment="Right" Classes="GitCountBadge">
                      <TextBlock Text="{Binding UnstagedCount}" />
                    </Border>
                  </Grid>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="All Commits">
                  <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="History" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="All Commits" />
                  </Grid>
                </ListBoxItem>
              </ListBox>
              <controls:SearchField x:Name="GitRefFilter" Classes="GitRefFilter"
                  Margin="{controls:Inset Top=Xs}" Text="{Binding RefFilter}"
                  PlaceholderText="Filter branches and tags" AutomationProperties.Name="Filter branches and tags" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="{controls:Inset Top=Sm}" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <StackPanel Spacing="0">
                  <ToggleButton
                      x:Name="GitBranchesDisclosure"
                      Classes="SectionDisclosure"
                      IsChecked="{Binding IsBranchesSectionExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="Branches">
                    <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Branches" />
                  </ToggleButton>
                  <TreeView x:Name="GitLocalBranchTree" Classes="GitRefTree"
                      ItemsSource="{Binding LocalBranchTree}" IsVisible="{Binding IsBranchesSectionExpanded}"
                      ItemContainerTheme="{StaticResource GitRefTreeItemTheme}"
                      AutomationProperties.Name="Branches">
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate x:DataType="vm:GitRefTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <Panel Classes="GitRefTreeRow">
                          <TextBlock Text="{Binding Name}" Classes="GitSidebarRow"
                              VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                          <Border IsVisible="{Binding HasRef}">
                            <Border DataContext="{Binding Item}" x:DataType="vm:GitRefItemViewModel" Padding="0"
                                Classes="GitRefRow"
                                DoubleTapped="OnBranchRowDoubleTapped">
                              <!-- Three groups: what you do with the branch,
                                   what you make from it, and deleting it,
                                   last and on its own. -->
                              <Border.ContextMenu>
                                <ContextMenu Opening="OnGitMenuOpening">
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchCheckout}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchCheckoutWorktree}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchFastForward}" IsVisible="{Binding HasUpstream}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchPush}" IsVisible="{Binding HasPushRemote}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchMerge}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchRebase}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                  <Separator />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitNewBranch}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchNewTag}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchRename}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchCopyName}" Click="OnGitMenuCommand" />
                                  <Separator IsVisible="{Binding !IsCurrent}" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitBranchDelete}" IsVisible="{Binding !IsCurrent}" Click="OnGitMenuCommand" />
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                                <icons:SymbolIcon
                                    Classes="GitRefGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Symbol="BranchFork"
                                    FontSize="{DynamicResource ShellIconSizeXs}"
                                    IsVisible="{Binding !IsCurrent}" />
                                <icons:SymbolIcon
                                    Classes="GitCurrentMark"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Symbol="Checkmark"
                                    FontSize="{DynamicResource ShellIconSizeXs}"
                                    IsVisible="{Binding IsCurrent}"
                                    ToolTip.Tip="Current branch" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="GitSidebarRow"
                                    Classes.current="{Binding IsCurrent}"
                                    Text="{Binding LeafName}" ToolTip.Tip="{Binding Name}" />
                                <!-- One text run renders “↑1 ↓3”: arrows from the
                                     digits' own font share their baseline by
                                     construction. -->
                                <TextBlock
                                    Grid.Column="2"
                                    Classes="GitTrackingText"
                                    Text="{Binding TrackingText}"
                                    IsVisible="{Binding HasTracking}" />
                              </Grid>
                            </Border>
                          </Border>
                        </Panel>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </StackPanel>

                <StackPanel Spacing="0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                    <ToggleButton
                        Classes="SectionDisclosure"
                        IsChecked="{Binding IsRemotesSectionExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="Remotes">
                      <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Remotes" />
                    </ToggleButton>
                    <Button
                        Grid.Column="1"
                        Classes="IconButton Compact"
                        Click="OnAddRemoteClick"
                        ToolTip.Tip="Add remote…"
                        AutomationProperties.Name="Add remote">
                      <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
                    </Button>
                  </Grid>
                  <TreeView x:Name="GitRemoteBranchTree" Classes="GitRefTree"
                      ItemsSource="{Binding RemoteBranchTree}" IsVisible="{Binding IsRemotesSectionExpanded}"
                      ItemContainerTheme="{StaticResource GitRefTreeItemTheme}"
                      AutomationProperties.Name="Remotes">
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate x:DataType="vm:GitRefTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <Panel Classes="GitRefTreeRow">
                          <TextBlock Text="{Binding Name}" Classes="GitSidebarRow"
                              VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                          <Border IsVisible="{Binding HasRef}">
                            <Border DataContext="{Binding Item}" x:DataType="vm:GitRefItemViewModel" Padding="0" Classes="GitRefRow">
                              <Border.ContextMenu>
                                <ContextMenu Opening="OnGitMenuOpening">
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitRemoteFetch}" Click="OnGitMenuCommand" />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitRemoteEdit}" Click="OnGitMenuCommand" />
                                  <Separator />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitRemoteRemove}" Click="OnGitMenuCommand" />
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Grid ColumnDefinitions="16,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                                <icons:SymbolIcon
                                    Classes="GitRefGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Symbol="Globe"
                                    FontSize="{DynamicResource ShellIconSizeXs}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="GitSidebarRow" Text="{Binding LeafName}" ToolTip.Tip="{Binding Name}" />
                              </Grid>
                            </Border>
                          </Border>
                        </Panel>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </StackPanel>

                <StackPanel Spacing="0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                    <ToggleButton
                        Classes="SectionDisclosure"
                        IsChecked="{Binding IsTagsSectionExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="Tags">
                      <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Tags" />
                    </ToggleButton>
                    <Button
                        Grid.Column="1"
                        Classes="IconButton Compact"
                        Click="OnCreateTagClick"
                        ToolTip.Tip="Create tag…"
                        AutomationProperties.Name="Create tag">
                      <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
                    </Button>
                  </Grid>
                  <TreeView x:Name="GitTagTree" Classes="GitRefTree"
                      ItemsSource="{Binding TagTree}" IsVisible="{Binding IsTagsSectionExpanded}"
                      ItemContainerTheme="{StaticResource GitRefTreeItemTheme}"
                      AutomationProperties.Name="Tags">
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate x:DataType="vm:GitRefTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <Panel Classes="GitRefTreeRow">
                          <TextBlock Text="{Binding Name}" Classes="GitSidebarRow"
                              VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                          <Border IsVisible="{Binding HasRef}">
                            <Border DataContext="{Binding Item}" x:DataType="vm:GitRefItemViewModel" Padding="0" Classes="GitRefRow">
                              <Border.ContextMenu>
                                <ContextMenu Opening="OnGitMenuOpening">
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitTagCopyName}" Click="OnGitMenuCommand" />
                                  <Separator />
                                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitTagDelete}" Click="OnGitMenuCommand" />
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Grid ColumnDefinitions="16,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                                <icons:SymbolIcon
                                    Classes="GitRefGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Symbol="Tag"
                                    FontSize="{DynamicResource ShellIconSizeXs}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="GitSidebarRow" Text="{Binding LeafName}" ToolTip.Tip="{Binding Name}" />
                              </Grid>
                            </Border>
                          </Border>
                        </Panel>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </StackPanel>

                <StackPanel Spacing="0">
                  <ToggleButton
                      Classes="SectionDisclosure"
                      IsChecked="{Binding IsStashesSectionExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="Stashes">
                    <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Stashes" />
                  </ToggleButton>
                  <ListBox
                      x:Name="GitStashList"
                      Classes="GitSidebarList"
                      ItemsSource="{Binding Stashes}"
                      IsVisible="{Binding IsStashesSectionExpanded}"
                      AutomationProperties.Name="Stashes">
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem" x:DataType="git:GitStashItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Subject}" />
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="GitRefRow">
                          <Border.ContextMenu>
                            <ContextMenu Opening="OnGitMenuOpening">
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitStashApply}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitStashPop}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitStashShowPatch}" Click="OnGitMenuCommand" />
                              <Separator />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitStashDrop}" Click="OnGitMenuCommand" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Grid ColumnDefinitions="16,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                            <icons:SymbolIcon Classes="GitRefGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Archive" FontSize="{DynamicResource ShellIconSizeXs}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="GitSidebarRow"
                                Text="{Binding Subject}"
                                ToolTip.Tip="{Binding Reference}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>

                <StackPanel Spacing="0">
                  <ToggleButton
                      Classes="SectionDisclosure"
                      IsChecked="{Binding IsWorktreesSectionExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="Worktrees">
                    <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Worktrees" />
                  </ToggleButton>
                  <ListBox
                      x:Name="GitWorktreeList"
                      Classes="GitSidebarList"
                      ItemsSource="{Binding Worktrees}"
                      IsVisible="{Binding IsWorktreesSectionExpanded}"
                      AutomationProperties.Name="Worktrees">
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem" x:DataType="git:GitWorktreeItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="GitRefRow">
                          <Border.ContextMenu>
                            <ContextMenu Opening="OnGitMenuOpening">
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitWorktreeOpen}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitWorktreeLock}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitWorktreeUnlock}" Click="OnGitMenuCommand" />
                              <Separator />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitWorktreeRemove}" Click="OnGitMenuCommand" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Grid ColumnDefinitions="16,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                            <icons:SymbolIcon Classes="GitRefGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="{DynamicResource ShellIconSizeXs}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="GitSidebarRow Path"
                                Text="{Binding Path}"
                                ToolTip.Tip="{Binding Branch}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>

                <StackPanel Spacing="0" IsVisible="{Binding HasSubmodules}">
                  <ToggleButton
                      Classes="SectionDisclosure"
                      IsChecked="{Binding IsSubmodulesSectionExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="Submodules">
                    <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Submodules" />
                  </ToggleButton>
                  <ListBox
                      x:Name="GitSubmoduleList"
                      Classes="GitSidebarList"
                      ItemsSource="{Binding Submodules}"
                      IsVisible="{Binding IsSubmodulesSectionExpanded}"
                      AutomationProperties.Name="Submodules">
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem" x:DataType="git:GitSubmoduleItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="GitRefRow">
                          <Border.ContextMenu>
                            <ContextMenu Opening="OnGitMenuOpening">
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitSubmoduleOpen}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitSubmoduleDetails}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitSubmoduleUpdate}" Click="OnGitMenuCommand" />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitSubmoduleSync}" Click="OnGitMenuCommand" />
                              <Separator />
                              <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitSubmoduleRemove}" Click="OnGitMenuCommand" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Grid ColumnDefinitions="16,*" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                            <icons:SymbolIcon Classes="GitRefGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Box" FontSize="{DynamicResource ShellIconSizeXs}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="GitSidebarRow Path"
                                Text="{Binding Path}"
                                ToolTip.Tip="{Binding State}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border
            x:Name="GitSidebarSplitterLine"
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="{DynamicResource ShellBorderBrush}"
            IsHitTestVisible="False" />
        <GridSplitter
            x:Name="GitSidebarSplitter"
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            AutomationProperties.Name="Resize repository sidebar" />

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
          <!-- Narrow layout keeps the two sections reachable without the sidebar. -->
          <controls:SegmentedControl
              x:Name="GitCompactSections"
              Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
              SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
              AutomationProperties.Name="Repository section">
            <RadioButton Content="Local Changes" />
            <RadioButton Content="All Commits" />
          </controls:SegmentedControl>

          <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}">
                <WrapPanel ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding HasOperation}" IsEnabled="{Binding CanMutateRepository}">
                  <TextBlock Text="{Binding OperationLabel}" VerticalAlignment="Center" />
                  <Button Content="Continue" IsVisible="{Binding Operation.CanContinue}" Tag="Continue" Click="OnOperationControl" IsEnabled="{Binding CanContinueOperation}" />
                  <Button Content="Skip" Tag="Skip" Click="OnOperationControl" IsVisible="{Binding CanSkipOperation}" />
                  <Button Content="Abort…" Tag="Abort" Click="OnOperationControl" IsVisible="{Binding !IsBisecting}" />
                  <Button Content="Good" Tag="Good" Click="OnOperationControl" IsVisible="{Binding IsBisecting}" />
                  <Button Content="Bad" Tag="Bad" Click="OnOperationControl" IsVisible="{Binding IsBisecting}" />
                  <Button Content="Skip Candidate" Tag="BisectSkip" Click="OnOperationControl" IsVisible="{Binding IsBisecting}" />
                  <Button Classes="DestructiveButton" Content="Reset Bisect" Tag="BisectReset" Click="OnOperationControl" IsVisible="{Binding IsBisecting}" />
                </WrapPanel>
                <WrapPanel ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding HasPendingGitFlowFinish}" IsEnabled="{Binding CanMutateRepository}">
                  <TextBlock Text="{Binding GitFlowPendingLabel}" VerticalAlignment="Center" />
                  <Button Content="Review and Resume Finish…" Click="OnGitFlowPending" />
                  <Button Classes="DestructiveButton" Content="Discard Pending Plan…" Tag="Cancel" Click="OnGitFlowPending" />
                </WrapPanel>
          </StackPanel>

          <!-- Local Changes: working set, composer, and diff. -->
          <Grid Grid.Row="2" IsVisible="{Binding IsLocalChangesSection}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding ChangesColumnWidth, Mode=TwoWay}" MinWidth="240" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="{Binding DiffColumnWidth, Mode=TwoWay}" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid RowDefinitions="Auto,*,Auto,*,Auto">
              <!-- A bordered band, so an empty section still reads as a
                   section rather than stray text floating in space. -->
              <Border
                  Classes="PanelToolbar"
                  MinHeight="{DynamicResource ShellControlMinHeight}"
                  Padding="{controls:Inset Horizontal=Md, Vertical=Xs}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Unstaged" />
                  <Border Grid.Column="1" Classes="GitCountBadge">
                    <TextBlock Text="{Binding UnstagedCount}" />
                  </Border>
                  <Button
                      Grid.Column="3"
                      Classes="IconButton"
                      Click="OnUnstagedViewToggleClick"
                      ToolTip.Tip="{Binding UnstagedViewToggleLabel}"
                      AutomationProperties.Name="{Binding UnstagedViewToggleLabel}">
                    <Panel>
                      <icons:SymbolIcon Symbol="Folder" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding !UnstagedViewIsTree}" />
                      <icons:SymbolIcon Symbol="Navigation" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding UnstagedViewIsTree}" />
                    </Panel>
                  </Button>
                  <Button
                      Grid.Column="4"
                      Classes="IconButton Danger"
                      Click="OnDiscardClick"
                      IsEnabled="{Binding HasUnstagedSelection}"
                      ToolTip.Tip="Discard selected changes"
                      AutomationProperties.Name="Discard selected changes">
                    <icons:SymbolIcon Symbol="Delete" FontSize="{DynamicResource ShellIconSizeSm}" />
                  </Button>
                  <Button
                      Grid.Column="5"
                      Classes="SecondaryButton Dense"
                      Command="{Binding StageCommand}"
                      Content="Stage"
                      ToolTip.Tip="Stage selected changes"
                      AutomationProperties.Name="Stage selected changes" />
                  <Button
                      Grid.Column="6"
                      Classes="SecondaryButton Dense"
                      Command="{Binding StageAllCommand}"
                      Content="Stage All"
                      ToolTip.Tip="Stage every unstaged change"
                      AutomationProperties.Name="Stage All" />
                </Grid>
              </Border>
              <ListBox
                  x:Name="UnstagedList"
                  Grid.Row="1"
                  Classes="GitChanges"
                  SelectionMode="Multiple"
                  ItemsSource="{Binding UnstagedItems}"
                  SelectionChanged="OnUnstagedSelectionChanged"
                  DoubleTapped="OnUnstagedDoubleTapped"
                  IsVisible="{Binding !UnstagedViewIsTree}"
                  AutomationProperties.Name="Unstaged changes">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <controls:ListItem
                        Classes="MiddleTruncatedDetail"
                        ContentPadding="{DynamicResource ShellListRowPadding}"
                        Title="{Binding FileName}"
                        Detail="{Binding Directory}"
                        AutomationProperties.Name="{Binding AccessibleSummary}">
                      <controls:ListItem.ContextMenu>
<ContextMenu Opening="OnGitMenuOpening">
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileExternalDiff}" Click="OnGitMenuCommand" />
                          <Separator />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileCopyPatch}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileSavePatch}" Click="OnGitMenuCommand" />
                          <Separator />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnore}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnoreExtension}" Click="OnGitMenuCommand" />
                        </ContextMenu>
                      </controls:ListItem.ContextMenu>
                      <controls:ListItem.Leading>
                        <Border
                            Classes="GitKindBadge"
                            Classes.addition="{Binding IsAdditionLike}"
                            Classes.removal="{Binding IsRemovalLike}"
                            Classes.conflict="{Binding IsConflicted}"
                            ToolTip.Tip="{Binding KindLabel}">
                          <TextBlock Text="{Binding KindBadge}" />
                        </Border>
                      </controls:ListItem.Leading>
                    </controls:ListItem>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TreeView
                  x:Name="UnstagedTree"
                  Grid.Row="1"
                  ItemsSource="{Binding UnstagedTreeRoots}"
                  SelectionChanged="OnUnstagedTreeSelectionChanged"
                  IsVisible="{Binding UnstagedViewIsTree}"
                  AutomationProperties.Name="Unstaged changes tree">
                <TreeView.ItemContainerTheme>
                  <ControlTheme TargetType="TreeViewItem" x:DataType="vm:GitChangeTreeNodeViewModel" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
                    <Setter Property="MinHeight" Value="24" />
                  </ControlTheme>
                </TreeView.ItemContainerTheme>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{DynamicResource ShellSpaceXs}"
                        AutomationProperties.Name="{Binding AccessibleSummary}">
                      <StackPanel.ContextMenu>
<ContextMenu Opening="OnGitMenuOpening">
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileExternalDiff}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <Separator IsVisible="{Binding !IsDirectory}" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileCopyPatch}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileSavePatch}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <Separator IsVisible="{Binding !IsDirectory}" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnore}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnoreExtension}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <icons:SymbolIcon
                          VerticalAlignment="Center"
                          Symbol="Folder"
                          FontSize="{DynamicResource ShellIconSizeSm}"
                          Foreground="{DynamicResource ShellMutedBrush}"
                          IsVisible="{Binding IsDirectory}" />
                      <Border
                          Classes="GitKindBadge"
                          Classes.addition="{Binding IsAdditionLike}"
                          Classes.removal="{Binding IsRemovalLike}"
                          Classes.conflict="{Binding IsConflicted}"
                          IsVisible="{Binding !IsDirectory}">
                        <TextBlock Text="{Binding KindBadge}" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" Classes="GitCommitCell" Text="{Binding Name}" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>

              <Border
                  Grid.Row="2"
                  Classes="PanelToolbar"
                  MinHeight="{DynamicResource ShellControlMinHeight}"
                  Padding="{controls:Inset Horizontal=Md, Vertical=Xs}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Staged" />
                  <Border Grid.Column="1" Classes="GitCountBadge">
                    <TextBlock Text="{Binding StagedCount}" />
                  </Border>
                  <Button
                      Grid.Column="3"
                      Classes="IconButton"
                      Click="OnStagedViewToggleClick"
                      ToolTip.Tip="{Binding StagedViewToggleLabel}"
                      AutomationProperties.Name="{Binding StagedViewToggleLabel}">
                    <Panel>
                      <icons:SymbolIcon Symbol="Folder" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding !StagedViewIsTree}" />
                      <icons:SymbolIcon Symbol="Navigation" FontSize="{DynamicResource ShellIconSizeSm}" IsVisible="{Binding StagedViewIsTree}" />
                    </Panel>
                  </Button>
                  <Button
                      Grid.Column="4"
                      Classes="SecondaryButton Dense"
                      Command="{Binding UnstageCommand}"
                      Content="Unstage"
                      ToolTip.Tip="Unstage selected changes"
                      AutomationProperties.Name="Unstage selected changes" />
                  <Button
                      Grid.Column="5"
                      Classes="SecondaryButton Dense"
                      Command="{Binding UnstageAllCommand}"
                      Content="Unstage All"
                      ToolTip.Tip="Unstage every staged change"
                      AutomationProperties.Name="Unstage All" />
                </Grid>
              </Border>
              <ListBox
                  x:Name="StagedList"
                  Grid.Row="3"
                  Classes="GitChanges"
                  SelectionMode="Multiple"
                  ItemsSource="{Binding StagedItems}"
                  SelectionChanged="OnStagedSelectionChanged"
                  DoubleTapped="OnStagedDoubleTapped"
                  IsVisible="{Binding !StagedViewIsTree}"
                  AutomationProperties.Name="Staged changes">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <controls:ListItem
                        Classes="MiddleTruncatedDetail"
                        ContentPadding="{DynamicResource ShellListRowPadding}"
                        Title="{Binding FileName}"
                        Detail="{Binding Directory}"
                        AutomationProperties.Name="{Binding AccessibleSummary}">
                      <controls:ListItem.ContextMenu>
<ContextMenu Opening="OnGitMenuOpening">
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileExternalDiff}" Click="OnGitMenuCommand" />
                          <Separator />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileCopyPatch}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileSavePatch}" Click="OnGitMenuCommand" />
                          <Separator />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnore}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnoreExtension}" Click="OnGitMenuCommand" />
                        </ContextMenu>
                      </controls:ListItem.ContextMenu>
                      <controls:ListItem.Leading>
                        <Border
                            Classes="GitKindBadge"
                            Classes.addition="{Binding IsAdditionLike}"
                            Classes.removal="{Binding IsRemovalLike}"
                            Classes.conflict="{Binding IsConflicted}"
                            ToolTip.Tip="{Binding KindLabel}">
                          <TextBlock Text="{Binding KindBadge}" />
                        </Border>
                      </controls:ListItem.Leading>
                    </controls:ListItem>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TreeView
                  x:Name="StagedTree"
                  Grid.Row="3"
                  ItemsSource="{Binding StagedTreeRoots}"
                  SelectionChanged="OnStagedTreeSelectionChanged"
                  IsVisible="{Binding StagedViewIsTree}"
                  AutomationProperties.Name="Staged changes tree">
                <TreeView.ItemContainerTheme>
                  <ControlTheme TargetType="TreeViewItem" x:DataType="vm:GitChangeTreeNodeViewModel" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
                    <Setter Property="MinHeight" Value="24" />
                  </ControlTheme>
                </TreeView.ItemContainerTheme>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{DynamicResource ShellSpaceXs}"
                        AutomationProperties.Name="{Binding AccessibleSummary}">
                      <StackPanel.ContextMenu>
<ContextMenu Opening="OnGitMenuOpening">
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileExternalDiff}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <Separator IsVisible="{Binding !IsDirectory}" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileCopyPatch}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileSavePatch}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <Separator IsVisible="{Binding !IsDirectory}" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnore}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileIgnoreExtension}" IsVisible="{Binding !IsDirectory}" Click="OnGitMenuCommand" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <icons:SymbolIcon
                          VerticalAlignment="Center"
                          Symbol="Folder"
                          FontSize="{DynamicResource ShellIconSizeSm}"
                          Foreground="{DynamicResource ShellMutedBrush}"
                          IsVisible="{Binding IsDirectory}" />
                      <Border
                          Classes="GitKindBadge"
                          Classes.addition="{Binding IsAdditionLike}"
                          Classes.removal="{Binding IsRemovalLike}"
                          Classes.conflict="{Binding IsConflicted}"
                          IsVisible="{Binding !IsDirectory}">
                        <TextBlock Text="{Binding KindBadge}" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" Classes="GitCommitCell" Text="{Binding Name}" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>

              <!-- The commit composer persists across refreshes: drafts live
                   on the view model, not in the controls. -->
              <Border
                  Grid.Row="4"
                  Classes="PanelFooter"
                  Padding="{controls:Inset Md}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBox
                      Text="{Binding CommitSubject, Mode=TwoWay}"
                      PlaceholderText="Commit subject"
                      AutomationProperties.Name="Commit subject" />
                  <TextBox
                      MinHeight="52"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Text="{Binding CommitBody, Mode=TwoWay}"
                      PlaceholderText="Description (optional)"
                      AutomationProperties.Name="Commit description" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <CheckBox
                        VerticalAlignment="Center"
                        IsChecked="{Binding Amend, Mode=TwoWay}"
                        Content="Amend" />
                    <Button
                        Grid.Column="2"
                        Classes="PrimaryButton"
                        Command="{Binding CommitCommand}"
                        Content="Commit" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Width="1"
                HorizontalAlignment="Center"
                Background="{DynamicResource ShellBorderBrush}"
                IsHitTestVisible="False" />
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                AutomationProperties.Name="Resize diff" />

            <components:GitDiffView Grid.Column="2" />
          </Grid>

          <!-- All Commits: history above, commit details and diff below. -->
          <Grid Grid.Row="2" IsVisible="{Binding IsAllCommitsSection}">
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding HistoryRowHeight, Mode=TwoWay}" MinHeight="120" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="{Binding DetailRowHeight, Mode=TwoWay}" MinHeight="140" />
            </Grid.RowDefinitions>

            <Grid RowDefinitions="*,Auto">
              <!-- Compact history: graph rail, subject with ref tags,
                   then author, SHA, and date columns. The current commit is
                   joined to the list in code rather than bound to its
                   SelectedItem: setting that collapses a multiple selection,
                   and the current commit moves within one, as Finder's does
                   when a selected row is right-clicked. -->
              <ListBox
                  x:Name="CommitHistory"
                  Classes="GitCommits"
                  SelectionMode="Multiple"
                  SelectionChanged="OnHistorySelection"
                  ItemsSource="{Binding Commits}"
                  AutomationProperties.Name="Commit history">
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="CommitContextMenu" Opening="OnHistoryContextMenuOpening">
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitNewBranch}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitNewTag}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitCheckout}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitCherryPick}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitRevert}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitInteractiveRebase}" Click="OnGitMenuCommand" />
                    <Separator />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitCompareLocal}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitCompare}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitOpenOnHost}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitSavePatch}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitCopySha}" Click="OnGitMenuCommand" />
                    <Separator />
                    <!-- The Git menu's three Reset Branch to Commit items, with
                         their titles: one title per command, here as there. -->
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitResetSoft}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitResetMixed}" Click="OnGitMenuCommand" />
                    <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitCommitResetHard}" Click="OnGitMenuCommand" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem" x:DataType="vm:GitCommitItemViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid
                        Background="Transparent"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource ShellSpaceSm}"
                        AutomationProperties.Name="{Binding AccessibleSummary}"
                        PointerPressed="OnHistoryDragPressed"
                        PointerMoved="OnHistoryDragMoved"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnHistoryDragOver"
                        DragDrop.Drop="OnHistoryDrop">
                      <components:GitCommitGraphRowView
                          Margin="{controls:Inset Left=Xs}"
                          VerticalAlignment="Stretch"
                          Row="{Binding Graph}" />
                      <!-- Tags take what they need; the subject gets the rest
                           of the column and trims with an ellipsis instead of
                           running under the author and SHA cells (a horizontal
                           StackPanel would measure it unbounded). -->
                      <Grid
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="{DynamicResource ShellSpaceXs}">
                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding RefNames}" IsVisible="{Binding HasRefs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="GitRefTag">
                                <TextBlock Text="{Binding}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="GitCommitCell"
                            Text="{Binding Subject}"
                            TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <TextBlock
                          Grid.Column="2"
                          Width="120"
                          VerticalAlignment="Center"
                          Classes="GitCommitCell Muted GitCommitAuthor"
                          Text="{Binding AuthorName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Grid.Column="3"
                          Width="70"
                          VerticalAlignment="Center"
                          Classes="GitCommitCell Muted"
                          FontFamily="{DynamicResource ShellDataFontFamily}"
                          Text="{Binding ShortSha}" />
                      <TextBlock
                          Grid.Column="4"
                          Width="118"
                          Margin="{controls:Inset Right=Sm}"
                          VerticalAlignment="Center"
                          TextAlignment="Right"
                          Classes="GitCommitCell Muted"
                          Text="{Binding AuthoredAtText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button
                  Grid.Row="1"
                  Classes="TextButton"
                  HorizontalAlignment="Center"
                  Command="{Binding LoadMoreCommitsCommand}"
                  Content="Load More Commits"
                  IsVisible="{Binding HasMoreCommits}" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                VerticalAlignment="Center"
                Background="{DynamicResource ShellBorderBrush}"
                IsHitTestVisible="False" />
            <GridSplitter
                Grid.Row="1"
                Height="5"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"
                AutomationProperties.Name="Resize commit details" />

            <!-- The Commit tab reads full width; only Changes and File Tree
                 split into list-plus-comparison columns. -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <controls:SegmentedControl
                    x:Name="GitCommitDetailTabs"
                    Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                    SelectedIndex="{Binding DetailTabIndex, Mode=TwoWay}"
                    AutomationProperties.Name="Commit detail view">
                  <RadioButton Content="Commit" />
                  <RadioButton Content="Changes" />
                  <RadioButton Content="File Tree" />
                </controls:SegmentedControl>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsCommitTab}">
                  <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceSm}">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource ShellSpaceSm}"
                        RowSpacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock Classes="GitMetaLabel" Text="Author" />
                      <TextBlock
                          Grid.Column="1"
                          Classes="GitMetaValue"
                          Text="{Binding CommitDetailMeta}"
                          TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Classes="GitMetaLabel" Text="Refs" IsVisible="{Binding SelectedCommit.HasRefs}" />
                      <ItemsControl
                          Grid.Row="1"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding SelectedCommit.RefNames}"
                          IsVisible="{Binding SelectedCommit.HasRefs}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="GitRefTag">
                              <TextBlock Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Row="2" Classes="GitMetaLabel" Text="SHA" />
                      <TextBlock
                          Grid.Row="2"
                          Grid.Column="1"
                          Classes="GitMetaValue MiddleTruncated"
                          FontFamily="{DynamicResource ShellDataFontFamily}"
                          Text="{Binding SelectedCommit.Commit.Sha}" />
                      <TextBlock Grid.Row="3" Classes="GitMetaLabel" Text="Parents" IsVisible="{Binding HasCommitParents}" />
                      <ItemsControl
                          Grid.Row="3"
                          Grid.Column="1"
                          ItemsSource="{Binding CommitParentShas}"
                          IsVisible="{Binding HasCommitParents}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <!-- No padding, so the link starts in the value
                                 column with the SHA above it. -->
                            <Button
                                Classes="TextButton Accent GitMetaLink"
                                Click="OnParentShaClick"
                                Content="{Binding}"
                                FontFamily="{DynamicResource ShellDataFontFamily}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>

                    <TextBlock Classes="GitMetaValue Muted" Text="{Binding CommitSignatureSummary}" TextWrapping="Wrap" IsVisible="{Binding CommitSignatureSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding SelectedCommit.Subject}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="GitCommitBody"
                        Text="{Binding CommitDetailBody}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasCommitDetailBody}" />

                    <!-- The changed files, opening in the Changes tab. -->
                    <ItemsControl ItemsSource="{Binding CommitChanges}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button
                              Classes="ListRow"
                              Click="OnCommitChangeRowClick"
                              AutomationProperties.Name="{Binding AccessibleSummary}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                              <Border
                                  Classes="GitKindBadge"
                                  Classes.addition="{Binding IsAdditionLike}"
                                  Classes.removal="{Binding IsRemovalLike}"
                                  Classes.conflict="{Binding IsConflicted}"
                                  ToolTip.Tip="{Binding KindLabel}">
                                <TextBlock Text="{Binding KindBadge}" />
                              </Border>
                              <TextBlock
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Classes="GitCommitCell Path"
                                  Text="{Binding Path}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="2*,Auto,3*"
                    IsVisible="{Binding !IsCommitTab}">
                <Grid>
                <TreeView
                    ItemsSource="{Binding CommitTreeRoots}"
                    SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                    IsVisible="{Binding IsFileTreeTab}"
                    AutomationProperties.Name="Commit file tree">
                  <TreeView.ItemContainerTheme>
                    <ControlTheme TargetType="TreeViewItem" x:DataType="vm:GitTreeNodeViewModel" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
                      <Setter Property="MinHeight" Value="24" />
                    </ControlTheme>
                  </TreeView.ItemContainerTheme>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                        <StackPanel.ContextMenu>
                          <ContextMenu Opening="OnGitMenuOpening"><MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" /></ContextMenu>
                        </StackPanel.ContextMenu>
                        <icons:SymbolIcon
                            VerticalAlignment="Center"
                            Symbol="Folder"
                            FontSize="{DynamicResource ShellIconSizeSm}"
                            Foreground="{DynamicResource ShellMutedBrush}"
                            IsVisible="{Binding IsDirectory}" />
                        <icons:SymbolIcon
                            VerticalAlignment="Center"
                            Symbol="Document"
                            FontSize="{DynamicResource ShellIconSizeSm}"
                            Foreground="{DynamicResource ShellMutedBrush}"
                            IsVisible="{Binding !IsDirectory}" />
                        <TextBlock VerticalAlignment="Center" Classes="GitCommitCell" Text="{Binding Name}" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>

                <ListBox
                    Classes="GitChanges"
                    ItemsSource="{Binding CommitChanges}"
                    SelectedItem="{Binding SelectedCommitChange, Mode=TwoWay}"
                    IsVisible="{Binding IsChangesTab}"
                    AutomationProperties.Name="Commit changes">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <controls:ListItem
                          Classes="MiddleTruncatedDetail"
                          ContentPadding="{DynamicResource ShellListRowPadding}"
                          Title="{Binding FileName}"
                          Detail="{Binding Directory}"
                          AutomationProperties.Name="{Binding AccessibleSummary}">
                        <controls:ListItem.ContextMenu>
<ContextMenu Opening="OnGitMenuOpening">
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileHistory}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileExternalDiff}" Click="OnGitMenuCommand" />
                          <Separator />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileCopyPatch}" Click="OnGitMenuCommand" />
                          <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitFileSavePatch}" Click="OnGitMenuCommand" />
                        </ContextMenu>
                        </controls:ListItem.ContextMenu>
                        <controls:ListItem.Leading>
                          <Border
                              Classes="GitKindBadge"
                              Classes.addition="{Binding IsAdditionLike}"
                              Classes.removal="{Binding IsRemovalLike}"
                              Classes.conflict="{Binding IsConflicted}"
                              ToolTip.Tip="{Binding KindLabel}">
                            <TextBlock Text="{Binding KindBadge}" />
                          </Border>
                        </controls:ListItem.Leading>
                      </controls:ListItem>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Border
                  Grid.Column="1"
                  Width="1"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ShellBorderBrush}"
                  IsHitTestVisible="False" />
              <GridSplitter
                  Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="Resize commit diff" />

              <Grid Grid.Column="2">
                <components:GitDiffView IsVisible="{Binding !IsFileTreeTab}" />

                <!-- The File Tree tab previews the file as the commit
                     recorded it, through the shared code preview. -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsFileTreeTab}">
                  <Border
                      Classes="PanelToolbar"
                      Padding="{controls:Inset Horizontal=Md, Vertical=Xs}"
                      IsVisible="{Binding HasCommitFile}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource ShellDataFontFamily}"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        LineHeight="{DynamicResource ShellSecondaryLineHeight}"
                        Classes="Path"
                        Text="{Binding CommitFileName}" />
                  </Border>
                  <components:CodePreviewView
                      Grid.Row="1"
                      Text="{Binding CommitFileText}"
                      FileName="{Binding CommitFileName}"
                      WordWrap="False"
                      IsVisible="{Binding HasCommitFile}" />
                  <controls:StateOverlay
                      Grid.Row="1"
                      Kind="Empty"
                      Heading="No file selected"
                      Body="Choose a file to read it as this commit recorded it."
                      IsVisible="{Binding !HasCommitFile}" />
                  <controls:Callout
                      Grid.Row="1"
                      Margin="{controls:Inset Md}"
                      VerticalAlignment="Top"
                      Tone="Default"
                      Title="Binary file"
                      Text="This file has no text preview."
                      IsVisible="{Binding CommitFileIsBinary}" />
                  <controls:StateOverlay
                      Grid.Row="1"
                      Kind="Loading"
                      Heading="Reading file…"
                      IsVisible="{Binding IsCommitFileLoading}" />
                </Grid>
              </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </controls:PanelChrome>
</UserControl>
