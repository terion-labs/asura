<UserControl
    x:Class="Asura.App.Views.RuntimePanels.DatabaseRuntimePanelView"
    x:DataType="vm:DatabaseRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Database panel">
  <controls:PanelChrome
      CloseLabel="Close database panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <Border Classes="StatusDot" Classes.available="{Binding IsConnected}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          IsEnabled="{Binding CanChangeConnection}"
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DatabasePanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <controls:LiveRegionTextBlock
          VerticalAlignment="Center"
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding StatusText}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Database state" />
    </controls:PanelChrome.Actions>

    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Classes="PanelToolbar">
        <Grid
            Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <!-- What to connect to and whether we are: one group, one place. -->
          <StackPanel
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceSm}"
              IsEnabled="{Binding CanChangeConnection}">
            <!-- Everything in this row wears the connection pill's 26px height
                 so the header reads as one line of controls. -->
            <ComboBox
                MinWidth="150"
                Height="26"
                VerticalAlignment="Center"
                IsVisible="{Binding HasDatabaseChoices}"
                ItemsSource="{Binding Databases}"
                SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                AutomationProperties.Name="Current database" />
            <Button
                VerticalAlignment="Center"
                Classes="IconButton"
                Click="OnEditConnectionClick"
                IsVisible="{Binding IsSavedConnection}"
                ToolTip.Tip="Edit connection"
                AutomationProperties.Name="Edit this database connection">
              <icons:SymbolIcon Symbol="Options" FontSize="13" />
            </Button>
            <Button
                MinWidth="86"
                Height="26"
                Padding="{controls:Inset Horizontal=Md}"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="SecondaryButton"
                Command="{Binding ConnectCommand}"
                Content="{Binding ConnectButtonLabel}"
                AutomationProperties.Name="Connect to the database" />
            <Button
                Height="26"
                Padding="{controls:Inset Horizontal=Md}"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="SecondaryButton"
                Command="{Binding DisconnectCommand}"
                Content="Disconnect"
                IsVisible="{Binding IsConnected}"
                AutomationProperties.Name="Disconnect from the database" />
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                IsVisible="{Binding !HasConnectionTarget}"
                Text="No connection — choose one from the connection menu."
                TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- The perspectives, out of the connection group: switching views
               is not a connection change. -->
          <components:DatabasePerspectivePicker
              Grid.Column="1"
              DiagramShown="OnDiagramShown" />
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <components:DatabaseWorkspaceView
            x:Name="DatabaseWorkspace"
            OpenObjectInTabRequested="OnOpenObjectInTab"
            OpenObjectInPanelRequested="OnOpenObjectInPanel" />
        <ProgressBar Classes="WorkingStripe" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Grid>
  </controls:PanelChrome>
</UserControl>
