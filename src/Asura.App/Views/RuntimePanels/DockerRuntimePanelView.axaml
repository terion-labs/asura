<UserControl
    x:Class="Asura.App.Views.RuntimePanels.DockerRuntimePanelView"
    x:DataType="vm:DockerRuntimePanelViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:panelViews="using:Asura.App.Views.RuntimePanels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:runtimePanels="using:Asura.App.Views.RuntimePanels"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Docker panel">
  <UserControl.Resources>
    <DataTemplate x:Key="DockerResourceItemTemplate" x:DataType="vm:DockerResourceItemViewModel">
      <!-- An image reference — a repository and its tag — keeps both ends
           when it is cut short, and so does the image under a container's
           name: the tag and the name's suffix are what tell two rows apart. -->
      <controls:ListItem
          Classes="DockerResourceListItem"
          Classes.MiddleTruncatedTitle="{Binding IsImage}"
          Classes.MiddleTruncatedDetail="{Binding IsContainer}"
          ContentPadding="{DynamicResource ShellListRowPadding}"
          Title="{Binding Title}"
          Detail="{Binding Subtitle}"
          Metadata="{Binding Tertiary}">
        <controls:ListItem.Leading>
          <controls:IdentityTile
              TileSize="Small"
              Classes.DockerImage="{Binding IsImage}"
              Classes.DockerVolume="{Binding IsVolume}"
              Classes.DockerNetwork="{Binding IsNetwork}"
              controls:StatusToneBrush.Tint="{Binding StatusTone}"
              Symbol="{Binding Icon}" />
        </controls:ListItem.Leading>
        <controls:ListItem.Trailing>
          <icons:SymbolIcon
              VerticalAlignment="Center"
              Symbol="ChevronRight"
              FontSize="{DynamicResource ShellIconSizeSm}"
              Foreground="{DynamicResource ShellMutedBrush}" />
        </controls:ListItem.Trailing>
      </controls:ListItem>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="controls|IdentityTile.DockerImage">
      <Setter Property="Tint" Value="{DynamicResource ShellDockerImageBrush}" />
    </Style>
    <Style Selector="controls|IdentityTile.DockerVolume">
      <Setter Property="Tint" Value="{DynamicResource ShellDockerVolumeBrush}" />
    </Style>
    <Style Selector="controls|IdentityTile.DockerNetwork">
      <Setter Property="Tint" Value="{DynamicResource ShellDockerNetworkBrush}" />
    </Style>
    <!-- The resource types are a source list: a list box, so the current type
         is its selected row — announced as selected, and moved with the arrow
         keys — rather than a push button wearing a class. -->
    <Style Selector="ListBox.DockerFamilyList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.DockerFamilyList ListBoxItem.DockerNav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>
    <Style Selector="ListBox.DockerResources ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.DockerResources">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.DockerLogs ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.DockerLogs ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A match is the find highlight — the yellow wash the host's find bars
         draw — not the accent, which belongs to what is selected or pressed. -->
    <Style Selector="Border.DockerLogMessageSegment.match">
      <Setter Property="Background" Value="{DynamicResource ShellWarningSoftBrush}" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Border.DockerLogMessageSegment.match TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.DockerResourceRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm}" />
      <Setter Property="AutomationProperties.ItemStatus" Value="" />
    </Style>
    <Style Selector="Button.DockerResourceRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <!-- The same style that draws the selection says it, so a screen reader
         hears which container is selected as well as seeing it. -->
    <Style Selector="Button.DockerResourceRow.selected">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
      <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
    </Style>
    <Style Selector="controls|ListItem.DockerResourceListItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="controls|ListItem.DockerResourceListItem /template/ ContentPresenter#PART_Leading">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="{controls:Inset Top=Xs}" />
    </Style>
    <!-- The name reads at body size and the lines about it at the secondary
         size, so a column of rows scans by name. All three were squeezed to
         eleven, ten and nine points, and the name no longer stood out. -->
    <Style Selector="controls|ListItem.DockerResourceListItem /template/ TextBlock#PART_Detail">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
    </Style>
    <Style Selector="controls|ListItem.DockerResourceListItem /template/ TextBlock#PART_Metadata">
      <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
    </Style>
    <!-- A stack header is a group heading, so it is neutral: a gray plate with
         no outline. Every header used to wear an accent outline, which put
         three or four accent marks on screen beside the selection and left the
         eye nowhere to land; the accent is for what is selected or pressed. -->
    <Style Selector="Border.DockerStackHeaderSurface">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>
    <!-- The header's buttons are full 28-point targets: the 24-point compact
         buttons were smaller than the host's own minimum for a click. -->
    <Style Selector="Button.IconButton.DockerStackToggle, Button.IconButton.DockerStackAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="ToggleButton.DockerFollowToggle">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The engine's status mark is a dot; where colour cannot carry state
         the dot gives way to a glyph with a shape for each state. -->
    <Style Selector="icons|SymbolIcon.DockerEngineStatusGlyph">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="FontSize" Value="{DynamicResource ShellIconSizeXs}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="Window.differentiate-without-color icons|SymbolIcon.DockerEngineStatusGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.differentiate-without-color Border.DockerEngineStatusDot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel Border.DockerFamilyRail">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.DockerFamilyRail">
      <Setter Property="Width" Value="180" />
    </Style>
    <Style Selector="Grid.DockerResourceColumn">
      <Setter Property="Width" Value="280" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel Grid.DockerResourceColumn">
      <Setter Property="Width" Value="220" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView controls|SegmentedControl.DockerCompactSections">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel controls|SegmentedControl.DockerCompactSections">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel StackPanel.DockerSectionHeading">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel TextBlock.DockerStatusSummary">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Where the segments no longer fit, the views become a pop-up button:
         it names the current view, and its menu checks it. -->
    <Style Selector="Button.DockerDetailMenuButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compactDetails controls|SegmentedControl.DockerDetailTabs">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compactDetails Button.DockerDetailMenuButton.hasSelection">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel TextBlock.DockerFollowLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="runtimePanels|DockerRuntimePanelView.narrowPanel TextBlock.DockerStackSummary">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <controls:PanelChrome
      CloseLabel="Close Docker panel"
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <Grid
          Background="Transparent"
          ToolTip.Tip="{Binding EngineStatusLabel}">
        <Border
            Classes="StatusDot DockerEngineStatusDot"
            controls:StatusToneBrush.Background="{Binding EngineStatusTone}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding EngineStatusLabel}" />
        <icons:SymbolIcon
            Classes="DockerEngineStatusGlyph"
            Symbol="{Binding EngineStatusGlyph}"
            AutomationProperties.Name="{Binding EngineStatusLabel}" />
      </Grid>
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted DockerStatusSummary"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            LineHeight="{DynamicResource ShellLineHeight11}"
            Text="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite" />
        <Button
            Classes="IconButton"
            Command="{Binding RefreshCommand}"
            ToolTip.Tip="Refresh Docker resources"
            AutomationProperties.Name="Refresh Docker resources">
          <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
        </Button>
      </StackPanel>
    </controls:PanelChrome.Actions>

    <controls:PanelChrome.Footer>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" LineHeight="{DynamicResource ShellLineHeight11}" Text="{Binding EnginePlatform}" />
        <TextBlock Grid.Column="2" Classes="Muted MiddleTruncated" FontSize="{DynamicResource ShellSecondaryFontSize}" LineHeight="{DynamicResource ShellLineHeight11}" Text="{Binding ConnectionDisplayName, StringFormat=Connection · {0}}" />
      </Grid>
    </controls:PanelChrome.Footer>

    <Grid Name="DockerBody" ColumnDefinitions="Auto,Auto,*">
      <!-- Resource families follow the compact left navigation of the reference,
           while keeping Asura's own spacing, typography, and colors. -->
      <Border Grid.Column="0" Classes="DockerFamilyRail" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="{controls:Inset Sm}" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource ShellSpaceSm}">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" Classes="Eyebrow" Text="Docker" />
            <ListBox
                x:Name="DockerFamilyNavigation"
                Classes="DockerFamilyList"
                SelectionMode="Single,AlwaysSelected"
                SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                AutomationProperties.Name="Docker resource types">
              <ListBoxItem Classes="DockerNav" AutomationProperties.Name="{Binding ContainerCount, StringFormat='Containers, {0}'}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="Box" FontSize="{DynamicResource ShellIconSizeMd}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Containers" />
                  <controls:StatusChip Grid.Column="2" MinWidth="28" HorizontalAlignment="Right" VerticalAlignment="Center" Shape="Rounded" Tone="Default" IsOutlined="False" Content="{Binding ContainerCount}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem Classes="DockerNav" AutomationProperties.Name="{Binding ImageCount, StringFormat='Images, {0}'}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="Archive" FontSize="{DynamicResource ShellIconSizeMd}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Images" />
                  <controls:StatusChip Grid.Column="2" MinWidth="28" HorizontalAlignment="Right" VerticalAlignment="Center" Shape="Rounded" Tone="Default" IsOutlined="False" Content="{Binding ImageCount}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem Classes="DockerNav" AutomationProperties.Name="{Binding VolumeCount, StringFormat='Volumes, {0}'}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="HardDrive" FontSize="{DynamicResource ShellIconSizeMd}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Volumes" />
                  <controls:StatusChip Grid.Column="2" MinWidth="28" HorizontalAlignment="Right" VerticalAlignment="Center" Shape="Rounded" Tone="Default" IsOutlined="False" Content="{Binding VolumeCount}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem Classes="DockerNav" AutomationProperties.Name="{Binding NetworkCount, StringFormat='Networks, {0}'}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="Globe" FontSize="{DynamicResource ShellIconSizeMd}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Networks" />
                  <controls:StatusChip Grid.Column="2" MinWidth="28" HorizontalAlignment="Right" VerticalAlignment="Center" Shape="Rounded" Tone="Default" IsOutlined="False" Content="{Binding NetworkCount}" />
                </Grid>
              </ListBoxItem>
            </ListBox>
          </StackPanel>

          <controls:SurfaceCard Grid.Row="2" Tone="Sunken" Padding="{controls:Inset Sm}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="Engine" />
              <TextBlock FontWeight="SemiBold" Text="{Binding EngineVersion, StringFormat=Docker {0}}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" LineHeight="{DynamicResource ShellLineHeight11}" Text="{Binding RunningContainerCount, StringFormat={}{0} running}" />
            </StackPanel>
          </controls:SurfaceCard>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Classes="DockerResourceColumn" RowDefinitions="Auto,*">
        <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="*,Auto">
          <StackPanel Classes="DockerSectionHeading">
            <TextBlock Classes="Headline" Text="{Binding Section}" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" LineHeight="{DynamicResource ShellLineHeight11}" Text="{Binding ResourceSummary}" />
          </StackPanel>
          <controls:SegmentedControl
              Grid.Column="0"
              Classes="DockerCompactSections"
              SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
              AutomationProperties.Name="Docker resource types">
            <RadioButton ToolTip.Tip="Containers" AutomationProperties.Name="Containers">
              <icons:SymbolIcon Symbol="Box" FontSize="{DynamicResource ShellIconSizeSm}" />
            </RadioButton>
            <RadioButton ToolTip.Tip="Images" AutomationProperties.Name="Images">
              <icons:SymbolIcon Symbol="Archive" FontSize="{DynamicResource ShellIconSizeSm}" />
            </RadioButton>
            <RadioButton ToolTip.Tip="Volumes" AutomationProperties.Name="Volumes">
              <icons:SymbolIcon Symbol="HardDrive" FontSize="{DynamicResource ShellIconSizeSm}" />
            </RadioButton>
            <RadioButton ToolTip.Tip="Networks" AutomationProperties.Name="Networks">
              <icons:SymbolIcon Symbol="Globe" FontSize="{DynamicResource ShellIconSizeSm}" />
            </RadioButton>
          </controls:SegmentedControl>
          <ProgressBar
              Grid.ColumnSpan="2"
              Classes="WorkingStripe"
              VerticalAlignment="Bottom"
              IsVisible="{Binding ShowResourceProgress}"
              AutomationProperties.Name="Loading Docker resources" />
        </Grid>
        <Grid Grid.Row="1">
          <ScrollViewer
              x:Name="ContainerResourceHost"
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              HorizontalScrollBarVisibility="Disabled"
              IsVisible="{Binding IsContainersSection}">
            <ItemsControl x:Name="ContainerStackList" Classes="StretchItems" ItemsSource="{Binding ContainerStacks}" ContextRequested="OnResourceContextRequested">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Classes="DockerStack" RowDefinitions="Auto,Auto">
                    <Border Classes="DockerStackHeaderSurface">
                      <Grid Classes="DockerStackHeader" MinHeight="42" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                        <Button Grid.Column="0" Classes="IconButton DockerStackToggle" Click="OnToggleStackClick" ToolTip.Tip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}">
                          <icons:SymbolIcon Symbol="{Binding ExpandIcon}" FontSize="{DynamicResource ShellIconSizeXs}" />
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="Headline MiddleTruncated" Text="{Binding Name}" />
                          <TextBlock Classes="Muted DockerStackSummary" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Summary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding HasLifecycleControls}">
                          <Grid Width="28" Height="28">
                            <Button Classes="IconButton DockerStackAction" Click="OnStartStackClick" IsVisible="{Binding !CanStop}" ToolTip.Tip="{Binding Name, StringFormat='Start every container in {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Start {0}'}">
                              <icons:SymbolIcon Symbol="Play" FontSize="{DynamicResource ShellIconSizeSm}" />
                            </Button>
                            <Button Classes="IconButton DockerStackAction" Click="OnStopStackClick" IsVisible="{Binding CanStop}" ToolTip.Tip="{Binding Name, StringFormat='Stop every container in {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Stop {0}'}">
                              <icons:SymbolIcon Symbol="Stop" FontSize="{DynamicResource ShellIconSizeSm}" />
                            </Button>
                          </Grid>
                          <Button Classes="IconButton DockerStackAction" Click="OnRestartStackClick" IsVisible="{Binding CanRestart}" ToolTip.Tip="{Binding Name, StringFormat='Restart the running containers in {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Restart {0}'}">
                            <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeSm}" />
                          </Button>
                          <Grid Width="28" Height="28" IsVisible="{Binding CanStop}">
                            <Button Classes="IconButton DockerStackAction" Click="OnPauseStackClick" IsVisible="{Binding CanPause}" ToolTip.Tip="{Binding Name, StringFormat='Pause the running containers in {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Pause {0}'}">
                              <icons:SymbolIcon Symbol="Pause" FontSize="{DynamicResource ShellIconSizeSm}" />
                            </Button>
                            <Button Classes="IconButton DockerStackAction" Click="OnResumeStackClick" IsVisible="{Binding !CanPause}" ToolTip.Tip="{Binding Name, StringFormat='Resume the paused containers in {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Resume {0}'}">
                              <icons:SymbolIcon Symbol="PauseOff" FontSize="{DynamicResource ShellIconSizeSm}" />
                            </Button>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <ItemsControl Grid.Row="1" Classes="StretchItems" ItemsSource="{Binding Containers}" IsVisible="{Binding IsExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button
                              Classes="DockerResourceRow"
                              Classes.selected="{Binding IsSelected}"
                              Click="OnContainerResourceClick"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource DockerResourceItemTemplate}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Typing a name selects the first resource that starts with it, as
               in any Mac list; the row's name is what is matched. -->
          <ListBox
              x:Name="FlatResourceHost"
              Classes="DockerResources"
              IsTextSearchEnabled="True"
              TextSearch.TextBinding="{Binding Title, DataType={x:Type vm:DockerResourceItemViewModel}}"
              IsVisible="{Binding !IsContainersSection}"
              ItemsSource="{Binding Resources}"
              ItemTemplate="{StaticResource DockerResourceItemTemplate}"
              SelectedItem="{Binding SelectedResource}"
              ContextRequested="OnResourceContextRequested"
              AutomationProperties.Name="{Binding Section, StringFormat='Docker {0}'}">
          </ListBox>
        </Grid>
      </Grid>

      <Border Grid.Column="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Grid x:Name="DockerDetailHeader" Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <Grid>
            <!-- Five stable views of the selection. A view that does not apply
                 to it is dimmed in place rather than removed, so the segments
                 never shift under the pointer as the selection changes. -->
            <controls:SegmentedControl
                x:Name="DockerDetailSegments"
                Classes="DockerDetailTabs"
                IsEnabled="{Binding HasSelection}"
                SelectedIndex="{Binding DetailIndex, Mode=OneWay}"
                SelectionChanged="OnDetailSegmentSelectionChanged"
                AutomationProperties.Name="Resource view">
              <RadioButton Classes="DockerTab" ToolTip.Tip="Info" AutomationProperties.Name="Info"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><icons:SymbolIcon Symbol="Info" FontSize="{DynamicResource ShellIconSizeSm}" /><TextBlock Classes="DockerTabLabel" Text="Info" /></StackPanel></RadioButton>
              <RadioButton Classes="DockerTab" IsEnabled="{Binding CanShowLogs}" ToolTip.Tip="Logs" AutomationProperties.Name="Logs"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><icons:SymbolIcon Symbol="DocumentText" FontSize="{DynamicResource ShellIconSizeSm}" /><TextBlock Classes="DockerTabLabel" Text="Logs" /></StackPanel></RadioButton>
              <RadioButton Classes="DockerTab" IsEnabled="{Binding CanShowShell}" ToolTip.Tip="Shell" AutomationProperties.Name="Shell"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><icons:SymbolIcon Symbol="WindowConsole" FontSize="{DynamicResource ShellIconSizeSm}" /><TextBlock Classes="DockerTabLabel" Text="Shell" /></StackPanel></RadioButton>
              <RadioButton Classes="DockerTab" IsEnabled="{Binding CanShowFiles}" ToolTip.Tip="Files" AutomationProperties.Name="Files"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><icons:SymbolIcon Symbol="Folder" FontSize="{DynamicResource ShellIconSizeSm}" /><TextBlock Classes="DockerTabLabel" Text="Files" /></StackPanel></RadioButton>
              <RadioButton Classes="DockerTab" IsEnabled="{Binding CanShowJson}" ToolTip.Tip="JSON" AutomationProperties.Name="JSON"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><icons:SymbolIcon Symbol="Code" FontSize="{DynamicResource ShellIconSizeSm}" /><TextBlock Classes="DockerTabLabel" Text="JSON" /></StackPanel></RadioButton>
            </controls:SegmentedControl>
            <Button
                Classes="SecondaryButton DockerDetailMenuButton"
                Classes.hasSelection="{Binding HasSelection}"
                ToolTip.Tip="Choose a view"
                AutomationProperties.Name="Resource view">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" Text="{Binding DetailTitle}" />
                <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" Foreground="{DynamicResource ShellMutedBrush}" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Classes="DockerDetailMenuItem" Header="Info" ToggleType="Radio" GroupName="DockerDetailView" IsChecked="{Binding IsInfoDetail, Mode=OneWay}" Click="OnInfoClick" />
                  <MenuItem Classes="DockerDetailMenuItem" Header="Logs" ToggleType="Radio" GroupName="DockerDetailView" IsChecked="{Binding IsLogsDetail, Mode=OneWay}" IsEnabled="{Binding CanShowLogs}" Click="OnLogsClick" />
                  <MenuItem Classes="DockerDetailMenuItem" Header="Shell" ToggleType="Radio" GroupName="DockerDetailView" IsChecked="{Binding IsShellDetail, Mode=OneWay}" IsEnabled="{Binding CanShowShell}" Click="OnShellClick" />
                  <MenuItem Classes="DockerDetailMenuItem" Header="Files" ToggleType="Radio" GroupName="DockerDetailView" IsChecked="{Binding IsFilesDetail, Mode=OneWay}" IsEnabled="{Binding CanShowFiles}" Click="OnFilesClick" />
                  <MenuItem Classes="DockerDetailMenuItem" Header="JSON" ToggleType="Radio" GroupName="DockerDetailView" IsChecked="{Binding IsJsonDetail, Mode=OneWay}" IsEnabled="{Binding CanShowJson}" Click="OnJsonClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <!-- The container's lifecycle is one toolbar group: a capsule with
               the actions inside it, as a Mac toolbar groups related items,
               rather than a row of separately bordered squares. -->
          <Border Grid.Column="1" Classes="ToolbarGroup" VerticalAlignment="Center" IsVisible="{Binding SelectedResource.IsContainer}">
          <StackPanel Classes="DockerContainerActions" Orientation="Horizontal">
            <Grid Width="32" Height="32">
              <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartSelectedContainer}" IsVisible="{Binding SelectedContainerIsStopped}" ToolTip.Tip="Start container" AutomationProperties.Name="Start container">
                <icons:SymbolIcon Symbol="Play" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
              <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopSelectedContainer}" IsVisible="{Binding SelectedContainerIsActive}" ToolTip.Tip="Stop container" AutomationProperties.Name="Stop container">
                <icons:SymbolIcon Symbol="Stop" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
            </Grid>
            <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestartSelectedContainer}" ToolTip.Tip="Restart container" AutomationProperties.Name="Restart container">
              <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="{DynamicResource ShellIconSizeMd}" />
            </Button>
            <Grid Width="32" Height="32">
              <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPauseSelectedContainer}" IsVisible="{Binding !SelectedResource.IsPaused}" ToolTip.Tip="Pause container" AutomationProperties.Name="Pause container">
                <icons:SymbolIcon Symbol="Pause" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
              <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResumeSelectedContainer}" IsVisible="{Binding SelectedResource.IsPaused}" ToolTip.Tip="Resume container" AutomationProperties.Name="Resume container">
                <icons:SymbolIcon Symbol="PauseOff" FontSize="{DynamicResource ShellIconSizeMd}" />
              </Button>
            </Grid>
            <!-- Shell is a view of the container, named once in the segments.
                 This only moves the shell out to a tab of its own, so it says
                 that and is shown with the shell; it was a second, accent
                 "Shell" beside the first. -->
            <Button
                Width="32"
                Height="32"
                Classes="IconButton ToolbarGroupAction"
                Click="OnOpenShellClick"
                IsEnabled="{Binding CanOpenShell}"
                IsVisible="{Binding IsShellDetail}"
                ToolTip.Tip="Open in New Tab"
                AutomationProperties.Name="Open shell in a new tab">
              <icons:SymbolIcon Symbol="Open" FontSize="{DynamicResource ShellIconSizeMd}" />
            </Button>
          </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer Margin="{controls:Inset Lg}" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsInfoDetail}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <StackPanel IsVisible="{Binding HasSelection}">
                <TextBlock Classes="Title2" Text="{Binding SelectedResource.Title}" TextWrapping="Wrap" />
                <TextBlock Classes="Muted MiddleTruncated" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SelectedResource.Resource.Id}" />
              </StackPanel>
              <!-- A container's usage leads its info: four figures are not a
                   view of their own, and a sixth segment would be one more
                   than a segmented control holds. -->
              <controls:CardGridPanel MinItemWidth="160" MaxColumns="4" Spacing="{DynamicResource ShellSpaceMd}" IsVisible="{Binding SelectedResource.IsContainer}">
                <controls:SurfaceCard Padding="{controls:Inset Md}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="CPU" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" LineHeight="{DynamicResource ShellLineHeight16}" Text="{Binding SelectedResource.Container.Cpu}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
                <controls:SurfaceCard Padding="{controls:Inset Md}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Memory" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" LineHeight="{DynamicResource ShellLineHeight16}" Text="{Binding SelectedResource.Container.Memory}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
                <controls:SurfaceCard Padding="{controls:Inset Md}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Network I/O" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" LineHeight="{DynamicResource ShellLineHeight16}" Text="{Binding SelectedResource.Container.NetworkIo}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
                <controls:SurfaceCard Padding="{controls:Inset Md}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="Eyebrow" Text="Block I/O" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" LineHeight="{DynamicResource ShellLineHeight16}" Text="{Binding SelectedResource.Container.BlockIo}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
              </controls:CardGridPanel>
              <controls:SurfaceCard Padding="0" IsVisible="{Binding HasInspection}">
                <ItemsControl Classes="StretchItems" ItemsSource="{Binding Inspection.Properties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="38" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="120,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                        <TextBlock Margin="{controls:Inset Vertical=Xs}" VerticalAlignment="Center" Classes="Muted" LineHeight="{DynamicResource ShellLineHeight12}" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Margin="{controls:Inset Vertical=Xs}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Classes="DockerPropertyValue" LineHeight="{DynamicResource ShellLineHeight12}" Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </controls:SurfaceCard>
            </StackPanel>
          </ScrollViewer>

          <Grid IsVisible="{Binding IsLogsDetail}" RowDefinitions="Auto,*,Auto">
            <Border Padding="{controls:Inset Horizontal=Md, Vertical=Sm}" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <!-- A search field: Return searches the logs on the Docker
                     host, and its clear button or Escape ends the search. -->
                <controls:SearchField
                    x:Name="LogSearchBox"
                    MinWidth="180"
                    Text="{Binding LogSearchText, Mode=TwoWay}"
                    KeyDown="OnLogSearchKeyDown"
                    PlaceholderText="Search all container logs"
                    ToolTip.Tip="Press Return to search this container's logs on the Docker host"
                    AutomationProperties.Name="Search all container logs" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
                  <TextBlock Classes="Muted" Text="Context" VerticalAlignment="Center" />
                  <NumericUpDown
                      x:Name="LogSearchContextInput"
                      Width="72"
                      Minimum="0"
                      Maximum="100"
                      Increment="1"
                      ClipValueToMinMax="True"
                      FormatString="0"
                      ShowButtonSpinner="False"
                      Value="{Binding LogSearchContextInput, Mode=TwoWay}"
                      TextAlignment="Center"
                      AutomationProperties.Name="Search context lines" />
                </StackPanel>
                <!-- Following is an on-off state of the log view, so it is a
                     toggle button in the toolbar, not a settings switch. -->
                <ToggleButton
                    Grid.Column="2"
                    Classes="DockerFollowToggle"
                    IsChecked="{Binding FollowLogs, Mode=TwoWay}"
                    IsEnabled="{Binding CanFollowLogs}"
                    ToolTip.Tip="Keep showing new log lines as they arrive"
                    AutomationProperties.Name="Follow container logs">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                    <icons:SymbolIcon Symbol="ArrowDown" FontSize="{DynamicResource ShellIconSizeSm}" />
                    <TextBlock Classes="DockerFollowLabel" Text="Follow" />
                  </StackPanel>
                </ToggleButton>
                <Border Grid.Column="3" Classes="ToolbarGroup" VerticalAlignment="Center">
                  <Button Width="32" Height="32" Classes="IconButton ToolbarGroupAction" Click="OnDownloadLogsClick" IsEnabled="{Binding !IsDownloadingLogs}" ToolTip.Tip="Download all container logs" AutomationProperties.Name="Download all container logs">
                    <icons:SymbolIcon Symbol="DocumentArrowDown" FontSize="{DynamicResource ShellIconSizeMd}" />
                  </Button>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ListBox
                  x:Name="LogList"
                  Classes="DockerLogs OwnSelection"
                  ItemsSource="{Binding LogRows}"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto">
                      <Border Height="1" Margin="{controls:Inset Vertical=Sm}" Background="{DynamicResource ShellBorderBrush}" IsVisible="{Binding StartsContextBlock}" />
                      <Grid Grid.Row="1" MinHeight="22" Margin="{controls:Inset Horizontal=Md, Vertical=Xs}" ColumnDefinitions="150,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <TextBlock
                            Classes="Muted"
                            FontFamily="{DynamicResource ShellDataFontFamily}"
                            FontSize="{DynamicResource ShellSecondaryFontSize}"
                            LineHeight="{DynamicResource ShellLineHeight11}"
                            Text="{Binding DisplayTimestamp}" />
                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding MessageSegments}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="DockerLogMessageSegment" Classes.match="{Binding IsMatch}">
                                <TextBlock
                                    FontFamily="{DynamicResource ShellDataFontFamily}"
                                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                                    LineHeight="{DynamicResource ShellLineHeight11}"
                                    Text="{Binding Text}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <controls:StateOverlay
                  Kind="Empty"
                  Heading="No log rows"
                  Body="This container has no logs for the current view."
                  IsVisible="{Binding !HasLogs}" />
            </Grid>

            <Grid Grid.Row="2" MinHeight="28" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,Auto">

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Loading…" IsVisible="{Binding IsLoadingLogs}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding LogResultSummary}" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding IsShellDetail}">
            <ContentControl Content="{Binding InlineShell}" IsVisible="{Binding HasInlineShell}">
              <ContentControl.ContentTemplate>
                <DataTemplate>
                  <components:EmbeddedTerminalSessionView TrustHostKeyRequested="OnInlineShellTrustHostKeyRequested" />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <controls:StateOverlay
                Kind="Retry"
                Heading="{Binding ShellStateTitle}"
                Body="{Binding ShellStateMessage}"
                IsVisible="{Binding !HasInlineShell}">
              <StackPanel HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
                <ProgressBar Width="180" IsIndeterminate="True" IsVisible="{Binding IsResolvingShell}" />
                <Button HorizontalAlignment="Center" Classes="SecondaryButton" Click="OnOpenInlineShellClick" Content="Retry" IsVisible="{Binding CanRetryShell}" />
              </StackPanel>
            </controls:StateOverlay>
          </Grid>

          <ContentControl Content="{Binding FileBrowser}" IsVisible="{Binding IsFilesDetail}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <panelViews:FileRuntimePanelView
                    IsEmbedded="True"
                    ActionRequested="OnEmbeddedFileActionRequested"
                    DismissOperationIssueRequested="OnEmbeddedFileDismissOperationIssueRequested"
                    EntryDoubleTapped="OnEmbeddedFileEntryDoubleTapped"
                    EntrySelectionChanged="OnEmbeddedFileEntrySelectionChanged"
                    LocationKeyDown="OnEmbeddedFileLocationKeyDown"
                    NavigateUpRequested="OnEmbeddedFileNavigateUpRequested"
                    RefreshRequested="OnEmbeddedFileRefreshRequested" />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <components:CodePreviewView
              Margin="{controls:Inset Md}"
              FileName="inspection.json"
              IsVisible="{Binding IsJsonDetail}"
              Text="{Binding Inspection.Json}"
              WordWrap="False" />

          <controls:StateOverlay
              Kind="Loading"
              Heading="Reading Docker resources…"
              Body="Docker works the same way on this computer and over a saved SSH connection."
              IsVisible="{Binding ShowLoading}" />

          <controls:StateOverlay
              Kind="Empty"
              Heading="No resources in this section"
              Body="Choose another resource type or refresh the engine."
              IsVisible="{Binding ShowEmptyState}" />

          <controls:StateOverlay
              Kind="TerminalError"
              Glyph="ErrorCircle"
              Heading="Docker resources unavailable"
              Body="Use Retry to request the current state."
              ActionLabel="Retry"
              ActionCommand="{Binding RefreshCommand}"
              IsVisible="{Binding HasIssue}"
              AutomationProperties.LiveSetting="Assertive">
            <Button
                Name="DockerInstallGuideButton"
                HorizontalAlignment="Left"
                Classes="SecondaryButton"
                Click="OnDockerInstallGuideClick"
                Content="Install Docker"
                IsVisible="{Binding ShowsDockerInstallHelp}"
                AutomationProperties.Name="Open the Docker installation guide" />
          </controls:StateOverlay>
        </Grid>
      </Grid>
      </Border>
    </Grid>
  </controls:PanelChrome>
</UserControl>
