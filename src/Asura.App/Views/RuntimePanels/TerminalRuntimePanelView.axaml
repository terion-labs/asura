<UserControl
    x:Class="Asura.App.Views.RuntimePanels.TerminalRuntimePanelView"
    x:Name="TerminalRuntimePanelRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:TerminalRuntimePanelViewModel"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <controls:PanelChrome
      CloseRequested="OnCloseClick"
      HasAttention="{Binding HasAttention}"
      IsActive="{Binding IsActive}"
      IsAgentActive="{Binding IsAgentActive}"
      IsNotificationPulseActive="{Binding IsNotificationPulseActive}"
      IsTitleAdornmentVisible="{CompiledBinding #TerminalRuntimePanelRoot.((vm:ITerminalContinuityState)DataContext).IsContinuityActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="Terminal">
    <controls:PanelChrome.TitleAdornment>
      <Grid ToolTip.Tip="Continuity enabled">
        <Grid.RenderTransform>
          <TranslateTransform Y="1" />
        </Grid.RenderTransform>
        <!-- This is the neon text-shadow pattern scaled to a header glyph:
             bright tight blooms build the luminous core, then progressively
             wider and softer accent layers carry the afterglow. Every layer
             owns bleed equal to its radius, so none is clipped. -->
        <Border
            Classes="ContinuityGlow ContinuityGlowFar"
            IsHitTestVisible="False"
            Margin="-32"
            Padding="32">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="32"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="0.5" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <Border
            Classes="ContinuityGlow ContinuityGlowWide"
            IsHitTestVisible="False"
            Margin="-23"
            Padding="23">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="23"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="0.65" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <Border
            Classes="ContinuityGlow ContinuityGlowMedium"
            IsHitTestVisible="False"
            Margin="-16"
            Padding="16">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="0.78" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <Border
            Classes="ContinuityGlow ContinuityGlowNear"
            IsHitTestVisible="False"
            Margin="-11"
            Padding="11">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="11"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="0.9" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <Border
            Classes="ContinuityGlow ContinuityGlowCore"
            IsHitTestVisible="False"
            Margin="-7"
            Padding="7">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="7"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="1" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <Border
            Classes="ContinuityGlow ContinuityGlowHotCore"
            IsHitTestVisible="False"
            Margin="-4"
            Padding="4">
          <Border.Effect>
            <DropShadowEffect
                BlurRadius="4"
                Color="{DynamicResource SystemAccentColor}"
                OffsetX="0"
                OffsetY="0"
                Opacity="1" />
          </Border.Effect>
          <icons:SymbolIcon
              FontSize="{DynamicResource ShellFontSize13}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="Agents" />
        </Border>
        <icons:SymbolIcon
            AutomationProperties.Name="Continuity enabled"
            FontSize="{DynamicResource ShellFontSize13}"
            Foreground="{DynamicResource ShellContinuityGlyphBrush}"
            Symbol="Agents" />
      </Grid>
    </controls:PanelChrome.TitleAdornment>

    <controls:PanelChrome.Status>
      <!-- The session's real state in words for the tooltip and VoiceOver, and
           a glyph per state under Differentiate Without Color. The name is
           never empty: the macOS bridge cannot announce a live element that
           has none. -->
      <controls:StatusMark
          x:Name="TerminalStatusMark"
          AutomationProperties.AccessibilityView="Content"
          AutomationProperties.LiveSetting="Polite"
          Tone="{Binding StatusTone, ElementName=RuntimeTerminal}"
          Description="{Binding StatusText, ElementName=RuntimeTerminal, StringFormat='Terminal session: {0}'}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{CompiledBinding $parent[Window].((vm:IPanelConnectionOptionsHost)DataContext).PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <Grid>
        <controls:TerminalPresentationHost
            x:Name="RuntimeTerminal"
            Margin="{DynamicResource ShellHairline}"
            ClientId="{CompiledBinding ClientId}"
            SessionClient="{CompiledBinding SessionClient}"
            StartupCommandDispatchState="{CompiledBinding StartupCommandDispatchState}"
            StartupCommandDispatcher="{CompiledBinding StartupCommandDispatcher}"
            SessionRequest="{CompiledBinding SessionRequest}"
            RenderProfile="{CompiledBinding RenderProfile}"
            BackgroundOpacity="{DynamicResource ShellTerminalSurfaceOpacity}"
            AccessibleTitle="{CompiledBinding Title}"
            IsCopyMode="{CompiledBinding IsCopyMode}"
            CanSplit="True"
            CopyModeExitRequested="OnCopyModeExitRequested"
            SplitRequested="OnSplitRequested"
            SessionSnapshotChanged="OnSessionSnapshotChanged"
            SessionInitializationFailed="OnSessionInitializationFailed" />
        <Border
            Margin="{DynamicResource ShellHairline}"
            Background="{DynamicResource ShellSurfaceBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding ShowFallback, ElementName=RuntimeTerminal}">
          <controls:StateOverlay
              Kind="Loading"
              Body="{Binding StatusMessage, ElementName=RuntimeTerminal}" />
        </Border>

        <Border
            Margin="{DynamicResource ShellHairline}"
            Background="{DynamicResource ShellSurfaceBrush}"
            IsVisible="{CompiledBinding HasConnectionOverlay}">
          <controls:StateOverlay
              Kind="Retry"
              Heading="{CompiledBinding ConnectionStatus}"
              Body="{CompiledBinding ConnectionDetail}">
            <StackPanel MaxWidth="460" Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellSecondaryFontSize}"
                  Text="{Binding RecoveryLabel}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding HasHostKeyReview}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="Headline" Text="{Binding HostKeyReviewTitle}" TextAlignment="Center" />
                  <TextBlock FontSize="{DynamicResource ShellFontSize12}" Text="{Binding HostKeyReview.Presented.Algorithm}" TextAlignment="Center" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding TrustedHostKeyFingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                  <Button Classes="SecondaryButton" Click="OnTrustHostKeyClick" Content="{Binding TrustHostKeyLabel}" IsVisible="{Binding CanTrustHostKey}" />
                </StackPanel>
              </controls:SurfaceCard>
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ReconnectStatus}" IsVisible="{Binding IsReconnecting}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
                <Button
                    Classes="PrimaryButton"
                    Click="OnProceedWithoutContinuityClick"
                    Content="Proceed without continuity"
                    IsVisible="{Binding CanProceedWithoutContinuity}" />
                <Button
                    Classes="SecondaryButton"
                    Click="OnRetryConnectionClick"
                    Content="Retry connection"
                    IsVisible="{Binding CanRetry}" />
                <Button
                    Classes="TextButton"
                    Click="OnCancelReconnectClick"
                    Content="{Binding CancelConnectionLabel}"
                    IsVisible="{Binding CanCancelConnection}" />
              </StackPanel>
            </StackPanel>
          </controls:StateOverlay>
        </Border>
    </Grid>
  </controls:PanelChrome>
</UserControl>
