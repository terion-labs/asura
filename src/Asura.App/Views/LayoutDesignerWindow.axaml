<views:EditorWindow
    x:Class="Asura.App.Views.LayoutDesignerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Asura.App.Views"
    Title="Layout Designer"
    Width="1000"
    Height="680"
    Background="{DynamicResource ShellBackgroundBrush}">
  <!--
    The Layout Designer, in a window beside the workspace rather than an
    overlay over it. Its content is the main window's LayoutDesignerView,
    handed over on show.
  -->
</views:EditorWindow>
