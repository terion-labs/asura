<UserControl
    x:Class="Asura.App.Views.RecoveryDataControlView"
    x:DataType="vm:RecoveryDataControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <controls:SurfaceCard>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontWeight="SemiBold" Text="Crash recovery data" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="Review recovery snapshots from previous runs."
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="RefreshRecoveryDataButton"
            Grid.Column="1"
            Classes="SecondaryButton"
            Click="OnRefreshClick"
            Content="Refresh"
            IsEnabled="{Binding CanRefresh, FallbackValue=False}"
            AutomationProperties.Name="Refresh crash recovery data" />
        <Button
            Grid.Column="2"
            Classes="DestructiveButton"
            Click="OnClearAllClick"
            Content="Clear All…"
            IsEnabled="{Binding CanClearAll, FallbackValue=False}"
            AutomationProperties.Name="Clear all previous crash recovery data" />
      </Grid>

      <controls:Callout
          Tone="Notice"
          Glyph="Shield"
          Text="Asura keeps these to reopen your work after a crash. This run’s own snapshot isn’t listed." />

      <!-- One state at a time: loading, nothing to show, couldn't load, or
           the list with its summary line. -->
      <controls:LiveRegionTextBlock
          Classes="Muted"
          FontSize="{DynamicResource ShellSecondaryFontSize}"
          Text="{Binding StatusMessage}"
          IsVisible="{Binding HasRuns, FallbackValue=False}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />

      <!-- A refresh with snapshots already listed keeps the list; the
           summary line above says it is reloading. -->
      <Panel>
        <Panel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsBusy" FallbackValue="False" />
            <Binding Path="!HasRuns" FallbackValue="False" />
          </MultiBinding>
        </Panel.IsVisible>
        <controls:StateOverlay
            Kind="Loading"
            Heading="Loading recovery snapshots…"
            Body="This run’s own snapshot stays protected while earlier ones load." />
      </Panel>

      <controls:StateOverlay
          Kind="Empty"
          Heading="No snapshots from earlier runs"
          Body="This run’s own snapshot is protected, so it isn’t listed."
          IsVisible="{Binding HasNoRuns, FallbackValue=False}" />

      <controls:StateOverlay
          Kind="Retry"
          Heading="Recovery snapshots couldn’t be loaded"
          Body="Nothing was removed. Click Refresh to try again."
          ActionLabel="Refresh"
          ActionRequested="OnRefreshClick"
          FocusTarget="PrimaryAction"
          IsVisible="{Binding HasError, FallbackValue=False}" />

      <ItemsControl
          ItemsSource="{Binding Runs}"
          IsEnabled="{Binding CanClearRuns, FallbackValue=False}"
          IsVisible="{Binding HasRuns, FallbackValue=False}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Margin="{controls:Inset Right=Md}" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SnapshotLabel}" />
                    <TextBlock Margin="{controls:Inset Right=Md}" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding SizeLabel}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding UpdatedLabel}" />
                  </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="DestructiveButton"
                    Click="OnClearRunClick"
                    Content="Clear…"
                    AutomationProperties.Name="{Binding ClearAutomationName}" />
              </Grid>
            </controls:SurfaceCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
