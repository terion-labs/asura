<Window
    x:Class="Asura.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:overlays="using:Asura.App.Views.Overlays"
    xmlns:panelViews="using:Asura.App.Views.RuntimePanels"
    xmlns:views="using:Asura.App.Views"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:sys="using:System"
    x:DataType="vm:MainWindowViewModel"
    Title="Asura"
    Width="1440"
    Height="900"
    MinWidth="640"
    MinHeight="480"
    WindowDecorations="Full"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowStartupLocation="CenterScreen">

  <!-- The menu bar is built from the command registry and attached to every
       window by App.Menus.cs; see ApplicationMenuLayout.cs. -->

  <!-- These routes are templates rather than live controls on purpose. Avalonia
       keeps template content deferred, so a window pays for Settings or an
       overlay only when that route is requested for the first time. -->
  <Window.Resources>
    <DataTemplate x:Key="EmptyDockLauncherTemplate" x:DataType="vm:MainWindowViewModel">
      <controls:SurfaceCard Tone="Panel" Padding="0" ClipsContent="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <components:LauncherView
              Margin="{controls:Inset Xl}"
              ShowCloseAction="False"
              AddConnectionRequested="OnAddConnectionClick"
              ManageConnectionsRequested="OnManageConnectionsClick"
              NewBrowserRequested="OnPlaceholderBrowserClick"
              NewDatabaseRequested="OnPlaceholderDatabaseClick"
              NewDockerRequested="OnPlaceholderDockerClick"
              NewKubernetesRequested="OnPlaceholderKubernetesClick"
              NewFileViewerRequested="OnPlaceholderFileViewerClick"
              NewGitRequested="OnPlaceholderGitClick"
              NewLocalTerminalRequested="OnPlaceholderTerminalClick"
              NewProcessMonitorRequested="OnPlaceholderProcessMonitorClick"
              NewStatisticsRequested="OnPlaceholderStatisticsClick"
              ConnectionLaunchRequested="OnPlaceholderConnectionLaunchRequested"
              DeleteConnectionRequested="OnDeleteSavedConnectionRequested"
              EditConnectionRequested="OnEditSavedConnectionRequested"
              FinishOnboardingRequested="OnFinishOnboardingClick"
              HistorySearchKeyDownRequested="OnHistorySearchKeyDown"
              RetryOnboardingRequested="OnRetryOnboardingClick"
              OpenScreenRequested="OnOpenScreenClick"
              ShowCommandPaletteRequested="OnShowCommandPaletteClick"
              ShowLayoutDesignerRequested="OnShowLayoutDesignerClick" />
        </ScrollViewer>
      </controls:SurfaceCard>
    </DataTemplate>
    <!-- This window's Settings content, built once on first use and shown in
         the Settings window rather than in place of the workspace. -->
    <DataTemplate x:Key="SettingsRouteTemplate" x:DataType="vm:MainWindowViewModel">
      <views:SettingsView
          AboutSettingsRequested="OnAboutSettingsClick"
          AddAiProviderRequested="OnAddAiProviderClick"
          AddFileProviderRequested="OnAddFileProviderClick"
          AddMcpServerRequested="OnAddMcpServerClick"
          AgentSettingsRequested="OnAgentSettingsClick"
          ExportAgentHistoryRequested="OnExportAgentHistoryClick"
          AppearanceSettingsRequested="OnAppearanceSettingsClick"
          ClearKeybindingPrefixRequested="OnClearKeybindingPrefixClick"
          ClearMcpServerDiagnosticHistoryRequested="OnClearMcpServerDiagnosticHistoryClick"
          CloneKeybindingPresetRequested="OnCloneKeybindingPresetClick"
          CreateAiProviderSecretRequested="OnCreateAiProviderSecretClick"
          CreateConnectionSecretRequested="OnCreateConnectionSecretClick"
          CreateFileProviderSecretRequested="OnCreateFileProviderSecretClick"
          CreateMcpServerSecretRequested="OnCreateMcpServerSecretClick"
          DeleteAiProviderRequested="OnDeleteAiProviderClick"
          DeleteFileProviderRequested="OnDeleteFileProviderClick"
          DeleteMcpServerRequested="OnDeleteMcpServerClick"
          DeleteScreenRequested="OnDeleteScreenClick"
          DeleteSecretRequested="OnDeleteSecretClick"
          DeleteWorkspaceRequested="OnDeleteWorkspaceClick"
          DiagnosticsSettingsRequested="OnDiagnosticsSettingsClick"
          DismissSavedScreenDeleteUndoRequested="OnDismissSavedScreenDeleteUndoClick"
          EditAiProviderRequested="OnEditAiProviderClick"
          EditFileProviderRequested="OnEditFileProviderClick"
          EditLayoutRequested="OnEditLayoutClick"
          EditMcpServerRequested="OnEditMcpServerClick"
          EditScreenRequested="OnEditScreenClick"
          EditSecretRequested="OnEditSecretClick"
          CreateWorkspaceRequested="OnCreateWorkspaceClick"
          CreateScreenRequested="OnCreateScreenClick"
          EditWorkspaceRequested="OnEditWorkspaceClick"
          ExportDefinitionsRequested="OnExportDefinitionsClick"
          DisableStartupProtectionRequested="OnDisableStartupProtectionClick"
          EnableStartupProtectionRequested="OnEnableStartupProtectionClick"
          FilesSettingsRequested="OnFilesSettingsClick"
          BrowserSettingsRequested="OnBrowserSettingsClick"
          BrowserProfileEnabledChangedRequested="OnBrowserProfileEnabledChanged"
          DeleteBrowserProfileRequested="OnDeleteBrowserProfileClick"
          LockNowRequested="OnLockNowClick"
          ImportDefinitionsRequested="OnImportDefinitionsClick"
          InstallWorkspaceIsolationRuntimeRequested="OnInstallWorkspaceIsolationRuntimeClick"
          KeybindingPrefixOptionsChangedRequested="OnKeybindingPrefixOptionsChanged"
          KeybindingProfileSelectionChangedRequested="OnKeybindingProfileSelectionChanged"
          KeybindingSettingsRequested="OnKeybindingSettingsClick"
          McpSettingsRequested="OnMcpSettingsClick"
          QuickTerminalSettingsRequested="OnQuickTerminalSettingsClick"
          RecordKeybindingPrefixRequested="OnRecordKeybindingPrefixClick"
          RecordKeybindingRequested="OnRecordKeybindingClick"
          ResetAllKeybindingsRequested="OnResetAllKeybindingsClick"
          ResetKeybindingRequested="OnResetKeybindingClick"
          ReviewOnboardingRequested="OnReviewOnboardingClick"
          RestoreSessionsOnStartChangedRequested="OnRestoreSessionsOnStartChanged"
          TerminalMultiplexingChangedRequested="OnTerminalMultiplexingChanged"
          TerminateManagedRemoteSessionRequested="OnTerminateManagedRemoteSessionClick"
          ForgetManagedRemoteSessionRequested="OnForgetManagedRemoteSessionClick"
          ApplicationAppearanceChangedRequested="OnApplicationAppearanceChanged"
          TerminalAppearanceChangedRequested="OnTerminalAppearanceChanged"
          AppearanceApplyRequested="OnAppearanceApplyClick"
          AppearanceApplyTerminalRequested="OnAppearanceApplyTerminalClick"
          AppearanceCancelRequested="OnAppearanceCancelClick"
          AppearanceCancelTerminalRequested="OnAppearanceCancelTerminalClick"
          AppearanceExportRequested="OnAppearanceExportClick"
          AppearanceImportRequested="OnAppearanceImportClick"
          AppearanceResetRequested="OnAppearanceResetClick"
          AppearanceResetTerminalPaletteRequested="OnAppearanceResetTerminalPaletteClick"
          PickColorRequested="OnPickColorRequested"
          RecordQuickTerminalHotkeyRequested="OnRecordQuickTerminalHotkeyClick"
          SaveKeybindingsRequested="OnSaveKeybindingsClick"
          SelectTerminalPaletteRequested="OnSelectTerminalPaletteClick"
          SecretsSettingsRequested="OnSecretsSettingsClick"
          ShowLayoutDesignerRequested="OnShowLayoutDesignerClick"
          ReviewHistoryPrivacyRequested="OnReviewHistoryPrivacyClick"
          RetryRecentSessionHistoryRequested="OnRetryRecentSessionHistoryClick"
          ExportAllHistoryRequested="OnExportAllHistoryClick"
          CancelHistoryExportRequested="OnCancelHistoryExportClick"
          ClearRecentSessionsRequested="OnClearRecentSessionsClick"
          ResetRecentSessionHistoryRequested="OnResetRecentSessionHistoryClick"
          TerminalSettingsRequested="OnTerminalSettingsClick"
          TestMcpServerRequested="OnTestMcpServerClick"
          UnbindKeybindingRequested="OnUnbindKeybindingClick"
          UndoDeletedSavedScreenRequested="OnUndoDeletedSavedScreenClick"
          WorkspaceSettingsRequested="OnWorkspaceSettingsClick"
          NetworkingSettingsRequested="OnNetworkingSettingsClick"
          NotificationSettingsRequested="OnNotificationSettingsClick"
          OpenNotificationSystemSettingsRequested="OnOpenNotificationSystemSettingsClick"
          SettingsSearchSubmitted="OnSettingsSearchSubmitted"
          HistoryRetentionSelectionChangedRequested="OnHistoryRetentionSelectionChanged"
          AgentHistoryRetentionSelectionChangedRequested="OnAgentHistoryRetentionSelectionChanged" />
    </DataTemplate>

    <DataTemplate x:Key="CommandPaletteOverlayTemplate" x:DataType="vm:MainWindowViewModel">
      <overlays:CommandPaletteView
          ActivateSearchResultRequested="OnLauncherSearchResultClick"
          CloseRequested="OnCloseOverlayClick"
          SearchKeyDownRequested="OnCommandSearchKeyDown" />
    </DataTemplate>

    <DataTemplate x:Key="NewPanelChooserTemplate" x:DataType="vm:MainWindowViewModel">
      <overlays:NewPanelChooserView
          AddBrowserPanelRequested="OnAddBrowserPanelClick"
          AddConnectionPanelRequested="OnAddConnectionPanelClick"
          AddDatabasePanelRequested="OnAddDatabasePanelClick"
          AddDockerPanelRequested="OnAddDockerPanelClick"
          AddKubernetesPanelRequested="OnAddKubernetesPanelClick"
          AddFilePanelRequested="OnAddFilePanelClick"
          AddGitPanelRequested="OnAddGitPanelClick"
          AddProcessMonitorPanelRequested="OnAddProcessMonitorPanelClick"
          AddStatisticsPanelRequested="OnAddStatisticsPanelClick"
          AddTerminalPanelRequested="OnAddTerminalPanelClick"
          OpenScreenRequested="OnOpenScreenClick"
          ShowLayoutDesignerRequested="OnShowLayoutDesignerClick" />
    </DataTemplate>

    <DataTemplate x:Key="LayoutDesignerTemplate" x:DataType="vm:MainWindowViewModel">
      <overlays:LayoutDesignerView
          AddSlotRequested="OnLayoutAddSlotClick"
          CloseRequested="OnLayoutDesignerCancelClick"
          EditLayoutRequested="OnEditLayoutClick"
          RemoveSlotRequested="OnLayoutRemoveSlotClick"
          ResetRequested="OnResetLayoutClick"
          SaveRequested="OnSaveLayoutDesignerClick"
          SlotSelectedRequested="OnLayoutSlotClick"
          SplitSlotDownRequested="OnLayoutSplitSlotDownClick"
          SplitSlotRightRequested="OnLayoutSplitSlotRightClick" />
    </DataTemplate>

    <!-- The workspace editor, shown in its own window (WorkspaceEditorWindow)
         beside this one. -->
    <DataTemplate x:Key="WorkspaceEditorTemplate" x:DataType="vm:MainWindowViewModel">
      <views:WorkspaceEditorView
          DataContext="{Binding WorkspaceEditor}"
          PickAccentRequested="OnWorkspaceAccentPickRequested"
          InstallWorkspaceIsolationRuntimeRequested="OnInstallWorkspaceIsolationRuntimeClick"
          RecreateWorkspaceIsolationRequested="OnRecreateWorkspaceIsolationRequested"
          SaveRequested="OnWorkspaceEditorSaveRequested"
          CancelRequested="OnWorkspaceEditorCancelRequested"
          WorkspaceSelectionRequested="OnWorkspaceSelectionRequested"
          CreateWorkspaceRequested="OnCreateWorkspaceRequested" />
    </DataTemplate>
  </Window.Resources>

  <!--
    The pale band across the top was never the platform's title bar — Avalonia
    draws its own decorations, and up to 12.0.4 the Fluent template filled them
    with an opaque brush, so extending the client area underneath put our
    translucent base beneath an opaque lid. Avalonia 12.0.5 makes them
    transparent, which is why the version moved rather than the template being
    forked here.

    https://github.com/AvaloniaUI/Avalonia/issues/21082

    The title text is still ours to hide: the shell puts its own tab bar in
    that band, and the window name drawn behind it is just noise.
  -->
  <Window.Styles>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The Add Panel popover sizes itself to the window it opens over and
         scrolls on its own, so the presenter neither caps nor scrolls it. -->
    <Style Selector="FlyoutPresenter.AddPanelChooser">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
      <Setter Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:TerminalRuntimePanelViewModel">
      <panelViews:TerminalRuntimePanelView
          CancelReconnectRequested="OnCancelConnectionReconnectClick"
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnTerminalConnectionSelected"
          GotFocus="OnRuntimePanelGotFocus"
          NewConnectionRequested="OnTerminalNewConnectionRequested"
          PointerPressed="OnRuntimePanelPointerPressed"
          SplitRequested="OnSplitRuntimePanelRequested"
          RetryConnectionRequested="OnRetryConnectionPanelClick"
          ProceedWithoutContinuityRequested="OnProceedWithoutContinuityClick"
          SessionInitializationFailed="OnTerminalSessionInitializationFailed"
          SessionSnapshotChanged="OnTerminalSessionSnapshotChanged"
          TrustHostKeyRequested="OnTrustConnectionHostKeyClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:BrowserRuntimePanelViewModel">
      <panelViews:BrowserRuntimePanelView
          AddressKeyDown="OnBrowserAddressKeyDown"
          BackRequested="OnBrowserBackClick"
          BrowserStateChanged="OnBrowserStateChanged"
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          DeveloperToolsRequested="OnBrowserDeveloperToolsClick"
          OpenInSystemBrowserRequested="OnBrowserOpenInSystemBrowserClick"
          ForwardRequested="OnBrowserForwardClick"
          GotFocus="OnRuntimePanelGotFocus"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          PointerPressed="OnRuntimePanelPointerPressed"
          SplitRequested="OnSplitRuntimePanelRequested"
          ReloadRequested="OnBrowserReloadClick"
          StopRequested="OnBrowserStopClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:FileRuntimePanelViewModel">
      <panelViews:FileRuntimePanelView
          ActionRequested="OnFileActionRequested"
          CloseRequested="OnCloseRuntimePanelClick"
          DatabaseObjectOpenInTabRequested="OnDatabaseObjectOpenInTabRequested"
          DatabaseObjectOpenInPanelRequested="OnDatabaseObjectOpenInPanelRequested"
          DatabaseOpenInViewerRequested="OnDatabaseOpenInViewerRequested"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          DismissOperationIssueRequested="OnDismissFileOperationIssueClick"
          EntryDoubleTapped="OnFileEntryDoubleTapped"
          EntrySelectionChanged="OnFileEntrySelectionChanged"
          EntryTransferDropRequested="OnFileEntryTransferDropRequested"
          EntryTransferKeyRequested="OnFileEntryTransferKeyRequested"
          GotFocus="OnRuntimePanelGotFocus"
          LocationKeyDown="OnFileLocationKeyDown"
          NavigateUpRequested="OnFileNavigateUpClick"
          PointerPressed="OnRuntimePanelPointerPressed"
          RefreshRequested="OnFileRefreshClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:StatisticsRuntimePanelViewModel">
      <panelViews:StatisticsRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:ProcessMonitorRuntimePanelViewModel">
      <panelViews:ProcessMonitorRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:DatabaseRuntimePanelViewModel">
      <panelViews:DatabaseRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          EditConnectionRequested="OnPanelEditDatabaseConnectionRequested"
          OpenObjectInTabRequested="OnDatabaseObjectOpenInTabRequested"
          OpenObjectInPanelRequested="OnDatabaseObjectOpenInPanelRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:RedisRuntimePanelViewModel">
      <panelViews:RedisRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          EditConnectionRequested="OnPanelEditDatabaseConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:KubernetesRuntimePanelViewModel">
      <panelViews:KubernetesRuntimePanelView FilesRequested="OnKubernetesFilesRequested" ShellRequested="OnKubernetesShellRequested" ForwardDatabaseRequested="OnKubernetesForwardDatabaseRequested" ForwardBrowserRequested="OnKubernetesForwardBrowserRequested" CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected" NewConnectionRequested="OnPanelNewConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested" GotFocus="OnRuntimePanelGotFocus" PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:DockerRuntimePanelViewModel">
      <panelViews:DockerRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          DockerInstallGuideRequested="OnDockerInstallGuideRequested"
          InlineShellRequested="OnDockerInlineShellRequested"
          InlineShellTrustHostKeyRequested="OnDockerInlineShellTrustHostKeyRequested"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          ShellRequested="OnDockerShellRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:GitRuntimePanelViewModel">
      <panelViews:GitRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          ConnectionSelected="OnPanelConnectionSelected"
          NewConnectionRequested="OnPanelNewConnectionRequested"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:UnavailableRuntimePanelViewModel">
      <panelViews:UnavailableRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          SplitRequested="OnSplitRuntimePanelRequested"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>
    <DataTemplate DataType="vm:PanelPlaceholderViewModel">
      <panelViews:PanelPlaceholderView
          AddConnectionRequested="OnAddConnectionClick"
          ManageConnectionsRequested="OnManageConnectionsClick"
          BrowserRequested="OnPlaceholderBrowserClick"
          CloseRequested="OnCloseRuntimePanelClick"
          DatabaseRequested="OnPlaceholderDatabaseClick"
          DockerRequested="OnPlaceholderDockerClick"
          KubernetesRequested="OnPlaceholderKubernetesClick"
          FileViewerRequested="OnPlaceholderFileViewerClick"
          GitRequested="OnPlaceholderGitClick"
          GotFocus="OnRuntimePanelGotFocus"
          ConnectionLaunchRequested="OnPlaceholderConnectionLaunchRequested"
          DeleteConnectionRequested="OnDeleteSavedConnectionRequested"
          EditConnectionRequested="OnEditSavedConnectionRequested"
          FinishOnboardingRequested="OnFinishOnboardingClick"
          HistorySearchKeyDownRequested="OnHistorySearchKeyDown"
          RetryOnboardingRequested="OnRetryOnboardingClick"
          OpenScreenRequested="OnOpenScreenClick"
          PointerPressed="OnRuntimePanelPointerPressed"
          ProcessMonitorRequested="OnPlaceholderProcessMonitorClick"
          ShowCommandPaletteRequested="OnShowCommandPaletteClick"
          ShowLayoutDesignerRequested="OnShowLayoutDesignerClick"
          SplitRequested="OnSplitRuntimePanelRequested"
          StatisticsRequested="OnPlaceholderStatisticsClick"
          TerminalRequested="OnPlaceholderTerminalClick" />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- The base surface everything else sits on. Translucent, so the blurred
       desktop reads behind the gaps between panels; the panels, sidebars and
       cards over it stay opaque, which is what keeps them legible and keeps
       the translucency reading as one surface rather than as see-through
       chrome. -->
  <!--
    The window's own corners, declared so everything inside can be concentric
    with the frame rather than guessing at it. The platform draws them; this
    only says what it drew.
  -->
  <Grid
      Background="{DynamicResource ShellWindowBackdropBrush}"
      controls:Concentric.IsContainer="True"
      controls:Concentric.ContainerRadius="{DynamicResource ShellWindowCornerRadius}">
    <!-- Everything the app draws lives inside this one layer so locking can
         collapse it whole. The browser is now an ordinary Avalonia visual, but
         a collapsed ancestor also hides any native terminal hosts that a veil
         alone could not cover. -->
    <Grid RowDefinitions="*,Auto" IsVisible="{CompiledBinding !ApplicationSecurityEditor.IsLocked}">
    <controls:SurfaceCard
        Grid.Row="1"
        IsVisible="{CompiledBinding BrowserStartupRecovery.ErrorNotices.HasErrors}"
        Margin="{controls:Inset Left=Md, Right=Md, Bottom=Md}"
        Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
        Tone="Notice"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="Browser recovery">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <components:ErrorNoticesView DataContext="{CompiledBinding BrowserStartupRecovery.ErrorNotices}" />
        <Button Grid.Column="1"
            IsVisible="{CompiledBinding BrowserStartupRecovery.CanRetry}"
            Content="{CompiledBinding BrowserStartupRecovery.RetryLabel}"
            Command="{CompiledBinding BrowserStartupRecovery.RetryCommand}" />
      </Grid>
    </controls:SurfaceCard>
    <!-- Runtime workspace -->
    <views:WorkspaceView
        x:Name="WorkspaceRouteView"
        ActivateTabRequested="OnActivateTabClick"
        AgentQuestionResponseKeyDownRequested="OnAgentQuestionResponseKeyDown"
        FloatPanelRequested="OnFloatRuntimePanelRequested"
        CollapsePanelRequested="OnCollapsePanelRequested"
        ExpandPanelRequested="OnExpandPanelRequested"
        RestorePanelRequested="OnRestorePanelRequested"
        PreviewPanelRequested="OnPreviewPanelRequested"
        EndPanelPreviewRequested="OnEndPanelPreviewRequested"
        ApproveAgentActionRequested="OnApproveAgentActionClick"
        CancelAgentActionRequested="OnCancelAgentActionClick"
        CancelAgentChatRequested="OnCancelAgentChatClick"
        CancelFileTransferRequested="OnCancelFileTransferClick"
        ClearAgentChatRequested="OnClearAgentChatClick"
        ClearAgentSavedScreenTargetRequested="OnClearAgentSavedScreenTargetClick"
        CreateAgentSavedScreenTargetRequested="OnCreateAgentSavedScreenTargetClick"
        CloseRuntimeTabRequested="OnCloseRuntimeTabClick"
        RuntimeTabTitleEditRequested="OnRuntimeTabTitleEditRequested"
        RuntimeTabIconEditRequested="OnRuntimeTabIconEditRequested"
        CloseOtherRuntimeTabsRequested="OnCloseOtherRuntimeTabsClick"
        MoveRuntimeTabToWorkspaceRequested="OnMoveRuntimeTabToWorkspaceRequested"
        DeclineAgentQuestionRequested="OnDeclineAgentQuestionClick"
        DenyAgentActionRequested="OnDenyAgentActionClick"
        DisableAgentYoloRequested="OnDisableAgentYoloClick"
        EnableAgentCapabilityAskRequested="OnEnableAgentCapabilityAskClick"
        EnableAgentYoloRequested="OnEnableAgentYoloClick"
        LockShellRequested="OnLockShellClick"
        ShowSettingsRequested="OnShowSettingsClick"
        IsVisible="{Binding IsWorkspaceVisible}"
        KeepAgentCapabilityOffRequested="OnKeepAgentCapabilityOffClick"
        LoadOlderAgentAuditRequested="OnLoadOlderAgentAuditClick"
        MoveQueuedFollowUpRequested="OnMoveAgentQueuedFollowUpRequested"
        OpenWorkspaceRequested="OnOpenWorkspaceClick"
        CloseWorkspaceRequested="OnCloseWorkspaceClick"
        TerminateWorkspaceRequested="OnTerminateWorkspaceClick"
        SaveWorkspaceLayoutRequested="OnSaveWorkspaceLayoutClick"
        EditWorkspaceRequested="OnEditWorkspaceClick"
        CreateWorkspaceRequested="OnCreateWorkspaceClick"
        RefreshAgentAuditRequested="OnRefreshAgentAuditClick"
        AuthorizeAgentSavedScreenTargetRequested="OnAuthorizeAgentSavedScreenTargetClick"

        StartNewAgentConversationRequested="OnStartNewAgentConversationClick"
        OpenAgentConversationRequested="OnOpenAgentConversationClick"
        DeleteAgentConversationRequested="OnDeleteAgentConversationClick"
        CopyAgentMessageRequested="OnCopyAgentMessageClick"
        ForkAgentConversationRequested="OnForkAgentConversationClick"
        SelectAgentModelRequested="OnSelectAgentModelClick"
        ToggleAgentModelFavoriteRequested="OnToggleAgentModelFavoriteClick"
        RefreshAgentModelsRequested="OnRefreshAgentModelsClick"
        RetryFileTransferRequested="OnRetryFileTransferClick"
        RuntimeTabDragEnterRequested="OnRuntimeTabDragEnter"
        RuntimeTabDragLeaveRequested="OnRuntimeTabDragLeave"
        RuntimeTabDragOverRequested="OnRuntimeTabDragOver"
        RuntimeTabDragPointerCaptureLostRequested="OnRuntimeTabDragPointerCaptureLost"
        RuntimeTabDragPointerMovedRequested="OnRuntimeTabDragPointerMoved"
        RuntimeTabDragPointerPressedRequested="OnRuntimeTabDragPointerPressed"
        RuntimeTabDragPointerReleasedRequested="OnRuntimeTabDragPointerReleased"
        RuntimeTabDropRequested="OnRuntimeTabDrop"
        SendAgentChatRequested="OnSendAgentChatClick"
        QueueAgentSteeringRequested="OnQueueAgentSteeringClick"
        AttachAgentImageRequested="OnAttachAgentImageClick"
        ClearAgentImagesRequested="OnClearAgentImagesClick"
        ShowAgentSettingsRequested="OnShowAgentSettingsClick"
        ShowCommandPaletteRequested="OnShowCommandPaletteClick"
        ShowLauncherRequested="OnShowLauncherClick"
        ShowNewItemRequested="OnShowNewItemClick"
        AddPanelToSideRequested="OnAddPanelToSideRequested"
        ShowNewPanelRequested="OnShowNewPanelClick"
        SubmitAgentQuestionRequested="OnSubmitAgentQuestionClick"
        ToggleAgentRequested="OnToggleAgentClick"
        ToggleAgentPinRequested="OnToggleAgentPinClick"
        WorkspaceNetworkConnectionSelected="OnWorkspaceNetworkConnectionSelected"
        WorkspaceNetworkToggleRequested="OnWorkspaceNetworkToggleRequested"
        NetworkingSettingsRequested="OnNetworkingSettingsClick" />

    <!-- The command palette, the one overlay left. Runtime native views are
         hidden while it is open, and a click on the scrim around it closes
         it, as a click outside a popover does. Add Panel is a flyout on its
         "+" button, and the workspace editor and the Layout Designer have
         windows of their own. -->
    <Grid
        x:Name="OverlayScrim"
        IsVisible="{Binding HasOverlay}"
        Background="{DynamicResource ShellScrimBrush}"
        PointerPressed="OnOverlayScrimPointerPressed">
      <ContentControl
          x:Name="CommandPaletteOverlayHost"
          IsVisible="{Binding IsCommandPaletteVisible}" />

      <Border
          x:Name="OverlayTitleBarDragRegion"
          Height="{Binding $parent[views:MainWindow].TitleBarChromeHeight}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top"
          Background="Transparent"
          WindowDecorationProperties.ElementRole="TitleBar" />
    </Grid>

    <controls:SurfaceCard Tone="Notice"
        Margin="0,0,0,62"
        Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        MaxWidth="620"
        IsVisible="{Binding HasApplicationKeySequenceHint}"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="Application key sequence status">
      <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ApplicationKeySequenceHint}" TextWrapping="Wrap" />
    </controls:SurfaceCard>

    <!-- A deleted connection or workspace leaves this behind instead of a
         question asked first: Undo puts back exactly what was deleted, and
         the next delete, Dismiss or closing the window makes it final. -->
    <controls:SurfaceCard Tone="Notice"
        x:Name="DefinitionDeleteUndoNotice"
        Margin="{controls:Inset Left=Lg, Bottom=Lg}"
        Padding="{DynamicResource ShellCardPaddingCompact}"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        MaxWidth="520"
        IsVisible="{CompiledBinding DefinitionDeleteUndo.HasPending}"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="{CompiledBinding DefinitionDeleteUndo.Status}"
        AutomationProperties.HelpText="Undo restores the exact saved definition that was deleted.">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Text="{CompiledBinding DefinitionDeleteUndo.Status}" TextWrapping="Wrap" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              Text="{CompiledBinding DefinitionDeleteUndo.Detail}"
              TextWrapping="Wrap"
              IsVisible="{CompiledBinding DefinitionDeleteUndo.HasDetail}" />
        </StackPanel>
        <Button
            x:Name="UndoDeletedDefinitionButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="SecondaryButton"
            Click="OnUndoDefinitionDeleteClick"
            Content="Undo"
            IsEnabled="{CompiledBinding DefinitionDeleteUndo.CanUndo}"
            AutomationProperties.Name="Undo delete"
            AutomationProperties.HelpText="Restore the exact saved definition that was just deleted." />
        <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes="TextButton"
            Click="OnDismissDefinitionDeleteUndoClick"
            Content="Dismiss"
            IsEnabled="{CompiledBinding DefinitionDeleteUndo.CanUndo}"
            AutomationProperties.Name="Dismiss delete notice" />
      </Grid>
    </controls:SurfaceCard>

    <Border IsVisible="{CompiledBinding !ApplicationSecurityEditor.IsLocked}"
            Margin="{controls:Inset Right=Lg, Bottom=Lg}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="520">
      <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
    </Border>

    <Canvas
        x:Name="DragGhostLayer"
        ZIndex="1000"
        ClipToBounds="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsHitTestVisible="False">
      <controls:SurfaceCard
          x:Name="DragGhostPresenter"
          x:DataType="components:DragGhostPayload"
          MinWidth="148"
          MaxWidth="320"
          Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
          Elevation="Overlay"
          Tone="Raised"
          Opacity="0"
          KeyboardNavigation.TabNavigation="Cycle"
          AutomationProperties.Name="Dragged item">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon
              VerticalAlignment="Center"
              FontSize="{DynamicResource ShellIconSizeMd}"
              Foreground="{DynamicResource ShellAccentBrush}"
              Symbol="{Binding Symbol}" />
          <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock
                Classes="MiddleTruncated"
                FontSize="{DynamicResource ShellFontSize11}"
                FontWeight="SemiBold"
                Text="{Binding Title}" />
            <TextBlock
                FontSize="{DynamicResource ShellFontSize10}"
                Foreground="{DynamicResource ShellMutedBrush}"
                Text="{Binding Detail}"
                TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </controls:SurfaceCard>
    </Canvas>

    <!-- Last inside the app layer: any remaining operating-system views. Browser
         content is composited normally inside its panel and does not use this
         airspace layer. -->
    <controls:NativeSurfaceLayer x:Name="NativeSurfaces" />

    <!-- Starting an isolated workspace is that workspace's state, so it takes
         that workspace's canvas and nothing else. The code-behind fits it to
         the space the workspace body leaves for the canvas, which keeps the
         rail, the tab strip and the title band live: another workspace can be
         brought forward, and the window can still be dragged. It sits above
         native surfaces while the isolate and its container come online, says
         how far an image pull has got when the provider can measure it, and
         can be cancelled while the environment is being prepared. -->
    <controls:SurfaceCard
        x:Name="WorkspaceIsolationProgress"
        ZIndex="1100"
        Tone="Panel"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        IsHitTestVisible="True">
      <controls:SurfaceCard.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsWorkspaceIsolationProgressVisible" />
          <Binding Path="IsWorkspaceVisible" />
        </MultiBinding>
      </controls:SurfaceCard.IsVisible>
      <StackPanel
          MaxWidth="420"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="{DynamicResource ShellSpaceSm}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding WorkspaceIsolationStartingHeading}">
        <ProgressBar
            Width="220"
            HorizontalAlignment="Center"
            Minimum="0"
            Maximum="100"
            IsIndeterminate="{Binding !HasWorkspaceIsolationStartingPercent}"
            Value="{Binding WorkspaceIsolationStartingPercent}" />
        <TextBlock
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
            Text="{Binding WorkspaceIsolationStartingHeading}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            HorizontalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            LineHeight="{DynamicResource ShellLineHeight11}"
            Text="{Binding WorkspaceIsolationStartingBody}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            Margin="{controls:Inset Top=Sm}"
            HorizontalAlignment="Center"
            Content="Cancel"
            Command="{Binding CancelWorkspaceIsolationStartupCommand}"
            IsVisible="{Binding CanCancelWorkspaceIsolationStartup}"
            AutomationProperties.Name="Cancel starting the workspace" />
      </StackPanel>
    </controls:SurfaceCard>
    </Grid>

    <!-- Last child of the root grid on purpose: when the shell is locked,
         the veil sits above every panel, overlay and toast — and the layer
         above holds nothing, native included. -->
    <components:ShellLockView
        DataContext="{CompiledBinding ApplicationSecurityEditor}"
        IsVisible="{CompiledBinding IsLocked}" />
  </Grid>
</Window>
