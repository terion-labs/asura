<controls:DialogWindow
    x:Class="Asura.App.Views.GitRepositoryPickerDialog"
    x:DataType="vm:GitRepositoryPickerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Width="620"
    Height="520"
    CanResize="False">
  <controls:DialogShell
      Title="Open Git Repository"
      Subtitle="{Binding ConnectionDisplayName, StringFormat=Browsing {0}. Folders holding a repository are marked.}"
      Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Classes="PrimaryButton" Click="OnOpenClick" Content="Open" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>

    <components:GitRepositoryBrowserView RepositoryChosen="OnRepositoryChosen" />
  </controls:DialogShell>
</controls:DialogWindow>
