<Window x:Class="Asura.App.Views.GitConflictDialog" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Asura.App.Controls" Width="1000" Height="700" MinWidth="650" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm, Vertical=Xs}" />
    </Style>
  </Window.Styles>
  <controls:DialogShell x:Name="Shell" Title="Resolve conflict" Scrolls="False">
    <controls:DialogShell.Footer>
      <WrapPanel x:Name="FooterActions" Orientation="Horizontal" ItemSpacing="{DynamicResource ShellSpaceXs}">
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Content="Cancel" Click="OnCancel" />
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" x:Name="CurrentButton" Classes="SecondaryButton" Content="Keep current" Click="OnCurrent" />
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" x:Name="IncomingButton" Classes="SecondaryButton" Content="Keep incoming" Click="OnIncoming" />
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" x:Name="BothButton" Classes="SecondaryButton" Content="Combine in result" Click="OnBoth" />
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="DestructiveButton" Content="Delete file" Click="OnDelete" />
        <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" x:Name="SaveButton" Classes="PrimaryButton" Content="Save and mark resolved" Click="OnSave" />
      </WrapPanel>
    </controls:DialogShell.Footer>
    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
      <TextBlock x:Name="PathLabel" TextWrapping="Wrap" />
      <TabControl Grid.Row="1">
        <TabItem Header="Result"><TextBox x:Name="ResultInput" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" AutomationProperties.Name="Resolved file content" /></TabItem>
        <TabItem Header="Current">
          <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
            <SelectableTextBlock x:Name="CurrentIdentity" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" TextWrapping="Wrap" AutomationProperties.Name="Current revision and file object" />
            <TextBox Grid.Row="1" x:Name="CurrentInput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" AutomationProperties.Name="Current version" />
          </Grid>
        </TabItem>
        <TabItem Header="Incoming">
          <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
            <SelectableTextBlock x:Name="IncomingIdentity" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" TextWrapping="Wrap" AutomationProperties.Name="Incoming revision and file object" />
            <TextBox Grid.Row="1" x:Name="IncomingInput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" AutomationProperties.Name="Incoming version" />
          </Grid>
        </TabItem>
        <TabItem Header="Base">
          <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
            <SelectableTextBlock x:Name="BaseIdentity" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" TextWrapping="Wrap" AutomationProperties.Name="Common ancestor file object" />
            <TextBox Grid.Row="1" x:Name="BaseInput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" AutomationProperties.Name="Common ancestor" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </controls:DialogShell>
</Window>
