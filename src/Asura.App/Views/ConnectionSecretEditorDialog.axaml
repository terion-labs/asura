<Window
    x:Class="Asura.App.Views.ConnectionSecretEditorDialog"
    x:DataType="vm:ConnectionSecretEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    Width="560" Height="480" MinWidth="480" MinHeight="400"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="Add credential">
  <controls:DialogShell Title="{Binding Title}" Subtitle="Save to your credential vault and use it for this connection."
      FooterHint="{Binding StorageHint}">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsEnabled="{Binding !IsSaving}" />
        <Button Classes="PrimaryButton" Click="OnSaveClick" Content="Save credential" IsEnabled="{Binding !IsSaving}" />
      </StackPanel>
    </controls:DialogShell.Footer>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <controls:LabeledField Label="Label">
        <TextBox Text="{Binding Label}" IsEnabled="{Binding !IsSaving}" AutomationProperties.Name="Credential label" />
      </controls:LabeledField>
      <controls:LabeledField Label="Secret value" Hint="{Binding ValueHint}">
        <TextBox Text="{Binding Value}" PasswordChar="●" AcceptsReturn="{Binding IsMultiline}"
            IsEnabled="{Binding !IsSaving}" AutomationProperties.Name="New credential value" />
      </controls:LabeledField>
      <TextBlock Classes="Muted" Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </controls:DialogShell>
</Window>
