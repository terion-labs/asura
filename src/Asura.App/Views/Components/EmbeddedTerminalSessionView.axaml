<UserControl
    x:Class="Asura.App.Views.Components.EmbeddedTerminalSessionView"
    x:DataType="vm:TerminalRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Container shell">
  <!-- The panel material behind this view is the chrome's translucent surface;
       painting the shell background here made every embedded terminal opaque
       regardless of the appearance settings. -->
  <Grid>
    <controls:TerminalPresentationHost
        x:Name="EmbeddedTerminal"
        Margin="0"
        ClientId="{Binding ClientId}"
        SessionClient="{Binding SessionClient}"
        StartupCommandDispatchState="{Binding StartupCommandDispatchState}"
        StartupCommandDispatcher="{Binding StartupCommandDispatcher}"
        SessionRequest="{Binding SessionRequest}"
        RenderProfile="{Binding RenderProfile}"
        BackgroundOpacity="{DynamicResource ShellTerminalSurfaceOpacity}"
        AccessibleTitle="{Binding Title}"
        IsCopyMode="{Binding IsCopyMode}"
        CopyModeExitRequested="OnCopyModeExitRequested"
        SessionSnapshotChanged="OnSessionSnapshotChanged"
        SessionInitializationFailed="OnSessionInitializationFailed" />

    <Border
        Margin="0"
        Padding="{controls:Inset Xl}"
        Background="{DynamicResource ShellSurfaceBrush}"
        IsHitTestVisible="False"
        IsVisible="{Binding ShowFallback, ElementName=EmbeddedTerminal}">
      <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
        <icons:SymbolIcon Symbol="WindowConsole" FontSize="{controls:TextScaled 24}" Foreground="{DynamicResource ShellMutedBrush}" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StatusMessage, ElementName=EmbeddedTerminal}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="420" />

    <Border
        Margin="0"
        Padding="{controls:Inset Xl}"
        Background="{DynamicResource ShellSurfaceBrush}"
        IsVisible="{Binding HasConnectionOverlay}">
      <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
        <icons:SymbolIcon Symbol="WindowConsole" FontSize="{controls:TextScaled 25}" Foreground="{DynamicResource ShellWarningBrush}" />
        <TextBlock Classes="Title3" Text="{Binding ConnectionStatus}" TextAlignment="Center" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ConnectionDetail}" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding RecoveryLabel}" TextAlignment="Center" TextWrapping="Wrap" />
        <controls:SurfaceCard Padding="0" IsVisible="{Binding HasHostKeyReview}">
          <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Headline" Text="{Binding HostKeyReviewTitle}" TextAlignment="Center" />
            <TextBlock FontSize="{DynamicResource ShellFontSize12}" Text="{Binding HostKeyReview.Presented.Algorithm}" TextAlignment="Center" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding TrustedHostKeyFingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="SecondaryButton" Click="OnTrustHostKeyClick" Content="{Binding TrustHostKeyLabel}" IsVisible="{Binding CanTrustHostKey}" />
          </StackPanel>
        </controls:SurfaceCard>
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding ReconnectStatus}" IsVisible="{Binding IsReconnecting}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
          <Button Classes="PrimaryButton" Click="OnProceedWithoutContinuityClick" Content="Proceed without continuity" IsVisible="{Binding CanProceedWithoutContinuity}" />
          <Button Classes="SecondaryButton" Click="OnRetryConnectionClick" Content="Retry connection" IsVisible="{Binding CanRetry}" />
          <Button Classes="TextButton" Click="OnCancelReconnectClick" Content="{Binding CancelConnectionLabel}" IsVisible="{Binding CanCancelConnection}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
