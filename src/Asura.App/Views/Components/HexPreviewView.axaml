<UserControl
    x:Class="Asura.App.Views.Components.HexPreviewView"
    x:DataType="vm:PreviewHexViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:previews="using:Asura.Application.Previews"
    xmlns:controls="using:Asura.App.Controls"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <Grid RowDefinitions="*,Auto">
    <!-- A list, not a text view: a dump is thousands of identical rows, and a
         text view has to measure every one before it can show the first. -->
    <!-- Rows are fixed width, so a narrow preview scrolls sideways rather
         than cutting a row mid-byte and losing the character column. The
         trailing inset keeps an overlay scroll bar off the last column. -->
    <ListBox
        x:Name="Rows"
        Classes="Dense"
        ItemsSource="{Binding Rows}"
        SelectionMode="Single"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        AutomationProperties.Name="File bytes">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="previews:HexPreviewRow">
          <!-- One size for the whole row: the offset is muted, not smaller,
               so its digits sit on the bytes' baseline. -->
          <StackPanel Margin="{controls:Inset Right=Lg}" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}">
            <TextBlock
                Classes="Muted"
                FontFamily="{DynamicResource ShellDataFontFamily}"
                FontSize="{DynamicResource ShellFontSize12}"
                Text="{Binding Offset}" />
            <TextBlock
                FontFamily="{DynamicResource ShellDataFontFamily}"
                FontSize="{DynamicResource ShellFontSize12}"
                Text="{Binding Bytes}" />
            <TextBlock
                Classes="Muted"
                FontFamily="{DynamicResource ShellDataFontFamily}"
                FontSize="{DynamicResource ShellFontSize12}"
                Text="{Binding Characters}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- The footer every File preview listing has: one 28-point band under
         the rows, its summary at the listing's own inset. -->
    <Grid
        x:Name="Footer"
        Grid.Row="1"
        MinHeight="{controls:TextScaled 28}"
        Margin="{controls:Inset Horizontal=Sm}">
      <TextBlock
          VerticalAlignment="Center"
          Classes="Muted"
          FontSize="{DynamicResource ShellSecondaryFontSize}"
          Text="{Binding Summary}"
          TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</UserControl>
