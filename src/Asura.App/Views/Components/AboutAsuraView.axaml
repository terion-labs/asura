<UserControl
    x:Class="Asura.App.Views.Components.AboutAsuraView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <!-- Product details, updates and the bundled component inventory. The About
       window shows this; Settings can host the same view. -->
  <StackPanel Spacing="{DynamicResource ShellSpaceLg}">
    <controls:SurfaceCard>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}" ColumnSpacing="{DynamicResource ShellSpaceXl}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Product" /><TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Version" /><TextBlock FontWeight="SemiBold" Text="{Binding ApplicationVersion}" /></StackPanel>
        <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Bundle identifier" /><TextBlock Text="{Binding ApplicationIdentifier}" /></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Executable" /><TextBlock Text="{Binding ExecutableName}" /></StackPanel>
        <StackPanel Grid.Row="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Platform" /><TextBlock Text="{Binding PlatformDescription}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Runtime" /><TextBlock Text="{Binding RuntimeDescription}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Row="3" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Agent runtime" /><TextBlock Text="{Binding AgentRuntimeDescription}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="Update channel" />
          <TextBlock Text="{Binding ApplicationUpdates.Channel}" />
          <controls:LiveRegionTextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ApplicationUpdates.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Application update status" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ApplicationUpdates.DownloadProgress}" IsVisible="{Binding ApplicationUpdates.IsDownloading}" AutomationProperties.Name="Update download progress" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding ApplicationUpdates.IsPreparingToRestart}" AutomationProperties.Name="Preparing update restart" />
          <WrapPanel Orientation="Horizontal">
            <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Click="OnCheckForUpdatesClick" Content="Check for Updates" IsEnabled="{Binding ApplicationUpdates.CanCheck}" IsVisible="{Binding ApplicationUpdates.CanCheck}" AutomationProperties.Name="Check for application updates" />
            <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="PrimaryButton" Click="OnDownloadUpdateClick" Content="Download Update" IsEnabled="{Binding ApplicationUpdates.CanDownload}" IsVisible="{Binding ApplicationUpdates.CanDownload}" AutomationProperties.Name="Download application update" />
            <Button Margin="{controls:Inset Bottom=Xs}" Classes="PrimaryButton" Click="OnRestartToApplyUpdateClick" Content="Restart to Update" IsEnabled="{Binding ApplicationUpdates.CanRestartToApply}" IsVisible="{Binding ApplicationUpdates.CanRestartToApply}" AutomationProperties.Name="Restart to apply application update" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </controls:SurfaceCard>

    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="SectionHeading" Text="Open-source components" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Key runtime components are shown here; the bundled notice records the current managed inventory." TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Classes="SecondaryButton" Click="OnOpenThirdPartyNoticesClick" Content="Acknowledgments…" AutomationProperties.Name="Open bundled third-party notices" />
      </Grid>
      <ItemsControl ItemsSource="{Binding ProductComponents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}" RowSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Purpose}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Top" Classes="Eyebrow" Text="Bundled" />
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                  <TextBlock Margin="{controls:Inset Right=Lg}" Text="{Binding Version}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" Text="{Binding License}" TextWrapping="Wrap" />
                </WrapPanel>
              </Grid>
            </controls:SurfaceCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoProductComponents}">
        <controls:StateOverlay Margin="{controls:Inset Xl}"
            Kind="Unsupported"
            Heading="No component inventory in this build"
            Body="The bundled notices remain available and record the licenses shipped with this copy." />
      </controls:SurfaceCard>
    </StackPanel>
  </StackPanel>
</UserControl>
