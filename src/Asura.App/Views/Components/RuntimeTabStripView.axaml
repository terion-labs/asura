<UserControl
    x:Class="Asura.App.Views.Components.RuntimeTabStripView"
    x:DataType="components:RuntimeTabStripView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:converters="using:Asura.App.Converters"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:vm="using:Asura.App.ViewModels"
    Focusable="False"
    Margin="{DynamicResource ShellTabStripTopClearance}"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Styles>
    <Style Selector="Grid.RuntimeTabDropTarget.panelDropTarget Button.RuntimeTabActivator">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- The tab's size belongs to the strip's axis, not to the tab. A strip
         running across the chrome deals in chips at the chrome's height, as
         wide as the strip can afford: they share the room down to a minimum
         and only then scroll, so a full strip compresses before anything
         goes out of sight. Docked at the side it deals in rows — full width,
         control height — and a chip-sized tab there sat squeezed in the
         middle of its own column. The chip is at least the chrome's height
         at the text size it was drawn for, and grows with larger text rather
         than clipping its title. -->
    <Style Selector="components|RuntimeTabStripView[Orientation=Horizontal] Grid.RuntimeTabDropTarget">
      <Setter Property="Width" Value="{Binding $parent[components:RuntimeTabStripView].TabWidth}" />
      <Setter Property="MinHeight" Value="{controls:TextScaled 22}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The trailing inset keeps the label clear of the close button, which
         sits over the chip's end: a label that ran under it could not be
         read on the one tab that always shows it. -->
    <Style Selector="components|RuntimeTabStripView[Orientation=Horizontal] Button.RuntimeTabActivator">
      <Setter Property="Padding" Value="{controls:Inset Left=Lg, Right=Xl}" />
    </Style>
    <Style Selector="components|RuntimeTabStripView[Orientation=Vertical] Grid.RuntimeTabDropTarget">
      <Setter Property="Height" Value="{DynamicResource ShellControlMinHeight}" />
    </Style>
    <!-- A row's label starts where a row's label starts, not where a chip's
         did: the horizontal chip spends Lg because its label floats in a
         box, and that inset carried over as dead air. -->
    <Style Selector="components|RuntimeTabStripView[Orientation=Vertical] Button.RuntimeTabActivator">
      <Setter Property="Padding" Value="{controls:Inset Left=Sm, Right=Xxl}" />
    </Style>
    <Style Selector="components|RuntimeTabStripView[Orientation=Vertical] Button#AddTabButton">
      <Setter Property="Margin" Value="{controls:Inset Top=Xs}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Close is offered where the HIG offers it: on the tab you are in, and
         on the one under the pointer. Twenty points at the least in the
         chrome's chip, the full twenty-four in a row with the height for it.
         It is not a Tab stop: Command-W and the tab's context menu close
         from the keyboard, and a hidden stop between every pair of tabs
         would only be in the way. -->
    <Style Selector="Button.RuntimeTabClose">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="components|RuntimeTabStripView[Orientation=Vertical] Button.RuntimeTabClose">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Grid.RuntimeTabDropTarget.active Button.RuntimeTabClose.closable, Grid.RuntimeTabDropTarget:pointerover Button.RuntimeTabClose.closable">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <!-- The add button lives outside the scroll: it is always reachable, no
       matter how many tabs overflowed. The scrollbar is hidden — overflow
       announces itself as a fade at the strip's edge, and as the pull-down
       beside the add button that lists every tab, so a tab out of sight is
       one click away rather than a scroll away.

       The strip shrinks to its tabs, so while they fit the button rides the
       last tab's edge; only an overflowing strip pins it to the far end,
       where this hairline steps it off from whatever sits beyond. -->
  <DockPanel>
    <Border
        x:Name="OverflowSeparator"
        DockPanel.Dock="Right"
        Width="1"
        Height="14"
        Margin="{controls:Inset Left=Sm}"
        VerticalAlignment="Center"
        Background="{DynamicResource ShellBorderBrush}"
        IsVisible="False" />
    <Button
        x:Name="AddTabButton"
        DockPanel.Dock="Right"
        Width="22"
        Height="22"
        Padding="0"
        Margin="{controls:Inset Left=Xs}"
        VerticalAlignment="Center"
        Classes="IconButton"
        Click="OnAddTab"
        ToolTip.Tip="{x:Static vm:ShortcutTips.NewTab}"
        AutomationProperties.Name="New Tab">
      <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
    </Button>
    <Button
        x:Name="OverflowMenuButton"
        DockPanel.Dock="Right"
        Width="22"
        Height="22"
        Padding="0"
        Margin="{controls:Inset Left=Xs}"
        VerticalAlignment="Center"
        Classes="IconButton"
        IsVisible="False"
        ToolTip.Tip="Show All Tabs"
        AutomationProperties.Name="Show All Tabs">
      <icons:SymbolIcon Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnOverflowMenuOpening" />
      </Button.Flyout>
    </Button>
    <ScrollViewer
        x:Name="TabScrollViewer"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Disabled"
        ScrollChanged="OnTabScrollChanged"
        AutomationProperties.Name="Open runtime tabs">
      <!-- The container theme stretches every generated presenter, or a
           side-docked tab is only as wide as its title and the close button
           trails the text instead of holding the row's edge. Stated as a
           theme because no style selector reliably reaches these presenters.

           The list is a tab group to assistive technology: each tab inside
           it says it is a tab, whether it is the selected one, and where it
           stands among the others. -->
      <controls:RuntimeTabList
          x:Name="TabItems"
          ItemsSource="{Binding Tabs, ElementName=Root}"
          AutomationProperties.Name="Tabs">
      <ItemsControl.ItemContainerTheme>
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </ControlTheme>
      </ItemsControl.ItemContainerTheme>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="{Binding Orientation, ElementName=Root}" Spacing="{DynamicResource ShellSpaceXs}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:IRuntimeTabStripItem">
          <!-- Compact, because the active tab is a filled accent block: at a
               taller height it was the heaviest thing in the chrome and read
               as a banner rather than as one tab among several. -->
          <Grid
              Classes="RuntimeTabDropTarget"
              Classes.active="{Binding IsActive}"
              ColumnDefinitions="*,Auto"
              DragDrop.AllowDrop="True"
              DragDrop.DragEnter="OnDragEnter"
              DragDrop.DragLeave="OnDragLeave"
              DragDrop.DragOver="OnDragOver"
              DragDrop.Drop="OnDrop">
            <!-- What a tab offers, in the order it is reached for: name it,
                 mark it, send it somewhere, end it. Closing comes last, behind
                 a separator. The items that need the shell's help only appear
                 where a shell has offered it. -->
            <Grid.ContextMenu>
              <ContextMenu Opening="OnTabContextMenuOpening" Opened="OnTabContextMenuOpened">
                <MenuItem Classes="RenameTab" Header="Rename Tab…" Click="OnRenameTabMenuClick" />
                <MenuItem Classes="ChangeTabIcon" Header="Change Icon…" Click="OnChangeTabIconMenuClick" />
                <Separator Classes="MoveTabSeparator" />
                <MenuItem Classes="MoveTabToWorkspace" Header="Move to Workspace" />
                <MenuItem
                    Classes="MoveTabToNewWindow"
                    Header="Move to New Window"
                    Click="OnMoveTabToNewWindowMenuClick"
                    ToolTip.ShowOnDisabled="True" />
                <Separator />
                <MenuItem Classes="CloseTab" Header="Close Tab" Click="OnClose" />
                <MenuItem Classes="CloseOtherTabs" Header="Close Other Tabs" Click="OnCloseOtherTabsMenuClick" />
              </ContextMenu>
            </Grid.ContextMenu>
            <!-- Stretched, or the chip shrinks to its label and the close button
                 that belongs to this tab renders outside it. Avalonia buttons do
                 not stretch by default. -->
            <!-- The active tab wears the accent, and the accent is the open
                 workspace's own, so the tab strip says which workspace you are
                 in without repeating its name. Colour comes from the theme
                 rather than from the view model: a tab that carried its own hex
                 answered no appearance setting. -->
            <!-- No inline Padding: the orientation styles above own it, and an
                 inline value would silently beat them both. The tooltip is the
                 whole title, because a compressed tab trims it. -->
            <controls:RuntimeTabButton
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="RuntimeTabActivator"
                Classes.active="{Binding IsActive}"
                IsSelected="{Binding IsActive}"
                Click="OnActivate"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                ToolTip.Tip="{Binding DisplayTitle}"
                AutomationProperties.HelpText="Drag to reorder. Middle-click closes. The context menu renames, changes the icon, moves, or closes the tab.">
              <AutomationProperties.Name>
                <MultiBinding Converter="{x:Static converters:AttentionLabelConverter.Instance}">
                  <Binding Path="DisplayTitle" />
                  <Binding Path="HasAttention" />
                  <Binding Path="AgentActivity" />
                </MultiBinding>
              </AutomationProperties.Name>
              <!-- A grid, not a stack: a stacked label takes whatever width it
                   wants, so a long tab name ran under its own attention dot and
                   out through the close button instead of trimming. The label is
                   the only part that gives. -->
              <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <Border
                    Classes="RuntimeTabIcon"
                    Tag="{Binding Icon}"
                    Background="Transparent"
                    DoubleTapped="OnIconDoubleTapped"
                    ToolTip.Tip="Double-click to change icon"
                    AutomationProperties.AccessibilityView="Raw">
                  <!-- Fluent's visible glyph sits one DIP below Inter's optical
                       centre even though both controls are geometrically centred. -->
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="{DynamicResource ShellIconSizeXs}">
                    <icons:SymbolIcon.RenderTransform>
                      <TranslateTransform Y="-1" />
                    </icons:SymbolIcon.RenderTransform>
                  </icons:SymbolIcon>
                  <FlyoutBase.AttachedFlyout>
                    <Flyout Opened="OnIconFlyoutOpened">
                      <components:IconPicker
                          x:DataType="vm:RuntimeTabIconPickerViewModel"
                          Width="330"
                          ItemsSource="{Binding IconChoices}"
                          SearchText="{Binding IconSearch, Mode=TwoWay}"
                          ShowAll="{Binding ShowAllIcons, Mode=TwoWay}"
                          TotalCount="{Binding IconCount}"
                          Hint="{Binding IconHint}"
                          IconChosen="OnIconChosen" />
                    </Flyout>
                  </FlyoutBase.AttachedFlyout>
                </Border>
                <Grid Grid.Column="1" Background="Transparent">
                  <TextBlock
                      Classes="RuntimeTabTitle"
                      VerticalAlignment="Center"
                      FontSize="{DynamicResource ShellFontSize10}"
                      Text="{Binding DisplayTitle}"
                      TextTrimming="CharacterEllipsis"
                      DoubleTapped="OnTitleDoubleTapped" />
                  <TextBox
                      Classes="Dense RuntimeTabTitleEditor"
                      MinHeight="{controls:TextScaled 20}"
                      Padding="2,0"
                      VerticalContentAlignment="Center"
                      FontSize="{DynamicResource ShellFontSize10}"
                      IsVisible="False"
                      KeyDown="OnTitleEditorKeyDown"
                      LostFocus="OnTitleEditorLostFocus"
                      AutomationProperties.Name="Tab name" />
                </Grid>
                <!-- Inside the tab, so the label trims before it rather than
                     running under it, and the tab's own name already says what
                     these marks draw. -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource ShellSpaceXs}">
                  <icons:SymbolIcon
                      AutomationProperties.AccessibilityView="Raw"
                      Classes="PanelAgentActivity"
                      FontSize="{DynamicResource ShellFontSize10}"
                      IsVisible="{Binding HasAgentActivity}"
                      Symbol="Bot"
                      ToolTip.Tip="{Binding AgentActivity}" />
                  <controls:SignalDot
                      AutomationProperties.AccessibilityView="Raw"
                      IsVisible="{Binding HasAttention}" />
                </StackPanel>
              </Grid>
            </controls:RuntimeTabButton>
            <Border
                Grid.ColumnSpan="2"
                Width="3"
                Margin="{controls:Inset Vertical=Xs}"
                HorizontalAlignment="Left"
                Background="{DynamicResource ShellAccentBrush}"
                Classes="RuntimeTabDropIndicator Before"
                IsHitTestVisible="False"
                IsVisible="False" />
            <Border
                Grid.ColumnSpan="2"
                Width="3"
                Margin="{controls:Inset Vertical=Xs}"
                HorizontalAlignment="Right"
                Background="{DynamicResource ShellAccentBrush}"
                Classes="RuntimeTabDropIndicator After"
                IsHitTestVisible="False"
                IsVisible="False" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="IconButton RuntimeTabClose"
                Classes.closable="{Binding CanClose}"
                Click="OnClose"
                ToolTip.Tip="{x:Static vm:ShortcutTips.CloseTab}"
                AutomationProperties.Name="{Binding DisplayTitle, StringFormat={}Close {0}}"
                AutomationProperties.HelpText="Closes this tab. A tab with running sessions asks first.">

              <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeXs}" />
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      </controls:RuntimeTabList>
    </ScrollViewer>
  </DockPanel>
</UserControl>
