<UserControl
    x:Class="Asura.App.Views.Components.ZoomableImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Styles>
    <!-- The zoom percentage is a text button among icon buttons: no fill,
         sized to its text, the same height as its neighbours. -->
    <Style Selector="Button#ZoomLevelButton">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="{controls:TextScaled 46}" />
      <Setter Property="Padding" Value="{controls:Inset Horizontal=Xs}" />
    </Style>
  </UserControl.Styles>
  <!-- The controls sit in a bar under the picture rather than over it, so
       no part of an image or a PDF page is ever behind them. -->
  <Grid RowDefinitions="*,Auto">
    <!-- The image keeps its own pixel size and is moved by a transform rather
         than by layout, so zooming and panning never re-run a measure pass. -->
    <Border x:Name="Viewport" ClipToBounds="True" Background="Transparent">
      <Image
          x:Name="Surface"
          Stretch="None"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%" />
    </Border>

    <Border
        x:Name="Toolbar"
        Grid.Row="1"
        HorizontalAlignment="Right"
        Margin="{controls:Inset Top=Sm}"
        Padding="{controls:Inset Horizontal=Xs, Vertical=Xs}"
        Background="{DynamicResource ShellSurfaceBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource ShellControlCornerRadius}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
        <Button
            Classes="IconButton"
            Click="OnZoomOutClick"
            ToolTip.Tip="Zoom out"
            AutomationProperties.Name="Zoom out">
          <icons:SymbolIcon Symbol="ZoomOut" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Button
            x:Name="ZoomLevelButton"
            Classes="IconButton"
            Click="OnFitClick"
            ToolTip.Tip="Fit to the preview area"
            AutomationProperties.Name="Fit image to the preview area">
          <controls:LiveRegionTextBlock
              x:Name="ZoomLevelText"
              FontSize="{DynamicResource ShellSecondaryFontSize}"
              HorizontalAlignment="Center"
              Text="100%"
              AutomationProperties.LiveSetting="Polite" />
        </Button>
        <Button
            Classes="IconButton"
            Click="OnZoomInClick"
            ToolTip.Tip="Zoom in"
            AutomationProperties.Name="Zoom in">
          <icons:SymbolIcon Symbol="ZoomIn" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Border Width="1" Margin="{DynamicResource ShellHairlineInset}" Background="{DynamicResource ShellBorderBrush}" />
        <Button
            Classes="IconButton"
            Click="OnRotateLeftClick"
            ToolTip.Tip="Rotate left"
            AutomationProperties.Name="Rotate left">
          <icons:SymbolIcon Symbol="ArrowRotateCounterclockwise" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Button
            Classes="IconButton"
            Click="OnRotateRightClick"
            ToolTip.Tip="Rotate right"
            AutomationProperties.Name="Rotate right">
          <icons:SymbolIcon Symbol="ArrowRotateClockwise" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
