<UserControl
    x:Class="Asura.App.Views.Components.GitDiffView"
    x:DataType="vm:GitRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:core="using:Asura.Core"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia">
  <UserControl.Styles>
    <!-- Comparison options that stay on are toggle buttons: VoiceOver hears
         "toggle button, on", and the fill says the same to the eye. -->
    <Style Selector="ToggleButton.GitDiffToggle">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.GitDiffToggle /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.GitDiffToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellControlHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.GitDiffToggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.GitDiffToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.GitDiffToggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
    <Style Selector="ToggleButton.GitDiffToggle icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.GitDiffToggle:checked icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
    </Style>
    <Style Selector="Button.GitPullDown">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.GitPullDown icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="ListBox.GitDiffLines ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <!-- A diff line keeps its added or removed tint when selected, so the row
         fill cannot carry the selection. A bar in the gutter does: muted while
         the diff is not focused, accent while it is, both at least 3:1 against
         the panel. Selected lines are what Stage Selection acts on. -->
    <Style Selector="ListBox.GitDiffLines ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.GitDiffSelectionMark">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
    <Style Selector="ListBox.GitDiffLines ListBoxItem:selected Border.GitDiffSelectionMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.GitDiffLines:focus-within ListBoxItem:selected Border.GitDiffSelectionMark">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTextBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.GitDiffLine.added">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.removed">
      <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.hunk">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ShellDataFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Line numbers at the code's own size, so a number sits on its line's
         baseline rather than a step below it. -->
    <Style Selector="Border.GitDiffLine TextBlock.GitDiffNumber">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="{controls:Inset Right=Xs}" />
    </Style>
    <Style Selector="Border.GitDiffLine.added TextBlock.GitDiffMarker">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.removed TextBlock.GitDiffMarker">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.hunk TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- The file and the way through it: previous and next file, previous
         and next change, as two compact pairs whose tooltips name their keys. -->
    <Border
        Classes="PanelToolbar"
        Padding="{controls:Inset Horizontal=Md, Vertical=Xs}"
        IsVisible="{Binding DiffFileName, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <TextBlock
            VerticalAlignment="Center"
            FontFamily="{DynamicResource ShellDataFontFamily}"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            LineHeight="{DynamicResource ShellLineHeight11}"
            Classes="Path"
            Text="{Binding DiffFileName}" />
        <controls:StatusChip
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="Warning"
            Shape="Rounded"
            Content="Truncated"
            IsVisible="{Binding DiffIsTruncated}" />
        <Border Grid.Column="2" Classes="FileToolbarGroup" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button
                x:Name="PreviousFileButton"
                Classes="IconButton FileToolbarAction"
                Tag="PreviousFile"
                Click="OnDiffNavigate"
                IsEnabled="{Binding CanSelectPreviousDiffFile}"
                ToolTip.Tip="{x:Static vm:GitDiffShortcuts.PreviousFileTip}"
                AutomationProperties.Name="Previous File">
              <icons:SymbolIcon Symbol="ArrowUp" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                x:Name="NextFileButton"
                Classes="IconButton FileToolbarAction"
                Tag="NextFile"
                Click="OnDiffNavigate"
                IsEnabled="{Binding CanSelectNextDiffFile}"
                ToolTip.Tip="{x:Static vm:GitDiffShortcuts.NextFileTip}"
                AutomationProperties.Name="Next File">
              <icons:SymbolIcon Symbol="ArrowDown" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="FileToolbarGroup" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button
                x:Name="PreviousChangeButton"
                Classes="IconButton FileToolbarAction"
                Tag="PreviousChange"
                Click="OnDiffNavigate"
                ToolTip.Tip="{x:Static vm:GitDiffShortcuts.PreviousChangeTip}"
                AutomationProperties.Name="Previous Change">
              <icons:SymbolIcon Symbol="ChevronUp" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
            <Button
                x:Name="NextChangeButton"
                Classes="IconButton FileToolbarAction"
                Tag="NextChange"
                Click="OnDiffNavigate"
                ToolTip.Tip="{x:Static vm:GitDiffShortcuts.NextChangeTip}"
                AutomationProperties.Name="Next Change">
              <icons:SymbolIcon Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeSm}" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Finding and how the comparison is drawn. One row that never wraps:
         the field gives way first, and the four drawing options share one
         View pull-down whose items carry checkmarks. -->
    <Grid
        x:Name="DiffOptionsBar"
        Grid.Row="1"
        Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
        ColumnDefinitions="*,Auto,Auto,Auto"
        ColumnSpacing="{DynamicResource ShellSpaceXs}"
        IsVisible="{Binding DiffFileName, Converter={x:Static ObjectConverters.IsNotNull}}">
      <controls:SearchField
          x:Name="DiffFindField"
          MinWidth="96"
          MaxWidth="260"
          HorizontalAlignment="Stretch"
          Classes="Dense"
          Text="{Binding DiffSearch}"
          PlaceholderText="Find in diff"
          AutomationProperties.Name="Find in diff" />
      <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          IsVisible="{Binding DiffSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Button
            x:Name="PreviousMatchButton"
            Classes="IconButton"
            Tag="Previous"
            Click="OnDiffNavigate"
            ToolTip.Tip="{x:Static vm:GitDiffShortcuts.PreviousMatchTip}"
            AutomationProperties.Name="Previous Match">
          <icons:SymbolIcon Symbol="ChevronLeft" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
        <Button
            x:Name="NextMatchButton"
            Classes="IconButton"
            Tag="Next"
            Click="OnDiffNavigate"
            ToolTip.Tip="{x:Static vm:GitDiffShortcuts.NextMatchTip}"
            AutomationProperties.Name="Next Match">
          <icons:SymbolIcon Symbol="ChevronRight" FontSize="{DynamicResource ShellIconSizeSm}" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ToggleButton
            x:Name="IgnoreWhitespaceToggle"
            Classes="GitDiffToggle"
            IsChecked="{Binding DiffIgnoresWhitespace, Mode=TwoWay}"
            ToolTip.Tip="Ignore whitespace changes"
            AutomationProperties.Name="Ignore whitespace changes">
          <icons:SymbolIcon Symbol="Spacebar" FontSize="{DynamicResource ShellIconSizeSm}" />
        </ToggleButton>
        <ToggleButton
            x:Name="SideBySideToggle"
            Classes="GitDiffToggle"
            IsChecked="{Binding DiffIsSplit, Mode=TwoWay}"
            ToolTip.Tip="Side-by-side comparison"
            AutomationProperties.Name="Side-by-side comparison">
          <icons:SymbolIcon Symbol="SplitVertical" FontSize="{DynamicResource ShellIconSizeSm}" />
        </ToggleButton>
      </StackPanel>
      <Button
          x:Name="DiffViewMenuButton"
          Grid.Column="3"
          Classes="Dense GitPullDown"
          ToolTip.Tip="How the comparison is drawn"
          AutomationProperties.Name="View">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock VerticalAlignment="Center" Text="View" />
          <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Wrap Lines" ToggleType="CheckBox" IsChecked="{Binding DiffWrap, Mode=TwoWay}" />
            <MenuItem Header="Show Invisible Characters" ToggleType="CheckBox" IsChecked="{Binding DiffShowsInvisibles, Mode=TwoWay}" />
            <MenuItem Header="Highlight Word Changes" ToggleType="CheckBox" IsChecked="{Binding DiffHighlightsWords, Mode=TwoWay}" />
            <Separator />
            <MenuItem Header="Show Whole File" ToggleType="CheckBox" IsChecked="{Binding DiffWholeFile, Mode=TwoWay}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <WrapPanel Grid.Row="2" ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" IsVisible="{Binding IsLocalChangesSection}">
      <!-- Dense, as the toolbar controls above them are. -->
      <Button Classes="SecondaryButton Dense" Content="Stage Selection" Tag="Stage" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding !SelectedChange.IsStaged}" />
      <Button Classes="SecondaryButton Dense" Content="Unstage Selection" Tag="Unstage" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding SelectedChange.IsStaged}" />
      <Button Classes="DestructiveButton Dense" Content="Discard Selection…" Tag="Discard" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding !SelectedChange.IsStaged}" />
    </WrapPanel>
    <components:GitImageDiffView Grid.Row="3" ImagePair="{Binding DiffImages}" IsVisible="{Binding HasDiffImages}" />
    <ListBox
        x:Name="UnifiedLines"
        Grid.Row="3"
        SelectionMode="Multiple,Toggle"
        SelectionChanged="OnDiffSelection"
        SelectedItem="{Binding DiffSearchMatch}"
        Classes="GitDiffLines OwnSelection"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        ItemsSource="{Binding DiffLines}"
        ScrollViewer.HorizontalScrollBarVisibility="{Binding DiffHorizontalScrollBarVisibility}"
        IsVisible="{Binding ShowsUnifiedDiff}"
        AutomationProperties.Name="Diff lines">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" x:DataType="vm:GitDiffLineViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Panel>
            <Border
                Classes="GitDiffLine"
                Classes.added="{Binding IsAdded}"
                Classes.removed="{Binding IsRemoved}"
                Classes.hunk="{Binding IsHunkHeader}">
              <Border.ContextMenu>
                <ContextMenu Opening="OnHunkMenuOpening">
                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitHunkStage}" Click="OnHunkAction" />
                  <MenuItem components:PanelMenuCommand.Command="{x:Static core:BuiltInCommands.GitHunkUnstage}" Click="OnHunkAction" />
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="44,44,18,*">
                <TextBlock Classes="GitDiffNumber" Text="{Binding OldNumberText}" />
                <TextBlock Grid.Column="1" Classes="GitDiffNumber" Text="{Binding NewNumberText}" />
                <TextBlock
                    Grid.Column="2"
                    Classes="GitDiffMarker"
                    TextAlignment="Center"
                    Text="{Binding MarkerText}" />
                <components:GitDiffTextBlock Grid.Column="3" SyntaxText="{Binding Text}" PeerText="{Binding PeerText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
              </Grid>
            </Border>
            <Border Classes="GitDiffSelectionMark" />
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The side-by-side rendering of the same parse: removals left,
         additions right, change blocks paired row by row. -->
    <ListBox
        x:Name="SplitLines"
        Grid.Row="3"
        Classes="GitDiffLines OwnSelection"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        ItemsSource="{Binding DiffSplitRows}"
        SelectedItem="{Binding DiffSearchSplitMatch, Mode=OneWay}"
        ScrollViewer.HorizontalScrollBarVisibility="{Binding DiffHorizontalScrollBarVisibility}"
        IsVisible="{Binding ShowsSplitDiff}"
        AutomationProperties.Name="Side-by-side diff lines">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" x:DataType="vm:GitDiffSplitRowViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Panel>
            <Border Classes="GitDiffLine hunk" IsVisible="{Binding IsHunkHeader}">
              <TextBlock Text="{Binding HeaderText}" />
            </Border>
            <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding !IsHunkHeader}">
              <Border Classes="GitDiffLine" Classes.removed="{Binding LeftIsRemoved}">
                <Grid ColumnDefinitions="44,18,*">
                  <TextBlock Classes="GitDiffNumber" Text="{Binding LeftNumberText}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="GitDiffMarker"
                      TextAlignment="Center"
                      Text="{Binding LeftMarkerText}" />
                  <components:GitDiffTextBlock Grid.Column="2" SyntaxText="{Binding LeftText}" PeerText="{Binding RightText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
                </Grid>
              </Border>
              <Border
                  Grid.Column="1"
                  Width="1"
                  Background="{DynamicResource ShellBorderBrush}"
                  IsHitTestVisible="False" />
              <Border Grid.Column="2" Classes="GitDiffLine" Classes.added="{Binding RightIsAdded}">
                <Grid ColumnDefinitions="44,18,*">
                  <TextBlock Classes="GitDiffNumber" Text="{Binding RightNumberText}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="GitDiffMarker"
                      TextAlignment="Center"
                      Text="{Binding RightMarkerText}" />
                  <components:GitDiffTextBlock Grid.Column="2" SyntaxText="{Binding RightText}" PeerText="{Binding LeftText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
                </Grid>
              </Border>
            </Grid>
            <Border Classes="GitDiffSelectionMark" />
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <controls:StateOverlay
        Grid.Row="3"
        Kind="Empty"
        Heading="No diff selected"
        Body="Choose a change to compare its versions."
        IsVisible="{Binding ShowsDiffEmptyState}" />
    <controls:Callout
        Grid.Row="3"
        Margin="{controls:Inset Md}"
        VerticalAlignment="Top"
        Tone="Default"
        Title="Binary file"
        Text="This change has no line-by-line comparison."
        IsVisible="{Binding ShowsBinaryDiffPlaceholder}" />
    <controls:StateOverlay
        Grid.Row="3"
        Kind="Loading"
        Heading="Reading diff…"
        IsVisible="{Binding IsDiffLoading}" />
  </Grid>
</UserControl>
