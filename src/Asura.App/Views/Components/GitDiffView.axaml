<UserControl
    x:Class="Asura.App.Views.Components.GitDiffView"
    x:DataType="vm:GitRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia">
  <UserControl.Styles>
    <Style Selector="Button.IconButton.GitDiffToggle.selected">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.IconButton.GitDiffToggle.selected > icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
    </Style>
    <Style Selector="ListBox.GitDiffLines ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="ListBox.GitDiffLines ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.GitDiffLine">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.GitDiffLine.added">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoftBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.removed">
      <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.hunk">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ShellDataFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
      <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.GitDiffLine TextBlock.GitDiffNumber">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource ShellFontSize10}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="{controls:Inset Right=Xs}" />
    </Style>
    <Style Selector="Border.GitDiffLine.added TextBlock.GitDiffMarker">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccessBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.removed TextBlock.GitDiffMarker">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <Style Selector="Border.GitDiffLine.hunk TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border
        Classes="PanelToolbar"
        Padding="{controls:Inset Horizontal=Md, Vertical=Xs}"
        IsVisible="{Binding DiffFileName, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <TextBlock
            VerticalAlignment="Center"
            FontFamily="{DynamicResource ShellDataFontFamily}"
            FontSize="{DynamicResource ShellFontSize10}"
            LineHeight="{DynamicResource ShellLineHeight10}"
            Text="{Binding DiffFileName}"
            TextTrimming="CharacterEllipsis" />
        <controls:StatusChip
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="Warning"
            Shape="Rounded"
            Content="Truncated"
            IsVisible="{Binding DiffIsTruncated}" />
        <Button
            Grid.Column="2"
            Classes="IconButton GitDiffToggle"
            Classes.selected="{Binding DiffIgnoresWhitespace}"
            Click="OnToggleWhitespaceClick"
            ToolTip.Tip="Ignore whitespace changes"
            AutomationProperties.Name="Ignore whitespace changes">
          <icons:SymbolIcon Symbol="Spacebar" FontSize="14" />
        </Button>
        <Button
            Grid.Column="3"
            Classes="IconButton GitDiffToggle"
            Classes.selected="{Binding DiffIsSplit}"
            Click="OnToggleSplitClick"
            ToolTip.Tip="Side-by-side comparison"
            AutomationProperties.Name="Side-by-side comparison">
          <icons:SymbolIcon Symbol="SplitVertical" FontSize="14" />
        </Button>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="1" ItemSpacing="{DynamicResource ShellSpaceXs}" LineSpacing="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" IsVisible="{Binding IsLocalChangesSection}">
      <Button Content="Stage selection" Tag="Stage" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding !SelectedChange.IsStaged}" />
      <Button Content="Unstage selection" Tag="Unstage" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding SelectedChange.IsStaged}" />
      <Button Content="Discard selection…" Tag="Discard" Click="OnApplyPartial" IsEnabled="{Binding CanApplyPartialDiff}" IsVisible="{Binding !SelectedChange.IsStaged}" />
    </WrapPanel>

    <WrapPanel Grid.Row="2" ItemSpacing="{DynamicResource ShellSpaceSm}" LineSpacing="{DynamicResource ShellSpaceXs}" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}">
      <TextBox Text="{Binding DiffSearch}" PlaceholderText="Find in diff" Width="150" AutomationProperties.Name="Find in diff" />
      <Button Content="Previous" Tag="Previous" Click="OnDiffNavigate" />
      <Button Content="Next" Tag="Next" Click="OnDiffNavigate" />
      <Button Content="Previous change" Tag="PreviousChange" Click="OnDiffNavigate" />
      <Button Content="Next change" Tag="NextChange" Click="OnDiffNavigate" />
      <CheckBox Content="Wrap" IsChecked="{Binding DiffWrap}" />
      <CheckBox Content="Invisible characters" IsChecked="{Binding DiffShowsInvisibles}" />
      <CheckBox Content="Word changes" IsChecked="{Binding DiffHighlightsWords}" />
      <CheckBox Content="Whole file" IsChecked="{Binding DiffWholeFile}" />
    </WrapPanel>
    <components:GitImageDiffView Grid.Row="3" ImagePair="{Binding DiffImages}" IsVisible="{Binding HasDiffImages}" />
    <ListBox
        x:Name="UnifiedLines"
        Grid.Row="3"
        SelectionMode="Multiple,Toggle"
        SelectionChanged="OnDiffSelection"
        SelectedItem="{Binding DiffSearchMatch}"
        Classes="GitDiffLines"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        ItemsSource="{Binding DiffLines}"
        ScrollViewer.HorizontalScrollBarVisibility="{Binding DiffHorizontalScrollBarVisibility}"
        IsVisible="{Binding ShowsUnifiedDiff}"
        AutomationProperties.Name="Diff lines">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" x:DataType="vm:GitDiffLineViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border
              Classes="GitDiffLine"
              Classes.added="{Binding IsAdded}"
              Classes.removed="{Binding IsRemoved}"
              Classes.hunk="{Binding IsHunkHeader}">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Stage hunk" Tag="Stage" Click="OnHunkAction" />
                <MenuItem Header="Unstage hunk" Tag="Unstage" Click="OnHunkAction" />
              </ContextMenu>
            </Border.ContextMenu>
            <Grid ColumnDefinitions="44,44,18,*">
              <TextBlock Classes="GitDiffNumber" Text="{Binding OldNumberText}" />
              <TextBlock Grid.Column="1" Classes="GitDiffNumber" Text="{Binding NewNumberText}" />
              <TextBlock
                  Grid.Column="2"
                  Classes="GitDiffMarker"
                  TextAlignment="Center"
                  Text="{Binding MarkerText}" />
              <components:GitDiffTextBlock Grid.Column="3" SyntaxText="{Binding Text}" PeerText="{Binding PeerText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The side-by-side rendering of the same parse: removals left,
         additions right, change blocks paired row by row. -->
    <ListBox
        x:Name="SplitLines"
        Grid.Row="3"
        Classes="GitDiffLines"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        ItemsSource="{Binding DiffSplitRows}"
        SelectedItem="{Binding DiffSearchSplitMatch, Mode=OneWay}"
        ScrollViewer.HorizontalScrollBarVisibility="{Binding DiffHorizontalScrollBarVisibility}"
        IsVisible="{Binding ShowsSplitDiff}"
        AutomationProperties.Name="Side-by-side diff lines">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" x:DataType="vm:GitDiffSplitRowViewModel" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Panel>
            <Border Classes="GitDiffLine hunk" IsVisible="{Binding IsHunkHeader}">
              <TextBlock Text="{Binding HeaderText}" />
            </Border>
            <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding !IsHunkHeader}">
              <Border Classes="GitDiffLine" Classes.removed="{Binding LeftIsRemoved}">
                <Grid ColumnDefinitions="44,18,*">
                  <TextBlock Classes="GitDiffNumber" Text="{Binding LeftNumberText}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="GitDiffMarker"
                      TextAlignment="Center"
                      Text="{Binding LeftMarkerText}" />
                  <components:GitDiffTextBlock Grid.Column="2" SyntaxText="{Binding LeftText}" PeerText="{Binding RightText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
                </Grid>
              </Border>
              <Border
                  Grid.Column="1"
                  Width="1"
                  Background="{DynamicResource ShellBorderBrush}"
                  IsHitTestVisible="False" />
              <Border Grid.Column="2" Classes="GitDiffLine" Classes.added="{Binding RightIsAdded}">
                <Grid ColumnDefinitions="44,18,*">
                  <TextBlock Classes="GitDiffNumber" Text="{Binding RightNumberText}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="GitDiffMarker"
                      TextAlignment="Center"
                      Text="{Binding RightMarkerText}" />
                  <components:GitDiffTextBlock Grid.Column="2" SyntaxText="{Binding RightText}" PeerText="{Binding LeftText}" FileName="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffFileName}" ShowInvisibles="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffShowsInvisibles}" HighlightWords="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffHighlightsWords}" TextWrapping="{Binding $parent[UserControl].((vm:GitRuntimePanelViewModel)DataContext).DiffTextWrapping}" />
                </Grid>
              </Border>
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <controls:StateOverlay
        Grid.Row="3"
        Kind="Empty"
        Heading="No diff selected"
        Body="Choose a change to compare its versions."
        IsVisible="{Binding ShowsDiffEmptyState}" />
    <controls:Callout
        Grid.Row="3"
        Margin="{controls:Inset Md}"
        VerticalAlignment="Top"
        Tone="Default"
        Title="Binary file"
        Text="This change has no line-by-line comparison."
        IsVisible="{Binding ShowsBinaryDiffPlaceholder}" />
    <controls:StateOverlay
        Grid.Row="3"
        Kind="Loading"
        Heading="Reading diff…"
        IsVisible="{Binding IsDiffLoading}" />
  </Grid>
</UserControl>
