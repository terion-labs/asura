<UserControl
    x:Class="Asura.App.Views.Components.ConnectionCredentialDraftView"
    x:DataType="vm:ConnectionSecretEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Asura.Core"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls">
  <!--
    A new credential, written in place under the field that needs it. It was
    a second modal window over the connection editor, which was itself often
    over Saved Connections: three windows deep to add a password, each with
    its own idea of what Escape did. Here Escape folds the draft away and
    leaves the editor exactly as it was.
  -->
  <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock x:Name="DraftTitle" Classes="SectionHeading" Text="{Binding Title}" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding StorageHint}"
            TextWrapping="Wrap" />
      </StackPanel>
      <controls:LabeledField Label="Label">
        <TextBox x:Name="LabelInput" Text="{Binding Label}" IsEnabled="{Binding !IsSaving}" AutomationProperties.Name="Credential label" />
      </controls:LabeledField>
      <controls:LabeledField Label="Secret value" Hint="{Binding ValueHint}">
        <TextBox
            Text="{Binding Value}"
            PasswordChar="●"
            AcceptsReturn="{Binding IsMultiline}"
            IsEnabled="{Binding !IsSaving}"
            AutomationProperties.Name="New credential value" />
      </controls:LabeledField>
      <components:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button
            Classes="SecondaryButton"
            Click="OnCancelClick"
            Content="Cancel"
            IsEnabled="{Binding !IsSaving}"
            AutomationProperties.Name="Cancel the new credential" />
        <Button
            x:Name="SaveButton"
            Classes="PrimaryButton"
            Click="OnSaveClick"
            Content="{x:Static core:PlatformTerms.SaveInSecretStore}"
            IsEnabled="{Binding !IsSaving}" />
      </StackPanel>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
