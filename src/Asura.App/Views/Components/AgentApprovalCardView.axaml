<UserControl
    x:Class="Asura.App.Views.Components.AgentApprovalCardView"
    x:DataType="vm:IAgentWorkspaceHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <controls:SurfaceCard Tone="Raised"
      x:Name="AgentApprovalRequest"
      Padding="{DynamicResource ShellCardPaddingCompact}"
      Focusable="True"
      KeyboardNavigation.TabNavigation="Local"
      AutomationProperties.Name="{Binding AgentChat.PendingApproval.AccessibleName, FallbackValue='AI agent action approval request'}"
      AutomationProperties.HelpText="Review the action, where it runs, and its arguments before choosing. Exact identifiers are under Details. Approval applies once to this exact action.">
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <icons:SymbolIcon Symbol="Shield" FontSize="{DynamicResource ShellIconSizeSm}"
            Foreground="{DynamicResource ShellMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="Muted" Text="Approval required"
            FontSize="{DynamicResource ShellSecondaryFontSize}" VerticalAlignment="Center" />
        <controls:StatusChip Grid.Column="2" Classes.Warning="True"
            IsVisible="{Binding AgentChat.PendingApproval.IsHighRisk}"
            Content="{Binding AgentChat.PendingApproval.Risk}" />
      </Grid>
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock Classes="Title3"
            Text="{Binding AgentChat.PendingApproval.ToolTitle}" TextWrapping="Wrap" />
        <SelectableTextBlock FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding AgentChat.PendingApproval.TargetDisplayTitle, StringFormat={}In {0}}" TextWrapping="Wrap" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding AgentChat.PendingApproval.Host}" TextWrapping="Wrap"
            IsVisible="{Binding AgentChat.PendingApproval.HasHost}" />
        <SelectableTextBlock FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding AgentChat.PendingApproval.WorkingDirectory}" TextWrapping="Wrap"
            IsVisible="{Binding AgentChat.PendingApproval.HasWorkingDirectory}" />
      </StackPanel>
      <controls:SurfaceCard Tone="Sunken" Padding="{DynamicResource ShellCardPaddingCompact}"
          IsVisible="{Binding AgentChat.PendingApproval.HasActionArguments}">
        <ItemsControl ItemsSource="{Binding AgentChat.PendingApproval.ActionArguments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="{DynamicResource ShellSpaceSm}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentApprovalArgumentViewModel">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding DisplayName}" />
                <SelectableTextBlock
                    LineHeight="{DynamicResource ShellLineHeight13}"
                    Text="{Binding DisplayValue}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:SurfaceCard>
      <!-- Identifiers bind the decision to one exact action. They are here to
           check, not to read: the heading above already says what and where.
           Inside, one layout for every fact, a label over its value, in a
           framed, inset well at body size. -->
      <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Border
            Margin="{controls:Inset Top=Xs}"
            Padding="{controls:Inset Md}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellInnerCornerRadius}">
          <Border.Styles>
            <Style Selector="TextBlock.DetailLabel">
              <Setter Property="FontSize" Value="{DynamicResource ShellSecondaryFontSize}" />
              <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
              <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
            </Style>
            <Style Selector="SelectableTextBlock.DetailValue, TextBlock.DetailValue">
              <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight13}" />
              <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
          </Border.Styles>
          <ScrollViewer MaxHeight="{controls:TextScaled 240}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="DetailLabel" Text="Tool" />
                <SelectableTextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.ToolName}" />
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="DetailLabel" Text="Risk" />
                <TextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.Risk}" />
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="DetailLabel" Text="Permission" />
                <TextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.Permission}" />
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="DetailLabel" Text="Target" />
                <SelectableTextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.TargetTitle}" />
                <SelectableTextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.ExactTarget}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding AgentChat.PendingApproval.Arguments}"
                  IsVisible="{Binding AgentChat.PendingApproval.HasArguments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="{DynamicResource ShellSpaceSm}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentApprovalArgumentViewModel">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock Classes="DetailLabel" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Name}" />
                      <SelectableTextBlock Classes="DetailValue" Text="{Binding DisplayValue}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="DetailLabel" Text="Expires" />
                <TextBlock Classes="DetailValue" Text="{Binding AgentChat.PendingApproval.ExpiresAt}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Expander>
      <controls:Callout
          Tone="Warning"
          Glyph="Warning"
          Text="{Binding AgentChat.PendingApproval.InputYieldWarning}"
          IsVisible="{Binding AgentChat.PendingApproval.TemporarilyYieldsTerminalInput}" />
      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}"
          Text="Approval applies to this action only." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button
            Classes="SecondaryButton"
            HorizontalAlignment="Stretch"
            Click="OnDenyClick"
            Content="Deny"
            IsEnabled="{Binding AgentChat.CanDecideApproval}"
            KeyboardNavigation.TabIndex="0"
            AutomationProperties.Name="Deny AI agent action" />
        <Button
            Grid.Column="1"
            Classes="PrimaryButton"
            HorizontalAlignment="Stretch"
            Click="OnApproveClick"
            Content="Approve Once"
            IsEnabled="{Binding AgentChat.CanDecideApproval}"
            KeyboardNavigation.TabIndex="1"
            AutomationProperties.Name="Approve AI agent action once" />
      </Grid>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
