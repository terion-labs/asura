<UserControl
    x:Class="Asura.App.Views.Components.DatabaseWorkspaceView"
    x:Name="DatabaseWorkspaceRoot"
    x:DataType="vm:DatabaseRuntimePanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:Asura.App.Views.Components"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    Container.Name="databaseWorkspace"
    Container.Sizing="Width">
  <UserControl.Styles>
    <!-- The row-action strip adapts to its width: labels on a roomy panel,
         glyphs on a narrow one. Both live in every button; the panel's own
         width decides which shows — declaratively, the way the File panel's
         toolbar answers to its container. -->
    <Style Selector="local|DatabaseWorkspaceView icons|SymbolIcon.rowActionGlyph">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <ContainerQuery Name="databaseWorkspace" Query="max-width:680">
      <Style Selector="icons|SymbolIcon.rowActionGlyph">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="TextBlock.rowActionLabel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <!-- Explanatory prose is the first thing a narrow panel can no longer
           afford; the disabled buttons still say what it said. Opacity rather
           than IsVisible, because the hint's visibility is already bound. -->
      <Style Selector="TextBlock.adaptiveHint">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="MaxWidth" Value="0" />
      </Style>
    </ContainerQuery>

    <!-- Placed by style rather than in the markup, so the narrow layout
         below can move them: a value set on the element would win over it. -->
    <Style Selector="Grid.filterValueLine">
      <Setter Property="Grid.Column" Value="3" />
    </Style>
    <Style Selector="CheckBox.filterInclude">
      <Setter Property="Content" Value="Filter" />
    </Style>
    <Style Selector="StackPanel.resultPager">
      <Setter Property="Grid.Column" Value="1" />
    </Style>

    <!-- The rows above the grid answer to the width they actually have —
         the data column, beside the objects list — rather than to the whole
         workspace's. -->
    <ContainerQuery Name="databaseData" Query="max-width:640">
      <!-- A condition takes two lines rather than squeezing its pickers until
           they read "Colum" and "Opera": what to compare on the first, the
           value and its actions on the second. The second line is a grid of
           its own, so the actions never claim width from the pickers above. -->
      <Style Selector="ComboBox.filterOperator">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="Grid.filterValueLine">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
      </Style>
      <!-- The box keeps its accessible name; the caption is what goes. -->
      <Style Selector="CheckBox.filterInclude">
        <Setter Property="Content" Value="{x:Null}" />
      </Style>
      <!-- The pager takes a line of its own under the row actions. -->
      <Style Selector="StackPanel.resultPager">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="databaseData" Query="max-width:400">
      <!-- The field keeps its accessible name; the caption is what goes. -->
      <Style Selector="TextBlock.pagerCaption">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>

    <!-- Delete's label is red at the strip's own weight; filled with the
         danger tone under the pointer, it turns to the fill's foreground. -->
    <Style Selector="Button.DestructiveButton TextBlock.rowActionLabel">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <Style Selector="Button.DestructiveButton icons|SymbolIcon.rowActionGlyph">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
    <Style Selector="Button.DestructiveButton:pointerover TextBlock.rowActionLabel">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerForegroundBrush}" />
    </Style>
    <Style Selector="Button.DestructiveButton:pointerover icons|SymbolIcon.rowActionGlyph">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerForegroundBrush}" />
    </Style>

    <!-- A draft value shows the focus ring while it is being written, as a
         text field does. -->
    <Style Selector="Border.InspectorDraft:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShellFocusRingShadow}" />
    </Style>

    <!-- The SQL editor is a flat writing surface; the surrounding toolbar owns
         its border and focus geometry. -->
    <Style Selector="TextBox.QueryEditor">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.QueryEditor /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.QueryEditor:focus /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>

    <!-- The object list is a list of buttons, so its selection is a class a
         screen reader cannot see. The row that is open says so. -->
    <Style Selector="local|DatabaseWorkspaceView Button.ListRow">
      <Setter Property="AutomationProperties.ItemStatus" Value="" />
    </Style>
    <Style Selector="local|DatabaseWorkspaceView Button.ListRow.selected">
      <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
    </Style>
    <!-- While the list is locked (unsaved row changes) its rows dim like the
         rest of a disabled source list; they do not turn into filled cards,
         and the open object keeps its selection. -->
    <Style Selector="local|DatabaseWorkspaceView Button.ListRow:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="local|DatabaseWorkspaceView Button.ListRow.selected:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    </Style>

    <!-- The DataGrid.DatabaseGrid table chrome moved to AsuraTheme so
         Redis and other value tables share it. -->
    <Style Selector="Border.DatabaseCellValidation">
      <!-- The factory binds thickness to validation state. Keeping the colour in
           XAML makes the indicator follow live theme changes. -->
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,25">
    <Grid x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="196" MinWidth="120" MaxWidth="480" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <!-- The rail idiom: transparent over the panel material with a single
           hairline at the boundary, so the object list reads at the same
           density as every other panel surface. -->
      <Border x:Name="ObjectsSidebar">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- The database itself heads its objects; selecting it opens the
               catalog overview. -->
          <!-- A heading that opens the overview, not a row of the list: it
               wears no selection, so the open object below is the only row
               that reads as chosen. -->
          <Button
              Classes="ListRow"
              Margin="{controls:Inset Horizontal=Xs, Top=Sm}"
              Click="OnDatabaseHeaderClick"
              IsEnabled="{Binding IsConnected}"
              ToolTip.Tip="Show the database's objects"
              AutomationProperties.Name="Show the database overview">
            <Grid
                Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon
                  VerticalAlignment="Center"
                  Symbol="Database"
                  FontSize="{DynamicResource ShellIconSizeSm}"
                  Foreground="{DynamicResource ShellMutedBrush}" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource ShellFontSize11}"
                  FontWeight="SemiBold"
                  Classes="MiddleTruncated"
                  Text="{Binding CurrentDatabaseLabel}" />
            </Grid>
          </Button>
          <controls:SearchField
              x:Name="ObjectFilterBox"
              Grid.Row="1"
              Margin="{controls:Inset Horizontal=Xs, Vertical=Sm}"
              Text="{Binding TableFilter, Mode=TwoWay}"
              PlaceholderText="Filter objects"
              AutomationProperties.Name="Filter database objects" />
          <ScrollViewer
              Grid.Row="2"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl
                ItemsSource="{Binding Tables}"
                IsEnabled="{Binding CanChangeSelectedObject}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button
                      Classes="ListRow"
                      Classes.selected="{Binding IsSelected}"
                      Click="OnTableClick"
                      ToolTip.Tip="{Binding KindLabel}"
                      AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                    <Button.ContextMenu>
                      <ContextMenu AutomationProperties.Name="Database object actions">
                        <MenuItem
                            Click="OnObjectOpenInTabClick"
                            Header="Open in New Tab"
                            AutomationProperties.Name="Open this object in a new tab" />
                        <MenuItem
                            Click="OnObjectOpenInPanelClick"
                            Header="Open in New Panel"
                            AutomationProperties.Name="Open this object in a new panel beside this one" />
                        <Separator />
                        <MenuItem
                            Click="OnObjectOpenStructureClick"
                            Header="Open Structure"
                            AutomationProperties.Name="Open this object's structure" />
                        <Separator />
                        <MenuItem
                            Click="OnObjectCopyNameClick"
                            Header="Copy Name"
                            AutomationProperties.Name="Copy this object's name" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid
                        Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon
                          VerticalAlignment="Center"
                          Symbol="Table"
                          FontSize="{DynamicResource ShellIconSizeSm}"
                          Foreground="{DynamicResource ShellMutedBrush}"
                          IsVisible="{Binding !IsView}" />
                      <icons:SymbolIcon
                          VerticalAlignment="Center"
                          Symbol="Eye"
                          FontSize="{DynamicResource ShellIconSizeSm}"
                          Foreground="{DynamicResource ShellMutedBrush}"
                          IsVisible="{Binding IsView}" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource ShellFontSize11}"
                          Classes="MiddleTruncated"
                          Text="{Binding Name}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter
          x:Name="ObjectsSplitter"
          Grid.Column="1"
          Width="5"
          HorizontalAlignment="Stretch"
          Background="Transparent"
          ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext"
          AutomationProperties.Name="Resize the database objects list" />
      <!-- The boundary is one hairline centered in the transparent grip, the
           same idiom as the file viewer's preview splitter. -->
      <Border
          Grid.Column="1"
          Width="1"
          HorizontalAlignment="Center"
          Background="{DynamicResource ShellBorderBrush}"
          IsHitTestVisible="False" />

      <Grid
          Grid.Column="2"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          Container.Name="databaseData"
          Container.Sizing="Width">
        <!-- Embedded in another panel — the file viewer's database preview —
             there is no panel header to carry the perspectives, so they get a
             row of their own here, with the way out to a full viewer tab. -->
        <Border
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType=local:DatabaseWorkspaceView}}">
          <Grid
              Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <local:DatabasePerspectivePicker DiagramShown="OnEmbeddedDiagramShown" />
            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Classes="TextButton Dense"
                Click="OnOpenInViewerClick"
                ToolTip.Tip="Open this database in a full viewer tab"
                AutomationProperties.Name="Open this database in a Database tab">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                <icons:SymbolIcon Symbol="Open" FontSize="{DynamicResource ShellIconSizeXs}" />
                <TextBlock Text="Open in Viewer" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Only the folded objects list surfaces here; the perspectives moved
             up into the panel header beside the connection controls. -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding #ObjectsPicker.IsVisible}">
          <Grid
              Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <Button
                x:Name="ObjectsPicker"
                MinHeight="{controls:TextScaled 28}"
                MinWidth="86"
                MaxWidth="180"
                Padding="{controls:Inset Horizontal=Sm}"
                HorizontalContentAlignment="Stretch"
                Background="{DynamicResource ShellSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ShellControlCornerRadius}"
                IsVisible="False"
                AutomationProperties.Name="Choose a database object">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize11}"
                    Classes="MiddleTruncated"
                    Text="{Binding ObjectPickerLabel}" />
                <icons:SymbolIcon
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellIconSizeXs}"
                    Symbol="ChevronDown" />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <Grid Width="280" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ShellSpaceSm}">
                    <controls:SearchField
                        Text="{Binding TableFilter, Mode=TwoWay}"
                        PlaceholderText="Filter objects"
                        AutomationProperties.Name="Filter database objects" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="260"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                      <ItemsControl
                          ItemsSource="{Binding Tables}"
                          IsEnabled="{Binding CanChangeSelectedObject}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button
                                Classes="ListRow"
                                Classes.selected="{Binding IsSelected}"
                                Click="OnPickedTableClick"
                                ToolTip.Tip="{Binding KindLabel}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                              <Grid
                                  Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                                <icons:SymbolIcon
                                    VerticalAlignment="Center"
                                    Symbol="Table"
                                    FontSize="{DynamicResource ShellIconSizeSm}"
                                    Foreground="{DynamicResource ShellMutedBrush}"
                                    IsVisible="{Binding !IsView}" />
                                <icons:SymbolIcon
                                    VerticalAlignment="Center"
                                    Symbol="Eye"
                                    FontSize="{DynamicResource ShellIconSizeSm}"
                                    Foreground="{DynamicResource ShellMutedBrush}"
                                    IsVisible="{Binding IsView}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource ShellFontSize11}"
                                    Classes="MiddleTruncated"
                                    Text="{Binding Name}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Flyout>
              </Button.Flyout>
            </Button>

          </Grid>
        </Border>

        <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding ShowQueryEditor}">
          <!-- The run affordance sits in the editor's top-right corner: the
               statement is the surface, the trigger is an icon, and Cmd+Enter
               is the real interface. It keeps a column of its own so a long
               statement wraps before the icon instead of running under it in
               a narrow panel. -->
          <Grid
              Margin="{controls:Inset Horizontal=Sm, Vertical=Sm}"
              ColumnDefinitions="*,Auto">
            <local:CodeEditBox
                x:Name="QueryEditorBox"
                MinHeight="58"
                MaxHeight="132"
                AcceptsFileDrop="True"
                GrammarExtension=".sql"
                SqlCompletionContext="{CompiledBinding #DatabaseWorkspaceRoot.((vm:ISqlQueryEditorHost)DataContext).SqlLanguageCompletionContext}"
                SqlLanguageSession="{CompiledBinding #DatabaseWorkspaceRoot.((vm:ISqlQueryEditorHost)DataContext).SqlLanguageSession}"
                SqlLanguageStatus="{CompiledBinding #DatabaseWorkspaceRoot.((vm:ISqlQueryEditorHost)DataContext).SqlLanguageStatus}"
                Text="{CompiledBinding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Watermark="SELECT …"
                EditorKeyDown="OnQueryEditorKeyDown"
                AutomationProperties.Name="SQL statement" />
            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="{controls:Inset Xs}"
                Padding="{controls:Inset Xs}"
                Classes="IconButton"
                Command="{Binding RunQueryCommand}"
                ToolTip.Tip="{x:Static vm:ShortcutTips.RunStatement}"
                AutomationProperties.Name="Run the SQL statement">
              <icons:SymbolIcon
                  Symbol="Play"
                  FontSize="{DynamicResource ShellIconSizeSm}"
                  Foreground="{DynamicResource ShellTextBrush}" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Row="3">
        <Border IsVisible="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType=local:DatabaseWorkspaceView}}">
          <local:ErrorNoticesView DataContext="{Binding ErrorNotices}" />
        </Border>

        <controls:SurfaceCard
            Tone="Notice"
            Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
            Padding="{controls:Inset Sm}"
            IsVisible="{Binding HasInterchangeNotice}">
          <controls:LiveRegionTextBlock
              Text="{Binding InterchangeNotice}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Spreadsheet formula risk" />
        </controls:SurfaceCard>
        </StackPanel>

        <Grid Grid.Row="4">
          <!-- DATA -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowDataSurface}">
            <Border
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding HasResults}">
              <StackPanel Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" Spacing="{DynamicResource ShellSpaceXs}">
                <!-- Stackable conditions: each row can be switched off without
                     losing what it says; Apply reads every included row. -->
                <!-- Shown only where a filter can run: a disabled row of
                     controls over a catalog read as broken, not unavailable. -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource ShellSpaceSm}"
                    Grid.IsSharedSizeScope="True"
                    IsVisible="{Binding CanFilterTable}">
                  <ItemsControl ItemsSource="{Binding FilterRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="{DynamicResource ShellSpaceXs}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Proportional rails: stacked rows still line up
                             in columns because every row stretches to the
                             same width. A narrow panel moves the value and
                             the actions to a second line (the container
                             query above) instead of squeezing the pickers. -->
                        <Grid
                            Classes="filterRow"
                            ColumnSpacing="{DynamicResource ShellSpaceXs}"
                            RowSpacing="{DynamicResource ShellSpaceXs}">
                          <!-- The minimums keep a picker readable at a narrow
                               width; past them its choice trims with an
                               ellipsis. Held by the columns, so a picker
                               never spills over the checkbox beside it. -->
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="filterLine" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="96" />
                            <ColumnDefinition Width="*" MinWidth="112" />
                            <ColumnDefinition Width="2*" />
                          </Grid.ColumnDefinitions>
                          <!-- Says what it switches: an unlabelled box at the
                               start of the row read as a row selector. The
                               caption comes from the styles above, so a narrow
                               panel can drop it. -->
                          <CheckBox
                              Classes="filterInclude"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              ToolTip.Tip="Include this condition when the filter is applied"
                              AutomationProperties.Name="Include this filter condition" />
                          <ComboBox
                              Grid.Column="1"
                              Classes="Dense"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Columns}"
                              SelectedItem="{Binding Column, Mode=TwoWay}"
                              PlaceholderText="Column"
                              AutomationProperties.Name="Filter column">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox
                              Grid.Column="2"
                              Classes="Dense filterOperator"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding Operator, Mode=TwoWay}"
                              PlaceholderText="Operator"
                              AutomationProperties.Name="Filter operator">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Grid
                              Classes="filterValueLine"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="{DynamicResource ShellSpaceXs}">
                            <TextBox
                                Classes="Dense filterValue"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Text="{Binding Value, Mode=TwoWay}"
                                IsVisible="{Binding NeedsValue}"
                                PlaceholderText="Value"
                                KeyDown="OnFilterValueKeyDown"
                                AutomationProperties.Name="Filter value" />
                            <!-- One push-button style for the whole row, so
                                 remove and add read as controls beside Apply. -->
                            <StackPanel
                                Grid.Column="1"
                                Classes="filterActions"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{DynamicResource ShellSpaceXs}">
                              <Button
                                  Classes="SecondaryButton Dense"
                                  Click="OnApplyFilterClick"
                                  ToolTip.Tip="Apply the table filter"
                                  AutomationProperties.Name="Apply the table filter">
                                <Panel>
                                  <TextBlock Classes="rowActionLabel" Text="Apply" />
                                  <icons:SymbolIcon Classes="rowActionGlyph" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
                                </Panel>
                              </Button>
                              <Button
                                  Classes="SecondaryButton Dense"
                                  Click="OnRemoveFilterRowClick"
                                  ToolTip.Tip="Remove this condition"
                                  AutomationProperties.Name="Remove this filter condition">
                                <icons:SymbolIcon Symbol="Subtract" FontSize="{DynamicResource ShellIconSizeXs}" />
                              </Button>
                              <Button
                                  Classes="SecondaryButton Dense"
                                  Click="OnAddFilterRowClick"
                                  ToolTip.Tip="Add a condition"
                                  AutomationProperties.Name="Add a filter condition">
                                <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeXs}" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- The same push button as Apply: one style per strip.
                       Centered in a band as tall as the first condition's
                       first line, so it sits on the same line as Apply. -->
                  <Grid Grid.Column="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" SharedSizeGroup="filterLine" />
                    </Grid.RowDefinitions>
                    <Button
                        VerticalAlignment="Center"
                        Classes="SecondaryButton Dense"
                        Click="OnClearFilterClick"
                        ToolTip.Tip="Clear the table filter"
                        AutomationProperties.Name="Clear the table filter">
                      <Panel>
                        <TextBlock Classes="rowActionLabel" Text="Clear" />
                        <icons:SymbolIcon Classes="rowActionGlyph" Symbol="FilterDismiss" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Panel>
                    </Button>
                  </Grid>
                </Grid>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" RowSpacing="{DynamicResource ShellSpaceXs}">
                  <!-- NULL and DEFAULT are cell verbs, so they live on the
                       cell's own context menu rather than in a strip that
                       mostly acts on rows. Each remaining action carries a
                       label and a glyph; which one shows follows the panel's
                       width, so the strip always fits and nothing is clipped
                       behind a scroll. One push-button style for the whole
                       strip: a filled Save beside a plain-text Delete read as
                       three kinds of control. -->
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                    <Button
                        Classes="SecondaryButton Dense"
                        Click="OnAddRowClick"
                        IsEnabled="{Binding CanMutateRows}"
                        ToolTip.Tip="{x:Static vm:DatabaseRuntimePanelViewModel.AddRowTip}"
                        AutomationProperties.Name="Add a database row">
                      <Panel>
                        <TextBlock Classes="rowActionLabel" Text="Add Row" />
                        <icons:SymbolIcon Classes="rowActionGlyph" Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Panel>
                    </Button>
                    <!-- A red label at the strip's own weight: the danger
                         is in the colour and the confirmation, not in a
                         heavier face. -->
                    <Button
                        Classes="DestructiveButton Dense"
                        FontWeight="Normal"
                        Click="OnDeleteRowClick"
                        IsEnabled="{Binding CanDeleteSelectedRow}"
                        ToolTip.Tip="Delete the selected rows"
                        AutomationProperties.Name="Delete the selected database rows">
                      <Panel>
                        <TextBlock Classes="rowActionLabel" Text="Delete" />
                        <icons:SymbolIcon Classes="rowActionGlyph" Symbol="Delete" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Panel>
                    </Button>
                    <Button
                        Classes="SecondaryButton Dense"
                        Click="OnRevertChangesClick"
                        IsEnabled="{Binding CanRevertChanges}"
                        ToolTip.Tip="Revert unsaved changes"
                        AutomationProperties.Name="Revert unsaved database changes">
                      <Panel>
                        <TextBlock Classes="rowActionLabel" Text="Revert" />
                        <icons:SymbolIcon Classes="rowActionGlyph" Symbol="ArrowUndo" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Panel>
                    </Button>
                    <Button
                        Classes="SecondaryButton Dense"
                        Click="OnSaveChangesClick"
                        IsEnabled="{Binding CanSaveChanges}"
                        ToolTip.Tip="Save changes"
                        AutomationProperties.Name="Save database changes">
                      <Panel>
                        <TextBlock Classes="rowActionLabel" Text="Save" />
                        <icons:SymbolIcon Classes="rowActionGlyph" Symbol="Save" FontSize="{DynamicResource ShellIconSizeSm}" />
                      </Panel>
                    </Button>
                  </StackPanel>

                  <!-- Paging belongs at the edge: it is about the result set,
                       not about editing rows. The arrows sit together after
                       the position they move, as in a Mac pager. -->
                  <StackPanel
                      Classes="resultPager"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource ShellSpaceXs}">
                    <!-- "Rows per page: 200 · 6 rows". A bare "200 / 6" read
                         as page 200 of 6. -->
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted pagerCaption"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="Rows per page:" />
                    <TextBox
                        Width="{controls:TextScaled 52}"
                        Classes="Dense"
                        HorizontalContentAlignment="Center"
                        Text="{Binding PageLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanChangePageLimit}"
                        KeyDown="OnPageLimitKeyDown"
                        ToolTip.Tip="Rows per page, from 1 to 5000"
                        AutomationProperties.Name="Database page row limit"
                        AutomationProperties.HelpText="Enter a value from 1 to 5000, then press Enter" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="·" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding TotalRowsText}"
                        AutomationProperties.Name="Total matching database rows" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="·" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                        Text="{Binding PagePositionText}"
                        AutomationProperties.Name="Database page position" />
                    <StackPanel Orientation="Horizontal">
                      <Button
                          Classes="IconButton"
                          Click="OnPreviousPageClick"
                          IsEnabled="{Binding CanGoToPreviousPage}"
                          ToolTip.Tip="Previous page"
                          AutomationProperties.Name="Show the previous database page">
                        <icons:SymbolIcon Symbol="ChevronLeft" FontSize="{DynamicResource ShellIconSizeXs}" />
                      </Button>
                      <Button
                          Classes="IconButton"
                          Click="OnNextPageClick"
                          IsEnabled="{Binding CanGoToNextPage}"
                          ToolTip.Tip="Next page"
                          AutomationProperties.Name="Show the next database page">
                        <icons:SymbolIcon Symbol="ChevronRight" FontSize="{DynamicResource ShellIconSizeXs}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>

                  <!-- Why the rows cannot be changed, on a line of its own
                       where it can be read whole rather than clipped at the
                       end of the action strip. -->
                  <TextBlock
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellSecondaryFontSize}"
                      Text="{Binding ReadOnlyReason}"
                      IsVisible="{Binding HasReadOnlyReason}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding ReadOnlyReason}"
                      AutomationProperties.Name="Database read-only reason" />
                </Grid>
              </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
              <!-- No containing ScrollViewer: DataGrid must receive a finite
                   viewport to virtualize rows and columns correctly. -->
              <DataGrid
                  x:Name="ResultDataGrid"
                  Classes="DatabaseGrid"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ResultRows}"
                  IsReadOnly="{Binding !CanMutateRows}"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="{Binding CanSortTable}"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Extended"
                  Sorting="OnResultSorting"
                  CellPointerPressed="OnResultCellPointerPressed"
                  ContextRequested="OnResultContextRequested"
                  KeyDown="OnResultGridKeyDown"
                  SelectionChanged="OnResultSelectionChanged"
                  AutomationProperties.Name="Database rows">
                <DataGrid.ContextMenu>
                  <!-- Kept inside the window: a menu opened near the bottom
                       of the grid flips up, and one near an edge slides in. -->
                  <ContextMenu
                      x:Name="ResultContextMenu"
                      MinWidth="286"
                      PlacementConstraintAdjustment="FlipY, SlideY, SlideX"
                      Opening="OnResultContextMenuOpening"
                      Closing="OnResultContextMenuClosing"
                      AutomationProperties.Name="Database rows context menu">
                    <!-- Groups, most used first: reading the cell and row,
                       reloading the page, changing rows, and — last, behind
                       its own separator — taking a row away. No item carries
                       an icon: four of fifteen did, which made those four look
                       like a different kind of command. -->
                    <MenuItem
                        x:Name="CellEditorMenuItem"
                        Click="OnCellEditorClick"
                        Header="Open Cell Editor…"
                        AutomationProperties.Name="Open the active database cell in the cell editor" />
                    <MenuItem
                        x:Name="CopyRowMenuItem"
                        Click="OnCopyRowClick"
                        Header="Copy Row"
                        AutomationProperties.Name="Copy the selected database row" />
                    <MenuItem
                        x:Name="CopyCellMenuItem"
                        Click="OnCopyCellClick"
                        Header="Copy Cell Value"
                        AutomationProperties.Name="Copy the active database cell value" />
                    <MenuItem
                        x:Name="CopyColumnMenuItem"
                        Click="OnCopyColumnClick"
                        Header="Copy All Column Values"
                        AutomationProperties.Name="Copy all values in the active database column" />
                    <MenuItem
                        x:Name="CopyRowAsMenuItem"
                        Header="Copy Row As"
                        AutomationProperties.Name="Copy the selected database row as">
                      <MenuItem
                          Click="OnCopyRowJsonClick"
                          Header="JSON"
                          AutomationProperties.Name="Copy the selected database row as JSON" />
                      <MenuItem
                          Click="OnCopyRowCsvClick"
                          Header="CSV"
                          AutomationProperties.Name="Copy the selected database row as CSV" />
                      <MenuItem
                          x:Name="CopyRowInsertMenuItem"
                          Click="OnCopyRowInsertClick"
                          Header="SQL INSERT"
                          AutomationProperties.Name="Copy the selected database row as an SQL INSERT statement" />
                    </MenuItem>
                    <MenuItem
                        x:Name="QuickFilterMenuItem"
                        Header="Quick Filter"
                        AutomationProperties.Name="Quick-filter the active database cell" />
                    <MenuItem
                        x:Name="ExportPageMenuItem"
                        Click="OnExportPageClick"
                        Header="Export Page…"
                        AutomationProperties.Name="Export the current database page" />

                    <Separator />
                    <MenuItem
                        x:Name="RefreshTableMenuItem"
                        Click="OnRefreshTableClick"
                        Header="Refresh"
                        AutomationProperties.Name="Refresh the current database page" />

                    <Separator x:Name="MutationMenuSeparator" />
                    <MenuItem
                        x:Name="PasteCellMenuItem"
                        Click="OnPasteCellClick"
                        Header="Paste"
                        AutomationProperties.Name="Paste a database cell value from the clipboard" />
                    <MenuItem
                        x:Name="SetValueMenuItem"
                        Header="Set Value"
                        AutomationProperties.Name="Set the active database cell value">
                      <MenuItem
                          x:Name="SetEmptyMenuItem"
                          Click="OnSetEmptyClick"
                          Header="Empty"
                          AutomationProperties.Name="Set the active database cell to empty text" />
                      <MenuItem
                          x:Name="SetNullContextMenuItem"
                          Click="OnSetNullContextClick"
                          Header="NULL"
                          AutomationProperties.Name="Set the active database cell to NULL from the context menu" />
                      <MenuItem
                          x:Name="SetDefaultContextMenuItem"
                          Click="OnSetDefaultContextClick"
                          Header="DEFAULT"
                          AutomationProperties.Name="Set the active database cell to DEFAULT from the context menu" />
                      <Separator x:Name="SetFileMenuSeparator" />
                      <MenuItem
                          x:Name="SetFileMenuItem"
                          Click="OnSetFileClick"
                          Header="Choose File…"
                          AutomationProperties.Name="Set the active database cell from a file" />
                    </MenuItem>
                    <MenuItem
                        x:Name="AddRowMenuItem"
                        Click="OnContextAddRowClick"
                        Header="Add Row"
                        AutomationProperties.Name="Add a database row from the context menu" />
                    <MenuItem
                        x:Name="DuplicateRowMenuItem"
                        Click="OnDuplicateRowClick"
                        Header="Duplicate Row"
                        AutomationProperties.Name="Duplicate the selected database row" />
                    <MenuItem
                        x:Name="ImportMenuItem"
                        Click="OnImportCsvClick"
                        Header="Import CSV…"
                        AutomationProperties.Name="Import database rows from CSV" />

                    <Separator x:Name="DeleteMenuSeparator" />
                    <MenuItem
                        x:Name="DeleteRowMenuItem"
                        Click="OnContextDeleteRowClick"
                        Header="Delete Row"
                        AutomationProperties.Name="Delete the selected database row from the context menu" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>

              <!-- The expanded editor for prose-sized cells (text, JSON). It
                   belongs to the workspace, not the cell template, so the
                   grid's edit lifecycle cannot tear it down mid-keystroke;
                   both editors stage into the same cell view model. Code
                   places it over the result grid (PlaceCellExpandPopup):
                   under the cell, or above it when the grid runs out below,
                   and slid left rather than past the grid's right edge. The
                   window constraint stays as the last resort. -->
              <Popup
                  x:Name="CellExpandPopup"
                  WindowManagerAddShadowHint="True"
                  IsLightDismissEnabled="True"
                  OverlayDismissEventPassThrough="True"
                  Placement="BottomEdgeAlignedLeft"
                  PlacementConstraintAdjustment="FlipY, SlideX">
                <!-- A popover's edge: hairline and shadow, the accent being
                     kept for the focus inside it. The margin leaves the
                     shadow room where popups are drawn in the window; the
                     placement offsets it, so the edge meets the cell. The
                     shadow is a plate behind the surface rather than the
                     surface's own: a box shadow on the editor's parent
                     border stops the text layer drawing when the popup is
                     rendered to a bitmap. -->
                <Panel>
                  <Border
                      Margin="{controls:Inset Sm}"
                      Background="{DynamicResource ShellPopupSurfaceBrush}"
                      BoxShadow="{DynamicResource ShellOverlayShadow}"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}"
                      IsHitTestVisible="False" />
                  <Border
                      x:Name="CellExpandSurface"
                      Margin="{controls:Inset Sm}"
                      Padding="{controls:Inset Xs}"
                      Background="{DynamicResource ShellPopupSurfaceBrush}"
                      BorderBrush="{DynamicResource ShellBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}">
                    <local:CodeEditBox
                        x:Name="CellExpandEditor"
                        Width="320"
                        MinHeight="104"
                        MaxHeight="200"
                        EditorKeyDown="OnCellExpandEditorKeyDown"
                        AutomationProperties.Name="Expanded cell editor" />
                  </Border>
                </Panel>
              </Popup>

              <StackPanel
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{DynamicResource ShellSpaceSm}"
                  IsVisible="{Binding ShowEmptyHint}"
                  IsHitTestVisible="False">
                <icons:SymbolIcon
                    HorizontalAlignment="Center"
                    Symbol="Database"
                    FontSize="{controls:TextScaled 24}"
                    Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock
                    Classes="Muted"
                    Text="Connect, then run a statement or pick an object to preview its rows."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="360" />
              </StackPanel>

              <!-- The field inspector is outside the virtualized grid so long
                   values remain readable without widening every result column. -->
              <Border
                  x:Name="InspectorColumn"
                  Grid.Column="1"
                  Width="330"
                  BorderBrush="{DynamicResource ShellBorderBrush}"
                  BorderThickness="1,0,0,0"
                  IsVisible="{Binding HasSelectedRow}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      x:Name="InspectorResizeHandle"
                      Width="5"
                      Background="Transparent"
                      Cursor="SizeWestEast"
                      PointerPressed="OnInspectorResizePressed"
                      PointerMoved="OnInspectorResizeMoved"
                      PointerReleased="OnInspectorResizeReleased" />
                  <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                    <Border Classes="PanelToolbar">
                      <Grid Margin="{controls:Inset Left=Md, Right=Xs}" ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="SectionHeading"
                            Text="{Binding SelectedRowTitle}" />
                        <Button
                            Grid.Column="1"
                            Classes="IconButton"
                            Click="OnDismissInspectorClick"
                            ToolTip.Tip="Close row inspector"
                            AutomationProperties.Name="Close the row inspector">
                          <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeXs}" />
                        </Button>
                      </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="0,0,0,1">
                      <StackPanel
                          Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource ShellSpaceXs}">
                        <!-- One pull-down that names its verb, rather than
                             three bare format names with no chrome. -->
                        <Button
                            x:Name="InspectorCopyAsButton"
                            Classes="SecondaryButton Dense CopyAction"
                            ToolTip.Tip="Copy this row in another format"
                            AutomationProperties.Name="Copy the row in another format">
                          <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                              <TextBlock Classes="CopyLabel" VerticalAlignment="Center" Text="Copy As" />
                              <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronDown" FontSize="{DynamicResource ShellIconSizeXs}" />
                            </StackPanel>
                            <icons:SymbolIcon Classes="CopyCheck" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" />
                          </Panel>
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                              <MenuItem Header="JSON" Click="OnInspectorCopyJsonClick" AutomationProperties.Name="Copy the row as JSON" />
                              <MenuItem Header="CSV" Click="OnInspectorCopyCsvClick" AutomationProperties.Name="Copy the row as CSV" />
                              <MenuItem
                                  Header="SQL INSERT"
                                  Click="OnInspectorCopyInsertClick"
                                  IsEnabled="{Binding CanCopySelectedRowAsInsert}"
                                  ToolTip.Tip="An executable INSERT for the active database"
                                  AutomationProperties.Name="Copy the row as an SQL INSERT statement" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Border>
                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SelectedRowFields}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
                              <StackPanel
                                  Margin="{controls:Inset Horizontal=Md, Vertical=Sm}"
                                  Spacing="{DynamicResource ShellSpaceXs}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                                  <TextBlock
                                      VerticalAlignment="Center"
                                      FontSize="{DynamicResource ShellFontSize11}"
                                      FontWeight="SemiBold"
                                      Classes="MiddleTruncated"
                                      Text="{Binding Name}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="Muted"
                                        FontSize="{DynamicResource ShellSecondaryFontSize}"
                                        Text="{Binding DataTypeName}" />
                                    <Button
                                        Classes="IconButton"
                                        Click="OnFieldEditClick"
                                        IsVisible="{Binding ShowsEditAction}"
                                        ToolTip.Tip="Edit this value"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}">
                                      <icons:SymbolIcon Symbol="Edit" FontSize="{DynamicResource ShellIconSizeXs}" />
                                    </Button>
                                    <Button
                                        Classes="IconButton"
                                        Click="OnFieldApplyClick"
                                        IsVisible="{Binding IsEditing}"
                                        ToolTip.Tip="Apply (stages the change; Save commits the row)"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Apply {0}}">
                                      <icons:SymbolIcon Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeXs}" Foreground="{DynamicResource ShellSuccessBrush}" />
                                    </Button>
                                    <Button
                                        Classes="IconButton"
                                        Click="OnFieldCancelClick"
                                        IsVisible="{Binding IsEditing}"
                                        ToolTip.Tip="Revert this edit"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Revert {0}}">
                                      <icons:SymbolIcon Symbol="Dismiss" FontSize="{DynamicResource ShellIconSizeXs}" />
                                    </Button>
                                  </StackPanel>
                                </Grid>
                                <Panel IsVisible="{Binding !IsEditing}">
                                  <TextBlock
                                      Classes.Muted="{Binding IsNull}"
                                      FontFamily="{DynamicResource ShellDataFontFamily}"
                                      FontSize="{DynamicResource ShellFontSize11}"
                                      IsVisible="{Binding !HasGrammar}"
                                      Text="{Binding Text}"
                                      TextWrapping="Wrap" />
                                  <!-- Values that read as code read highlighted:
                                       the same engine as the file previews,
                                       keyed by the value's detected grammar.
                                       Not FitsContent and not interactive: the
                                       fit machinery writes the editor's height
                                       inside this scrolling column and layout
                                       feeds back on itself, and a wheel over
                                       the value must scroll the inspector, not
                                       an editor with nothing to scroll. Sized
                                       by measure, it simply grows like the
                                       plain text beside it does. -->
                                  <local:CodePreviewView
                                      ShowLineNumbers="False"
                                      IsHitTestVisible="False"
                                      IsVisible="{Binding HasGrammar}"
                                      Text="{Binding Text}"
                                      FileName="{Binding GrammarFileName}" />
                                </Panel>
                                <Border
                                    Classes="InspectorDraft"
                                    BorderBrush="{DynamicResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ShellControlCornerRadius}"
                                    Padding="{controls:Inset Xs}"
                                    IsVisible="{Binding ShowsTextEditor}">
                                  <local:CodeEditBox
                                      MinHeight="24"
                                      MaxHeight="200"
                                      GrammarExtension="{Binding GrammarExtension}"
                                      Text="{Binding Draft, Mode=TwoWay}"
                                      EditorKeyDown="OnFieldDraftKeyDown"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Draft value for {0}}" />
                                </Border>
                                <ComboBox
                                    IsVisible="{Binding ShowsBooleanEditor}"
                                    ItemsSource="{Binding BooleanValues}"
                                    SelectedItem="{Binding Draft, Mode=TwoWay}"
                                    KeyDown="OnFieldDraftKeyDown"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Draft value for {0}}" />
                                <TextBlock
                                    Classes="Muted"
                                    FontSize="{DynamicResource ShellSecondaryFontSize}"
                                    Foreground="{DynamicResource ShellDangerBrush}"
                                    IsVisible="{Binding HasValidationError}"
                                    Text="{Binding ValidationError}"
                                    TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- DATABASE ER DIAGRAM: the diagram fills the whole area, and the
               header panel floats over its top edge as dark glass — the dense
               background tone, translucent, so the diagram slides beneath it.
               (Tinted translucency, not blur — Avalonia's acrylic backdrop is
               window-level and cannot blur in-app content behind a control.) -->
          <Grid IsVisible="{Binding IsDatabaseDiagramOverview}">
            <local:DatabaseWorkerDiagramView
                x:Name="MermaidDiagramRenderer"
                Session="{Binding DiagramSession}" />
            <Border
                x:Name="DiagramHeaderBar"
                VerticalAlignment="Top"
                Background="{DynamicResource ShellVeilBrush}">
              <StackPanel
                  Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource ShellSpaceXs}">
                <Button
                    Classes="TextButton Dense"
                    Click="OnCopyMermaidDiagramClick"
                    Content="Copy Source"
                    IsEnabled="{Binding HasMermaidDiagram}"
                    AutomationProperties.Name="Copy the Mermaid ER diagram source" />
                <Button
                    Classes="TextButton Dense"
                    Click="OnCopyMermaidSvgClick"
                    Content="Copy SVG"
                    IsEnabled="{Binding HasMermaidDiagram}"
                    AutomationProperties.Name="Copy the rendered Mermaid ER diagram SVG" />
                <Button
                    Classes="TextButton Dense"
                    Click="OnSaveMermaidDiagramClick"
                    Content="Save…"
                    IsEnabled="{Binding IsConnected}"
                    AutomationProperties.Name="Save the Mermaid ER diagram" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- STRUCTURE -->
          <DataGrid
              Classes="DatabaseGrid"
              AutoGenerateColumns="False"
              ItemsSource="{Binding StructureColumns}"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              HeadersVisibility="Column"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              SelectionMode="Single"
              IsVisible="{Binding ShowStructure}"
              AutomationProperties.Name="Database object structure">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="180" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" />
              <DataGridTextColumn Header="Nullable" Binding="{Binding Nullable}" Width="90" />
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="80" />
              <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="180" />
              <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- INDEXES -->
          <DataGrid
              Classes="DatabaseGrid"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Indexes}"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              HeadersVisibility="Column"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              SelectionMode="Single"
              IsVisible="{Binding ShowIndexes}"
              AutomationProperties.Name="Database object indexes">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Index" Binding="{Binding Name}" Width="180" />
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
              <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="220" />
              <DataGridTextColumn Header="Unique" Binding="{Binding Unique}" Width="80" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
              <DataGridTextColumn Header="Predicate or expression" Binding="{Binding Predicate}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>
    </Grid>

    <Border
        Grid.Row="1"
        Classes="PanelFooter">
      <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <TextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding ResultSummary}" />
        <!-- The session, never the connection string: engine and version,
             transport security, route, principal, database, object. -->
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellSecondaryFontSize}"
            Text="{Binding ConnectionSummary}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.Name="Connection summary" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
