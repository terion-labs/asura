<UserControl
    x:Class="Asura.App.Views.Components.WorkspaceMemoriesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:core="using:Asura.Core"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    x:DataType="vm:WorkspaceMemoriesViewModel">
  <!--
    A sheet in two columns, each owning its own controls: the notes and how
    to narrow them on the left, the one you are reading or writing on the
    right. The header carries only the two switches that govern the whole
    store, the footer only what is true of the store right now. Short fields
    name themselves inline so the editor is a form you can take in at a
    glance, not a column of labels; the one explanatory paragraph lives in
    the empty state, where it is read once, rather than over every visit.
  -->
  <Grid
      Width="640"
      MaxHeight="640"
      RowDefinitions="Auto,*,Auto"
      IsEnabled="{Binding IsReady}">

    <Border
        Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <icons:SymbolIcon
            VerticalAlignment="Center"
            Symbol="BookOpen"
            FontSize="15"
            Foreground="{DynamicResource ShellAccentBrush}" />
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="{DynamicResource ShellFontSize14}"
            FontWeight="SemiBold"
            Text="Workspace memories"
            ToolTip.Tip="Notes shared with built-in and connected agents. Stored locally; recalled notes are sent to the selected model." />
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="{DynamicResource ShellSpaceSm}"
            ToolTip.Tip="When on, relevant notes are added to the selected model's context.">
          <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize11}" Text="Recall" />
          <ToggleSwitch
              IsChecked="{Binding RecallEnabled, Mode=OneWay}"
              Command="{Binding ToggleEnabledCommand}"
              AutomationProperties.Name="Recall workspace memories" />
        </StackPanel>
        <StackPanel
            Grid.Column="3"
            Margin="{controls:Inset Left=Sm}"
            Orientation="Horizontal"
            Spacing="{DynamicResource ShellSpaceSm}"
            ToolTip.Tip="When on, agents may save and archive notes. Reading is always allowed.">
          <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize11}" Text="Agent writes" />
          <ToggleSwitch
              IsChecked="{Binding AgentWritesAllowed, Mode=OneWay}"
              Command="{Binding ToggleWritesCommand}"
              AutomationProperties.Name="Allow agents to write workspace memories" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" MinHeight="360" ColumnDefinitions="240,*">
      <Border
          BorderBrush="{DynamicResource ShellBorderBrush}"
          BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid
              Margin="{controls:Inset Horizontal=Sm, Vertical=Sm}"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceXs}">
            <TextBox
                Classes="Dense"
                Text="{Binding Search}"
                PlaceholderText="Search notes"
                KeyDown="OnSearchKeyDown"
                ToolTip.Tip="Press Enter to search"
                AutomationProperties.Name="Search workspace memories">
              <TextBox.InnerLeftContent>
                <icons:SymbolIcon
                    Margin="{controls:Inset Left=Sm}"
                    Symbol="Search"
                    FontSize="11"
                    Foreground="{DynamicResource ShellMutedBrush}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <ComboBox
                Grid.Column="1"
                Classes="Chip"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding Filter}"
                ToolTip.Tip="Show one kind of note"
                AutomationProperties.Name="Filter memories by type" />
          </Grid>
          <Panel Grid.Row="1">
            <ListBox
                Classes="Rows"
                ItemsSource="{Binding Notes}"
                SelectedItem="{Binding Selected}"
                IsVisible="{Binding HasNotes}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="Workspace notes">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:WorkspaceMemory">
                  <controls:ListItem
                      ContentPadding="{DynamicResource ShellListRowPadding}"
                      Title="{Binding Title}"
                      AutomationProperties.Name="{Binding Title}">
                    <controls:ListItem.Detail>
                      <MultiBinding StringFormat="{}{0} · {1:d MMM}">
                        <Binding Path="Kind" />
                        <Binding Path="UpdatedAt" />
                      </MultiBinding>
                    </controls:ListItem.Detail>
                    <controls:ListItem.Trailing>
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                        <icons:SymbolIcon
                            VerticalAlignment="Center"
                            Symbol="Pin"
                            FontSize="11"
                            Foreground="{DynamicResource ShellMutedBrush}"
                            IsVisible="{Binding Pinned}"
                            ToolTip.Tip="Pinned: recalled first" />
                        <controls:StatusChip
                            Classes="Neutral"
                            Shape="Rounded"
                            IsOutlined="False"
                            Content="{Binding Status}"
                            IsVisible="{Binding Status, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static core:WorkspaceMemoryStatus.Active}}" />
                      </StackPanel>
                    </controls:ListItem.Trailing>
                  </controls:ListItem>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <controls:EmptyStatePanel
                ShowsGlyph="False"
                Padding="{DynamicResource ShellInsetLg}"
                Heading="{Binding EmptyHeading}"
                Body="{Binding EmptyBody}"
                IsVisible="{Binding !HasNotes}" />
          </Panel>
          <!-- Where you are in the list, and the one filter that widens it
               rather than narrowing it. -->
          <Grid
              Grid.Row="2"
              Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceXs}">
            <Button
                Classes="IconButton Compact"
                Command="{Binding PreviousCommand}"
                ToolTip.Tip="Previous page"
                AutomationProperties.Name="Previous page of notes">
              <icons:SymbolIcon Symbol="ChevronLeft" FontSize="12" />
            </Button>
            <TextBlock
                Grid.Column="1"
                MinWidth="56"
                VerticalAlignment="Center"
                TextAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding PageLabel}" />
            <Button
                Grid.Column="2"
                Classes="IconButton Compact"
                Command="{Binding NextCommand}"
                ToolTip.Tip="Next page"
                AutomationProperties.Name="Next page of notes">
              <icons:SymbolIcon Symbol="ChevronRight" FontSize="12" />
            </Button>
            <CheckBox
                Grid.Column="4"
                VerticalAlignment="Center"
                FontSize="{DynamicResource ShellFontSize10}"
                Content="Archived"
                IsChecked="{Binding IncludeInactive}"
                ToolTip.Tip="Also list archived, superseded, and expired notes."
                AutomationProperties.Name="Show archived, superseded, and expired notes" />
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Column="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceSm}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
              <TextBlock
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding EditorEyebrow}" />
              <controls:StatusChip
                  Classes.Neutral="{Binding !IsNoteActive}"
                  Content="{Binding NoteStatusLabel}"
                  IsVisible="{Binding HasSelection}" />
              <icons:SymbolIcon
                  VerticalAlignment="Center"
                  Symbol="Pin"
                  FontSize="11"
                  Foreground="{DynamicResource ShellMutedBrush}"
                  IsVisible="{Binding IsNotePinned}"
                  ToolTip.Tip="Pinned: recalled first" />
            </StackPanel>
            <!-- A note's history is a thing you step through, not a number you
                 type. -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{DynamicResource ShellSpaceXs}"
                IsVisible="{Binding HasSelection}">
              <Button
                  Classes="IconButton Compact"
                  Command="{Binding OlderRevisionCommand}"
                  ToolTip.Tip="Older revision"
                  AutomationProperties.Name="Show the previous revision">
                <icons:SymbolIcon Symbol="ChevronLeft" FontSize="12" />
              </Button>
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize10}"
                  Text="{Binding RevisionLabel}" />
              <Button
                  Classes="IconButton Compact"
                  Command="{Binding NewerRevisionCommand}"
                  ToolTip.Tip="Newer revision"
                  AutomationProperties.Name="Show the next revision">
                <icons:SymbolIcon Symbol="ChevronRight" FontSize="12" />
              </Button>
            </StackPanel>
            <Button
                Grid.Column="2"
                Classes="SecondaryButton Dense"
                Command="{Binding NewCommand}"
                IsVisible="{Binding HasSelection}"
                AutomationProperties.Name="Start a new memory note">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                <icons:SymbolIcon Symbol="Add" FontSize="11" />
                <TextBlock Text="New note" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding NoteMeta}"
              TextTrimming="CharacterEllipsis"
              ToolTip.Tip="{Binding NoteMeta}"
              IsVisible="{Binding HasSelection}" />

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <ComboBox
                Classes="Chip"
                VerticalAlignment="Center"
                ItemsSource="{Binding Kinds}"
                SelectedItem="{Binding Kind}"
                ToolTip.Tip="What kind of note this is"
                AutomationProperties.Name="Memory type" />
            <TextBox
                Grid.Column="1"
                Text="{Binding Title}"
                MaxLength="120"
                FontWeight="SemiBold"
                PlaceholderText="Title"
                AutomationProperties.Name="Memory title" />
          </Grid>
          <TextBox
              MinHeight="96"
              Text="{Binding Body}"
              MaxLength="2000"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              PlaceholderText="What should this workspace remember?"
              AutomationProperties.Name="Memory text" />
          <!-- Short fields name themselves inside the box, so they keep their
               names once filled without a row of labels above them. -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBox
                Classes="Dense"
                Text="{Binding Source}"
                MaxLength="500"
                PlaceholderText="Conversation or document"
                ToolTip.Tip="Where this came from. Attribution, not proof."
                AutomationProperties.Name="Memory source">
              <TextBox.InnerLeftContent>
                <TextBlock
                    Margin="{controls:Inset Left=Sm}"
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Text="Source" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <TextBox
                Grid.Column="1"
                Classes="Dense"
                Text="{Binding Applicability}"
                MaxLength="200"
                PlaceholderText="Everywhere"
                ToolTip.Tip="An environment or path this note applies to. Empty means everywhere."
                AutomationProperties.Name="Memory applicability">
              <TextBox.InnerLeftContent>
                <TextBlock
                    Margin="{controls:Inset Left=Sm}"
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Text="Applies to" />
              </TextBox.InnerLeftContent>
            </TextBox>
          </Grid>

          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <Button
                Classes="PrimaryButton Dense"
                Content="Save"
                Command="{Binding SaveCommand}"
                AutomationProperties.Name="Save memory note" />
            <Button
                Grid.Column="1"
                Classes="SecondaryButton Dense"
                Content="{Binding PinLabel}"
                Command="{Binding PinCommand}"
                IsVisible="{Binding HasSelection}"
                ToolTip.Tip="Pinned notes are recalled first."
                AutomationProperties.Name="Pin or unpin this note" />
            <Button
                Grid.Column="2"
                Classes="SecondaryButton Dense"
                Content="{Binding ArchiveLabel}"
                Command="{Binding ArchiveCommand}"
                IsVisible="{Binding HasSelection}"
                ToolTip.Tip="Archived notes leave default recall but stay on record."
                AutomationProperties.Name="Archive or restore this note" />
            <!-- Deletion stays one quiet word until asked for. -->
            <Button
                Grid.Column="4"
                Classes="TextButton Dense"
                Content="Forget…"
                Command="{Binding ToggleForgetCommand}"
                AutomationProperties.Name="Show or hide the forget controls" />
          </Grid>

          <controls:Callout
              Tone="Danger"
              Glyph="Delete"
              Text="Forgetting permanently removes notes and their revisions. Source conversations, backups, and copies already held by connected agents are not erased."
              IsVisible="{Binding IsForgetOpen}">
            <Grid Margin="{controls:Inset Top=Xs}" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <TextBox
                  Classes="Dense"
                  Width="110"
                  Text="{Binding Confirmation}"
                  PlaceholderText="Type FORGET"
                  AutomationProperties.Name="Confirm forgetting memory" />
              <Button
                  Grid.Column="1"
                  Classes="DestructiveButton Dense"
                  Content="Forget this note"
                  Command="{Binding ForgetCommand}"
                  IsVisible="{Binding HasSelection}"
                  AutomationProperties.Name="Forget the selected note" />
              <Button
                  Grid.Column="2"
                  Classes="DestructiveButton Dense"
                  Content="Forget all"
                  Command="{Binding ForgetAllCommand}"
                  AutomationProperties.Name="Forget every note in this workspace" />
            </Grid>
          </controls:Callout>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="{controls:Inset Horizontal=Md, Vertical=Xs}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <controls:LiveRegionTextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding Status}"
            TextTrimming="CharacterEllipsis"
            ToolTip.Tip="{Binding Status}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Memory status" />
        <controls:StatusChip
            Grid.Column="1"
            Classes="Warning"
            Content="Nearly full"
            IsVisible="{Binding IsStorageNearlyFull}" />
        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding StorageLabel}"
            ToolTip.Tip="Notes and their revisions count toward a 50 MiB quota per workspace." />
        <Button
            Grid.Column="3"
            Classes="TextButton Accent Dense"
            Content="Export…"
            Click="OnExportClick"
            ToolTip.Tip="Save every note and revision as JSON."
            AutomationProperties.Name="Export workspace memories" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
