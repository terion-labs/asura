<UserControl
    x:Class="Asura.App.Views.Components.SettingsPageHeader"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <!--
    The Settings window's title names the page on show, so the page no longer
    repeats it as a large heading above its first section: two titles a few
    points apart said the same word twice. What the page is for stays as its
    opening line. The heading is kept, unseen, for the page's own name.
  -->
  <StackPanel>
    <TextBlock
        x:Name="HeadingText"
        Classes="Title1"
        IsVisible="False"
        Text="{Binding Heading, ElementName=Root}" />
    <TextBlock
        Classes="Muted"
        LineHeight="{DynamicResource ShellLineHeight12}"
        Text="{Binding Description, ElementName=Root}"
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
