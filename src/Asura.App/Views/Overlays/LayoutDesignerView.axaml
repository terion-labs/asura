<UserControl
    x:Class="Asura.App.Views.Overlays.LayoutDesignerView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:views="using:Asura.App.Views"
    xmlns:components="using:Asura.App.Views.Components"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:dockDocuments="using:Dock.Model.Inpc.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:overlays="using:Asura.App.Views.Overlays"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.DataTemplates>
    <!--
      One designer slot, rendered inside its Dock document. The header is the
      drag surface — exactly the runtime panel contract — so rearranging a
      designed layout is the same gesture as rearranging a live workspace.
    -->
    <DataTemplate DataType="vm:LayoutDesignerSlotViewModel">
      <controls:SurfaceCard
          Tone="Sunken"
          ClipsContent="True"
          Padding="0"
          Classes.active="{Binding IsSelected}"
          PointerPressed="OnLayoutSlotPointerPressed">
        <Grid RowDefinitions="32,*">
          <Border Classes="PanelHeader">
            <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <Border
                  Width="20"
                  Height="20"
                  VerticalAlignment="Center"
                  Classes="LayoutSlotBadge"
                  Classes.orange="{Binding UsesOrangePalette}"
                  Classes.blue="{Binding UsesBluePalette}"
                  Classes.green="{Binding UsesGreenPalette}"
                  Classes.pink="{Binding UsesPinkPalette}"
                  CornerRadius="{DynamicResource ShellInnerCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize10}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ShellSlotBadgeInkBrush}"
                    Text="{Binding Order}" />
              </Border>
              <controls:PanelDockHandle
                  x:DataType="dockDocuments:Document"
                  Grid.Column="1"
                  DataContext="{Binding $parent[dock:DockableControl].DataContext}">
                <!-- The handle takes the dockable's context for the drag, so
                     the label reads the slot from the card it sits on. -->
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ShellFontSize11}"
                    FontWeight="SemiBold"
                    Text="{Binding $parent[controls:SurfaceCard].((vm:LayoutDesignerSlotViewModel)DataContext).OrderLabel}" />
              </controls:PanelDockHandle>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
                <Button
                    Classes="IconButton"
                    Click="OnLayoutSplitSlotRightClick"
                    ToolTip.Tip="Split left/right"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Split {0} left and right}">
                  <icons:SymbolIcon FontSize="{DynamicResource ShellIconSizeSm}" Symbol="SplitVertical" />
                </Button>
                <Button
                    Classes="IconButton"
                    Click="OnLayoutSplitSlotDownClick"
                    ToolTip.Tip="Split top/bottom"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Split {0} top and bottom}">
                  <icons:SymbolIcon FontSize="{DynamicResource ShellIconSizeSm}" Symbol="SplitHorizontal" />
                </Button>
                <Button
                    Classes="IconButton"
                    Click="OnLayoutRemoveSlotClick"
                    ToolTip.Tip="Remove panel"
                    AutomationProperties.Name="{Binding OrderLabel, StringFormat={}Remove {0}}">
                  <icons:SymbolIcon FontSize="{DynamicResource ShellIconSizeSm}" Symbol="Dismiss" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <!-- The header already names the panel; the body says its size. -->
          <TextBlock
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="Headline"
              Text="{Binding SizeLabel}" />
        </Grid>
      </controls:SurfaceCard>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- It fills the Layout Designer window, which can be as small as half a
       laptop screen: the canvas and the panel list share what is left, and
       the footer stays pinned along the bottom. The window's own title says
       what it is, so the content doesn't say it again, and its close button
       is the way out besides Cancel. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <controls:LabeledField Label="Layout name">
          <TextBox x:Name="NewLayoutName" Text="{Binding LayoutDesignerEditor.Name, Mode=TwoWay}" PlaceholderText="My layout" AutomationProperties.Name="Layout name" />
        </controls:LabeledField>
        <!-- Only news is worth a badge: "saved" is the resting state, and
             a label saying so was furniture. -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" Margin="{controls:Inset Bottom=Xs}" Classes="Keycap" IsVisible="{Binding LayoutDesignerEditor.IsDirty}"><TextBlock Text="{Binding LayoutDesignerEditor.DirtyStatus}" /></Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="300" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource ShellBackgroundBrush}">
        <Grid Margin="{controls:Inset Lg}" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ShellSpaceMd}">
          <Border
              Background="{DynamicResource ShellBackgroundBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ShellCardCornerRadius}"
              ClipToBounds="True">
            <dock:DockControl
                x:Name="LayoutDesignerDock"
                Margin="{controls:Inset Xs}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Layout="{Binding LayoutDesignerEditor.DockLayout}"
                Factory="{Binding LayoutDesignerEditor.DockFactory}"
                IsDockingEnabled="{Binding IsLayoutDesignerDockingEnabled}"
                InitializeFactory="True"
                InitializeLayout="False"
                AutomationProperties.Name="Editable layout canvas" />
          </Border>
          <Border Grid.Row="1" HorizontalAlignment="Center" Padding="{controls:Inset Horizontal=Md, Vertical=Sm}" Background="{DynamicResource ShellSurfaceRaisedBrush}" CornerRadius="{DynamicResource ShellPillCornerRadius}">
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding LayoutDesignerEditor.GridHint}" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
            <components:SectionHeader Heading="Panels" Count="{Binding LayoutDesignerEditor.PanelCount}" />

            <ItemsControl ItemsSource="{Binding LayoutDesignerEditor.Slots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button
                      Margin="{controls:Inset Bottom=Xs}"
                      Padding="{controls:Inset Sm}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Classes="SecondaryButton"
                      Classes.active="{Binding IsSelected}"
                      Click="OnLayoutSlotClick"
                      AutomationProperties.Name="{Binding OrderLabel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Border
                          Width="24"
                          Height="24"
                          Classes="LayoutSlotBadge"
                          Classes.orange="{Binding UsesOrangePalette}"
                          Classes.blue="{Binding UsesBluePalette}"
                          Classes.green="{Binding UsesGreenPalette}"
                          Classes.pink="{Binding UsesPinkPalette}"
                          CornerRadius="{DynamicResource ShellControlCornerRadius}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource ShellSlotBadgeInkBrush}" Text="{Binding Order}" />
                      </Border>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                      <components:CountPill Grid.Column="2" Value="{Binding SizeLabel}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                HorizontalAlignment="Stretch"
                Classes="SecondaryButton"
                Click="OnLayoutAddSlotClick"
                AutomationProperties.Name="Add a panel">
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="Add" FontSize="{DynamicResource ShellIconSizeSm}" />
                <TextBlock Text="Add Panel" />
              </StackPanel>
            </Button>

            <controls:SurfaceCard Tone="Notice" Padding="{DynamicResource ShellCardPaddingCompact}">
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="A layout's panels start empty. Choose what each one opens when you use the layout in a screen." TextWrapping="Wrap" />
            </controls:SurfaceCard>

            <components:ErrorNoticesView DataContext="{Binding LayoutDesignerEditor.ErrorNotices}" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding LayoutDesignerEditor.ValidationSummary}" TextWrapping="Wrap" />

            <!-- The saved layouts, as a list with the one being designed
                 checked: choosing another opens it here. -->
            <components:SectionHeader Heading="Saved layouts" />
            <ItemsControl ItemsSource="{Binding Layouts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button
                      Margin="{controls:Inset Bottom=Xs}"
                      Padding="{controls:Inset Xs}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Classes="ListRow"
                      Classes.selected="{Binding #OpenMark.IsVisible}"
                      Click="OnEditLayoutClick">
                    <!-- The check is only drawn, so the open layout says so
                         in its name; the selected row also reports itself
                         as selected. -->
                    <AutomationProperties.Name>
                      <MultiBinding Converter="{x:Static overlays:LayoutDesignerView.LayoutRowName}">
                        <Binding Path="Name" />
                        <Binding Path="Id" />
                        <Binding Path="$parent[overlays:LayoutDesignerView].((vm:MainWindowViewModel)DataContext).LayoutDesignerEditor.Id" />
                      </MultiBinding>
                    </AutomationProperties.Name>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Border Width="44" Height="28" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellInnerCornerRadius}" ClipToBounds="True">
                        <ItemsControl Margin="{DynamicResource ShellPreviewTileInset}" ItemsSource="{Binding PreviewPanels}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ScreenLayoutPreviewPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="{DynamicResource ShellHairlineInset}" Classes="ScreenPreviewPanel" Classes.primary="{Binding IsPrimary}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="MiddleTruncated" Text="{Binding Name}" />
                      <icons:SymbolIcon x:Name="OpenMark" Grid.Column="2" VerticalAlignment="Center" Symbol="Checkmark" FontSize="{DynamicResource ShellIconSizeSm}" AutomationProperties.AccessibilityView="Raw">
                        <icons:SymbolIcon.IsVisible>
                          <MultiBinding Converter="{x:Static overlays:LayoutDesignerView.SameLayout}">
                            <Binding Path="Id" />
                            <Binding Path="$parent[overlays:LayoutDesignerView].((vm:MainWindowViewModel)DataContext).LayoutDesignerEditor.Id" />
                          </MultiBinding>
                        </icons:SymbolIcon.IsVisible>
                      </icons:SymbolIcon>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Reset Layout is an auxiliary action: on the leading edge, away
         from Cancel and Save. The panel count is in the Panels heading. -->
    <Border Grid.Row="2" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button x:Name="ResetButton" MinWidth="88" VerticalAlignment="Center" Classes="SecondaryButton" Click="OnResetLayoutClick" Content="Reset Layout" ToolTip.Tip="Restore the saved layout" />
        <Button x:Name="CancelButton" Grid.Column="2" MinWidth="88" VerticalAlignment="Center" Classes="SecondaryButton" Click="OnLayoutDesignerCancelClick" Content="Cancel" IsCancel="True" />
        <Button x:Name="SaveButton" Grid.Column="3" MinWidth="88" VerticalAlignment="Center" Classes="PrimaryButton" Click="OnSaveLayoutDesignerClick" Content="Save" IsDefault="True" IsEnabled="{Binding LayoutDesignerEditor.CanSave}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
