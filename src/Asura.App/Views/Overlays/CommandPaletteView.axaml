<UserControl
    x:Class="Asura.App.Views.Overlays.CommandPaletteView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Asura.App.ViewModels"
    xmlns:controls="using:Asura.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:overlays="using:Asura.App.Views.Overlays"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Styles>
    <!-- Typing keeps focus in the search field, and Return opens the
         selected row, so the list is the one being worked in whenever the
         palette has focus: its selection wears the accent, as Spotlight's
         does, rather than the gray of a list in the background. -->
    <Style Selector="controls|SurfaceCard:focus-within ListBox.CommandPaletteResults ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="controls|SurfaceCard:focus-within ListBox.CommandPaletteResults ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
    <Style Selector="controls|SurfaceCard:focus-within ListBox.CommandPaletteResults ListBoxItem:selected icons|SymbolIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    </Style>
  </UserControl.Styles>
  <!-- 680 wide where there is room; the code-behind caps it at the window's
       width less its margins, so a window tiled to half a laptop screen
       still shows the whole palette. -->
  <controls:SurfaceCard Elevation="Overlay" Padding="0"
      x:Name="PaletteCard"
      MaxHeight="700"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      KeyboardNavigation.TabNavigation="Cycle">
    <Grid RowDefinitions="58,*,44">
      <!-- The host's search field: its own magnifier, a clear button once
           there is text, and Escape that clears before it closes. -->
      <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <controls:SearchField
            x:Name="CommandSearchBox"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            KeyDown="OnSearchKeyDown"
            PlaceholderText="Search commands, connections, screens, workspaces, and sessions"
            AutomationProperties.Name="Search commands and launch targets"
            Text="{Binding LauncherSearchQuery}" />
        <Button Grid.Column="1" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="OnCloseClick" AutomationProperties.Name="Close command palette">
          <Border Classes="Keycap">
            <TextBlock Text="{x:Static overlays:CommandPaletteView.CloseKeyText}" />
          </Border>
        </Button>
      </Grid>
      <!-- Rows are list items, not buttons: Return or a click opens the
           selected one, and the list draws its selection the way every list
           does. A row says what it is, where it belongs and its shortcut;
           command identifiers stay out of sight. -->
      <ListBox
          x:Name="LauncherSearchResultList"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          Classes="CommandPaletteResults"
          AutomationProperties.Name="Commands and launch targets"
          ItemsSource="{Binding LauncherSearchResults}"
          SelectedItem="{Binding SelectedLauncherSearchResult, Mode=TwoWay}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:LauncherSearchResultViewModel">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="Padding" Value="{DynamicResource ShellInsetNone}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LauncherSearchResultViewModel">
            <!-- The whole row answers a click, padding included. -->
            <Border Padding="{controls:Inset Sm}" Background="Transparent" Tapped="OnActivateSearchResultTapped">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
              <Border Width="34" Height="34" VerticalAlignment="Center" Classes="IconTile">
                <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="{DynamicResource ShellIconSizeSm}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Classes="MiddleTruncated" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Classes="Muted"
                  Text="{Binding TrailingText}"
                  IsVisible="{Binding HasTrailingText}" />
            </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel
          Grid.Row="1"
          Margin="{controls:Inset Xxl}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="{DynamicResource ShellSpaceSm}"
          IsVisible="{Binding HasNoLauncherSearchResults}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Launcher search has no results">
        <icons:SymbolIcon HorizontalAlignment="Center" Symbol="Search" FontSize="{controls:TextScaled 24}" />
        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No results" />
        <TextBlock MaxWidth="420" HorizontalAlignment="Center" Classes="Muted" TextAlignment="Center" Text="{Binding LauncherSearchEmptyState}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="Dimmed results can't be used right now." />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellSecondaryFontSize}" Text="{x:Static overlays:CommandPaletteView.KeyHintText}" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
