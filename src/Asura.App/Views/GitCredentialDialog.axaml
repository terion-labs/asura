<Window x:Class="Asura.App.Views.GitCredentialDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Asura.App.Controls"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ShellBackgroundBrush}"
        Title="Sign in to Git">
  <StackPanel Margin="{controls:Inset Xl}" Spacing="{DynamicResource ShellSpaceMd}">
    <TextBlock Text="Sign in to Git" FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" />
    <TextBlock x:Name="RemoteLabel" TextWrapping="Wrap" />
    <TextBlock x:Name="Description" Classes="Muted" TextWrapping="Wrap"
               Text="Enter your username and password or personal access token to continue." />
    <TextBox x:Name="UsernameInput" MaxLength="4096" PlaceholderText="Username" AutomationProperties.Name="Git username" />
    <TextBox x:Name="PasswordInput" MaxLength="16384" PlaceholderText="Password or access token" PasswordChar="•"
             AutomationProperties.Name="Git password or access token" />
    <CheckBox x:Name="SaveCredentials" IsChecked="False" Content="Save in system credential store" />
    <TextBlock x:Name="Validation" IsVisible="False" Text="Enter a username and password or token without line breaks." TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
      <Button Classes="PrimaryButton" Click="OnSignInClick" Content="Sign in and retry" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
