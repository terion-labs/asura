<controls:DialogWindow x:Class="Asura.App.Views.GitCredentialDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Asura.App.Controls"
        Width="440" SizeToContent="Height" CanResize="False">
  <controls:DialogShell x:Name="Shell" Title="Sign In to Git" Scrolls="False">
    <controls:DialogShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Classes="PrimaryButton" Click="OnSignInClick" Content="Sign In" IsDefault="True" />
      </StackPanel>
    </controls:DialogShell.Footer>
    <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <controls:LabeledField Label="Username" controls:FieldValidation.For="Username">
        <TextBox x:Name="UsernameInput" MaxLength="4096" AutomationProperties.Name="Git username" />
      </controls:LabeledField>
      <controls:LabeledField Label="Password or access token" controls:FieldValidation.For="Password">
        <TextBox x:Name="PasswordInput" MaxLength="16384" PasswordChar="•"
                 AutomationProperties.Name="Git password or access token" />
      </controls:LabeledField>
      <CheckBox x:Name="SaveCredentials" IsChecked="False" Content="Save in system credential store" />
    </StackPanel>
  </controls:DialogShell>
</controls:DialogWindow>
