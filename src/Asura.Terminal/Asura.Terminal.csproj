<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Asura.Application\Asura.Application.csproj" />
    <ProjectReference Include="..\Asura.Core\Asura.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- PortablePtyRuntime loads libasura_pty from the application directory,
       but this library project never learns the RID being published: the SDK
       does not pass it to project references, so a payload selected here would
       be the build host's. src/Asura.Desktop selects the payload by its
       effective RID; tests/Asura.Terminal.Tests copies it for the test host. -->

</Project>
