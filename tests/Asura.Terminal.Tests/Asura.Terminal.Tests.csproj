<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- PortablePtyRuntime loads libasura_pty from the application directory,
         which for these tests is their own output. src/Asura.Desktop selects
         the payload for the application; this copies the staged library for
         the RID the tests run on. -->
    <AsuraPtyRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</AsuraPtyRid>
    <AsuraPtyRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</AsuraPtyRid>
    <AsuraPtyLibrary Condition="$(AsuraPtyRid.StartsWith('osx-'))">libasura_pty.dylib</AsuraPtyLibrary>
    <AsuraPtyLibrary Condition="$(AsuraPtyRid.StartsWith('linux-'))">libasura_pty.so</AsuraPtyLibrary>
    <AsuraPtyArtifact>$(MSBuildThisFileDirectory)../../native/artifacts/$(AsuraPtyRid)/$(AsuraPtyLibrary)</AsuraPtyArtifact>
  </PropertyGroup>

  <ItemGroup Condition="'$(AsuraPtyLibrary)' != '' and Exists('$(AsuraPtyArtifact)')">
    <Content Include="$(AsuraPtyArtifact)" Link="$(AsuraPtyLibrary)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Asura.Terminal\Asura.Terminal.csproj" />
  </ItemGroup>

</Project>
