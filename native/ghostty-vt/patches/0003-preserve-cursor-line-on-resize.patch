diff --git a/src/terminal/Screen.zig b/src/terminal/Screen.zig
index 8cc2787..c8718ac 100644
--- a/src/terminal/Screen.zig
+++ b/src/terminal/Screen.zig
@@ -1944,6 +1944,8 @@ pub inline fn blankCell(self: *const Screen) Cell {
 }
 
 pub const Resize = struct {
+    /// Whether cursor coordinates follow text reflow or the old physical rows.
+    reflow_cursor: bool = true,
     /// The new size to resize to
     cols: size.CellCountInt,
     rows: size.CellCountInt,
@@ -2045,6 +2047,27 @@ pub inline fn resize(
         self.cursor.hyperlink = null;
     }
 
+    // Readline tracks its physical row within the input independently of the
+    // terminal. Reflow text normally, but keep that row offset for SIGWINCH
+    // redraws, including when widening collapses several input rows into one.
+    const physical_cursor: ?struct { start: *Pin, row_offset: usize, x: size.CellCountInt } = if (!opts.reflow_cursor and opts.reflow and opts.cols != self.pages.cols) saved: {
+        var rows = self.cursor.page_pin.rowIterator(.left_up, self.pages.pin(.{ .active = .{} }));
+        var row_offset: usize = 0;
+        while (rows.next()) |row| : (row_offset += 1) {
+            if (row.rowAndCell().row.wrap_continuation) continue;
+            if (row_offset >= opts.rows) break :saved null;
+            var start = row;
+            start.x = 0;
+            break :saved .{
+                .start = try self.pages.trackPin(start),
+                .row_offset = row_offset,
+                .x = self.cursor.x,
+            };
+        }
+        break :saved null;
+    } else null;
+    defer if (physical_cursor) |saved| self.pages.untrackPin(saved.start);
+
     // Perform the resize operation.
     try tw.check(.pages);
     try self.pages.resize(.{
@@ -2058,6 +2081,26 @@ pub inline fn resize(
         },
     });
 
+    if (physical_cursor) |saved| {
+        // Widening may remove the rows Readline still thinks it occupies.
+        // Retain enough blank rows for its relative cursor-up sequence.
+        var retained_rows: usize = 0;
+        while (saved.start.down(saved.row_offset) == null and retained_rows < opts.rows) : (retained_rows += 1) {
+            _ = self.pages.grow() catch |err| {
+                // Text already reflowed successfully. Keep its valid cursor
+                // instead of failing midway through restoration on OOM.
+                log.warn("failed to retain shell redraw rows err={}", .{err});
+                break;
+            };
+        }
+        if (saved.start.down(saved.row_offset)) |position| {
+            if (self.pages.pointFromPin(.active, position) != null) {
+                self.cursor.page_pin.* = position;
+                self.cursor.page_pin.x = @min(saved.x, opts.cols - 1);
+            }
+        }
+    }
+
     // No more failures are possible after this. Enforced by compiler
     // because we do NO cleanup of the state below.
     errdefer comptime unreachable;
