diff --git a/src/terminal/c/terminal.zig b/src/terminal/c/terminal.zig
index b06c8ac..2bf2d6d 100644
--- a/src/terminal/c/terminal.zig
+++ b/src/terminal/c/terminal.zig
@@ -818,6 +818,9 @@ pub fn resize(
 ) callconv(lib.calling_conv) Result {
     const wrapper = terminal_ orelse return .invalid_value;
     wrapper.stream.handler.resize(.{
+        // Readline tracks physical rows and redraws after SIGWINCH. Reflowing
+        // its input first moves the cursor behind the shell's back.
+        .reflow_cursor = false,
         .cols = cols,
         .rows = rows,
         .cell_size_px = .{
@@ -4242,3 +4245,61 @@ test "get_multi null keys returns invalid_value" {
     var values = [_]?*anyopaque{@ptrCast(&cols)};
     try testing.expectEqual(Result.invalid_value, get_multi(null, 1, null, &values, null));
 }
+
+test "resize keeps readline cursor row while reflowing completed output" {
+    const alloc = testing.allocator;
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 20, 8));
+    defer free(t);
+    const initial = "history-0123456789\r\nprobe> abcdefgh";
+    vt_write(t, initial, initial.len);
+    try testing.expectEqual(Result.success, resize(t, 8, 8, 8, 16));
+    // History wraps to three rows. The pending input stays on its original
+    // physical row so Readline's carriage return targets the prompt start.
+    try testing.expectEqual(3, t.?.terminal.screens.active.cursor.y);
+    const redraw = "\r\x1b[Kprobe> abcdefgh";
+    vt_write(t, redraw, redraw.len);
+    const actual = try t.?.terminal.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(actual);
+    try testing.expectEqualStrings("history-\n01234567\n89\nprobe> a\nbcdefgh", actual);
+}
+
+test "resize preserves the physical cursor row of wrapped input" {
+    const alloc = testing.allocator;
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 8, 8));
+    defer free(t);
+    const initial = "probe> abcdefgh";
+    vt_write(t, initial, initial.len);
+    try testing.expectEqual(Result.success, resize(t, 20, 8, 8, 16));
+    try testing.expectEqual(1, t.?.terminal.screens.active.cursor.y);
+    try testing.expectEqual(7, t.?.terminal.screens.active.cursor.x);
+    const redraw = "\r\x1b[A\x1b[Jprobe> abcdefgh";
+    vt_write(t, redraw, redraw.len);
+    const actual = try t.?.terminal.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(actual);
+    try testing.expectEqualStrings("probe> abcdefgh", actual);
+}
+
+test "resize reflows wide input glyphs without moving the cursor row" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 10, 8));
+    defer free(t);
+    const initial = "abc界def";
+    vt_write(t, initial, initial.len);
+    try testing.expectEqual(Result.success, resize(t, 4, 8, 8, 16));
+    try testing.expectEqual(0, t.?.terminal.screens.active.cursor.y);
+    try testing.expectEqual(3, t.?.terminal.screens.active.cursor.x);
+    t.?.terminal.screens.active.assertIntegrity();
+}
+
+test "resize never retains scrollback-sized cursor row offsets" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 8, 4));
+    defer free(t);
+    const text = "x" ** 800;
+    vt_write(t, text, text.len);
+    try testing.expectEqual(Result.success, resize(t, 80, 4, 8, 16));
+    try testing.expect(t.?.terminal.screens.active.pages.total_rows < 20);
+    try testing.expect(t.?.terminal.screens.active.cursor.y < 4);
+}
